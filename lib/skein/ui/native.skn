;;;; The skein.ui bridge for stock Skein. Patch batches and UI events travel
;;;; over the renderer's pipes as length-prefixed skein.bin values.

(ns skein.ui.native
  (:require [skein.bin :as bin] [skein.io :as io] [skein.process :as process]
            [skein.sys :as sys]))

(def ^:private package-root
  (when-let [[_ source] (skein.core/%find-lib "skein.ui.native")]
    (let [root (nth (iterate io/parent (io/absolute source)) 4)]
      (or (io/canonical root) root))))

(def ^:private frame-limit (* 128 1024 1024))

(defn- host-path []
  (or (sys/getenv "SKEIN_UI_HOST")
      (some #(when (io/file? %) %)
            (let [{:keys [os arch]} (sys/info)
                  exe (if (= :windows os) "skein-ui-host.exe" "skein-ui-host")]
              [(io/path package-root "target" "release" exe)
               (io/path package-root "bin" (str (name os) "-" (name arch)) exe)]))
      (error "skein-ui: renderer missing. Run cargo build --release --locked -p skein-ui-host in"
             package-root "or set SKEIN_UI_HOST.")))

(defn- read-exact [stream size]
  (loop [remaining size parts (transient [])]
    (if (zero? remaining)
      (apply bytes-concat (persistent! parts))
      (if-let [part (io/read stream (min remaining 65536))]
        (recur (- remaining (count part)) (conj! parts part))
        (when (< remaining size) (error "skein-ui: truncated renderer message"))))))

(defn- receive [stream]
  (when-let [header (read-exact stream 4)]
    (let [n (reduce + (map-indexed (fn [i b] (bit-shift-left b (* i 8))) header))]
      (when-not (<= 5 n frame-limit)
        (error "skein-ui: invalid renderer message length" n))
      (if-let [body (read-exact stream n)]
        (bin/decode body)
        (error "skein-ui: truncated renderer message")))))

(defn- send!
  "Queue a frame. For a patch batch (count? set), the batch's number: the
  renderer counts the batches it is sent the same way, and names a
  rejected one by it."
  [{:keys [outbox wake]} kind data count?]
  (let [body (bin/encode [kind data])
        n (count body)]
    (when (> n frame-limit) (error "skein-ui: patch exceeds the renderer message limit"))
    (let [length (bytes (mapv #(bit-and (bit-shift-right n %) 255) [0 8 16 24]))
          ;; (numbered and queued in one step, so the numbers are the order sent)
          state (swap! outbox (fn [o] (-> o
                                          (update :frames conj [length body])
                                          (update :batches (if count? inc identity)))))]
      (offer! wake true)
      (when count? (:batches state)))))

(defn- close-process! [p]
  ;; (closing its input tells the renderer to quit, and closing its output
  ;; keeps it from blocking on a write nobody reads; once it has, the rest)
  (io/close (:in p))
  (io/close (:out p))
  (try (process/wait p) (finally (process/close p))))

(defn- stop-app! [p stopped? message]
  ;; An image restores with a new renderer. A reader saved in the old
  ;; image can only be waiting on a stale pipe.
  (when (and (resource-live? (:out p)) (compare-and-set! stopped? false true))
    (close-process! p)
    (when message (skein.core/%write-stderr (str "skein-ui: " message "\n")))
    (exit (if message 1 0))))

(defn- read-events! [p stopped? events]
  (try
    (loop []
      (let [event (receive (:out p))]
        (cond
          (map? event) (do (put! events event) (recur))
          (= [:quit] event) (stop-app! p stopped? nil)
          (nil? event) (stop-app! p stopped? "renderer exited")
          :else (stop-app! p stopped? "unexpected renderer message"))))
    (catch Error e (stop-app! p stopped? (condition-message e)))))

(defn- write-requests! [p stopped? outbox wake]
  ;; Callers enqueue complete frames. A single writer keeps frames intact
  ;; even when a fiber that submitted one is cancelled during a pipe write.
  (try
    (loop []
      (when (take! wake)
        (let [[old _] (swap-vals! outbox assoc :frames [])]
          (doseq [[header body] (:frames old)]
            (io/write (:in p) header)
            (io/write (:in p) body)))
        (recur)))
    (catch Error e (stop-app! p stopped? (condition-message e)))))

(defn connect
  "Connect to the renderer. Its events are sent to events."
  [events]
  (let [p (process/start (host-path) :err :inherit)]
    (try
      (when-not (= [:ready 1] (receive (:out p)))
        (error "skein-ui: renderer failed to start or has an incompatible protocol"))
      (catch Error e
        (close-process! p)
        (throw e)))
    (let [outbox (atom {:frames [] :batches 0})
          wake (chan 1 :dropping)
          stopped? (atom false)]
      (spawn-detached (write-requests! p stopped? outbox wake))
      (spawn-detached (read-events! p stopped? events))
      {:outbox outbox :wake wake})))

(defn apply!
  "Send a patch batch. Returns its number, which an :error event for it
  carries as :batch."
  [engine batch]
  (send! engine :apply batch true))

(defn simulate! [engine input]
  (send! engine :simulate input false)
  nil)
