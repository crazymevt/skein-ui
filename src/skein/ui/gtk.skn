(ns skein.ui.gtk
  "The GTK 4 backend (Skein's M2.14, D-097): skein.ui's widgets as GTK's own, on Linux
(and on macOS, with Homebrew's GTK), through skein.ui.gtk.lib.

  (ui/use-backend! (gtk/backend))

GTK runs on the main thread, where it was initialized: -main runs there, and ui/run!
runs the main loop there. A call from another fiber is queued for the main thread, which
an idle source wakes the main loop to run, while the fiber waits for its result.

Every container is a GtkFixed in which layout places each child and sets its size
request. For tests, click!, type-text!, press-return!, native-string and native-frame
act on and read the real widgets."
  (:require [skein.ui :as ui]
            [skein.ui.gtk.lib :as lib]
            [skein.ffi :as ffi]
            [skein.math :as math]
            [skein.string :as string]
            [skein.time :as time]))

;;; ------------------------------------------------------------------------------------
;;; What each widget class implements here

(defgeneric make-native [w]
  "Make w's GTK widget, with a reference of our own, without its properties: the core
sets them next.")

(defgeneric set-native [w property value]
  "Show value, w's new property, in its GTK widget. The default ignores the property.")

(defmethod set-native [w property value]
  nil)

(defgeneric native-signal [w kind instance arg]
  "w's GTK widget (or a controller of it), instance, emitted the signal we know as kind
(:clicked, :changed, ...), with arg, its argument if it has one.")

(defmethod native-signal [w kind instance arg]
  nil)

(defgeneric layout-native [w width height]
  "w's GTK widget got the size width by height from layout: place what GTK doesn't (a
split pane's divider).")

(defmethod layout-native [w width height]
  nil)

(defgeneric setup-cell [w column list-item]
  "Give the GtkListItem of w's list, table or tree a child for a cell of column.")

(defgeneric bind-cell [w column list-item]
  "Show in the GtkListItem's child the cell of its row in column.")

(defgeneric children-model [w item]
  "The GListModel of the children of a tree's item (a GtkStringObject), or null.")

(defgeneric native-draw [w cr width height]
  "w's drawing area draws with the Cairo context cr: emit :draw.")

(defgeneric native-input [w kind controller args]
  "One of w's event controllers reported kind (:pressed, :motion, :key-pressed, ...)
with args, a map.")

(defgeneric native-close-request [o]
  "The user asked o's GtkWindow to close: by default ui/close!.")

(defmethod native-close-request [o]
  (ui/close! o))

(defgeneric native-natural-size [w]
  "w's natural [width height]: by default its GTK widget's natural size.")

(defgeneric container-view [o]
  "The GtkFixed that o's children go in: by default its own widget.")

(defmethod container-view [o]
  (:native o))

(defn- native [o] (:native o))

(def ^:private show-button-content!
  "Show a button's label and image (defined with the images, below).")

;;; ------------------------------------------------------------------------------------
;;; Signals: a few callbacks, one for each C signature. The handler's user data is a
;;; small integer saying which signal it is.

(def ^:private signal-kinds
  [:clicked :activate :changed :toggled :value-changed :resized :selected :switch-page
   :close-request :position :sort :items-changed :pressed :released :motion :enter :leave
   :scroll :key-pressed :key-released :window-key :closed :menu-activate :active
   :page-reordered :tab-close])

(defn- kind-of [data] (nth signal-kinds (ffi/address data)))

(defn connect!
  "Connect the GTK object o's signal named signal-name to the callback handler (one of
this namespace's), reporting it as kind. Returns o."
  [o signal-name kind handler]
  (lib/g-signal-connect-data o signal-name handler
                             (lib/signal-data (index-of signal-kinds kind)) (ffi/null) 0)
  o)

(ffi/defcallback signal-imp void [instance ptr, data ptr]
  (when-let [w (lib/object-for instance)]
    (native-signal w (kind-of data) instance nil)))

(ffi/defcallback signal-arg-imp void [instance ptr, arg ptr, data ptr]
  (when-let [w (lib/object-for instance)]
    (native-signal w (kind-of data) instance arg)))

(ffi/defcallback close-request-imp bool [window ptr, data ptr]
  (when-let [w (lib/object-for window)]
    (native-close-request w))
  ;; true: GTK doesn't close the window itself; ui/close! did, unless a handler vetoed.
  true)

(ffi/defcallback idle-imp bool [data ptr]
  (drain-main-thread!)
  false)

(ffi/defcallback switch-page-imp void [notebook ptr, page ptr, number u32, data ptr]
  (when-let [w (lib/object-for notebook)]
    (native-signal w :switch-page notebook number)))

(ffi/defcallback page-signal-imp void [notebook ptr, page ptr, number u32, data ptr]
  (when-let [w (lib/object-for notebook)]
    (native-signal w (kind-of data) notebook [page number])))

(def ^:private tab-event!
  "Handle an event in a tabbed pane, before its GtkNotebook does (defined below).")

(ffi/defcallback legacy-imp bool [controller ptr, event ptr, data ptr]
  (boolean (when-let [pane (lib/object-for controller)] (tab-event! pane event))))

(def ^:private factory-owners
  "A list item factory's address -> [widget column-index]."
  (atom {}))

(ffi/defcallback setup-imp void [factory ptr, item ptr, data ptr]
  (when-let [[w column] (get @factory-owners (ffi/address factory))]
    (setup-cell w column item)))

(ffi/defcallback bind-imp void [factory ptr, item ptr, data ptr]
  (when-let [[w column] (get @factory-owners (ffi/address factory))]
    (bind-cell w column item)))

(ffi/defcallback selection-changed-imp void [model ptr, position u32, n u32, data ptr]
  (when-let [w (lib/object-for model)]
    (native-signal w :selected model nil)))

(ffi/defcallback activate-row-imp void [view ptr, position u32, data ptr]
  (when-let [w (lib/object-for view)]
    (native-signal w :activate view position)))

(def ^:private trees
  "A small id -> the tree widget, for the tree list model's children function."
  (atom {}))

(ffi/defcallback children-imp ptr [item ptr, data ptr]
  (if-let [t (get @trees (ffi/address data))]
    (children-model t item)
    (ffi/null)))

(ffi/defcallback items-changed-imp void [model ptr, position u32, removed u32, added u32,
                                         data ptr]
  (when-let [w (lib/object-for model)]
    (native-signal w :items-changed model nil)))

(ffi/defcallback draw-imp void [area ptr, cr ptr, width i32, height i32, data ptr]
  (when-let [w (lib/object-for area)]
    (native-draw w cr width height)))

(ffi/defcallback press-imp void [gesture ptr, n i32, x f64, y f64, data ptr]
  (when-let [w (lib/object-for gesture)]
    (native-input w (kind-of data) gesture {:n n :x x :y y})))

(ffi/defcallback motion-imp void [controller ptr, x f64, y f64, data ptr]
  (when-let [w (lib/object-for controller)]
    (native-input w (kind-of data) controller {:x x :y y})))

(ffi/defcallback leave-imp void [controller ptr, data ptr]
  (when-let [w (lib/object-for controller)]
    (native-input w :leave controller {})))

(ffi/defcallback scroll-imp bool [controller ptr, dx f64, dy f64, data ptr]
  (when-let [w (lib/object-for controller)]
    (native-input w :scroll controller {:dx dx :dy dy}))
  true)

(ffi/defcallback key-imp bool [controller ptr, keyval u32, keycode u32, state u32, data ptr]
  (boolean
   (when-let [w (lib/object-for controller)]
     (native-input w (kind-of data) controller {:keyval keyval :state state}))))

(def ^:private async-results
  "An async call's id -> its GAsyncResult, once it finished."
  (atom {}))

(ffi/defcallback async-imp void [source ptr, result ptr, data ptr]
  (lib/g-object-ref result)
  (swap! async-results assoc (ffi/address data) result))

(def ^:private timers
  "A timer's id -> the skein.ui timer."
  (atom {}))

(ffi/defcallback timer-imp bool [data ptr]
  (if-let [t (get @timers (ffi/address data))]
    (do (when-not (:repeat t) (swap! timers dissoc (ffi/address data)))
        (ui/timer-fired! t)
        (boolean (:repeat t)))
    false))

(def ^:private auto-answer!
  "Answer the dialog that is open, for tests (defined below).")

(ffi/defcallback answer-imp bool [data ptr]
  (auto-answer!)
  false)

(def ^:private pulsing
  "progress bar id -> the indeterminate progress bar it pulses."
  (atom {}))

(ffi/defcallback pulse-imp bool [data ptr]
  (if-let [w (get @pulsing (ffi/address data))]
    (do (lib/progress-pulse (:native w)) true)
    false))

;;; ------------------------------------------------------------------------------------
;;; The backend, and running on the main thread

(defclass gtk-backend [ui/backend]
  "The GTK 4 backend."
  (main-thread :init nil :doc "The GThread of the main thread, where GTK was initialized.")
  (actions :init nil :doc "The GSimpleActionGroup of the menu items' actions, \"skein\".")
  (css :init nil :doc "The GtkCssProvider of the widgets' fonts and colors.")
  (running :cell :atom :init false :doc "Whether ui/run!'s main loop runs."))

(defn available?
  "True if GTK 4 is installed and can open the display."
  []
  (and (lib/load!) (lib/gtk-init-check)))

(defn backend
  "A new GTK backend. Make it on the main thread (in -main, or a test)."
  []
  (when-not (lib/load!)
    (error "the GTK backend needs GTK 4, which isn't installed"))
  (when-not (lib/gtk-init-check)
    (error "GTK 4 can't open the display"))
  (let [css (lib/css-provider-new)]
    (lib/style-add-provider-for-display (lib/display-get-default) css 600)   ; APPLICATION
    (make gtk-backend :main-thread (lib/g-thread-self) :actions (lib/g-simple-action-group-new)
          :css css)))

(defn- main-thread? [b]
  (= (ffi/address (lib/g-thread-self)) (ffi/address (:main-thread b))))

(defmethod ui/backend-in-ui-thread [(b gtk-backend) f]
  (if (main-thread? b)
    (f)
    (let [t (spawn-pinned :main (f))]
      (lib/g-idle-add idle-imp (ffi/null))
      @t)))

(defmethod ui/backend-call-later [(b gtk-backend) f]
  (spawn-pinned :main (f))
  (lib/g-idle-add idle-imp (ffi/null))
  nil)

(defmethod ui/backend-run-loop [(b gtk-backend)]
  (set-slot! b :running true)
  (while (:running b)
    (lib/g-main-context-iteration (ffi/null) true)))

(defmethod ui/backend-quit-loop [(b gtk-backend)]
  (set-slot! b :running false)
  (lib/g-main-context-wakeup (ffi/null)))

(defn settle!
  "Run the main loop until it has nothing left to do: GTK lays out and draws what changed.
For tests, outside ui/run!."
  []
  (loop [n 0]
    (when (and (< n 1000) (lib/g-main-context-pending (ffi/null)))
      (lib/g-main-context-iteration (ffi/null) false)
      (recur (inc n)))))

;;; ------------------------------------------------------------------------------------
;;; Objects, properties and layout

(def ^:private quiet-depth
  "Above 0 while the backend changes a widget itself, so the signal it emits isn't taken
for the user's doing."
  (atom 0))

(defn- quiet? [] (pos? @quiet-depth))

(defn- quietly [f]
  (swap! quiet-depth inc)
  (try (f) (finally (swap! quiet-depth dec))))

(defn- owned
  "Take a reference of our own to the new GTK widget o (sinking a floating one). Returns o."
  [o]
  (lib/g-object-ref-sink o))

(def ^:private install-input!
  "Give a widget with input signals its event controllers (defined below).")

(defmethod ui/backend-realize [(b gtk-backend) o]
  (let [n (lib/register! (make-native o) o)]
    (install-input! o n)
    n))

(defmethod ui/backend-destroy [(b gtk-backend) o]
  (let [n (native o)]
    (cond (instance? ui/window-widget o) (lib/window-destroy n)
          ;; Out of its container as remove! takes it: a split pane or a notebook must let
          ;; go of it itself.
          (and (instance? ui/widget o) (:parent o)
               (not (ffi/null? (lib/widget-get-parent n))))
          (ui/backend-remove-child b (:parent o) o))
    (lib/unregister! n)
    (lib/g-object-unref n)))

(defmethod ui/backend-set-property [(b gtk-backend) o property value]
  (quietly (fn [] (set-native o property value))))

(defmethod ui/backend-get-property [(b gtk-backend) o property]
  (slot o property))

(defmethod ui/backend-add-child [(b gtk-backend) parent child]
  (lib/fixed-put (container-view parent) (native child) 0.0 0.0))

(defmethod ui/backend-remove-child [(b gtk-backend) parent child]
  (lib/fixed-remove (container-view parent) (native child)))

(defmethod native-natural-size [w]
  (let [n (native w)
        size (lib/natural-size n)]
    ;; Measuring cleared the size request; put back the one layout gave.
    (when-let [[_ _ width height] (:allocation w)]
      (lib/widget-set-size-request n width height))
    size))

(defmethod ui/backend-natural-size [(b gtk-backend) w]
  (native-natural-size w))

(defmethod ui/backend-set-bounds [(b gtk-backend) w x y width height]
  (let [n (native w)
        p (:parent w)]
    ;; Its GTK parent is the GtkFixed it was put in (a notebook page's own), except in a
    ;; split pane, which places its panes itself, and a tab bar's, whose widgets are in the
    ;; GtkNotebook's tabs and ends.
    (when (and p (not (instance? ui/paned-widget p)) (not (instance? ui/tab-bar-widget p))
               (not (instance? ui/tab-bar-widget w)))
      (lib/fixed-move (lib/widget-get-parent n) n (f64 x) (f64 y)))
    (lib/widget-set-size-request n width height)
    (layout-native w width height)))

(defmethod set-native [(w ui/widget) (p (= :visible)) v]
  (lib/widget-set-visible (native w) (boolean v)))

(defmethod set-native [(w ui/widget) (p (= :enabled)) v]
  (lib/widget-set-sensitive (native w) (boolean v)))

(defmethod set-native [(w ui/widget) (p (= :tooltip)) v]
  (lib/widget-set-tooltip-text (native w) v))

(defn- xalign [a] (case a :center 0.5 :right 1.0 0.0))

;;; ------------------------------------------------------------------------------------
;;; Windows

(def ^:private inner-fixed
  "The address of a window's, frame's or scrolled window's GTK widget -> the GtkFixed
inside it that holds its children."
  (atom {}))

(def ^:private window-boxes
  "A window's GtkWindow address -> the vertical GtkBox of its menu bar and content."
  (atom {}))

(def ^:private menu-bar-heights
  "A window's GtkWindow address -> the height of its menu bar, or 0."
  (atom {}))

(defmethod make-native [(w ui/window-widget)]
  (let [b (ui/current-backend)
        win (lib/g-object-ref (lib/window-new))
        box (lib/box-new 1 0)
        content (lib/fixed-new)
        keys (lib/key-controller-new)]
    (lib/widget-set-vexpand content true)
    (lib/box-append box content)
    (lib/window-set-child win box)
    (lib/widget-insert-action-group win "skein" (:actions b))
    (swap! inner-fixed assoc (ffi/address win) content)
    (swap! window-boxes assoc (ffi/address win) box)
    ;; Its own shortcuts (add-shortcut!), before the focused widget gets the key.
    (lib/controller-set-phase keys 1)   ; GTK_PHASE_CAPTURE
    (lib/register! keys w)
    (connect! keys "key-pressed" :window-key key-imp)
    (lib/widget-add-controller win keys)
    (connect! win "close-request" :close-request close-request-imp)
    (connect! win "notify::default-width" :resized signal-arg-imp)
    (connect! win "notify::default-height" :resized signal-arg-imp)
    win))

(defmethod container-view [(w ui/window-widget)]
  (get @inner-fixed (ffi/address (native w))))

(defmethod set-native [(w ui/window-widget) (p (= :title)) v]
  (lib/window-set-title (native w) (or v "")))

(defn- bar-height [w] (get @menu-bar-heights (ffi/address (native w)) 0))

(defn- set-default-size! [w]
  (when (and (:width w) (:height w))
    (lib/window-set-default-size (native w) (:width w) (+ (:height w) (bar-height w)))))

(defmethod set-native [(w ui/window-widget) (p (= :width)) v] (set-default-size! w))
(defmethod set-native [(w ui/window-widget) (p (= :height)) v] (set-default-size! w))

(defmethod native-signal [(w ui/window-widget) (k (= :resized)) win arg]
  (when-not (quiet?)
    (ffi/with-foreign [width (ffi/alloc i32 1)]
      (ffi/with-foreign [height (ffi/alloc i32 1)]
        (lib/window-get-default-size win width height)
        (let [size [(ffi/get width i32) (- (ffi/get height i32) (bar-height w))]]
          (when (and (every? pos? size) (not= size [(:width w) (:height w)]))
            (apply ui/resized-by-user! w size)))))))

(defmethod ui/backend-show [(b gtk-backend) w]
  (lib/window-present (native w)))

(defmethod ui/backend-close [(b gtk-backend) w]
  (lib/widget-set-visible (native w) false))

;;; ------------------------------------------------------------------------------------
;;; Containers: GtkFixed, where layout places the children

(defmethod make-native [(w ui/box-widget)] (owned (lib/fixed-new)))
(defmethod make-native [(w ui/grid-widget)] (owned (lib/fixed-new)))
(defmethod make-native [(w ui/spacer-widget)] (owned (lib/fixed-new)))

(defmethod make-native [(s ui/separator-widget)]
  (owned (lib/separator-new (if (= :vertical (:orientation s)) 1 0))))

;;; ------------------------------------------------------------------------------------
;;; Labels, buttons and entries

(defmethod make-native [(l ui/label-widget)] (owned (lib/label-new "")))

(defmethod set-native [(l ui/label-widget) (p (= :text)) v]
  (lib/label-set-text (native l) (str (or v ""))))

(defmethod set-native [(l ui/label-widget) (p (= :alignment)) v]
  (lib/label-set-xalign (native l) (f32 (xalign v))))

(defmethod set-native [(l ui/label-widget) (p (= :wrap)) v]
  (lib/label-set-wrap (native l) (boolean v)))

(defmethod set-native [(l ui/label-widget) (p (= :selectable)) v]
  (lib/label-set-selectable (native l) (boolean v)))

(defmethod make-native [(b ui/button-widget)]
  (connect! (owned (lib/button-new)) "clicked" :clicked signal-imp))

(defmethod set-native [(b ui/button-widget) (p (= :label)) v]
  (if (:image b)
    (show-button-content! b)
    (lib/button-set-label (native b) (str (or v "")))))

(defmethod set-native [(b ui/button-widget) (p (= :style)) v]
  (lib/button-set-has-frame (native b) (= v :push)))

(defmethod native-signal [(b ui/button-widget) (k (= :clicked)) instance arg]
  (ui/emit! b (ui/event-for b :clicked)))

(defn- make-entry [n]
  (connect! n "changed" :changed signal-imp)
  (connect! n "activate" :activate signal-imp)
  n)

(defmethod make-native [(e ui/entry-widget)] (make-entry (owned (lib/entry-new))))
(defmethod make-native [(e ui/password-entry-widget)]
  (make-entry (owned (lib/password-entry-new))))
(defmethod make-native [(e ui/search-entry-widget)] (make-entry (owned (lib/search-entry-new))))

(defmethod set-native [(e ui/entry-widget) (p (= :text)) v]
  (lib/editable-set-text (native e) (str (or v ""))))

(defmethod set-native [(e ui/entry-widget) (p (= :placeholder)) v]
  (if (instance? ui/password-entry-widget e)
    (lib/g-object-set-string (native e) "placeholder-text" (or v "") (ffi/null))
    (if (instance? ui/search-entry-widget e)
      (lib/g-object-set-string (native e) "placeholder-text" (or v "") (ffi/null))
      (lib/entry-set-placeholder (native e) v))))

(defmethod set-native [(e ui/entry-widget) (p (= :editable)) v]
  (lib/editable-set-editable (native e) (boolean v)))

(defmethod set-native [(e ui/entry-widget) (p (= :alignment)) v]
  (lib/editable-set-alignment (native e) (f32 (xalign v))))

(defmethod set-native [(e ui/entry-widget) (p (= :width-chars)) v]
  (lib/editable-set-width-chars (native e) (or v 20)))

(defmethod native-signal [(e ui/entry-widget) (k (= :changed)) instance arg]
  (when-not (quiet?)
    (let [t (lib/editable-get-text instance)]
      (when (not= t (:text e))
        (ui/changed-by-user! e :text t)))))

(defmethod native-signal [(e ui/entry-widget) (k (= :activate)) instance arg]
  (ui/emit! e (ui/event-for e :activate)))

;;; ------------------------------------------------------------------------------------
;;; Helpers

(defn- also-register!
  "Register the GTK object o, part of w, as standing for w too. Returns o."
  [o w]
  (lib/register! o w))

(defn- whole [x] (if (= x (math/floor x)) (int x) x))

(def ^:private textures
  "image (by identity) -> its GdkTexture, made once and kept: images don't change."
  (atom {}))

(defn texture
  "The GdkTexture of a skein.ui image, or null for nil."
  [image]
  (cond
    (nil? image) (ffi/null)
    (get @textures image) (get @textures image)
    :else
    (let [t (if (:path image)
              (lib/texture-new-from-filename (:path image) (ffi/null))
              (let [w (:width image) h (:height image)
                    bytes (ffi/pin [p (:pixels image)] (lib/g-bytes-new p (* 4 w h)))
                    t (lib/memory-texture-new w h 5 bytes (* 4 w))]  ; GDK_MEMORY_R8G8B8A8
                (lib/g-bytes-unref bytes)
                t))]
      (when (ffi/null? t) (error "GTK can't read the image" (pr-str (:path image))))
      (swap! textures assoc image t)
      t)))

(defmethod ui/backend-image-size [(b gtk-backend) path]
  (let [t (lib/texture-new-from-filename path (ffi/null))]
    (when (ffi/null? t) (error "GTK can't read the image" (pr-str path)))
    (let [size [(lib/texture-get-width t) (lib/texture-get-height t)]]
      (lib/g-object-unref t)
      size)))

;;; Images and button contents

(defmethod make-native [(v ui/image-view-widget)] (owned (lib/picture-new)))

(defmethod set-native [(v ui/image-view-widget) (p (= :image)) image]
  (lib/picture-set-paintable (native v) (texture image)))

(defmethod set-native [(v ui/image-view-widget) (p (= :scaling)) s]
  ;; GTK_CONTENT_FIT_FILL 0, SCALE_DOWN 3
  (lib/picture-set-content-fit (native v) (if (= s :fill) 0 3))
  (lib/picture-set-can-shrink (native v) (not= s :none)))

(defmethod native-natural-size [(v ui/image-view-widget)]
  (if-let [i (:image v)] [(:width i) (:height i)] [0 0]))

(defn- show-button-content!
  "Show the button's label, or its image and label in a box (only the image for the
:icon style)."
  [b]
  (let [n (native b)
        image (:image b)]
    (if (nil? image)
      (lib/button-set-label n (str (or (:label b) "")))
      (let [box (lib/box-new 0 4)
            icon (lib/image-new-from-paintable (texture image))]
        (lib/image-set-pixel-size icon (:height image))
        (lib/box-append box icon)
        (when (not= :icon (:style b))
          (lib/box-append box (lib/label-new (str (or (:label b) "")))))
        (lib/button-set-child n box)))))

(defmethod set-native [(b ui/button-widget) (p (= :image)) v] (show-button-content! b))

;;; ------------------------------------------------------------------------------------
;;; Toggles, check boxes and radio buttons

(defmethod make-native [(t ui/toggle-button-widget)]
  (connect! (owned (lib/toggle-button-new)) "toggled" :toggled signal-imp))

(defmethod make-native [(c ui/check-box-widget)]
  (connect! (owned (lib/check-button-new)) "toggled" :toggled signal-imp))

(defmethod make-native [(r ui/radio-button-widget)]
  (connect! (owned (lib/check-button-new)) "toggled" :toggled signal-imp))

(defn- check-like? [t] (instance? ui/check-box-widget t))
(defn- radio? [t] (instance? ui/radio-button-widget t))

(defmethod set-native [(t ui/toggle-button-widget) (p (= :label)) v]
  (if (or (check-like? t) (radio? t))
    (lib/check-set-label (native t) (str (or v "")))
    (show-button-content! t)))

(defmethod set-native [(t ui/toggle-button-widget) (p (= :image)) v]
  (when-not (or (check-like? t) (radio? t))
    (show-button-content! t)))

(defmethod set-native [(t ui/toggle-button-widget) (p (= :checked)) v]
  (if (or (check-like? t) (radio? t))
    (lib/check-set-active (native t) (boolean v))
    (lib/toggle-set-active (native t) (boolean v))))

(defmethod native-signal [(t ui/toggle-button-widget) (k (= :toggled)) instance arg]
  (when-not (quiet?)
    (let [on (if (or (check-like? t) (radio? t))
               (lib/check-get-active instance)
               (lib/toggle-get-active instance))]
      ;; GTK turns the rest of a radio group off itself; the core does it with events.
      (when (and (not= on (boolean (:checked t))) (or on (not (radio? t))))
        (ui/toggled-by-user! t on)))))

(defmethod ui/backend-add-child :after [(b gtk-backend) parent (r ui/radio-button-widget)]
  ;; GTK draws a check button as a radio button when it is in a group: join the first
  ;; other radio button of its group that has a GTK widget.
  (when-let [other (first (remove (fn [x] (identical? x r)) (ui/radio-group r)))]
    (quietly (fn [] (lib/check-set-group (native r) (native other))))))

;;; ------------------------------------------------------------------------------------
;;; Sliders, spin buttons, progress bars and spinners

(defmethod make-native [(s ui/slider-widget)]
  (let [n (owned (lib/scale-new (if (= :vertical (:orientation s)) 1 0) (ffi/null)))]
    (lib/scale-set-draw-value n false)
    (connect! n "value-changed" :value-changed signal-imp)))

(defn- show-range! [s]
  (let [n (native s)]
    (lib/range-set-range n (f64 (:min s)) (f64 (max (:max s) (+ (:min s) 1.0e-9))))
    (lib/range-set-value n (f64 (or (:value s) 0)))
    (lib/scale-clear-marks n)
    (let [ticks (or (:ticks s) 0)]
      (when (> ticks 1)
        (doseq [i (range ticks)]
          (lib/scale-add-mark n (f64 (+ (:min s) (* i (/ (- (:max s) (:min s)) (dec ticks)))))
                              3 (ffi/null)))))))

(defmethod set-native [(s ui/slider-widget) (p (= :min)) v] (show-range! s))
(defmethod set-native [(s ui/slider-widget) (p (= :max)) v] (show-range! s))
(defmethod set-native [(s ui/slider-widget) (p (= :value)) v] (show-range! s))
(defmethod set-native [(s ui/slider-widget) (p (= :ticks)) v] (show-range! s))
(defmethod set-native [(s ui/slider-widget) (p (= :orientation)) v]
  (lib/orientable-set (native s) (if (= v :vertical) 1 0)))

(defmethod native-natural-size [(s ui/slider-widget)]
  (let [[w h] (call-next-method)]
    (if (= :vertical (:orientation s)) [w (max h 120)] [(max w 120) h])))

(defmethod native-signal [(s ui/slider-widget) (k (= :value-changed)) instance arg]
  (when-not (quiet?)
    (let [v (whole (lib/range-get-value instance))]
      (when (not= v (:value s))
        (ui/changed-by-user! s :value v)))))

(defmethod make-native [(s ui/spin-button-widget)]
  (connect! (owned (lib/spin-new 0.0 100.0 1.0)) "value-changed" :value-changed signal-imp))

(defn- show-spin! [s]
  (let [n (native s)]
    (lib/spin-set-range n (f64 (:min s)) (f64 (:max s)))
    (lib/spin-set-increments n (f64 (:step s)) (f64 (* 10 (:step s))))
    (lib/spin-set-digits n (or (:digits s) 0))
    (lib/spin-set-value n (f64 (or (:value s) 0)))))

(defmethod set-native [(s ui/spin-button-widget) (p (= :min)) v] (show-spin! s))
(defmethod set-native [(s ui/spin-button-widget) (p (= :max)) v] (show-spin! s))
(defmethod set-native [(s ui/spin-button-widget) (p (= :step)) v] (show-spin! s))
(defmethod set-native [(s ui/spin-button-widget) (p (= :digits)) v] (show-spin! s))
(defmethod set-native [(s ui/spin-button-widget) (p (= :value)) v] (show-spin! s))

(defmethod native-signal [(s ui/spin-button-widget) (k (= :value-changed)) instance arg]
  (when-not (quiet?)
    (let [v (whole (lib/spin-get-value instance))]
      (when (not= v (:value s))
        (ui/changed-by-user! s :value v)))))

(defmethod make-native [(b ui/progress-bar-widget)] (owned (lib/progress-new)))

(defn- show-fraction! [b]
  (let [span (- (:max b) (:min b))]
    (lib/progress-set-fraction (native b)
                               (f64 (if (pos? span)
                                      (math/clamp (/ (- (or (:value b) 0) (:min b)) span) 0 1)
                                      0)))))

(defmethod set-native [(b ui/progress-bar-widget) (p (= :value)) v] (show-fraction! b))
(defmethod set-native [(b ui/progress-bar-widget) (p (= :min)) v] (show-fraction! b))
(defmethod set-native [(b ui/progress-bar-widget) (p (= :max)) v] (show-fraction! b))

(def ^:private pulse-ids (atom 0))

(defmethod set-native [(b ui/progress-bar-widget) (p (= :indeterminate)) v]
  (swap! pulsing (fn [m] (into {} (remove (fn [[_ w]] (identical? w b)) m))))
  (if v
    (let [id (swap! pulse-ids inc)]
      (swap! pulsing assoc id b)
      (lib/g-timeout-add 100 pulse-imp (lib/signal-data id)))
    (show-fraction! b)))

(defmethod native-natural-size [(b ui/progress-bar-widget)]
  (let [[w h] (call-next-method)] [(max w 120) h]))

(defmethod make-native [(s ui/spinner-widget)] (owned (lib/spinner-new)))

(defmethod set-native [(s ui/spinner-widget) (p (= :active)) v]
  (lib/spinner-set-spinning (native s) (boolean v)))

;;; ------------------------------------------------------------------------------------
;;; Drop-downs and combo entries

(defn- string-list [w]
  (let [l (lib/string-list-new (ffi/null))]
    (doseq [i (range (count (:items w)))]
      (lib/string-list-append l (ui/item-text w i)))
    l))

(defmethod make-native [(c ui/combo-box-widget)]
  (connect! (owned (lib/drop-down-new (ffi/null) (ffi/null))) "notify::selected" :selected
            signal-arg-imp))

(defn- show-selected! [c]
  (lib/drop-down-set-selected (native c) (or (:selected-index c) lib/invalid-position)))

(defmethod set-native [(c ui/combo-box-widget) (p (= :items)) v]
  (let [l (string-list c)]
    (lib/drop-down-set-model (native c) l)
    (lib/g-object-unref l)
    (show-selected! c)))

(defmethod set-native [(c ui/combo-box-widget) (p (= :item-label)) v]
  (set-native c :items (:items c)))

(defmethod set-native [(c ui/combo-box-widget) (p (= :selected-index)) v]
  (show-selected! c))

(defmethod native-signal [(c ui/combo-box-widget) (k (= :selected)) instance arg]
  (when-not (quiet?)
    (let [i (lib/drop-down-get-selected instance)
          i (when (not= i lib/invalid-position) i)]
      (when (not= i (:selected-index c))
        (ui/chosen-by-user! c i)))))

(defn- combo-entry-of [c] (lib/combo-get-child (native c)))

(defmethod make-native [(c ui/combo-entry-widget)]
  (let [n (owned (lib/combo-text-new-with-entry))
        e (lib/combo-get-child n)]
    (also-register! e c)
    (connect! e "changed" :changed signal-imp)
    (connect! e "activate" :activate signal-imp)
    n))

(defmethod set-native [(c ui/combo-entry-widget) (p (= :items)) v]
  (let [n (native c)]
    (lib/combo-text-remove-all n)
    (doseq [i (range (count v))]
      (lib/combo-text-append n (ui/item-text c i)))))

(defmethod set-native [(c ui/combo-entry-widget) (p (= :item-label)) v]
  (set-native c :items (:items c)))

(defmethod set-native [(c ui/combo-entry-widget) (p (= :text)) v]
  (lib/editable-set-text (combo-entry-of c) (str (or v ""))))

(defmethod native-signal [(c ui/combo-entry-widget) (k (= :changed)) instance arg]
  (when-not (quiet?)
    (let [t (lib/editable-get-text instance)]
      (when (not= t (:text c))
        (ui/changed-by-user! c :text t)))))

(defmethod native-signal [(c ui/combo-entry-widget) (k (= :activate)) instance arg]
  (ui/emit! c (ui/event-for c :activate)))

;;; ------------------------------------------------------------------------------------
;;; Color buttons and date pickers

(defmethod make-native [(c ui/color-button-widget)]
  (connect! (owned (lib/color-dialog-button-new (lib/color-dialog-new))) "notify::rgba"
            :selected signal-arg-imp))

(defn rgba-of
  "[r g b a] of a color designator; a system color as GTK's theme would have it, roughly
(GTK has no named system colors)."
  [d]
  (let [c (ui/ensure-color d)
        c (if (keyword? c) (ui/system-color c) c)]
    [(f64 (ui/color-red c)) (f64 (ui/color-green c)) (f64 (ui/color-blue c))
     (f64 (ui/color-alpha c))]))

(defmethod set-native [(c ui/color-button-widget) (p (= :color)) v]
  (let [[r g b a] (rgba-of v)]
    (ffi/with-foreign [rgba (ffi/alloc lib/gdk-rgba)]
      (ffi/put-field! rgba lib/gdk-rgba :red (f32 r))
      (ffi/put-field! rgba lib/gdk-rgba :green (f32 g))
      (ffi/put-field! rgba lib/gdk-rgba :blue (f32 b))
      (ffi/put-field! rgba lib/gdk-rgba :alpha (f32 a))
      (lib/color-dialog-button-set-rgba (native c) rgba))))

(defn native-color
  "The color a color button shows."
  [c]
  (let [rgba (lib/color-dialog-button-get-rgba (native c))]
    (ui/rgb (ffi/field rgba lib/gdk-rgba :red) (ffi/field rgba lib/gdk-rgba :green)
            (ffi/field rgba lib/gdk-rgba :blue) (ffi/field rgba lib/gdk-rgba :alpha))))

(defmethod native-signal [(c ui/color-button-widget) (k (= :selected)) instance arg]
  (when-not (quiet?)
    (ui/changed-by-user! c :color (native-color c))))

(def ^:private date-parts
  "A date picker's GtkBox address -> {:calendar :hour :minute}."
  (atom {}))

(defn- parts [d] (get @date-parts (ffi/address (native d))))

(defmethod make-native [(d ui/date-picker-widget)]
  (let [box (owned (lib/box-new 0 6))
        calendar (lib/calendar-new)
        hour (lib/spin-new 0.0 23.0 1.0)
        minute (lib/spin-new 0.0 59.0 1.0)]
    (doseq [x [calendar hour minute]]
      (lib/box-append box x)
      (also-register! x d))
    (connect! calendar "day-selected" :selected signal-imp)
    (connect! hour "value-changed" :value-changed signal-imp)
    (connect! minute "value-changed" :value-changed signal-imp)
    (swap! date-parts assoc (ffi/address box) {:calendar calendar :hour hour :minute minute})
    box))

(defmethod set-native [(d ui/date-picker-widget) (p (= :date)) ms]
  (let [{:keys [calendar hour minute]} (parts d)
        dt (lib/date-time-new-from-unix-local (quot (or ms 0) 1000))]
    (lib/calendar-select-day calendar dt)
    (lib/spin-set-value hour (f64 (lib/date-time-get-hour dt)))
    (lib/spin-set-value minute (f64 (lib/date-time-get-minute dt)))
    (lib/date-time-unref dt)))

(defmethod set-native [(d ui/date-picker-widget) (p (= :mode)) mode]
  (let [{:keys [calendar hour minute]} (parts d)]
    (lib/widget-set-visible calendar (not= mode :time))
    (lib/widget-set-visible hour (not= mode :date))
    (lib/widget-set-visible minute (not= mode :date))))

(defn- picked-millis [d]
  (let [{:keys [calendar hour minute]} (parts d)
        day (lib/calendar-get-date calendar)]
    (ffi/with-foreign [y (ffi/alloc i32 1)]
      (ffi/with-foreign [m (ffi/alloc i32 1)]
        (ffi/with-foreign [dd (ffi/alloc i32 1)]
          (lib/date-time-get-ymd day y m dd)
          (lib/date-time-unref day)
          (let [dt (lib/date-time-new-local (ffi/get y i32) (ffi/get m i32) (ffi/get dd i32)
                                            (int (lib/spin-get-value hour))
                                            (int (lib/spin-get-value minute)) 0.0)
                ms (* 1000 (lib/date-time-to-unix dt))]
            (lib/date-time-unref dt)
            ms))))))

(defmethod native-signal [(d ui/date-picker-widget) k instance arg]
  (when-not (quiet?)
    (let [ms (picked-millis d)]
      (when (not= ms (:date d))
        (ui/changed-by-user! d :date ms)))))

;;; ------------------------------------------------------------------------------------
;;; Frames

(defmethod make-native [(f ui/frame-widget)]
  (let [n (owned (lib/frame-new (ffi/null)))
        inner (lib/fixed-new)]
    (lib/frame-set-child n inner)
    (swap! inner-fixed assoc (ffi/address n) inner)
    n))

(defmethod container-view [(f ui/frame-widget)]
  (get @inner-fixed (ffi/address (native f))))

(defmethod set-native [(f ui/frame-widget) (p (= :title)) v]
  (lib/frame-set-label (native f) v))

(defn- decoration
  "What the GTK widget n adds around its inner one."
  [n inner]
  (let [[w h] (lib/natural-size n)
        [iw ih] (lib/natural-size inner)]
    [(max 0 (- w iw)) (max 0 (- h ih))]))

(defmethod ui/backend-decoration-size [(b gtk-backend) (f ui/frame-widget)]
  (decoration (native f) (container-view f)))

(defmethod ui/backend-content-area [(b gtk-backend) (f ui/frame-widget) width height]
  (let [[dw dh] (decoration (native f) (container-view f))]
    [0 0 (max 0 (- width dw)) (max 0 (- height dh))]))

(defmethod native-natural-size [(f ui/frame-widget)]
  (lib/natural-size (native f)))

;;; ------------------------------------------------------------------------------------
;;; Text views

(def ^:private text-views
  "A text view widget's GtkScrolledWindow address -> its GtkTextView."
  (atom {}))

(defn- text-view-of [v] (get @text-views (ffi/address (native v))))
(defn- buffer-of [v] (lib/text-view-get-buffer (text-view-of v)))

(defmethod make-native [(v ui/text-view-widget)]
  (let [scroll (owned (lib/scrolled-new))
        tv (lib/text-view-new)]
    (lib/scrolled-set-child scroll tv)
    (swap! text-views assoc (ffi/address scroll) tv)
    (let [buffer (lib/text-view-get-buffer tv)]
      (also-register! buffer v)
      (connect! buffer "changed" :changed signal-imp))
    scroll))

(defn- with-iters [f]
  (ffi/with-foreign [a (ffi/alloc u8 128)]
    (ffi/with-foreign [b (ffi/alloc u8 128)]
      (f a b))))

(defn- buffer-text [buffer]
  (with-iters
   (fn [start end]
     (lib/text-buffer-get-start-iter buffer start)
     (lib/text-buffer-get-end-iter buffer end)
     (let [p (lib/text-buffer-get-text buffer start end true)
           s (ffi/c-string p)]
       (lib/g-free p)
       s))))

(defmethod set-native [(v ui/text-view-widget) (p (= :text)) s]
  (lib/text-buffer-set-text (buffer-of v) (str (or s "")) -1))

(defmethod set-native [(v ui/text-view-widget) (p (= :editable)) e]
  (lib/text-view-set-editable (text-view-of v) (boolean e)))

(defmethod set-native [(v ui/text-view-widget) (p (= :wrap)) w]
  (lib/text-view-set-wrap-mode (text-view-of v) (if w 3 0)))   ; GTK_WRAP_WORD_CHAR 3

(defmethod set-native [(v ui/text-view-widget) (p (= :border)) b]
  (lib/scrolled-set-has-frame (native v) (boolean b)))

(defmethod native-natural-size [(v ui/text-view-widget)]
  [240 120])

(defmethod native-signal [(v ui/text-view-widget) (k (= :changed)) buffer arg]
  (when-not (quiet?)
    (let [t (buffer-text buffer)]
      (when (not= t (:text v))
        (ui/changed-by-user! v :text t)))))

(defmethod ui/backend-text-append [(b gtk-backend) v s]
  (quietly
   (fn []
     (with-iters (fn [end _]
                   (lib/text-buffer-get-end-iter (buffer-of v) end)
                   (lib/text-buffer-insert (buffer-of v) end s -1))))))

(defmethod ui/backend-text-selection [(b gtk-backend) v]
  (with-iters (fn [start end]
                (lib/text-buffer-get-selection-bounds (buffer-of v) start end)
                [(lib/text-iter-get-offset start) (lib/text-iter-get-offset end)])))

(defmethod ui/backend-set-text-selection [(b gtk-backend) v start end]
  (with-iters (fn [ins bound]
                (lib/text-buffer-get-iter-at-offset (buffer-of v) ins start)
                (lib/text-buffer-get-iter-at-offset (buffer-of v) bound end)
                (lib/text-buffer-select-range (buffer-of v) ins bound))))

(defmethod ui/backend-text-insert [(b gtk-backend) v s]
  (let [[start end] (ui/backend-text-selection b v)
        buffer (buffer-of v)]
    (quietly
     (fn []
       (with-iters (fn [a z]
                     (lib/text-buffer-get-iter-at-offset buffer a start)
                     (lib/text-buffer-get-iter-at-offset buffer z end)
                     (lib/text-buffer-delete buffer a z)
                     (lib/text-buffer-get-iter-at-offset buffer a start)
                     (lib/text-buffer-insert buffer a s -1)))))))

;;; ------------------------------------------------------------------------------------
;;; Notebooks: each page is a GtkFixed holding the page widget

(defmethod make-native [(n ui/notebook-widget)]
  (let [nb (owned (lib/notebook-new))]
    (lib/g-signal-connect-data nb "switch-page" switch-page-imp (ffi/null) (ffi/null) 0)
    nb))

(defn- page-wrapper [page] (lib/widget-get-parent (native page)))

(defmethod ui/backend-add-child [(b gtk-backend) (n ui/notebook-widget) page]
  (let [wrapper (lib/fixed-new)]
    (lib/fixed-put wrapper (native page) 0.0 0.0)
    (quietly (fn [] (lib/notebook-append-page
                     (native n) wrapper
                     (lib/label-new (let [l (:tab-label page)] (if (string? l) l ""))))))))

(defmethod ui/backend-remove-child [(b gtk-backend) (n ui/notebook-widget) page]
  (let [wrapper (page-wrapper page)
        i (lib/notebook-page-num (native n) wrapper)]
    (lib/fixed-remove wrapper (native page))
    (when (>= i 0) (quietly (fn [] (lib/notebook-remove-page (native n) i))))))

(defmethod ui/backend-set-page-label [(b gtk-backend) n page label]
  (lib/notebook-set-tab-label-text (native n) (page-wrapper page) (or label "")))

(defmethod set-native [(n ui/notebook-widget) (p (= :selected-index)) i]
  (lib/notebook-set-current-page (native n) (or i 0)))

(defmethod set-native [(n ui/notebook-widget) (p (= :tab-position)) v]
  ;; GTK_POS_LEFT 0, RIGHT 1, TOP 2, BOTTOM 3
  (lib/notebook-set-tab-pos (native n) (case v :left 0 :right 1 :bottom 3 2)))

(defn- notebook-decoration [n]
  (let [[w h] (lib/natural-size (native n))
        pages (map (fn [p] (lib/natural-size (page-wrapper p))) (:children n))]
    [(max 0 (- w (reduce max 0 (map first pages))))
     (max 0 (- h (reduce max 0 (map second pages))))]))

(defmethod ui/backend-decoration-size [(b gtk-backend) (n ui/notebook-widget)]
  (notebook-decoration n))

(defmethod ui/backend-content-area [(b gtk-backend) (n ui/notebook-widget) width height]
  (let [[dw dh] (notebook-decoration n)]
    [0 0 (max 0 (- width dw)) (max 0 (- height dh))]))

(defmethod native-signal [(n ui/notebook-widget) (k (= :switch-page)) instance number]
  (when-not (quiet?)
    (when (not= number (:selected-index n))
      (ui/page-changed-by-user! n number))))

;;; ------------------------------------------------------------------------------------
;;; Split panes: GtkPaned holds two panes and places them itself

(defmethod make-native [(p ui/paned-widget)]
  (let [n (owned (lib/paned-new (if (= :vertical (:orientation p)) 1 0)))]
    (lib/paned-set-shrink-start n false)
    (lib/paned-set-shrink-end n false)
    (connect! n "notify::position" :position signal-arg-imp)))

(defmethod set-native [(p ui/paned-widget) (k (= :orientation)) v]
  (lib/orientable-set (native p) (if (= v :vertical) 1 0)))

(defmethod ui/backend-add-child [(b gtk-backend) (p ui/paned-widget) child]
  (let [n (native p)]
    (cond (ffi/null? (lib/paned-get-start-child n)) (lib/paned-set-start-child n (native child))
          (ffi/null? (lib/paned-get-end-child n)) (lib/paned-set-end-child n (native child))
          :else (error "a GTK split pane holds two panes"))))

(defmethod ui/backend-remove-child [(b gtk-backend) (p ui/paned-widget) child]
  (let [n (native p)]
    (if (= (ffi/address (lib/paned-get-start-child n)) (ffi/address (native child)))
      (lib/paned-set-start-child n (ffi/null))
      (lib/paned-set-end-child n (ffi/null)))))

(def ^:private divider-thickness
  "How thick GtkPaned's divider is, measured once on a split pane of two empty panes."
  (atom nil))

(defmethod ui/backend-decoration-size [(b gtk-backend) (p ui/paned-widget)]
  ;; Left out, the panes ask for the divider's pixels more than the window has, and GTK
  ;; widens the window by that on every layout.
  (let [t (or @divider-thickness
              (let [probe (owned (lib/paned-new 0))]
                (lib/paned-set-start-child probe (lib/fixed-new))
                (lib/paned-set-end-child probe (lib/fixed-new))
                (let [[w _] (lib/natural-size probe)]
                  (lib/g-object-unref probe)
                  (reset! divider-thickness w))))]
    [t t]))

(defmethod layout-native [(p ui/paned-widget) width height]
  (let [lengths (ui/pane-lengths p (if (= :horizontal (:orientation p)) width height))]
    (when (seq lengths)
      (quietly (fn [] (lib/paned-set-position (native p) (first lengths)))))))

(defmethod native-signal [(p ui/paned-widget) (k (= :position)) instance arg]
  (when-not (quiet?)
    (let [position (lib/paned-get-position instance)]
      (when (not= position (:position p))
        (ui/divider-moved-by-user! p position)))))

;;; ------------------------------------------------------------------------------------
;;; Scrolled windows: a GtkFixed inside, as big as the content

(defmethod make-native [(s ui/scrolled-window-widget)]
  (let [n (owned (lib/scrolled-new))
        inner (lib/fixed-new)]
    (lib/scrolled-set-child n inner)
    (swap! inner-fixed assoc (ffi/address n) inner)
    (doseq [a [(lib/scrolled-get-hadjustment n) (lib/scrolled-get-vadjustment n)]]
      (also-register! a s)
      (connect! a "value-changed" :value-changed signal-imp))
    n))

(defmethod container-view [(s ui/scrolled-window-widget)]
  (get @inner-fixed (ffi/address (native s))))

(defn- show-policy! [s]
  ;; GTK_POLICY_ALWAYS 0, AUTOMATIC 1, NEVER 2
  (let [policy (fn [p] (case p :always 0 :never 2 1))]
    (lib/scrolled-set-policy (native s) (policy (:horizontal-policy s))
                             (policy (:vertical-policy s)))))

(defmethod set-native [(s ui/scrolled-window-widget) (p (= :horizontal-policy)) v]
  (show-policy! s))

(defmethod set-native [(s ui/scrolled-window-widget) (p (= :vertical-policy)) v]
  (show-policy! s))

(defmethod set-native [(s ui/scrolled-window-widget) (p (= :border)) v]
  (lib/scrolled-set-has-frame (native s) (boolean v)))

(defmethod ui/backend-set-scroll-extent [(b gtk-backend) s width height]
  (lib/widget-set-size-request (container-view s) width height)
  nil)

(defmethod ui/backend-scroll-to [(b gtk-backend) s x y]
  (quietly
   (fn []
     (lib/adjustment-set-value (lib/scrolled-get-hadjustment (native s)) (f64 x))
     (lib/adjustment-set-value (lib/scrolled-get-vadjustment (native s)) (f64 y)))))

(defmethod native-signal [(s ui/scrolled-window-widget) (k (= :value-changed)) instance arg]
  (when-not (quiet?)
    (ui/scrolled-by-user! s
                          (int (math/round (lib/adjustment-get-value
                                            (lib/scrolled-get-hadjustment (native s)))))
                          (int (math/round (lib/adjustment-get-value
                                            (lib/scrolled-get-vadjustment (native s))))))))

;;; ------------------------------------------------------------------------------------
;;; List boxes, tables and trees: GtkListView or GtkColumnView in a GtkScrolledWindow.
;;; A list's or table's model has one string per row (the rows are the core's); a tree's
;;; is a GtkTreeListModel of GtkStringObjects of item ids. Cells are filled by signal
;;; list item factories, one for each column.

(def ^:private list-parts
  "The widget's GtkScrolledWindow address -> {:view :selection :model :columns :tree-id}."
  (atom {}))

(defn- parts-of [w] (get @list-parts (ffi/address (native w))))
(defn- view-of [w] (:view (parts-of w)))
(defn- selection-of [w] (:selection (parts-of w)))

(def ^:private bound-cells
  "For tests: [widget address, row, column] -> the text last bound in the cell."
  (atom {}))

(defn- new-factory
  "A signal list item factory for the widget's column."
  [w column]
  (let [f (lib/signal-factory-new)]
    (swap! factory-owners assoc (ffi/address f) [w column])
    (lib/g-signal-connect-data f "setup" setup-imp (ffi/null) (ffi/null) 0)
    (lib/g-signal-connect-data f "bind" bind-imp (ffi/null) (ffi/null) 0)
    f))

(defn- tree? [w] (instance? ui/tree-view-widget w))
(defn- columns-of [w] (vec (:columns w)))

(defn- selection-model
  "A selection model over model (taking it), single or multiple as w's :selection-mode."
  [w model]
  (let [sel (if (= :multiple (:selection-mode w))
              (lib/multi-selection-new model)
              (let [s (lib/single-selection-new model)]
                (lib/single-selection-set-autoselect s false)
                (lib/single-selection-set-can-unselect s true)
                s))]
    (lib/register! sel w)
    (lib/g-signal-connect-data sel "selection-changed" selection-changed-imp (ffi/null)
                               (ffi/null) 0)
    sel))

(def ^:private tree-ids (atom 0))

(def ^:private item-ids
  "[tree view address, item key] -> id, and id -> the item."
  (atom {:next 1 :ids {} :items {}}))

(defn- item-id [t item]
  (let [k [(ffi/address (native t)) ((:item-key t) item)]
        id (or (get-in @item-ids [:ids k])
               (let [{n :next} (swap! item-ids (fn [m] (-> m (update :next inc)
                                                           (assoc-in [:ids k] (:next m)))))]
                 (dec n)))]
    (swap! item-ids assoc-in [:items id] item)
    (str id)))

(defn- item-of-object
  "The tree item of a GtkStringObject of its id."
  [o]
  (get-in @item-ids [:items (parse-long (lib/string-object-get-string o))]))

(defn- items-model [t items]
  (lib/string-list-of (map (fn [i] (item-id t i)) items)))

(defn- row-model
  "A new model for w's rows: row numbers for a list or table, the tree's for a tree."
  [w]
  (if (tree? w)
    (lib/tree-list-model-new (items-model w (ui/tree-children w nil)) false false children-imp
                             (lib/signal-data (:tree-id (parts-of w))) (ffi/null))
    (lib/string-list-of (map str (range (count (:items w)))))))

(defmethod children-model [(t ui/tree-view-widget) o]
  (let [children (ui/tree-children t (item-of-object o))]
    (if (seq children) (items-model t children) (ffi/null))))

(defn- set-view-model! [w sel]
  (if (:columns? (parts-of w))
    (lib/column-view-set-model (view-of w) sel)
    (lib/list-view-set-model (view-of w) sel)))

(defn- tree-row [w position]
  (lib/tree-list-model-get-row (:model (parts-of w)) position))

(defn- n-rows [w]
  (lib/list-model-n-items (selection-of w)))

(defn- show-expansion!
  "Open the tree's rows the core says are open, from the top down."
  [t]
  (quietly
   (fn []
     (loop [i 0]
       (when (< i (n-rows t))
         (let [row (tree-row t i)
               o (lib/tree-row-get-item row)
               item (item-of-object o)]
           (lib/tree-row-set-expanded row (boolean (ui/expanded? t item)))
           (lib/g-object-unref o)
           (lib/g-object-unref row))
         (recur (inc i)))))))

(defn- row-items
  "The tree's items at the rows."
  [t rows]
  (mapv (fn [r] (let [row (tree-row t r)
                      o (lib/tree-row-get-item row)
                      item (item-of-object o)]
                  (lib/g-object-unref o)
                  (lib/g-object-unref row)
                  item))
        rows))

(defn- selected-rows [w]
  (let [set (lib/selection-get (selection-of w))
        rows (mapv (fn [i] (lib/bitset-get-nth set i)) (range (lib/bitset-get-size set)))]
    (lib/bitset-unref set)
    rows))

(defn- select-rows! [w rows]
  (quietly
   (fn []
     (lib/selection-unselect-all (selection-of w))
     (doseq [r rows] (lib/selection-select-item (selection-of w) r false)))))

(defn- reload! [w]
  (let [model (row-model w)
        sel (selection-model w model)]
    (when (tree? w)
      (lib/register! model w)
      (lib/g-signal-connect-data model "items-changed" items-changed-imp (ffi/null) (ffi/null) 0))
    (swap! list-parts update (ffi/address (native w)) assoc :model model :selection sel)
    (quietly (fn [] (set-view-model! w sel)))
    (if (tree? w)
      (do (show-expansion! w)
          (select-rows! w (keep (fn [r] (when (contains? (set (:selection w))
                                                         (first (row-items w [r])))
                                          r))
                                (range (n-rows w)))))
      (select-rows! w (:selected-indices w)))))

(defn- add-columns! [w]
  (let [view (view-of w)
        cols (columns-of w)]
    (doseq [[i c] (map-indexed vector cols)]
      (let [col (lib/column-new (:title c) (new-factory w i))]
        (when (:width c) (lib/column-set-fixed-width col (:width c)))
        (lib/column-set-expand col (nil? (:width c)))
        (when (:sort c)
          (lib/column-set-sorter col (lib/custom-sorter-new (ffi/null) (ffi/null) (ffi/null))))
        (lib/column-view-append-column view col)
        (lib/g-object-unref col)))))

(defn- remove-columns! [w]
  (let [view (view-of w)
        cols (lib/column-view-get-columns view)
        items (mapv (fn [i] (lib/list-model-get-item cols i))
                    (range (lib/list-model-n-items cols)))]
    (doseq [c items]
      (lib/column-view-remove-column view c)
      (lib/g-object-unref c))))

(defn- make-list-native [w]
  (let [scroll (owned (lib/scrolled-new))
        columns? (and (not (instance? ui/list-box-widget w)) (seq (columns-of w)))
        columns? (or (instance? ui/table-view-widget w) columns?)
        tree-id (when (tree? w) (swap! tree-ids inc))
        _ (when tree-id (swap! trees assoc tree-id w))
        view (if columns?
               (lib/column-view-new (ffi/null))
               (lib/list-view-new (ffi/null) (new-factory w 0)))]
    (lib/scrolled-set-child scroll view)
    (lib/register! view w)
    (lib/g-signal-connect-data view "activate" activate-row-imp (ffi/null) (ffi/null) 0)
    (swap! list-parts assoc (ffi/address scroll) {:view view :columns? columns? :tree-id tree-id})
    (when columns?
      (let [sorter (lib/column-view-get-sorter view)]
        (lib/register! sorter w)
        (connect! sorter "changed" :sort signal-arg-imp)))
    scroll))

(defmethod make-native [(l ui/list-box-widget)] (make-list-native l))
(defmethod make-native [(t ui/tree-view-widget)] (make-list-native t))

(defmethod setup-cell [w column list-item]
  (let [label (lib/label-new "")
        c (get (columns-of w) column)]
    (lib/label-set-xalign label (f32 (xalign (:alignment c))))
    (if (and (tree? w) (= column 0))
      (let [expander (lib/tree-expander-new)]
        (lib/tree-expander-set-child expander label)
        (lib/list-item-set-child list-item expander))
      (lib/list-item-set-child list-item label))))

(defn- cell-text [w column list-item]
  (if (tree? w)
    (let [row (lib/list-item-get-item list-item)
          item (item-of-object (lib/tree-row-get-item row))]
      (ui/tree-cell-text w item column))
    (let [pos (lib/list-item-get-position list-item)]
      (if (instance? ui/table-view-widget w)
        (ui/table-cell-text w pos column)
        (ui/item-text w pos)))))

(defmethod bind-cell [w column list-item]
  (let [text (cell-text w column list-item)
        child (lib/list-item-get-child list-item)
        label (if (and (tree? w) (= column 0))
                (do (lib/tree-expander-set-list-row child (lib/list-item-get-item list-item))
                    (lib/tree-expander-get-child child))
                child)]
    (lib/label-set-text label text)
    (swap! bound-cells assoc
           [(ffi/address (native w)) (lib/list-item-get-position list-item) column]
           text)))

(defmethod set-native [(l ui/list-box-widget) (p (= :items)) v] (reload! l))
(defmethod set-native [(l ui/list-box-widget) (p (= :item-label)) v] (reload! l))
(defmethod set-native [(l ui/list-box-widget) (p (= :selection-mode)) v] (reload! l))
(defmethod set-native [(l ui/list-box-widget) (p (= :selected-indices)) v] (select-rows! l v))
(defmethod set-native [(l ui/list-box-widget) (p (= :border)) v]
  (lib/scrolled-set-has-frame (native l) (boolean v)))

(defmethod native-natural-size [(l ui/list-box-widget)] [160 120])

(defmethod native-signal [(l ui/list-box-widget) (k (= :selected)) model arg]
  (when-not (quiet?)
    (let [rows (selected-rows l)]
      (when (not= rows (vec (:selected-indices l)))
        (ui/selection-changed-by-user! l rows)))))

(defmethod native-signal [(l ui/list-box-widget) (k (= :activate)) view row]
  (ui/row-activated-by-user! l row 2))

;;; Tables

(defmethod set-native [(t ui/table-view-widget) (p (= :columns)) v]
  (when (:view (parts-of t))
    (remove-columns! t)
    (add-columns! t)
    (reload! t)))

(defmethod set-native [(t ui/table-view-widget) (p (= :alternating)) v]
  (lib/column-view-set-row-separators (view-of t) (not v)))

(defn- show-sort! [t]
  (let [view (view-of t)
        i (when-let [c (:sort-column t)] (index-of (:columns t) c))]
    (when i
      (let [cols (lib/column-view-get-columns view)
            col (lib/list-model-get-item cols i)]
        (quietly (fn [] (lib/column-view-sort-by-column view col (if (:sort-descending t) 1 0))))
        (lib/g-object-unref col)))))

(defmethod set-native [(t ui/table-view-widget) (p (= :sort-column)) v] (show-sort! t))
(defmethod set-native [(t ui/table-view-widget) (p (= :sort-descending)) v] (show-sort! t))

(defmethod native-natural-size [(t ui/table-view-widget)]
  [(max 160 (reduce + 0 (map (fn [c] (or (:width c) 100)) (:columns t)))) 120])

(defmethod native-signal [(t ui/table-view-widget) (k (= :sort)) sorter arg]
  (when-not (quiet?)
    (let [col (lib/column-sorter-primary sorter)
          cols (lib/column-view-get-columns (view-of t))]
      (when-not (ffi/null? col)
        (let [i (first (filter (fn [i] (let [c (lib/list-model-get-item cols i)
                                             same (= (ffi/address c) (ffi/address col))]
                                         (lib/g-object-unref c)
                                         same))
                               (range (lib/list-model-n-items cols))))]
          (when i (ui/column-clicked-by-user! t i)))))))

;;; Trees

(defmethod set-native [(t ui/tree-view-widget) (p (= :roots)) v] (reload! t))
(defmethod set-native [(t ui/tree-view-widget) (p (= :item-label)) v] (reload! t))
(defmethod set-native [(t ui/tree-view-widget) (p (= :selection-mode)) v] (reload! t))
(defmethod set-native [(t ui/tree-view-widget) (p (= :expanded)) v] (show-expansion! t))

(defmethod set-native [(t ui/tree-view-widget) (p (= :selection)) v]
  (let [wanted (set v)]
    (select-rows! t (filter (fn [r] (contains? wanted (first (row-items t [r]))))
                            (range (n-rows t))))))

(defmethod set-native [(t ui/tree-view-widget) (p (= :columns)) v]
  (when (and (:columns? (parts-of t)) (seq v))
    (remove-columns! t)
    (add-columns! t)
    (reload! t)))

(defmethod ui/backend-tree-refresh [(b gtk-backend) t item]
  (reload! t))

(defmethod native-natural-size [(t ui/tree-view-widget)] [160 120])

(defmethod native-signal [(t ui/tree-view-widget) (k (= :items-changed)) model arg]
  ;; The user opened or closed a row: find the rows whose state isn't the core's.
  (when-not (quiet?)
    (doseq [r (range (n-rows t))]
      (let [row (tree-row t r)
            o (lib/tree-row-get-item row)
            item (item-of-object o)
            open (lib/tree-row-get-expanded row)]
        (lib/g-object-unref o)
        (lib/g-object-unref row)
        (when (not= open (ui/expanded? t item))
          (ui/expansion-changed-by-user! t item open))))))

(defmethod native-signal [(t ui/tree-view-widget) (k (= :selected)) model arg]
  (when-not (quiet?)
    (let [items (row-items t (selected-rows t))]
      (when (not= items (vec (:selection t)))
        (ui/tree-selection-changed-by-user! t items)))))

(defmethod native-signal [(t ui/tree-view-widget) (k (= :activate)) view row]
  (ui/tree-item-activated-by-user! t (first (row-items t [row]))))

;;; ------------------------------------------------------------------------------------
;;; Canvases: a GtkDrawingArea drawn with Cairo (text with Pango), with event controllers

(def ^:private click-gestures
  "A canvas's drawing area address -> its click gesture."
  (atom {}))

(def ^:private pressed-buttons
  "canvas widget (by identity) -> the mouse button held down, for :mouse-drag."
  (atom {}))

(defn- add-controller! [w n controller signals]
  (lib/register! controller w)
  (doseq [[signal kind handler] signals]
    (connect! controller signal kind handler))
  (lib/widget-add-controller n controller))

(defmethod make-native [(c ui/canvas-widget)]
  (let [n (owned (lib/drawing-area-new))
        click (lib/gesture-click-new)]
    (lib/drawing-area-set-draw-func n draw-imp (ffi/null) (ffi/null))
    (lib/gesture-single-set-button click 0)   ; every button
    (swap! click-gestures assoc (ffi/address n) click)
    (add-controller! c n click [["pressed" :pressed press-imp] ["released" :released press-imp]])
    (add-controller! c n (lib/motion-controller-new)
                     [["motion" :motion motion-imp] ["enter" :enter motion-imp]
                      ["leave" :leave leave-imp]])
    (add-controller! c n (lib/scroll-controller-new 3) [["scroll" :scroll scroll-imp]])
    (add-controller! c n (lib/key-controller-new)
                     [["key-pressed" :key-pressed key-imp] ["key-released" :key-released key-imp]])
    n))

(defmethod set-native [(c ui/canvas-widget) (p (= :focusable)) v]
  (lib/widget-set-focusable (native c) (boolean v)))

(defmethod native-natural-size [(c ui/canvas-widget)] [100 100])

(defmethod ui/backend-redraw [(b gtk-backend) c rect]
  (lib/widget-queue-draw (native c)))

(defn- pango-font
  "A Pango font description string for a font map (nil for the default)."
  [font]
  (let [f (or font (ui/font))]
    (string/join " " (remove nil? [(case (:family f) :system "Sans" :monospace "Monospace"
                                         (:family f))
                                   (when (:italic f) "Italic")
                                   (case (:weight f) :light "Light" :medium "Medium"
                                         :semibold "Semi-Bold" :bold "Bold" nil)
                                   (str (or (:size f) 10))]))))

(defn- text-layout
  "A Pango layout of s in font on the Cairo context cr; free it with g-object-unref."
  [cr s font]
  (let [layout (lib/pango-cairo-create-layout cr)
        desc (lib/pango-font-from-string (pango-font font))]
    (lib/pango-layout-set-text layout s -1)
    (lib/pango-layout-set-font layout desc)
    (lib/pango-font-free desc)
    layout))

(defn- layout-size [layout]
  (ffi/with-foreign [w (ffi/alloc i32 1)]
    (ffi/with-foreign [h (ffi/alloc i32 1)]
      (lib/pango-layout-get-pixel-size layout w h)
      [(ffi/get w i32) (ffi/get h i32)])))

(defn- measure-text [s font]
  (let [surface (lib/cairo-image-surface-create 0 1 1)
        cr (lib/cairo-create surface)
        layout (text-layout cr s font)
        size (layout-size layout)]
    (lib/g-object-unref layout)
    (lib/cairo-destroy cr)
    (lib/cairo-surface-destroy surface)
    size))

(defmethod ui/backend-text-size [(b gtk-backend) s font]
  (measure-text s font))

(defclass gtk-context [ui/graphics-context]
  "A graphics context drawing with Cairo. Cairo has one source color, so the fill and
stroke colors are set as each shape is drawn."
  (cr :init nil :doc "The cairo_t."))

(defn- source! [gc color]
  (let [[r g b a] (rgba-of color)]
    (lib/cairo-set-source-rgba (:cr gc) r g b a)))

(defmethod ui/gc-set-fill-color [(gc gtk-context) c] nil)
(defmethod ui/gc-set-stroke-color [(gc gtk-context) c] nil)
(defmethod ui/gc-set-line-width [(gc gtk-context) w] (lib/cairo-set-line-width (:cr gc) w))

(defmethod ui/gc-set-line-style [(gc gtk-context) cap join dash]
  (lib/cairo-set-line-cap (:cr gc) (case cap :round 1 :square 2 0))
  (lib/cairo-set-line-join (:cr gc) (case join :round 1 :bevel 2 0))
  (if (seq dash)
    (ffi/with-foreign [lengths (ffi/alloc f64 (count dash))]
      (doseq [[i x] (map-indexed vector dash)] (ffi/put! lengths f64 (f64 x) i))
      (lib/cairo-set-dash (:cr gc) lengths (count dash) 0.0))
    (lib/cairo-set-dash (:cr gc) (ffi/null) 0 0.0)))

(defmethod ui/gc-save [(gc gtk-context)] (lib/cairo-save (:cr gc)))
(defmethod ui/gc-restore [(gc gtk-context)] (lib/cairo-restore (:cr gc)))
(defmethod ui/gc-translate [(gc gtk-context) dx dy] (lib/cairo-translate (:cr gc) dx dy))
(defmethod ui/gc-scale [(gc gtk-context) sx sy] (lib/cairo-scale (:cr gc) sx sy))
(defmethod ui/gc-rotate [(gc gtk-context) r] (lib/cairo-rotate (:cr gc) r))

(defmethod ui/gc-clip-rectangle [(gc gtk-context) x y w h]
  (lib/cairo-rectangle (:cr gc) x y w h)
  (lib/cairo-clip (:cr gc)))

(defn- finish-shape! [gc mode]
  (let [cr (:cr gc)]
    (case mode
      :fill (do (source! gc (:fill-color gc)) (lib/cairo-fill cr))
      :stroke (do (source! gc (:stroke-color gc)) (lib/cairo-stroke cr))
      :fill-and-stroke (do (source! gc (:fill-color gc)) (lib/cairo-fill-preserve cr)
                           (source! gc (:stroke-color gc)) (lib/cairo-stroke cr)))))

(defmethod ui/gc-rectangle [(gc gtk-context) x y w h mode]
  (lib/cairo-new-path (:cr gc))
  (lib/cairo-rectangle (:cr gc) x y w h)
  (finish-shape! gc mode))

(defmethod ui/gc-ellipse [(gc gtk-context) x y w h mode]
  (let [cr (:cr gc)]
    (lib/cairo-new-path cr)
    (lib/cairo-save cr)
    (lib/cairo-translate cr (+ x (/ w 2)) (+ y (/ h 2)))
    (lib/cairo-scale cr (max (/ w 2) 1.0e-9) (max (/ h 2) 1.0e-9))
    (lib/cairo-arc cr 0.0 0.0 1.0 0.0 (* 2 math/pi))
    ;; Restore before stroking, so the line isn't scaled with the ellipse.
    (lib/cairo-restore cr)
    (finish-shape! gc mode)))

(defmethod ui/gc-begin-path [(gc gtk-context)] (lib/cairo-new-path (:cr gc)))
(defmethod ui/gc-move-to [(gc gtk-context) x y] (lib/cairo-move-to (:cr gc) x y))
(defmethod ui/gc-line-to [(gc gtk-context) x y] (lib/cairo-line-to (:cr gc) x y))
(defmethod ui/gc-curve-to [(gc gtk-context) x1 y1 x2 y2 x y]
  (lib/cairo-curve-to (:cr gc) x1 y1 x2 y2 x y))
(defmethod ui/gc-arc [(gc gtk-context) cx cy r start end]
  ;; Cairo's angles turn clockwise on the screen, as skein.ui's do.
  (lib/cairo-arc (:cr gc) cx cy r start end))
(defmethod ui/gc-close-path [(gc gtk-context)] (lib/cairo-close-path (:cr gc)))
(defmethod ui/gc-draw-path [(gc gtk-context) mode] (finish-shape! gc mode))

(defmethod ui/gc-text [(gc gtk-context) s x y font color]
  (let [cr (:cr gc)
        layout (text-layout cr s font)]
    (source! gc color)
    (lib/cairo-move-to cr x y)
    (lib/pango-cairo-show-layout cr layout)
    (lib/g-object-unref layout)))

(defmethod ui/gc-text-size [(gc gtk-context) s font]
  (let [layout (text-layout (:cr gc) s font)
        size (layout-size layout)]
    (lib/g-object-unref layout)
    size))

(def ^:private image-surfaces
  "image (by identity) -> a Cairo image surface of it."
  (atom {}))

(defn- image-surface [image]
  (or (get @image-surfaces image)
      (let [t (texture image)
            w (lib/texture-get-width t)
            h (lib/texture-get-height t)
            surface (lib/cairo-image-surface-create 0 w h)]   ; CAIRO_FORMAT_ARGB32
        (lib/cairo-surface-flush surface)
        ;; GdkTexture's default format is Cairo's ARGB32, premultiplied.
        (lib/texture-download t (lib/cairo-image-surface-get-data surface)
                              (lib/cairo-image-surface-get-stride surface))
        (lib/cairo-surface-mark-dirty surface)
        (swap! image-surfaces assoc image surface)
        surface)))

(defmethod ui/gc-image [(gc gtk-context) image x y w h]
  (let [cr (:cr gc)]
    (lib/cairo-save cr)
    (lib/cairo-translate cr x y)
    (lib/cairo-scale cr (/ w (max 1 (:width image))) (/ h (max 1 (:height image))))
    (lib/cairo-set-source-surface cr (image-surface image) 0.0 0.0)
    (lib/cairo-paint cr)
    (lib/cairo-restore cr)))

(defn- draw-canvas! [c cr width height]
  (let [gc (make gtk-context :cr cr :width width :height height :widget c)]
    (when (:background c)
      (ui/paint! gc (:background c)))
    (ui/emit! c (ui/event-for c :draw :context gc :width width :height height))))

(defmethod native-draw [(c ui/canvas-widget) cr width height]
  (draw-canvas! c cr width height))

(def ^:private named-keys
  {0xff0d :return 0xff8d :return 0xff1b :escape 0xff09 :tab 0xff08 :backspace 0xffff :delete
   0xff51 :left 0xff52 :up 0xff53 :right 0xff54 :down 0xff50 :home 0xff57 :end
   0xff55 :page-up 0xff56 :page-down 0x20 :space 0xffbe :f1 0xffbf :f2 0xffc0 :f3
   0xffc1 :f4 0xffc2 :f5 0xffc3 :f6 0xffc4 :f7 0xffc5 :f8 0xffc6 :f9 0xffc7 :f10
   0xffc8 :f11 0xffc9 :f12})

(defn- modifiers-of
  "The set of modifier keys in a GdkModifierType."
  [state]
  (set (keep (fn [[bit m]] (when (pos? (bit-and state bit)) m))
             [[1 :shift] [4 :control] [8 :alt] [0x4000000 :command] [0x10000000 :command]])))

(defmethod native-input [(c ui/canvas-widget) kind controller args]
  (let [mods (modifiers-of (lib/controller-current-state controller))
        button (fn [] (case (lib/gesture-single-get-current-button controller)
                        2 :middle 3 :right :left))]
    (case kind
      :pressed (let [b (button)]
                 (swap! pressed-buttons assoc c b)
                 (when (:focusable c) (lib/widget-grab-focus (native c)))
                 (ui/emit! c (ui/event-for c :mouse-down :x (:x args) :y (:y args) :button b
                                           :click-count (:n args) :modifiers mods)))
      :released (let [b (button)]
                  (swap! pressed-buttons dissoc c)
                  (ui/emit! c (ui/event-for c :mouse-up :x (:x args) :y (:y args) :button b
                                            :click-count (:n args) :modifiers mods)))
      :motion (let [b (get @pressed-buttons c)]
                (ui/emit! c (ui/event-for c (if b :mouse-drag :mouse-move) :x (:x args)
                                          :y (:y args) :button b :modifiers mods)))
      :enter (ui/emit! c (ui/event-for c :mouse-enter :x (:x args) :y (:y args) :modifiers mods))
      :leave (ui/emit! c (ui/event-for c :mouse-leave :modifiers mods))
      :scroll (ui/emit! c (ui/event-for c :scroll :delta-x (:dx args) :delta-y (:dy args)
                                        :modifiers mods))
      (:key-pressed :key-released)
      (let [keyval (:keyval args)
            lower (lib/keyval-to-lower keyval)
            code (lib/keyval-to-unicode keyval)
            key (or (get named-keys lower)
                    (when (pos? (lib/keyval-to-unicode lower))
                      (char (lib/keyval-to-unicode lower))))
            e (ui/event-for c (if (= kind :key-pressed) :key-down :key-up) :key key
                            :modifiers (modifiers-of (:state args))
                            :text (if (pos? code) (str (char code)) ""))]
        (ui/emit! c e)
        (ui/consumed? e)))))

;;; ------------------------------------------------------------------------------------
;;; Window shortcuts

(defn- key-of
  "skein.ui's key for a GDK keyval."
  [keyval]
  (let [lower (lib/keyval-to-lower keyval)]
    (or (get named-keys lower)
        (let [code (lib/keyval-to-unicode lower)] (when (pos? code) (char code))))))

(defmethod native-input [(w ui/window-widget) (k (= :window-key)) controller args]
  (let [e (ui/event-for w :key-down :key (key-of (:keyval args))
                        :modifiers (modifiers-of (:state args)))]
    (or (ui/dispatch-shortcut! w e)
        (do (ui/emit! w e) (ui/consumed? e)))))

;;; ------------------------------------------------------------------------------------
;;; Menus: each item is a GSimpleAction in the backend's action group ("skein."), each
;;; menu a GMenu filled from the core's tree, a menu bar a GtkPopoverMenuBar in its
;;; window above the content. Separators split a menu into sections.

(def ^:private action-names
  "A menu item's GSimpleAction address -> its name."
  (atom {}))

(def ^:private action-ids (atom 0))

(defn- action-name [item] (get @action-names (ffi/address (native item))))

(defmethod make-native [(item ui/menu-item-widget)]
  (let [name (str "item-" (swap! action-ids inc))
        a (if (instance? ui/check-menu-item-widget item)
            (lib/g-simple-action-new-stateful name (ffi/null)
                                              (lib/g-variant-new-boolean (boolean (:checked item))))
            (lib/g-simple-action-new name (ffi/null)))]
    (swap! action-names assoc (ffi/address a) name)
    (lib/g-action-map-add-action (:actions (ui/current-backend)) a)
    (connect! a "activate" :menu-activate signal-arg-imp)))

(defmethod make-native [(m ui/menu-widget)] (lib/g-menu-new))
(defmethod make-native [(s ui/menu-separator-widget)] (lib/g-menu-new))

(def ^:private bar-models
  "A menu bar's GtkPopoverMenuBar address -> its top GMenu."
  (atom {}))

(defmethod make-native [(bar ui/menu-bar-widget)]
  (let [top (lib/g-menu-new)
        n (owned (lib/popover-menu-bar-new top))]
    (swap! bar-models assoc (ffi/address n) top)
    n))

(def ^:private gtk-keys
  {:return "Return" :escape "Escape" :tab "Tab" :backspace "BackSpace" :delete "Delete"
   :left "Left" :right "Right" :up "Up" :down "Down" :home "Home" :end "End"
   :page-up "Page_Up" :page-down "Page_Down" :space "space"
   \, "comma" \. "period" \+ "plus" \- "minus" \/ "slash" \; "semicolon" \= "equal"})

(defn accelerator
  "GTK's accelerator string for a shortcut string, such as \"<Control><Shift>s\"."
  [shortcut]
  (let [[key mods] (ui/parse-shortcut shortcut)]
    (str (apply str (keep (fn [[m s]] (when (contains? mods m) s))
                          [[:control "<Control>"] [:alt "<Alt>"] [:shift "<Shift>"]
                           [:command "<Meta>"]]))
         (or (get gtk-keys key)
             (if (keyword? key) (string/upper-case (name key)) (str key))))))

(defn- fill-menu!
  "Fill the GMenu of the menu widget m from its children, sections at the separators."
  [m]
  (let [gmenu (native m)
        sections (reduce (fn [acc c] (if (instance? ui/menu-separator-widget c)
                                       (conj acc [])
                                       (update acc (dec (count acc)) conj c)))
                         [[]] (:children m))
        fill (fn [target items]
               (doseq [c items]
                 (if (instance? ui/menu-widget c)
                   (do (fill-menu! c)
                       (lib/g-menu-append-submenu target (or (:title c) "") (native c)))
                   (let [i (lib/g-menu-item-new (or (:label c) "") (str "skein." (action-name c)))]
                     (when (:shortcut c)
                       (lib/g-menu-item-set-attribute-value
                        i "accel" (lib/g-variant-new-string (accelerator (:shortcut c)))))
                     (lib/g-menu-append-item target i)
                     (lib/g-object-unref i)))))]
    (lib/g-menu-remove-all gmenu)
    (if (= 1 (count sections))
      (fill gmenu (first sections))
      (doseq [section sections]
        (let [sm (lib/g-menu-new)]
          (fill sm section)
          (lib/g-menu-append-section gmenu (ffi/null) sm)
          (lib/g-object-unref sm))))))

(def ^:private window-shortcuts
  "A window's GtkWindow address -> the shortcut controller of its menu bar's items."
  (atom {}))

(def ^:private window-of-bar
  "A window's address -> the window, for the windows with menu bars."
  (atom {}))

(defn- windows-with-bar [bar]
  (filter (fn [w] (identical? bar (:menu-bar w))) (vals @window-of-bar)))

(defn- install-shortcuts! [w]
  (let [win (native w)
        old (get @window-shortcuts (ffi/address win))
        controller (lib/shortcut-controller-new)]
    (when old (lib/widget-remove-controller win old))
    (lib/shortcut-controller-set-scope controller 1)   ; GTK_SHORTCUT_SCOPE_MANAGED
    (when-let [bar (:menu-bar w)]
      (ui/map-menu-items
       (fn [item _]
         (when (:shortcut item)
           (lib/shortcut-controller-add
            controller (lib/shortcut-new (lib/shortcut-trigger-parse (accelerator (:shortcut item)))
                                         (lib/named-action-new
                                          (str "skein." (action-name item)))))))
       bar))
    (lib/widget-add-controller win controller)
    (swap! window-shortcuts assoc (ffi/address win) controller)))

(defn- rebuild-menus!
  "Fill again the GMenus of the menu bar or menu that o is in, and the shortcuts of the
windows that show it."
  [o]
  (let [root (last (take-while some? (iterate :parent o)))]
    (cond
      (instance? ui/menu-bar-widget root)
      (let [top (get @bar-models (ffi/address (native root)))]
        (lib/g-menu-remove-all top)
        (doseq [m (:children root)]
          (fill-menu! m)
          (lib/g-menu-append-submenu top (or (:title m) "") (native m)))
        (doseq [w (windows-with-bar root)] (install-shortcuts! w)))
      (instance? ui/menu-widget root) (fill-menu! root))))

(defmethod ui/backend-add-child [(b gtk-backend) (parent ui/menu-object) child]
  (rebuild-menus! parent))

(defmethod ui/backend-remove-child [(b gtk-backend) (parent ui/menu-object) child]
  (rebuild-menus! parent))

(defmethod set-native [(m ui/menu-widget) (p (= :title)) v]
  (rebuild-menus! m))

(defmethod set-native [(item ui/menu-item-widget) (p (= :label)) v]
  (rebuild-menus! item))

(defmethod set-native [(item ui/menu-item-widget) (p (= :shortcut)) v]
  (rebuild-menus! item))

(defmethod set-native [(item ui/menu-item-widget) (p (= :enabled)) v]
  (lib/g-simple-action-set-enabled (native item) (boolean v)))

(defmethod set-native [(item ui/check-menu-item-widget) (p (= :checked)) v]
  (lib/g-simple-action-set-state (native item) (lib/g-variant-new-boolean (boolean v))))

(defmethod native-signal [(item ui/menu-item-widget) (k (= :menu-activate)) action arg]
  (ui/activate-menu-item! item))

(defmethod ui/backend-destroy :before [(b gtk-backend) (item ui/menu-item-widget)]
  (lib/g-action-map-remove-action (:actions b) (action-name item)))

(defmethod set-native [(w ui/window-widget) (p (= :menu-bar)) bar]
  (let [win (native w)
        box (get @window-boxes (ffi/address win))
        first-child (lib/widget-get-first-child box)
        content (container-view w)]
    (when (not= (ffi/address first-child) (ffi/address content))
      (lib/box-remove box first-child))
    (if bar
      (do (lib/box-prepend box (native bar))
          (swap! window-of-bar assoc (ffi/address win) w)
          (swap! menu-bar-heights assoc (ffi/address win) (second (lib/natural-size (native bar))))
          (rebuild-menus! bar))
      (do (swap! window-of-bar dissoc (ffi/address win))
          (swap! menu-bar-heights dissoc (ffi/address win))))
    (install-shortcuts! w)
    (set-default-size! w)))

(defclass popup-state []
  "A popup menu that is open."
  (closed :cell :atom :init false))

(defmethod native-signal [(p popup-state) (k (= :closed)) instance arg]
  (set-slot! p :closed true))

(ffi/defcstruct gdk-rectangle (x i32) (y i32) (width i32) (height i32))

(defmethod ui/backend-popup-menu [(b gtk-backend) m widget x y]
  (fill-menu! m)
  ;; A tab bar's point is in its pane, whose GtkNotebook draws the bar.
  (let [widget (if (instance? ui/tab-bar-widget widget) (:pane widget) widget)
        popover (lib/popover-menu-new (native m))
        state (make popup-state)]
    (lib/widget-set-parent popover (native widget))
    (lib/widget-insert-action-group popover "skein" (:actions b))
    (lib/register! popover state)
    (connect! popover "closed" :closed signal-imp)
    (ffi/with-foreign [r (ffi/alloc gdk-rectangle)]
      (ffi/put-field! r gdk-rectangle :x (int x))
      (ffi/put-field! r gdk-rectangle :y (int y))
      (ffi/put-field! r gdk-rectangle :width 1)
      (ffi/put-field! r gdk-rectangle :height 1)
      (lib/popover-set-pointing-to popover r))
    (lib/popover-popup popover)
    (while (not (:closed state))
      (lib/g-main-context-iteration (ffi/null) true))
    (lib/widget-unparent popover)
    (lib/unregister! popover)))

(defn- toplevels []
  (let [l (lib/window-get-toplevels)]
    (mapv (fn [i] (let [w (lib/list-model-get-item l i)] (lib/g-object-unref w) w))
          (range (lib/list-model-n-items l)))))

(defmethod ui/backend-active-window [(b gtk-backend)]
  (some (fn [w] (when (lib/window-is-active w) (lib/object-for w))) (toplevels)))

(def ^:private role-actions
  {:copy "clipboard.copy" :cut "clipboard.cut" :paste "clipboard.paste"
   :select-all "selection.select-all" :delete "selection.delete" :undo "text.undo"
   :redo "text.redo"})

(defmethod ui/backend-perform-role [(b gtk-backend) role]
  (when-let [w (ui/backend-active-window b)]
    (let [win (native w)]
      (case role
        :minimize (lib/window-minimize win)
        :zoom (if (lib/window-is-maximized win)
                (lib/window-unmaximize win)
                (lib/window-maximize win))
        :fullscreen (lib/window-fullscreen win)
        (when-let [action (get role-actions role)]
          (let [focus (lib/root-get-focus win)]
            (when-not (ffi/null? focus)
              (lib/widget-activate-action focus action (ffi/null)))))))))

;;; ------------------------------------------------------------------------------------
;;; Dialogs: GtkAlertDialog and GtkFileDialog, and a window of our own for a text prompt.
;;; They are asynchronous in GTK 4: the backend runs the main loop until they answer.

(def ^:private async-ids (atom 0))

(def ^:private next-answer
  "For tests: {:answer x} for the next dialog (answer-next-dialog!), or nil."
  (atom nil))

(def ^:private open-dialog
  "The dialog that is open: {:kind :alert or :file, :cancellable} or {:kind :prompt ...}."
  (atom nil))

(defn- await-async
  "Start an async call (f id cancellable) and run the main loop until it finished; its
GAsyncResult, which the caller unrefs."
  [kind f]
  (let [id (swap! async-ids inc)
        cancellable (lib/g-cancellable-new)]
    (reset! open-dialog {:kind kind :cancellable cancellable})
    (when (some? @next-answer)
      (lib/g-timeout-add 100 answer-imp (ffi/null)))
    (f (lib/signal-data id) cancellable)
    (while (not (contains? @async-results id))
      (lib/g-main-context-iteration (ffi/null) true))
    (reset! open-dialog nil)
    (lib/g-object-unref cancellable)
    (let [r (get @async-results id)]
      (swap! async-results dissoc id)
      r)))

(defn- parent-window
  "The GtkWindow a dialog belongs to: parent's, else the active window's, else null."
  [parent]
  (if-let [w (or parent (ui/backend-active-window (ui/current-backend)))]
    (native w)
    (ffi/null)))

(defn- c-strings
  "A NULL-terminated C array of copies of the strings, and a function that frees it."
  [strings]
  (let [a (ffi/alloc ptr (inc (count strings)))
        copies (mapv (fn [s] (lib/g-strdup s)) strings)]
    (doseq [[i p] (map-indexed vector copies)] (ffi/put! a ptr p i))
    (ffi/put! a ptr (ffi/null) (count strings))
    [a (fn [] (doseq [p copies] (lib/g-free p)) (ffi/free a))]))

(defmethod ui/backend-message-box [(b gtk-backend) parent message detail type labels]
  (let [d (lib/alert-dialog-new "%s" message)
        [buttons free!] (c-strings labels)]
    (when detail (lib/alert-dialog-set-detail d detail))
    (lib/alert-dialog-set-buttons d buttons)
    (free!)
    (lib/alert-dialog-set-cancel-button d -1)
    (let [r (await-async :alert (fn [id c] (lib/alert-dialog-choose d (parent-window parent) c
                                                                    async-imp id)))
          i (lib/alert-dialog-choose-finish d r (ffi/null))]
      (lib/g-object-unref r)
      (lib/g-object-unref d)
      (when (< -1 i (count labels)) i))))

(defclass prompt-dialog []
  "A text prompt that is open: its window, entry and OK button, and the answer once
given ({:text s} or {:text nil})."
  (window :init nil)
  (entry :init nil)
  (ok :init nil)
  (answer :cell :atom :init nil))

(defn- answer-prompt! [p ok?]
  (when-not (:answer p)
    (set-slot! p :answer {:text (when ok? (lib/editable-get-text (:entry p)))})))

(defmethod native-signal [(p prompt-dialog) (k (= :clicked)) button arg]
  (answer-prompt! p (= (ffi/address button) (ffi/address (:ok p)))))

(defmethod native-signal [(p prompt-dialog) (k (= :activate)) entry arg]
  (answer-prompt! p true))

(defmethod native-close-request [(p prompt-dialog)]
  (answer-prompt! p false))

(defmethod ui/backend-prompt-text [(b gtk-backend) parent message detail default ok cancel]
  (let [win (lib/window-new)
        box (lib/box-new 1 8)
        buttons (lib/box-new 0 8)
        entry (lib/entry-new)
        ok-button (lib/button-new)
        cancel-button (lib/button-new)
        p (make prompt-dialog :window win :entry entry :ok ok-button)]
    (lib/window-set-title win "")
    (lib/window-set-modal win true)
    (when parent (lib/window-set-transient-for win (native parent)))
    (lib/box-append box (lib/label-new message))
    (when detail (lib/box-append box (lib/label-new detail)))
    (lib/editable-set-text entry (or default ""))
    (lib/box-append box entry)
    (lib/button-set-label cancel-button cancel)
    (lib/button-set-label ok-button ok)
    (lib/box-append buttons cancel-button)
    (lib/box-append buttons ok-button)
    (lib/box-append box buttons)
    (lib/window-set-child win box)
    (doseq [[o signal kind handler] [[win "close-request" :close-request close-request-imp]
                                     [entry "activate" :activate signal-imp]
                                     [ok-button "clicked" :clicked signal-imp]
                                     [cancel-button "clicked" :clicked signal-imp]]]
      (lib/register! o p)
      (connect! o signal kind handler))
    (reset! open-dialog {:kind :prompt :prompt p})
    (when (some? @next-answer) (lib/g-timeout-add 100 answer-imp (ffi/null)))
    (lib/window-present win)
    (while (nil? (:answer p))
      (lib/g-main-context-iteration (ffi/null) true))
    (reset! open-dialog nil)
    (doseq [o [win entry ok-button cancel-button]] (lib/unregister! o))
    (lib/window-destroy win)
    (:text (:answer p))))

(defmethod ui/backend-choose-file [(b gtk-backend) parent opts]
  (let [d (lib/file-dialog-new)
        mode (:mode opts)]
    (when (:title opts) (lib/file-dialog-set-title d (:title opts)))
    (when (and (= mode :save) (:name opts)) (lib/file-dialog-set-initial-name d (:name opts)))
    (when (:directory opts)
      (let [f (lib/g-file-new-for-path (:directory opts))]
        (lib/file-dialog-set-initial-folder d f)
        (lib/g-object-unref f)))
    (when (seq (:filters opts))
      (let [store (lib/g-list-store-new (lib/file-filter-get-type))]
        (doseq [[description & extensions] (:filters opts)]
          (let [f (lib/file-filter-new)]
            (lib/file-filter-set-name f description)
            (doseq [e extensions] (lib/file-filter-add-suffix f e))
            (lib/g-list-store-append store f)
            (lib/g-object-unref f)))
        (lib/file-dialog-set-filters d store)
        (lib/g-object-unref store)))
    (let [parent (parent-window parent)
          multiple (and (= mode :open) (:multiple opts))
          r (await-async :file
                         (fn [id c]
                           (cond (= mode :save) (lib/file-dialog-save d parent c async-imp id)
                                 (= mode :directory) (lib/file-dialog-select-folder
                                                      d parent c async-imp id)
                                 multiple (lib/file-dialog-open-multiple d parent c async-imp id)
                                 :else (lib/file-dialog-open d parent c async-imp id))))
          path (fn [f] (let [p (lib/owned-string (lib/g-file-get-path f))]
                         (lib/g-object-unref f)
                         p))
          paths (if multiple
                  (let [files (lib/file-dialog-open-multiple-finish d r (ffi/null))]
                    (when-not (ffi/null? files)
                      (let [ps (mapv (fn [i] (path (lib/list-model-get-item files i)))
                                     (range (lib/list-model-n-items files)))]
                        (lib/g-object-unref files)
                        ps)))
                  (let [f (case mode
                            :save (lib/file-dialog-save-finish d r (ffi/null))
                            :directory (lib/file-dialog-select-folder-finish d r (ffi/null))
                            (lib/file-dialog-open-finish d r (ffi/null)))]
                    (when-not (ffi/null? f) [(path f)])))]
      (lib/g-object-unref r)
      (lib/g-object-unref d)
      paths)))

(defmethod ui/backend-show-about [(b gtk-backend) info]
  (let [d (lib/about-dialog-new)]
    (when (:name info) (lib/about-set-program-name d (:name info)))
    (when (:version info) (lib/about-set-version d (:version info)))
    (when (:copyright info) (lib/about-set-copyright d (:copyright info)))
    (when (:comments info) (lib/about-set-comments d (:comments info)))
    (when (:website info) (lib/about-set-website d (:website info)))
    (when (:icon info) (lib/about-set-logo d (texture (:icon info))))
    (lib/window-present d)))

(defn- find-button
  "The GtkButton whose label is label among the toplevel windows' widgets, or nil."
  [label]
  (first (filter (fn [w] (and (= "GtkButton" (lib/type-name-of w))
                              (= label (lib/button-get-label w))))
                 (mapcat lib/widgets-under (toplevels)))))

(defn- auto-answer! []
  (let [{answer :answer} @next-answer
        {:keys [kind cancellable prompt]} @open-dialog]
    (reset! next-answer nil)
    (case kind
      :alert (if (nil? answer)
               (lib/g-cancellable-cancel cancellable)
               (if-let [button (find-button answer)]
                 (lib/emit! button "clicked")
                 (lib/g-cancellable-cancel cancellable)))
      :file (lib/g-cancellable-cancel cancellable)
      :prompt (if (nil? answer)
                (answer-prompt! prompt false)
                (do (lib/editable-set-text (:entry prompt) answer)
                    (answer-prompt! prompt true)))
      nil)))

;;; ------------------------------------------------------------------------------------
;;; Timers, the clipboard and the system

(def ^:private timer-ids (atom 0))

(defmethod ui/backend-start-timer [(b gtk-backend) t]
  (let [id (swap! timer-ids inc)]
    (swap! timers assoc id t)
    [id (lib/g-timeout-add (max 1 (int (math/round (* 1000 (:interval t))))) timer-imp
                           (lib/signal-data id))]))

(defmethod ui/backend-stop-timer [(b gtk-backend) t [id source]]
  (when (contains? @timers id)
    (swap! timers dissoc id)
    (lib/g-source-remove source)))

(defn- clipboard [] (lib/display-get-clipboard (lib/display-get-default)))

(defmethod ui/backend-clipboard-text [(b gtk-backend)]
  (let [r (await-async :clipboard (fn [id c] (lib/clipboard-read-text-async (clipboard) c
                                                                            async-imp id)))
        text (lib/owned-string (lib/clipboard-read-text-finish (clipboard) r (ffi/null)))]
    (lib/g-object-unref r)
    text))

(defmethod ui/backend-set-clipboard-text [(b gtk-backend) s]
  (lib/clipboard-set-text (clipboard) s))

(defmethod ui/backend-beep [(b gtk-backend)]
  (lib/display-beep (lib/display-get-default)))

(defmethod ui/backend-open-url [(b gtk-backend) url]
  (lib/uri-launcher-launch (lib/uri-launcher-new url) (ffi/null) (ffi/null) (ffi/null) (ffi/null)))

(defmethod ui/backend-dark-mode? [(b gtk-backend)]
  (ffi/with-foreign [v (ffi/alloc i32 1)]
    (lib/g-object-get-bool (lib/settings-get-default) "gtk-application-prefer-dark-theme" v
                           (ffi/null))
    (not= 0 (ffi/get v i32))))

(def ^:private adwaita
  "GTK has no system colors to ask for: Adwaita's, light and dark."
  {false {:text "#000000" :secondary-text "#5e5c64" :disabled-text "#9a9996"
          :background "#ffffff" :control-background "#ffffff" :window-background "#fafafb"
          :selection "#c0d5f6" :accent "#3584e4" :separator "#d7d7d7" :link "#1c71d8"
          :grid "#e6e6e6"}
   true {:text "#ffffff" :secondary-text "#c0bfbc" :disabled-text "#77767b"
         :background "#1e1e1e" :control-background "#242424" :window-background "#222226"
         :selection "#1c4e8c" :accent "#78aeed" :separator "#3a3a3a" :link "#78aeed"
         :grid "#303030"}})

(def ^:private palette
  {:system-red "#e01b24" :system-orange "#ff7800" :system-yellow "#f6d32d"
   :system-green "#33d17a" :system-mint "#2ec27e" :system-teal "#2190a4"
   :system-cyan "#62a0ea" :system-blue "#3584e4" :system-indigo "#5e5ce6"
   :system-purple "#9141ac" :system-pink "#dc8add" :system-brown "#986a44"
   :system-gray "#9a9996"})

(defmethod ui/backend-system-color [(b gtk-backend) name]
  (ui/parse-color (or (get palette name)
                      (get (get adwaita (ui/backend-dark-mode? b)) name)
                      "#808080")))

;;; ------------------------------------------------------------------------------------
;;; For tests: the real widgets, read and acted on

(defn native-frame
  "Where GTK placed the widget, [x y width height], in its container's coordinates."
  [w]
  (mapv (fn [v] (int (math/round v)))
        (or (lib/bounds-in (native w) (container-view (:parent w))) [0 0 0 0])))

(defn native-string
  "The text the widget shows: a label's, a button's label, an entry's, a window's title."
  [w]
  (let [n (native w)]
    (cond (instance? ui/window-widget w) (lib/window-get-title n)
          (instance? ui/label-widget w) (lib/label-get-text n)
          (instance? ui/button-widget w) (lib/button-get-label n)
          (instance? ui/entry-widget w) (lib/editable-get-text n))))

(defn native-visible?
  "True if the widget's GTK widget is visible."
  [w]
  (lib/widget-get-visible (native w)))

(defn click!
  "Click the button, as GTK does for a mouse click."
  [b]
  (lib/emit! (native b) "clicked"))

(defn type-text!
  "Make the entry's text s, as typing does: GTK emits changed."
  [e s]
  (lib/editable-set-text (native e) s))

(defn press-return!
  "Press Return in the entry: GTK emits activate."
  [e]
  (lib/emit! (native e) "activate"))

(defn native-active?
  "True if the toggle button, check box or radio button is on in GTK."
  [t]
  (if (instance? ui/toggle-button-widget t)
    (if (or (instance? ui/check-box-widget t) (instance? ui/radio-button-widget t))
      (lib/check-get-active (native t))
      (lib/toggle-get-active (native t)))
    false))

(defn toggle!
  "Click the toggle, check box or radio button, as the user does: GTK toggles it."
  [t]
  (if (or (instance? ui/check-box-widget t) (instance? ui/radio-button-widget t))
    (lib/check-set-active (native t) (not (lib/check-get-active (native t))))
    (lib/toggle-set-active (native t) (not (lib/toggle-get-active (native t))))))

(defn native-value
  "The value a slider or spin button shows, or a progress bar's fraction."
  [w]
  (cond (instance? ui/slider-widget w) (lib/range-get-value (native w))
        (instance? ui/spin-button-widget w) (lib/spin-get-value (native w))
        (instance? ui/progress-bar-widget w) (lib/progress-get-fraction (native w))))

(defn move-slider!
  "Move the slider to v, as dragging it does."
  [s v]
  (lib/range-set-value (native s) (f64 v)))

(defn choose-item!
  "Choose the item at index in a combo box, as the user does."
  [c index]
  (lib/drop-down-set-selected (native c) index))

(defn native-selected
  "The index a combo box shows chosen, or nil."
  [c]
  (let [i (lib/drop-down-get-selected (native c))]
    (when (not= i lib/invalid-position) i)))

(defn native-date
  "The date and time a date picker shows, in milliseconds since 1970."
  [d]
  (picked-millis d))

(defn has-image?
  "True if the image view shows an image."
  [v]
  (not (ffi/null? (lib/picture-get-paintable (native v)))))

(defn native-text
  "The text in a text view's buffer."
  [v]
  (buffer-text (buffer-of v)))

(defn edit-text!
  "Make a text view's text s, as typing does: its buffer emits changed."
  [v s]
  (lib/text-buffer-set-text (buffer-of v) s -1))

(defn tab-labels
  "The labels of a notebook's tabs."
  [n]
  (mapv (fn [p] (lib/notebook-get-tab-label-text (native n) (page-wrapper p))) (:children n)))

(defn choose-tab!
  "Click the notebook's tab at index, as the user does."
  [n index]
  (lib/notebook-set-current-page (native n) index))

(defn scroll-origin
  "The point of a scrolled window's content at its top left, [x y]."
  [s]
  [(int (math/round (lib/adjustment-get-value (lib/scrolled-get-hadjustment (native s)))))
   (int (math/round (lib/adjustment-get-value (lib/scrolled-get-vadjustment (native s)))))])

(defn row-count
  "How many rows a list box's, table's or tree's view has."
  [w]
  (n-rows w))

(defn cell-string
  "The text GTK last asked the backend to show in the cell at row and column."
  [w row column]
  (get @bound-cells [(ffi/address (native w)) row column]))

(defn select-rows-natively!
  "Select rows in a list box's, table's or tree's view, as the user does."
  [w rows]
  (lib/selection-unselect-all (selection-of w))
  (doseq [r rows] (lib/selection-select-item (selection-of w) r false)))

(defn activate-row!
  "Activate a row of a list box's, table's or tree's view, as a double-click does."
  [w row]
  (lib/g-signal-emit-u32 (view-of w) "activate" row (ffi/null)))

(defn click-column-title!
  "Click the title of the table's column at index, as the user does: GTK sorts by it."
  [t index]
  (let [cols (lib/column-view-get-columns (view-of t))
        col (lib/list-model-get-item cols index)]
    (lib/column-view-sort-by-column (view-of t) col 0)
    (lib/g-object-unref col)))

(defn expand-natively!
  "Open the tree's item's row, as clicking its expander does."
  [t item]
  (doseq [r (range (n-rows t))]
    (when (= item (first (row-items t [r])))
      (let [row (tree-row t r)]
        (lib/tree-row-set-expanded row true)
        (lib/g-object-unref row)))))

(defn draw-into-image!
  "Draw the canvas into a Cairo image, as GTK draws it, and return the image's color at
x, y."
  [c x y]
  (let [[_ _ w h] (or (:allocation c) (into [0 0] (ui/preferred-size c)))
        surface (lib/cairo-image-surface-create 0 w h)
        cr (lib/cairo-create surface)]
    (draw-canvas! c cr w h)
    (lib/cairo-surface-flush surface)
    (let [data (lib/cairo-image-surface-get-data surface)
          stride (lib/cairo-image-surface-get-stride surface)
          at (+ (* y stride) (* 4 x))
          ;; ARGB32 is a native-endian 32-bit word: blue, green, red, alpha in memory.
          [b g r a] (mapv (fn [i] (ffi/get data u8 (+ at i))) (range 4))]
      (lib/cairo-destroy cr)
      (lib/cairo-surface-destroy surface)
      (ui/rgb255 r g b a))))

(defn press-mouse!
  "Press the mouse button at x, y in the canvas, as GTK's click gesture reports it."
  [c x y]
  (lib/g-signal-emit-press (get @click-gestures (ffi/address (native c))) "pressed" 1 (f64 x)
                           (f64 y) (ffi/null)))

(defn answer-next-dialog!
  "For tests: make the next dialog answer by itself, as the user would: a message box
clicks the button labelled answer (nil cancels it); a text prompt types answer and
clicks OK (nil cancels it); a file chooser is cancelled."
  [answer]
  (reset! next-answer {:answer answer})
  nil)

(defn run-for!
  "Run the main loop for seconds, so timers fire, outside ui/run!."
  [seconds]
  (let [end (+ (time/now) seconds)]
    (while (< (time/now) end)
      (lib/g-main-context-iteration (ffi/null) false)
      (sleep 0.005))))

(defn activate-menu-item-natively!
  "Activate the menu item's action, as GTK does when it is chosen."
  [item]
  (lib/g-action-activate (native item) (ffi/null)))

(defn menu-labels
  "The labels of the items of a menu bar's or menu's GMenu, as GTK shows them."
  [m]
  (lib/menu-model-labels (if (instance? ui/menu-bar-widget m)
                           (get @bar-models (ffi/address (native m)))
                           (native m))))

(defmethod ui/backend-destroy :before [(b gtk-backend) (w ui/window-widget)]
  ;; Forget what the backend keeps by the window's address, which a new window may get.
  (let [a (ffi/address (native w))]
    (doseq [m [inner-fixed window-boxes menu-bar-heights window-of-bar window-shortcuts]]
      (swap! m dissoc a))))

;;; ------------------------------------------------------------------------------------
;;; Fonts and colors: one CSS provider, a class for each widget that has its own

(def ^:private css-classes
  "A widget's GTK widget address -> its CSS class."
  (atom {}))

(def ^:private css-rules
  "A CSS class -> the declarations of its rule."
  (atom {}))

(defn- css-color [d]
  (let [[r g b a] (rgba-of d)]
    (format "rgba(%d,%d,%d,%.3f)" (int (math/round (* 255 r))) (int (math/round (* 255 g)))
            (int (math/round (* 255 b))) a)))

(defn- css-font [f]
  (let [f (ui/ensure-font f)]
    (str (case (:family f) :system "" :monospace "font-family: monospace; "
               (str "font-family: \"" (:family f) "\"; "))
         (if (:size f) (str "font-size: " (:size f) "pt; ") "")
         "font-weight: " (case (:weight f) :light 300 :medium 500 :semibold 600 :bold 700 400) "; "
         (if (:italic f) "font-style: italic; " ""))))

(defn- style-target [w]
  (if (instance? ui/text-view-widget w) (text-view-of w) (native w)))

(def ^:private size-scales {:small "85%" :mini "72%" :large "115%"})

(defn- declarations
  "The CSS declarations of the widget's own look: its font, control size, a label's
colors, the palette's text and background colors, a container's surface or background."
  [w]
  (let [palette-text (when (ui/palette-color w :text) (ui/widget-color w :text))
        palette-bg (when (ui/palette-color w :background) (ui/widget-color w :background))
        label? (instance? ui/label-widget w)
        fill (when (or (instance? ui/container-widget w) (instance? ui/window-widget w))
               (or (ui/container-fill w)
                   (when-let [role (ui/surface-color-role (:surface w))]
                     (when (not= role :window-background) (ui/widget-color w role)))))]
    (str (if (and (instance? ui/widget w) (:font w)) (css-font (:font w)) "")
         (if-let [scale (and (instance? ui/widget w) (get size-scales (:control-size w)))]
           (str "font-size: " scale "; ") "")
         (if-let [c (or (when label? (:text-color w)) palette-text)]
           (str "color: " (css-color c) "; ") "")
         (if-let [c (or (when label? (:background w)) fill
                        (when (or (instance? ui/entry-widget w) (instance? ui/text-view-widget w)
                                  (instance? ui/list-box-widget w))
                          palette-bg))]
           (str "background-color: " (css-color c) "; ") ""))))

(defn- restyle!
  "Give the widget's GTK widget a CSS rule of its own look (declarations)."
  [w]
  (let [n (style-target w)
        a (ffi/address n)
        d (declarations w)]
    (when (or (seq d) (get @css-classes a))
      (let [class (or (get @css-classes a)
                      (let [c (str "skein-" (count @css-classes))]
                        (lib/widget-add-css-class n c)
                        (swap! css-classes assoc a c)
                        c))]
        (swap! css-rules assoc class d)
        (lib/css-provider-load (:css (ui/current-backend))
                               (apply str (map (fn [[c d]] (str "." c " { " d "}\n"))
                                               @css-rules)))))))

(defmethod set-native [(w ui/widget) (p (= :font)) f] (restyle! w))
(defmethod set-native [(w ui/widget) (p (= :control-size)) v] (restyle! w))
(defmethod set-native [(l ui/label-widget) (p (= :text-color)) c] (restyle! l))
(defmethod set-native [(l ui/label-widget) (p (= :background)) c] (restyle! l))
(defmethod set-native [(c ui/container-widget) (p (= :surface)) v] (restyle! c))
(defmethod set-native [(c ui/container-widget) (p (= :background)) v] (restyle! c))
(defmethod set-native [(w ui/window-widget) (p (= :surface)) v] (restyle! w))
(defmethod set-native [(w ui/window-widget) (p (= :background)) v] (restyle! w))

(defmethod ui/backend-apply-palette [(b gtk-backend) w]
  (restyle! w))

;;; ------------------------------------------------------------------------------------
;;; Input events of the controls, context menus and focus

(defn- input-target
  "The GTK widget that gets a widget's keys and clicks, given its own GTK widget n."
  [w n]
  (cond (instance? ui/text-view-widget w) (get @text-views (ffi/address n))
        (or (instance? ui/list-box-widget w) (instance? ui/tree-view-widget w))
        (:view (get @list-parts (ffi/address n)))
        :else n))

(def ^:private right-clickable
  "The addresses of the GTK widgets that have a click gesture of ours."
  (atom #{}))

(defn- add-click-gesture! [w target button]
  (when-not (contains? @right-clickable (ffi/address target))
    (let [g (lib/gesture-click-new)]
      (lib/gesture-single-set-button g button)
      (lib/controller-set-phase g 1)   ; capture: before the widget's own
      (lib/register! g w)
      (connect! g "pressed" :pressed press-imp)
      (connect! g "released" :released press-imp)
      (lib/widget-add-controller target g)
      (swap! right-clickable conj (ffi/address target)))))

(defn- install-input! [w n]
  (when (and (contains? (ui/signals w) :key-down) (not (instance? ui/canvas-widget w))
             (instance? ui/widget w))
    (let [target (input-target w n)
          keys (lib/key-controller-new)]
      (lib/controller-set-phase keys 1)
      (lib/register! keys w)
      (connect! keys "key-pressed" :key-pressed key-imp)
      (connect! keys "key-released" :key-released key-imp)
      (lib/widget-add-controller target keys)
      (add-click-gesture! w target 0))))

(defmethod set-native [(w ui/widget) (p (= :context-menu)) m]
  (when m (add-click-gesture! w (input-target w (native w)) 0)))

(defn- emit-input! [w signal & kvs]
  (let [e (apply ui/event-for w signal kvs)]
    (ui/emit! w e)
    (ui/consumed? e)))

(defmethod native-input [(w ui/widget) kind controller args]
  (let [mods (modifiers-of (lib/controller-current-state controller))
        input (contains? (ui/signals w) :key-down)]
    (case kind
      (:pressed :released)
      (let [button (case (lib/gesture-single-get-current-button controller)
                     2 :middle 3 :right :left)
            down (= kind :pressed)
            consumed (or (and input (emit-input! w (if down :mouse-down :mouse-up)
                                                 :x (:x args) :y (:y args) :button button
                                                 :click-count (:n args) :modifiers mods))
                         (and down (= button :right)
                              (or (and input (emit-input! w :context-request :x (:x args)
                                                          :y (:y args) :button button
                                                          :click-count (:n args)
                                                          :modifiers mods))
                                  (when-let [m (:context-menu w)]
                                    (ui/popup-menu! m w (:x args) (:y args))
                                    true))))]
        (when consumed (lib/gesture-set-state controller 1))   ; CLAIMED: the widget skips it
        consumed)
      (:key-pressed :key-released)
      (let [keyval (:keyval args)
            code (lib/keyval-to-unicode keyval)
            text (if (pos? code) (str (char code)) "")
            mods (modifiers-of (:state args))
            down (= kind :key-pressed)]
        (boolean
         (or (emit-input! w (if down :key-down :key-up) :key (key-of keyval) :modifiers mods
                          :text text)
             (and down (pos? code) (>= code 32) (not (contains? mods :control))
                  (emit-input! w :text-input :text text :modifiers mods)))))
      false)))

(defmethod ui/backend-focus [(b gtk-backend) w]
  (lib/widget-grab-focus (input-target w (native w))))

(defn- widget-of-gtk
  "The widget a GTK widget (or one it is in) stands for, or nil."
  [n]
  (loop [n n]
    (when-not (ffi/null? n)
      (let [w (lib/object-for n)]
        (if (and w (instance? ui/widget w)) w (recur (lib/widget-get-parent n)))))))

(defmethod ui/backend-focused-widget [(b gtk-backend)]
  (when-let [win (ui/backend-active-window b)]
    (widget-of-gtk (lib/root-get-focus (native win)))))

;;; ------------------------------------------------------------------------------------
;;; Windows' options and modal runs

(defmethod set-native [(w ui/window-widget) (p (= :resizable)) v]
  (lib/window-set-resizable (native w) (boolean v)))

(defmethod set-native [(w ui/window-widget) (p (= :closable)) v]
  (lib/window-set-deletable (native w) (boolean v)))

(defmethod set-native [(w ui/window-widget) (p (= :min-size)) size]
  ;; The window's content can't be made smaller than this.
  (when-let [[mw mh] size]
    (lib/widget-set-size-request (container-view w) mw mh)))

(def ^:private modal-state
  "A window's address -> {:done :value} while it runs modally."
  (atom {}))

(defmethod ui/backend-run-modal [(b gtk-backend) w]
  (let [a (ffi/address (native w))]
    (swap! modal-state assoc a {:done false})
    (lib/window-set-modal (native w) true)
    (while (not (:done (get @modal-state a)))
      (lib/g-main-context-iteration (ffi/null) true))
    (lib/window-set-modal (native w) false)
    (let [v (:value (get @modal-state a))]
      (swap! modal-state dissoc a)
      v)))

(defmethod ui/backend-end-modal [(b gtk-backend) w value]
  (swap! modal-state assoc (ffi/address (native w)) {:done true :value value})
  (lib/g-main-context-wakeup (ffi/null)))

(defn native-resizable?
  "True if the user can resize the window."
  [w]
  (lib/window-get-resizable (native w)))

(defn send-key!
  "Press the key (a character) in the widget, as GTK's key controller reports it. True if
a handler consumed it."
  [w ch]
  (native-input w :key-pressed (lib/key-controller-new)
                {:keyval (int ch) :state 0}))

;;; ------------------------------------------------------------------------------------
;;; Appearance: GTK 4 has one dark-mode setting for the application. A subtree that asks
;;; for :light or :dark gets the theme's variant as a style provider of its own widgets.

(defn- inherited-appearance [w]
  (some (fn [o] (let [a (:appearance o)] (when (or (= a :light) (= a :dark)) a)))
        (ui/holders w)))

(defmethod ui/backend-widget-appearance [(b gtk-backend) w]
  (or (inherited-appearance w) (if (ui/backend-dark-mode? b) :dark :light)))

(defmethod ui/backend-color-in-appearance [(b gtk-backend) name w]
  (let [dark (= :dark (ui/backend-widget-appearance b w))]
    (ui/parse-color (or (when-let [[l d] (get ui/system-palette name)] (if dark d l))
                        (get palette name)
                        (get (get adwaita dark) name)
                        (get (get adwaita dark) ({:sidebar-background :window-background
                                                  :content-background :background
                                                  :status-background :window-background
                                                  :toolbar-background :window-background
                                                  :activity-background :window-background
                                                  :popover-background :background} name))
                        "#808080"))))

(def ^:private theme-providers
  "[theme mode] -> a CSS provider of the theme's variant."
  (atom {}))

(def ^:private attached-themes
  "A GTK widget's address -> the theme provider attached to its style context."
  (atom {}))

(defn- theme-name []
  (ffi/with-foreign [out (ffi/alloc ptr 1)]
    (lib/g-object-get-string (lib/settings-get-default) "gtk-theme-name" out (ffi/null))
    (or (lib/owned-string (ffi/get out ptr)) "Adwaita")))

(defn- theme-provider [mode]
  (let [k [(theme-name) mode]]
    (or (get @theme-providers k)
        (let [p (lib/css-provider-new)]
          (lib/css-provider-load-named p (first k) (when (= mode :dark) "dark"))
          (swap! theme-providers assoc k p)
          p))))

(defn- apply-native-appearance!
  "Attach to the widget's GTK widgets the theme variant its appearance asks for."
  [w]
  (when (and (instance? ui/widget w) (ui/realized? w))
    (let [mode (inherited-appearance w)
          provider (when mode (theme-provider mode))]
      (doseq [n (lib/widgets-under (native w))]
        (let [a (ffi/address n)
              old (get @attached-themes a)
              context (lib/widget-get-style-context n)]
          (when (not= (when old (ffi/address old)) (when provider (ffi/address provider)))
            (when old (lib/style-context-remove-provider context old))
            (when provider (lib/style-context-add-provider context provider 599))
            (swap! attached-themes assoc a provider)))))))

(defmethod set-native [(w ui/widget) (p (= :appearance)) a]
  (doseq [x (ui/widgets-in w)] (apply-native-appearance! x)))

(defmethod set-native [(w ui/window-widget) (p (= :appearance)) a]
  (doseq [x (ui/widgets-in w)] (apply-native-appearance! x)))

(defmethod ui/backend-add-child :after [(b gtk-backend) parent (child ui/widget)]
  (doseq [x (ui/widgets-in child)] (apply-native-appearance! x)))

(defn has-css-rule?
  "True if the widget has a CSS rule of its own look."
  [w]
  (seq (get @css-rules (get @css-classes (ffi/address (style-target w))))))

;;; ------------------------------------------------------------------------------------
;;; Stacks and tabbed panes. A tabbed pane is a GtkNotebook: it scrolls its tabs, lists
;;; them in a popup and reorders them itself; each tab is a GtkBox of the page's icon,
;;; label, accessory and close button, and the tab bar's start and end boxes are its action
;;; widgets. A capture-phase legacy controller drags tabs to other panes of the drag group.

(defmethod make-native [(s ui/stack-widget)] (owned (lib/fixed-new)))

(defmethod make-native [(bar ui/tab-bar-widget)] (owned (lib/fixed-new)))

(defn- install-tab-drag! [pane nb]
  (let [c (lib/legacy-controller-new)]
    (lib/controller-set-phase c 1)   ; capture: before the notebook's own gesture
    (lib/register! c pane)
    (lib/g-signal-connect-data c "event" legacy-imp (ffi/null) (ffi/null) 0)
    (lib/widget-add-controller nb c)))

(defmethod make-native [(pane ui/tabbed-pane-widget)]
  (let [nb (call-next-method)]
    (lib/notebook-set-scrollable nb true)
    (lib/notebook-popup-enable nb)
    (connect! nb "page-reordered" :page-reordered page-signal-imp)
    (install-tab-drag! pane nb)
    nb))

(defmethod ui/backend-add-child [(b gtk-backend) (pane ui/tabbed-pane-widget) child]
  ;; The tab bar's GtkFixed only holds its widgets until they go in the tabs and ends.
  (when-not (instance? ui/tab-bar-widget child)
    (call-next-method)))

(defn- detach!
  "Take the GTK widget n out of the box or fixed it is in. Returns n."
  [n]
  (let [parent (lib/widget-get-parent n)]
    (when-not (ffi/null? parent)
      (let [type (lib/type-name-of parent)]
        (cond (= type "GtkBox") (lib/box-remove parent n)
              (= type "GtkFixed") (lib/fixed-remove parent n)
              :else (lib/widget-unparent n)))))
  n)

(defmethod ui/backend-remove-child [(b gtk-backend) (bar ui/tab-bar-widget) child]
  (detach! (native child)))

(defmethod ui/backend-set-page-label [(b gtk-backend) (pane ui/tabbed-pane-widget) page label]
  ;; backend-tab-update shows the label.
  nil)

(def ^:private tab-closers
  "A page's GTK widget address -> the close button of its tab."
  (atom {}))

(defn- tab-closer [page]
  (let [a (ffi/address (native page))]
    (or (get @tab-closers a)
        (let [button (owned (lib/button-new-from-icon-name "window-close-symbolic"))]
          (lib/widget-add-css-class button "flat")
          (lib/register! button page)
          (connect! button "clicked" :tab-close signal-imp)
          (swap! tab-closers assoc a button)
          button))))

(defn- forget-closer! [page]
  (let [a (ffi/address (native page))]
    (when-let [button (get @tab-closers a)]
      (detach! button)
      (lib/unregister! button)
      (lib/g-object-unref button)
      (swap! tab-closers dissoc a))))

(defmethod native-signal [(page ui/widget) (k (= :tab-close)) button arg]
  (let [pane (:parent page)]
    (when (and (instance? ui/tabbed-pane-widget pane) (:tab-closable page) (:enabled pane))
      (ui/close-page! pane page))))

(defmethod ui/backend-tab-update [(b gtk-backend) pane page]
  (let [nb (native pane)
        box (lib/box-new 0 6)
        l (:tab-label page)
        a (:tab-accessory page)]
    (when-let [icon (:tab-icon page)]
      (let [i (lib/image-new-from-paintable (texture icon))]
        (lib/image-set-pixel-size i 16)
        (lib/box-append box i)))
    (lib/box-append box (if (instance? ui/widget l)
                          (detach! (native l))
                          (lib/label-new (ui/tab-title pane page))))
    (when (instance? ui/widget a) (lib/box-append box (detach! (native a))))
    (when (:tab-closable page) (lib/box-append box (detach! (tab-closer page))))
    (lib/widget-set-tooltip-text box (:tab-tooltip page))
    (lib/notebook-set-tab-label nb (page-wrapper page) box)
    (lib/notebook-set-tab-reorderable nb (page-wrapper page) (boolean (:reorderable pane)))))

(defmethod ui/backend-remove-child [(b gtk-backend) (pane ui/tabbed-pane-widget) page]
  (forget-closer! page)
  (call-next-method))

(defmethod set-native [(pane ui/tabbed-pane-widget) (p (= :reorderable)) v]
  (doseq [page (:children pane)]
    (lib/notebook-set-tab-reorderable (native pane) (page-wrapper page) (boolean v))))

(defmethod ui/backend-tab-move [(b gtk-backend) pane page old index]
  (quietly (fn [] (lib/notebook-reorder-child (native pane) (page-wrapper page) index))))

(defmethod native-signal [(pane ui/tabbed-pane-widget) (k (= :page-reordered)) nb arg]
  (when-not (quiet?)
    (let [[child number] arg
          page (first (filter (fn [p] (= (ffi/address (page-wrapper p)) (ffi/address child)))
                              (:children pane)))]
      (when (and page (not= number (index-of (:children pane) page)))
        (ui/page-moved-by-user! pane page number)))))

(defn- page-decoration
  "What the GtkNotebook adds around its pages, [width height] (its header, borders and
margins), or nil without pages: measured with the pages' GtkStack far bigger than any
header."
  [pane]
  (when-let [page (first (:children pane))]
    (let [nb (native pane)
          stack (lib/widget-get-parent (page-wrapper page))
          big 100000]
      (when-not (ffi/null? stack)
        (lib/widget-set-size-request stack big big)
        (let [[w h] (lib/natural-size nb)]
          (lib/widget-set-size-request stack -1 -1)
          (when-let [[_ _ aw ah] (:allocation pane)] (lib/widget-set-size-request nb aw ah))
          [(max 0 (- w big)) (max 0 (- h big))])))))

(defmethod native-natural-size [(bar ui/tab-bar-widget)]
  [0 (or (second (page-decoration (:pane bar))) 34)])

(defmethod ui/backend-tab-page-area [(b gtk-backend) pane width height]
  ;; Pages sized for the core's bar would ask the GtkNotebook for more than it has.
  (if-let [[dw dh] (page-decoration pane)]
    [(max 0 (- width dw)) (max 0 (- height dh))]
    (call-next-method)))

(defmethod ui/backend-tab-layout [(b gtk-backend) pane width height]
  (let [bar (:tab-bar pane)
        nb (native pane)]
    (doseq [[pack w] [[0 (:start bar)] [1 (:end bar)]]]   ; GTK_PACK_START, GTK_PACK_END
      (when w
        (let [n (native w)]
          (when-not (= (ffi/address n) (ffi/address (lib/notebook-get-action-widget nb pack)))
            (detach! n)
            (lib/notebook-set-action-widget nb n pack)))))))

(defn- gtk-ancestors
  "The GTK widget n and the widgets it is in, up to (not including) stop, or to the top."
  [n stop]
  (loop [n n out []]
    (if (or (ffi/null? n) (and stop (= (ffi/address n) (ffi/address stop))))
      out
      (recur (lib/widget-get-parent n) (conj out n)))))

(defmethod ui/backend-tab-at-point [(b gtk-backend) pane x y]
  (let [nb (native pane)
        chain (set (map ffi/address (gtk-ancestors (lib/widget-pick nb (f64 x) (f64 y) 0) nil)))]
    (first (filter (fn [page]
                     (let [label (lib/notebook-get-tab-label nb (page-wrapper page))]
                       ;; The label box, or the notebook's tab around it.
                       (or (contains? chain (ffi/address label))
                           (contains? chain (ffi/address (lib/widget-get-parent label))))))
                   (:children pane)))))

;; Dragging a tab to another pane of its drag group: GtkNotebook's own gesture still
;; selects and reorders; the legacy controller sees the same press, motion and release.
;; Points are in the window's coordinates; picking finds the pane under the pointer, so
;; covered parts don't count, and a CSS outline marks it until the button goes up.

(def ^:private tab-drags
  "A tabbed pane's GTK widget address -> its tab drag: {:page :x :y :dragging :stopped
:target}."
  (atom {}))

(defn- drag-key [pane] (ffi/address (native pane)))

(defn- window-point
  "Where the GdkEvent happened in the window of the GTK widget n, [x y], or nil."
  [n event]
  (ffi/with-foreign [x (ffi/alloc f64 1)]
    (ffi/with-foreign [y (ffi/alloc f64 1)]
      (when (lib/event-get-position event x y)
        (let [ex (ffi/get x f64)
              ey (ffi/get y f64)]
          (lib/native-get-surface-transform (lib/widget-get-native n) x y)
          [(- ex (ffi/get x f64)) (- ey (ffi/get y f64))])))))

(defn- pane-point
  "The window point x, y in the widget's own coordinates, or nil."
  [w x y]
  (let [n (native w)]
    (lib/point-in (lib/widget-get-native n) n x y)))

(defn- drop-target
  "The pane other than pane that its tab dragged to the window point x, y would drop on,
or nil."
  [pane x y]
  (when (:drag-group pane)
    (let [picked (lib/widget-pick (lib/widget-get-native (native pane)) (f64 x) (f64 y) 0)
          w (when-not (ffi/null? picked) (widget-of-gtk picked))
          target (when w
                   (first (filter (fn [o] (and (instance? ui/tabbed-pane-widget o)
                                               (= (:drag-group o) (:drag-group pane))))
                                  (take-while some? (iterate :parent w)))))]
      (when (and target (ui/page-drop-target? target pane)) target))))

(defn- show-drop-target! [pane target]
  (let [k (drag-key pane)
        old (get-in @tab-drags [k :target])]
    (when-not (identical? target old)
      (when (and old (not (:destroyed old)))
        (lib/widget-remove-css-class (native old) "skein-drop-target"))
      (swap! tab-drags assoc-in [k :target] target)
      (when target
        (when-not (contains? @css-rules "skein-drop-target")
          (swap! css-rules assoc "skein-drop-target"
                 "outline: 2px solid @accent_color; outline-offset: -2px; ")
          (lib/css-provider-load (:css (ui/current-backend))
                                 (apply str (map (fn [[c d]] (str "." c " { " d "}\n"))
                                                 @css-rules))))
        (lib/widget-add-css-class (native target) "skein-drop-target")))))

(defn- end-tab-drag! [pane]
  (show-drop-target! pane nil)
  (swap! tab-drags dissoc (drag-key pane)))

(defn- on-button?
  "True if the point x, y in the pane is on a button in it (a tab's close button)."
  [pane x y]
  (let [nb (native pane)]
    (boolean (some (fn [n] (= "GtkButton" (lib/type-name-of n)))
                   (gtk-ancestors (lib/widget-pick nb (f64 x) (f64 y) 0) nb)))))

(defn- tab-drag-press! [pane x y]
  (end-tab-drag! pane)
  (when (and (:drag-group pane) (:enabled pane))
    (when-let [[px py] (pane-point pane x y)]
      (let [page (ui/backend-tab-at-point (ui/current-backend) pane px py)]
        (when (and page (not (on-button? pane px py)))
          (swap! tab-drags assoc (drag-key pane) {:page page :x x :y y}))))))

(defn- stop-native-reorder!
  "End GtkNotebook's own reorder drag (which it commits when cancelled), keeping the page
where it was: over another pane, the drag is no longer a reorder."
  [pane page]
  (let [index (index-of (:children pane) page)
        controllers (lib/widget-observe-controllers (native pane))]
    (doseq [i (range (lib/list-model-n-items controllers))]
      (let [c (lib/list-model-get-item controllers i)]
        (when (= "GtkGestureClick" (lib/type-name-of c)) (lib/controller-reset c))
        (lib/g-object-unref c)))
    (lib/g-object-unref controllers)
    (let [now (index-of (:children pane) page)]
      (when (and index now (not= index now)) (ui/move-page! pane page index)))))

(defn- tab-drag-motion! [pane x y]
  (let [k (drag-key pane)
        d (get @tab-drags k)]
    (when (and d (index-of (:children pane) (:page d)))
      (when (or (:dragging d) (> (abs (- x (:x d))) 5) (> (abs (- y (:y d))) 5))
        (swap! tab-drags assoc-in [k :dragging] true)
        (show-drop-target! pane (drop-target pane x y))
        (when (and (get-in @tab-drags [k :target]) (not (:stopped d)))
          (swap! tab-drags assoc-in [k :stopped] true)
          (stop-native-reorder! pane (:page d)))))))

(defn- drop-index
  "Where a tab dropped at the window point x, y goes in pane: before the tab there, else
last."
  [pane x y]
  (let [page (when-let [[px py] (pane-point pane x y)]
               (ui/backend-tab-at-point (ui/current-backend) pane px py))]
    (if page (index-of (:children pane) page) (count (:children pane)))))

(defn- tab-drag-release! [pane x y]
  (let [d (get @tab-drags (drag-key pane))
        target (:target d)]
    (end-tab-drag! pane)
    (when (and d target (not (:destroyed target)))
      ;; GtkNotebook handles the same release after this controller: drop afterwards.
      (let [index (drop-index target x y)]
        (ui/backend-call-later (ui/current-backend)
                               (fn [] (ui/page-dropped-by-user! (:page d) target index)))))))

(defn- tab-event!
  "A press, motion or release in the pane: drag tabs between panes, and report a
right-click on a tab. True to stop the GtkNotebook from seeing it."
  [pane event]
  (let [type (lib/event-get-event-type event)]   ; GDK_MOTION_NOTIFY 1, BUTTON_PRESS 2, RELEASE 3
    (when (contains? #{1 2 3} type)
      (when-let [[x y] (window-point (native pane) event)]
        (cond
          (= type 1) (do (tab-drag-motion! pane x y) false)
          (= type 3) (do (when (= 1 (lib/button-event-get-button event))
                           (tab-drag-release! pane x y))
                         false)
          (= 1 (lib/button-event-get-button event)) (do (tab-drag-press! pane x y) false)
          (= 3 (lib/button-event-get-button event))
          (when-let [[px py] (pane-point pane x y)]
            (when (ui/backend-tab-at-point (ui/current-backend) pane px py)
              (ui/tab-context-requested! pane px py
                                         (modifiers-of (lib/event-get-modifier-state event)))
              true))
          :else false)))))

(defmethod ui/backend-destroy :before [(b gtk-backend) (pane ui/tabbed-pane-widget)]
  (doseq [page (:children pane)] (forget-closer! page))
  (swap! tab-drags dissoc (drag-key pane)))

(defn native-tab
  "What the page's tab shows: {:title :closable :tooltip}."
  [page]
  (let [pane (:parent page)
        box (lib/notebook-get-tab-label (native pane) (page-wrapper page))
        kids (lib/children-of box)
        label (first (filter (fn [n] (= "GtkLabel" (lib/type-name-of n))) kids))]
    {:title (if label (lib/label-get-text label) (ui/tab-title pane page))
     :closable (boolean (some (fn [n] (= "GtkButton" (lib/type-name-of n))) kids))
     :tooltip (lib/widget-get-tooltip-text box)}))

(defn click-tab-close!
  "Click the close button of the page's tab, as the user does."
  [page]
  (lib/emit! (tab-closer page) "clicked"))

(defn reorder-tab!
  "Drag the page's tab to index in its pane, as the user does: GtkNotebook moves it and
emits page-reordered."
  [page index]
  (lib/notebook-reorder-child (native (:parent page)) (page-wrapper page) index))

(defn tab-point
  "The middle of the page's tab, [x y] in its pane."
  [page]
  (let [pane (:parent page)
        label (lib/notebook-get-tab-label (native pane) (page-wrapper page))
        [x y w h] (lib/bounds-in label (native pane))]
    [(+ x (/ w 2)) (+ y (/ h 2))]))

(defn drag-tab-to!
  "Drag the page's tab onto the middle of the widget w and let go, as the user does,
reporting window points as the pane's event controller would."
  [page w]
  (let [pane (:parent page)
        win (lib/widget-get-native (native pane))
        [px py] (tab-point page)
        [sx sy] (lib/point-in (native pane) win px py)
        [_ _ ww wh] (lib/bounds-in (native w) (native w))
        [tx ty] (lib/point-in (native w) win (/ ww 2) (/ wh 2))]
    (tab-drag-press! pane sx sy)
    (tab-drag-motion! pane (/ (+ sx tx) 2) (/ (+ sy ty) 2))
    (tab-drag-motion! pane tx ty)
    (tab-drag-release! pane tx ty)))

;;; ------------------------------------------------------------------------------------
;;; Popovers and completion popups: a GtkPopover holding a GtkFixed, parented to the
;;; widget it is shown for while it is shown. A completion popup's has no arrow and doesn't
;;; hide itself, and the widget it is shown for keeps the focus.

(def ^:private popdowns
  "The addresses of the popovers the program is closing, whose closed signal isn't the
user's doing."
  (atom #{}))

(defmethod make-native [(s ui/surface-widget)]
  (let [p (owned (lib/popover-new))
        host (lib/fixed-new)]
    (lib/popover-set-child p host)
    (swap! inner-fixed assoc (ffi/address p) host)
    (when (instance? ui/completion-popup-widget s)
      (lib/popover-set-has-arrow p false)
      (lib/popover-set-autohide p false))
    (connect! p "closed" :closed signal-imp)
    p))

(defmethod set-native [(s ui/surface-widget) (p (= :visible)) v]
  ;; A GtkPopover is visible while it pops up: show-popover! and close-surface! decide.
  nil)

(defmethod container-view [(s ui/surface-widget)]
  (get @inner-fixed (ffi/address (native s))))

(defn- unparent-surface! [s]
  (let [p (native s)]
    (when-not (ffi/null? (lib/widget-get-parent p))
      (lib/widget-unparent p))))

(defmethod ui/backend-destroy :before [(b gtk-backend) (s ui/surface-widget)]
  (unparent-surface! s)
  (swap! inner-fixed dissoc (ffi/address (native s))))

(defmethod native-signal [(s ui/surface-widget) (k (= :closed)) p arg]
  (when-not (contains? @popdowns (ffi/address p))
    (ui/surface-closed! s :dismissed))
  ;; Let go of the widget it was shown for once GTK is done closing it.
  (ui/backend-call-later (ui/current-backend)
                         (fn [] (when (and (not (:shown s)) (not (:destroyed s)))
                                  (unparent-surface! s)))))

(defmethod set-native [(s ui/surface-widget) (p (= :size)) size]
  (when-let [[w h] size]
    (lib/widget-set-size-request (container-view s) w h)))

(defmethod set-native [(s ui/popover-widget) (p (= :behavior)) v]
  (lib/popover-set-autohide (native s) (not= v :application-defined)))

(defn- point-popover! [s widget [x y width height] position]
  (let [p (native s)
        n (native widget)]
    (when-not (= (ffi/address (lib/widget-get-parent p)) (ffi/address n))
      (unparent-surface! s)
      (lib/widget-set-parent p n))
    (ffi/with-foreign [r (ffi/alloc gdk-rectangle)]
      (ffi/put-field! r gdk-rectangle :x (int x))
      (ffi/put-field! r gdk-rectangle :y (int y))
      (ffi/put-field! r gdk-rectangle :width (max 1 (int width)))
      (ffi/put-field! r gdk-rectangle :height (max 1 (int height)))
      (lib/popover-set-pointing-to p r))
    ;; GTK_POS_LEFT 0, RIGHT 1, TOP 2, BOTTOM 3
    (lib/popover-set-position p (case position :left 0 :right 1 :top 2 3))
    (doseq [x (ui/widgets-in s)] (apply-native-appearance! x))
    (lib/popover-popup p)))

(defmethod ui/backend-show-popover [(b gtk-backend) s widget rectangle edge]
  (point-popover! s widget rectangle edge))

(defn- pop-down! [s]
  (let [p (native s)
        a (ffi/address p)]
    (swap! popdowns conj a)
    (try (lib/popover-popdown p)
         (finally (swap! popdowns disj a)))))

(defmethod ui/backend-close-popover [(b gtk-backend) s]
  (pop-down! s))

(defmethod ui/backend-caret-rectangle [(b gtk-backend) w position]
  (let [tv (text-view-of w)]
    (with-iters
      (fn [iter _]
        (lib/text-buffer-get-iter-at-offset (buffer-of w) iter position)
        (ffi/with-foreign [r (ffi/alloc gdk-rectangle)]
          (lib/text-view-get-iter-location tv iter r)
          (ffi/with-foreign [wx (ffi/alloc i32 1)]
            (ffi/with-foreign [wy (ffi/alloc i32 1)]
              ;; GTK_TEXT_WINDOW_WIDGET 1: from the buffer to the text view's own
              (lib/text-view-buffer-to-window-coords tv 1 (ffi/field r gdk-rectangle :x)
                                                     (ffi/field r gdk-rectangle :y) wx wy)
              (let [[x y] (or (lib/point-in tv (native w) (ffi/get wx i32) (ffi/get wy i32))
                              [(ffi/get wx i32) (ffi/get wy i32)])]
                [(int (math/round x)) (int (math/round y)) 1
                 (max 1 (ffi/field r gdk-rectangle :height))]))))))))

(defmethod ui/backend-show-panel [(b gtk-backend) s widget anchor]
  (let [focus (ui/backend-focused-widget b)
        rectangle (if (vector? anchor)
                    anchor
                    (ui/backend-caret-rectangle b widget (if (= anchor :caret)
                                                           (ui/caret-position widget)
                                                           anchor)))]
    ;; GTK centers a popover on what it points at: a list starts at the caret instead.
    (lib/popover-set-offset (native s) (quot (or (first (:size s)) 0) 2) 0)
    (point-popover! s widget rectangle :bottom)
    (when focus (ui/backend-focus b focus))))

(defmethod ui/backend-close-panel [(b gtk-backend) s]
  (pop-down! s))

(defn native-surface-shown?
  "True if the surface's GtkPopover is shown."
  [s]
  (lib/widget-get-visible (native s)))
