(ns skein.ui.cocoa.objc
  "The Objective-C runtime from Skein, for the Cocoa backend (Skein's M2.14, D-097):
classes and selectors by name, objc_msgSend in each shape of call the backend makes,
NSStrings, autorelease pools, classes defined at run time whose methods are Skein
callbacks, and a registry from native objects back to Skein's.

Every call here must run on the main thread, as AppKit requires; the backend sees to it.
The sends are marked ^:blocking since some of them run the event loop or a modal dialog,
and all of them run on the main thread, which no fiber waits to share."
  (:require [skein.ffi :as ffi]))

;;; ------------------------------------------------------------------------------------
;;; Libraries

(def ^:private loaded (atom false))

(defn load-frameworks!
  "Load libobjc, Foundation and AppKit, once. Only on macOS: other systems never call it."
  []
  (when-not @loaded
    (ffi/load-library {:macos "/usr/lib/libobjc.A.dylib"})
    (ffi/load-library {:macos "/System/Library/Frameworks/Foundation.framework/Foundation"})
    (ffi/load-library {:macos "/System/Library/Frameworks/AppKit.framework/AppKit"})
    (reset! loaded true))
  nil)

;;; ------------------------------------------------------------------------------------
;;; Geometry

(ffi/defcstruct ns-rect
  (x f64) (y f64) (width f64) (height f64))

(ffi/defcstruct ns-size
  (width f64) (height f64))

(ffi/defcstruct ns-point
  (x f64) (y f64))

(ffi/defcstruct ns-range
  (location u64) (length u64))

(defn rect
  "An NSRect argument: a map of :x, :y, :width and :height."
  [x y width height]
  {:x (f64 x) :y (f64 y) :width (f64 width) :height (f64 height)})

(defn rect-vec
  "An NSRect result as [x y width height]."
  [r]
  [(ffi/field r ns-rect :x) (ffi/field r ns-rect :y)
   (ffi/field r ns-rect :width) (ffi/field r ns-rect :height)])

(defn size-vec
  "An NSSize result as [width height]."
  [s]
  [(ffi/field s ns-size :width) (ffi/field s ns-size :height)])

;;; ------------------------------------------------------------------------------------
;;; The runtime

(ffi/defcfun %get-class "objc_getClass" ptr [name c-string])
(ffi/defcfun %sel "sel_registerName" ptr [name c-string])
(ffi/defcfun %allocate-class "objc_allocateClassPair" ptr [super ptr, name c-string, extra u64])
(ffi/defcfun %register-class "objc_registerClassPair" void [cls ptr])
(ffi/defcfun %add-method "class_addMethod" bool [cls ptr, sel ptr, imp ptr, types c-string])
(ffi/defcfun %pool-push "objc_autoreleasePoolPush" ptr [])
(ffi/defcfun %pool-pop "objc_autoreleasePoolPop" void [pool ptr])
(ffi/defcfun main-thread-np "pthread_main_np" i32 [])

(defn main-thread?
  "True on the process's main thread, where AppKit runs."
  []
  (= 1 (main-thread-np)))

(def ^:private classes (atom {}))
(def ^:private selectors (atom {}))

(defn cls
  "The Objective-C class named name."
  [name]
  (or (get @classes name)
      (let [c (%get-class name)]
        (when (ffi/null? c) (error "no Objective-C class named" name))
        (swap! classes assoc name c)
        c)))

(defn sel
  "The selector named name, such as \"setTitle:\"."
  [name]
  (or (get @selectors name)
      (let [s (%sel name)]
        (swap! selectors assoc name s)
        s)))

;;; objc_msgSend, once for each shape of call: send-<arguments>[-<result>], where the
;;; letters are p (an object or pointer), l (an integer), d (a double), b (a BOOL), s (a C
;;; string), r (an NSRect) and z (an NSSize); with no result named, an object.

(ffi/defcfun ^:blocking send "objc_msgSend" ptr [self ptr, sel ptr])
(ffi/defcfun ^:blocking send-void "objc_msgSend" void [self ptr, sel ptr])
(ffi/defcfun ^:blocking send-bool "objc_msgSend" bool [self ptr, sel ptr])
(ffi/defcfun ^:blocking send-long "objc_msgSend" i64 [self ptr, sel ptr])
(ffi/defcfun ^:blocking send-double "objc_msgSend" f64 [self ptr, sel ptr])
(ffi/defcfun ^:blocking send-cstr "objc_msgSend" c-string [self ptr, sel ptr])
(ffi/defcfun ^:blocking send-rect "objc_msgSend" ns-rect [self ptr, sel ptr])
(ffi/defcfun ^:blocking send-size "objc_msgSend" ns-size [self ptr, sel ptr])
(ffi/defcfun ^:blocking send-p "objc_msgSend" ptr [self ptr, sel ptr, a ptr])
(ffi/defcfun ^:blocking send-p-void "objc_msgSend" void [self ptr, sel ptr, a ptr])
(ffi/defcfun ^:blocking send-p-bool "objc_msgSend" bool [self ptr, sel ptr, a ptr])
(ffi/defcfun ^:blocking send-pp "objc_msgSend" ptr [self ptr, sel ptr, a ptr, b ptr])
(ffi/defcfun ^:blocking send-pp-void "objc_msgSend" void [self ptr, sel ptr, a ptr, b ptr])
(ffi/defcfun ^:blocking send-ppbp-void "objc_msgSend" void
  [self ptr, sel ptr, a ptr, b ptr, c bool, d ptr])
(ffi/defcfun ^:blocking send-l "objc_msgSend" ptr [self ptr, sel ptr, n i64])
(ffi/defcfun ^:blocking send-l-void "objc_msgSend" void [self ptr, sel ptr, n i64])
(ffi/defcfun ^:blocking send-d "objc_msgSend" ptr [self ptr, sel ptr, d f64])
(ffi/defcfun ^:blocking send-d-void "objc_msgSend" void [self ptr, sel ptr, d f64])
(ffi/defcfun ^:blocking send-b-void "objc_msgSend" void [self ptr, sel ptr, b bool])
(ffi/defcfun ^:blocking send-s "objc_msgSend" ptr [self ptr, sel ptr, s c-string])
(ffi/defcfun ^:blocking send-r "objc_msgSend" ptr [self ptr, sel ptr, r ns-rect])
(ffi/defcfun ^:blocking send-r-void "objc_msgSend" void [self ptr, sel ptr, r ns-rect])
(ffi/defcfun ^:blocking send-z-void "objc_msgSend" void [self ptr, sel ptr, z ns-size])
(ffi/defcfun ^:blocking send-rllb "objc_msgSend" ptr
  [self ptr, sel ptr, r ns-rect, style u64, backing u64, defer bool])
(ffi/defcfun ^:blocking send-event "objc_msgSend" ptr
  [self ptr, sel ptr, type u64, location ns-point, flags u64, time f64, window i64,
   context ptr, subtype i16, data1 i64, data2 i64])
(ffi/defcfun ^:blocking send-pb-void "objc_msgSend" void [self ptr, sel ptr, a ptr, b bool])
(ffi/defcfun ^:blocking send-p-long "objc_msgSend" i64 [self ptr, sel ptr, a ptr])
(ffi/defcfun ^:blocking send-pp-bool "objc_msgSend" bool [self ptr, sel ptr, a ptr, b ptr])
(ffi/defcfun ^:blocking send-ppp-void "objc_msgSend" void [self ptr, sel ptr, a ptr, b ptr, c ptr])
(ffi/defcfun ^:blocking send-pppp-void "objc_msgSend" void
  [self ptr, sel ptr, a ptr, b ptr, c ptr, d ptr])
(ffi/defcfun ^:blocking send-rb "objc_msgSend" ptr [self ptr, sel ptr, r ns-rect, b bool])
(ffi/defcfun ^:blocking send-z "objc_msgSend" ptr [self ptr, sel ptr, z ns-size])
(ffi/defcfun ^:blocking send-dddd "objc_msgSend" ptr
  [self ptr, sel ptr, a f64, b f64, c f64, d f64])
(ffi/defcfun ^:blocking send-dl-void "objc_msgSend" void [self ptr, sel ptr, d f64, n i64])
(ffi/defcfun ^:blocking send-point-void "objc_msgSend" void [self ptr, sel ptr, p ns-point])
(ffi/defcfun ^:blocking send-range "objc_msgSend" ns-range [self ptr, sel ptr])
(ffi/defcfun ^:blocking send-range-void "objc_msgSend" void [self ptr, sel ptr, r ns-range])
(ffi/defcfun ^:blocking send-range-p-void "objc_msgSend" void
  [self ptr, sel ptr, r ns-range, s ptr])
(ffi/defcfun ^:blocking send-bitmap "objc_msgSend" ptr
  [self ptr, sel ptr, planes ptr, width i64, height i64, bits i64, samples i64, alpha bool,
   planar bool, space ptr, row-bytes i64, pixel-bits i64])
(ffi/defcfun memcpy "memcpy" ptr [to ptr, from ptr, n u64])
(ffi/defcfun ^:blocking send-pb "objc_msgSend" ptr [self ptr, sel ptr, a ptr, b bool])
(ffi/defcfun ^:blocking send-pp-long "objc_msgSend" i64 [self ptr, sel ptr, a ptr, b ptr])
(ffi/defcfun ^:blocking send-ll "objc_msgSend" ptr [self ptr, sel ptr, a i64, b i64])
(ffi/defcfun ^:blocking send-pl "objc_msgSend" ptr [self ptr, sel ptr, a ptr, b i64])
(ffi/defcfun ^:blocking send-ppl "objc_msgSend" ptr [self ptr, sel ptr, a ptr, b ptr, n i64])
(ffi/defcfun ^:blocking send-pbp-void "objc_msgSend" void [self ptr, sel ptr, a ptr, b bool, c ptr])
(ffi/defcfun ^:blocking send-l-long "objc_msgSend" i64 [self ptr, sel ptr, n i64])
(ffi/defcfun ^:blocking send-point "objc_msgSend" ns-point [self ptr, sel ptr])
(ffi/defcfun ^:blocking send-point-p "objc_msgSend" ns-point [self ptr, sel ptr, p ns-point, a ptr])
(ffi/defcfun ^:blocking send-point-p-void "objc_msgSend" void
  [self ptr, sel ptr, p ns-point, a ptr])
(ffi/defcfun ^:blocking send-p-size "objc_msgSend" ns-size [self ptr, sel ptr, a ptr])
(ffi/defcfun ^:blocking send-rlpp "objc_msgSend" ptr
  [self ptr, sel ptr, r ns-rect, options u64, owner ptr, info ptr])
(ffi/defcfun ^:blocking send-rrldbp-void "objc_msgSend" void
  [self ptr, sel ptr, r ns-rect, from ns-rect, op u64, fraction f64, flipped bool, hints ptr])
(ffi/defcfun ^:blocking send-dd "objc_msgSend" ptr [self ptr, sel ptr, a f64, b f64])
(ffi/defcfun ^:blocking send-pd "objc_msgSend" ptr [self ptr, sel ptr, a ptr, d f64])
(ffi/defcfun sel-name "sel_getName" c-string [sel ptr])
(ffi/defcfun ^:blocking send-mouse-event "objc_msgSend" ptr
  [self ptr, sel ptr, type u64, location ns-point, flags u64, time f64, window i64,
   context ptr, number i64, clicks i64, pressure f32])
(ffi/defcfun ^:blocking send-rp-void "objc_msgSend" void [self ptr, sel ptr, r ns-rect, a ptr])
(ffi/defcfun ^:blocking send-ppp "objc_msgSend" ptr [self ptr, sel ptr, a ptr, b ptr, c ptr])
(ffi/defcfun ^:blocking send-ppp-bool "objc_msgSend" bool [self ptr, sel ptr, a ptr, b ptr, c ptr])
(ffi/defcfun ^:blocking send-ppointp-bool "objc_msgSend" bool
  [self ptr, sel ptr, item ptr, location ns-point, in ptr])
(ffi/defcfun ^:blocking send-dpppb "objc_msgSend" ptr
  [self ptr, sel ptr, interval f64, target ptr, selector ptr, info ptr, repeats bool])
(ffi/defcfun ^:blocking send-ppdp-void "objc_msgSend" void
  [self ptr, sel ptr, selector ptr, arg ptr, delay f64, modes ptr])
(ffi/defcfun ns-beep "NSBeep" void [])
(ffi/defcfun ^:blocking send-lp "objc_msgSend" ptr [self ptr, sel ptr, n u64, p ptr])
(ffi/defcfun ^:blocking send-pt "objc_msgSend" ptr [self ptr, sel ptr, p ns-point])
(ffi/defcfun ^:blocking send-plp-void "objc_msgSend" void [self ptr, sel ptr, a ptr, n i64, b ptr])
(ffi/defcfun ^:blocking send-l-double "objc_msgSend" f64 [self ptr, sel ptr, n i64])
(ffi/defcfun dlopen "dlopen" ptr [path ptr, mode i32])
(ffi/defcfun ^:blocking send-key-event "objc_msgSend" ptr
  [self ptr, sel ptr, type u64, location ns-point, flags u64, time f64, window i64,
   context ptr, chars ptr, plain ptr, repeat bool, code u16])
