  [self ptr, sel ptr, r ns-range, p ptr])
(ffi/defcfun ^:blocking send-r-rect "objc_msgSend" ns-rect [self ptr, sel ptr, r ns-rect])
(ffi/defcfun ^:blocking send-rp-rect "objc_msgSend" ns-rect [self ptr, sel ptr, r ns-rect, p ptr])
(ffi/defcfun ^:blocking send-rp "objc_msgSend" ptr [self ptr, sel ptr, r ns-rect, p ptr])
(ffi/defcfun ^:blocking send-range-lb-void "objc_msgSend" void
  [self ptr, sel ptr, r ns-range, n u64, b bool])
