(defn new-object
  "A new instance of the class named class-name: [[class alloc] init], owned (+1)."
  [class-name]
  (send (send (cls class-name) (sel "alloc")) (sel "init")))

(defn alloc
  "[class alloc], for an init method that takes arguments."
  [class-name]
  (send (cls class-name) (sel "alloc")))

(defn retain [o] (send o (sel "retain")))
(defn release [o] (send-void o (sel "release")))
(defn autorelease [o] (send o (sel "autorelease")))

(defn responds?
  "True if the object answers the selector named name."
  [o name]
  (send-p-bool o (sel "respondsToSelector:") (sel name)))

;;; ------------------------------------------------------------------------------------
;;; Strings

(defn ns-string
  "An autoreleased NSString of the Skein string s (nil for nil)."
  [s]
  (if (nil? s)
    (ffi/null)
    (send-s (cls "NSString") (sel "stringWithUTF8String:") (str s))))

(defn string-of
  "The Skein string of an NSString, or nil for a null one."
  [o]
  (when-not (ffi/null? o)
    (send-cstr o (sel "UTF8String"))))

;;; ------------------------------------------------------------------------------------
;;; Autorelease pools

(defn call-with-pool
  "f's value, called inside an autorelease pool."
  [f]
  (let [pool (%pool-push)]
    (try (f)
         (finally (%pool-pop pool)))))

;;; ------------------------------------------------------------------------------------
;;; Classes defined at run time, whose methods are Skein callbacks

(defn define-class!
  "Define the Objective-C class class-name, a subclass of the class super-name, with
methods [[selector-name imp type-encoding] ...]; imp is an ffi/defcallback. Returns the
class, or the existing one if it was defined already (by this program, earlier)."
  [class-name super-name methods]
  (let [existing (%get-class class-name)]
    (if-not (ffi/null? existing)
      existing
      (let [c (%allocate-class (cls super-name) class-name 0)]
        (doseq [[sel-name imp types] methods]
          (%add-method c (sel sel-name) imp types))
        (%register-class c)
        (swap! classes assoc class-name c)
        c))))

;;; ------------------------------------------------------------------------------------
;;; From native objects to Skein's

(def ^:private registry (atom {}))

(defn register!
  "Remember that the native object o stands for the Skein object x. Returns o."
  [o x]
  (swap! registry assoc (ffi/address o) x)
  o)

(defn unregister!
  "Forget the native object o."
  [o]
  (swap! registry dissoc (ffi/address o))
  nil)

(defn object-for
  "The Skein object the native object o stands for, or nil."
  [o]
  (when-not (ffi/null? o)
    (get @registry (ffi/address o))))
