(ffi/defcfun cg-set-line-dash "CGContextSetLineDash" void [c ptr, phase f64, lengths ptr, n u64])
(ffi/defcfun cg-save "CGContextSaveGState" void [c ptr])
(ffi/defcfun cg-restore "CGContextRestoreGState" void [c ptr])
(ffi/defcfun cg-translate "CGContextTranslateCTM" void [c ptr, x f64, y f64])
(ffi/defcfun cg-scale "CGContextScaleCTM" void [c ptr, x f64, y f64])
(ffi/defcfun cg-rotate "CGContextRotateCTM" void [c ptr, a f64])
(ffi/defcfun cg-clip-rect "CGContextClipToRect" void [c ptr, r ns-rect])
(ffi/defcfun cg-fill-rect "CGContextFillRect" void [c ptr, r ns-rect])
(ffi/defcfun cg-stroke-rect "CGContextStrokeRect" void [c ptr, r ns-rect])
(ffi/defcfun cg-fill-ellipse "CGContextFillEllipseInRect" void [c ptr, r ns-rect])
(ffi/defcfun cg-stroke-ellipse "CGContextStrokeEllipseInRect" void [c ptr, r ns-rect])
