;;; ------------------------------------------------------------------------------------
;;; From GTK objects to Skein's

(def ^:private registry (atom {}))

(defn register!
  "Remember that the GTK object o stands for the Skein object x. Returns o."
  [o x]
  (swap! registry assoc (ffi/address o) x)
  o)

(defn unregister! [o] (swap! registry dissoc (ffi/address o)) nil)

(defn object-for
  "The Skein object the GTK object o stands for, or nil."
  [o]
  (when-not (ffi/null? o) (get @registry (ffi/address o))))
