(ffi/defcfun ^:blocking widget-grab-focus "gtk_widget_grab_focus" bool [w ptr])

(ffi/defcstruct graphene-point (x f32) (y f32))
(ffi/defcstruct graphene-rect (x f32) (y f32) (width f32) (height f32))
(ffi/defcfun ^:blocking widget-compute-bounds "gtk_widget_compute_bounds" bool
  [w ptr, target ptr, out ptr])

(defn bounds-in
  "The GTK widget w's bounds in target's coordinates, [x y width height], or nil if GTK
hasn't placed it."
  [w target]
  (ffi/with-foreign [r (ffi/alloc graphene-rect)]
    (when (widget-compute-bounds w target r)
      [(ffi/field r graphene-rect :x) (ffi/field r graphene-rect :y)
       (ffi/field r graphene-rect :width) (ffi/field r graphene-rect :height)])))

(defn natural-size
  "The natural [width height] of the GTK widget w, measured without a size request."
  [w]
  (ffi/with-foreign [mn (ffi/alloc i32 1)]
    (ffi/with-foreign [nt (ffi/alloc i32 1)]
      (widget-set-size-request w -1 -1)
      (widget-measure w 0 -1 mn nt (ffi/null) (ffi/null))
      (let [width (ffi/get nt i32)]
        (widget-measure w 1 width mn nt (ffi/null) (ffi/null))
        [width (ffi/get nt i32)]))))

(defn position-in
  "Where the GTK widget w's top left is in target's coordinates, [x y], or nil if GTK
hasn't placed it."
  [w target]
  (ffi/with-foreign [p (ffi/alloc graphene-point)]
    (ffi/with-foreign [out (ffi/alloc graphene-point)]
      (when (widget-compute-point w target p out)
        [(ffi/field out graphene-point :x) (ffi/field out graphene-point :y)]))))

