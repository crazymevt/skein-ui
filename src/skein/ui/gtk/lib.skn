(defn owned-string
  "The Skein string of a C string GLib allocated (null for nil), freeing it."
  [p]
  (when-not (ffi/null? p)
    (let [s (ffi/c-string p)]
      (g-free p)
      s)))

(defn children-of
  "The GTK widget w's children, in order."
  [w]
  (loop [c (widget-get-first-child w) out []]
    (if (ffi/null? c) out (recur (widget-get-next-sibling c) (conj out c)))))

(defn widgets-under
  "w and every GTK widget inside it, depth first."
  [w]
  (tree-seq (fn [_] true) children-of w))

;;; ------------------------------------------------------------------------------------
;;; From GTK objects to Skein's

(def ^:private registry (atom {}))

(defn register!
  "Remember that the GTK object o stands for the Skein object x. Returns o."
  [o x]
  (swap! registry assoc (ffi/address o) x)
  o)

(defn unregister! [o] (swap! registry dissoc (ffi/address o)) nil)

(defn object-for
  "The Skein object the GTK object o stands for, or nil."
  [o]
  (when-not (ffi/null? o) (get @registry (ffi/address o))))

;;; ------------------------------------------------------------------------------------
;;; WebKitGTK 6.0, for web views: loaded the first time one is made (Linux only)

(def ^:private webkit-loaded (atom nil))

(defn load-webkit!
  "Load WebKitGTK 6.0 once. True if it loaded."
  []
  (when (nil? @webkit-loaded)
    (reset! webkit-loaded
            (try (ffi/load-library {:linux ["libwebkitgtk-6.0.so.4" "libwebkitgtk-6.0.so"]})
                 true
                 (catch error e false))))
  @webkit-loaded)

