(ns skein.ui.gtk.lib
  "The parts of GTK 4, GObject and GLib that the GTK backend calls (Skein's M2.14, D-097),
written by hand, and a registry from GTK objects back to Skein's.

Every call here runs on the main thread, where GTK was initialized; the backend sees to
it. The calls are marked ^:blocking: some run the main loop, and all run on the main
thread, which no fiber waits to share."
  (:require [skein.ffi :as ffi]))

;;; ------------------------------------------------------------------------------------
;;; Loading

(def ^:private loaded (atom nil))

(defn load!
  "Load GTK 4 once. True if it loaded (false if it isn't installed)."
  []
  (when (nil? @loaded)
    (reset! loaded
            (try (ffi/load-library {:macos "libgtk-4.1.dylib"
                                    :linux ["libgtk-4.so.1" "libgtk-4.so"]
                                    :windows "libgtk-4-1.dll"})
                 true
                 (catch error e false))))
  @loaded)

;;; ------------------------------------------------------------------------------------
;;; GLib and GObject

(ffi/defcfun ^:blocking g-object-ref-sink "g_object_ref_sink" ptr [o ptr])
(ffi/defcfun ^:blocking g-object-ref "g_object_ref" ptr [o ptr])
(ffi/defcfun ^:blocking g-object-unref "g_object_unref" void [o ptr])
(ffi/defcfun ^:blocking g-free "g_free" void [p ptr])
(ffi/defcfun ^:blocking g-signal-connect-data "g_signal_connect_data" u64
  [instance ptr, signal c-string, handler ptr, data ptr, destroy ptr, flags i32])
(ffi/defcfun ^:blocking g-signal-emit-by-name "g_signal_emit_by_name" void
  [instance ptr, signal c-string & end ptr])
(ffi/defcfun ^:blocking g-signal-handlers-block "g_signal_handlers_block_matched" u32
  [instance ptr, mask i32, id u32, detail u32, closure ptr, func ptr, data ptr])
(ffi/defcfun g-idle-add "g_idle_add" u32 [f ptr, data ptr])
(ffi/defcfun g-thread-self "g_thread_self" ptr [])
(ffi/defcfun ^:blocking g-timeout-add "g_timeout_add" u32 [interval u32, f ptr, data ptr])
(ffi/defcfun ^:blocking g-source-remove "g_source_remove" bool [id u32])
(ffi/defcfun ^:blocking g-main-context-iteration "g_main_context_iteration" bool
  [context ptr, may-block bool])
(ffi/defcfun ^:blocking g-main-context-pending "g_main_context_pending" bool [context ptr])
(ffi/defcfun g-main-context-wakeup "g_main_context_wakeup" void [context ptr])
(ffi/defcfun ^:blocking g-object-set-string "g_object_set" void
  [o ptr, name c-string & value c-string, end ptr])
(ffi/defcfun ^:blocking g-object-set-int "g_object_set" void
  [o ptr, name c-string & value i32, end ptr])
(ffi/defcfun ^:blocking g-object-set-double "g_object_set" void
  [o ptr, name c-string & value f64, end ptr])

(defn emit!
  "Emit the GObject signal named name (one with no arguments) on o, as GTK does when the
user acts."
  [o name]
  (g-signal-emit-by-name o name (ffi/null)))

(defn signal-data
  "A pointer whose address is the small integer n, for a signal handler's user data."
  [n]
  (ffi/ptr+ (ffi/null) n))

