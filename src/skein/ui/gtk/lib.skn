(ffi/defcstruct g-error (domain u32) (code i32) (message ptr))

(defn error-text
  "The message of a GError, or nil."
  [e]
  (when-not (ffi/null? e)
    (let [m (ffi/field e g-error :message)]
      (when-not (ffi/null? m) (ffi/c-string m)))))
