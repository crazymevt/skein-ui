(defn menu-model-labels
  "The labels of a GMenuModel's items."
  [m]
  (mapv (fn [i] (let [v (g-menu-model-attribute m i "label" (ffi/null))]
                  (when-not (ffi/null? v)
                    (let [s (g-variant-get-string v (ffi/null))]
                      (g-variant-unref v)
                      s))))
        (range (g-menu-model-n-items m))))

