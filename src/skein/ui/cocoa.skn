(ns skein.ui.cocoa
  "The Cocoa backend (Skein's M2.14, D-097): skein.ui's widgets as AppKit's own controls,
on macOS, through the Objective-C runtime (skein.ui.cocoa.objc).

  (ui/use-backend! (cocoa/backend))

AppKit runs on the main thread: -main runs there, and ui/run! runs the event loop there.
A call from another fiber is queued for the main thread, which the backend wakes from
the event loop to run it, while the fiber waits for its result.

Containers are flipped views, so layout's coordinates (from the top left) are AppKit's
too. For tests, click!, type-text!, press-return!, native-string and native-frame act on
and read the real controls."
  (:require [skein.ui :as ui]
            [skein.ui.cocoa.objc :as objc]
            [skein.ffi :as ffi]
            [skein.math :as math]
            [skein.io :as io]
            [skein.string :as string]
            [skein.system :as system]))

;;; ------------------------------------------------------------------------------------
;;; What each widget class implements here

(defgeneric make-native [w]
  "Make w's AppKit object, owned (+1), without its properties: the core sets them next.")

(defgeneric set-native [w property value]
  "Show value, w's new property, in its AppKit object. The default ignores the property.")

(defmethod set-native [w property value]
  nil)

(defgeneric native-action [w sender]
  "w's AppKit control sent its action (a click, Return): emit what the user did.")

(defmethod native-action [w sender]
  nil)

(defgeneric native-text-changed [w field]
  "The user edited the text of w's AppKit field.")

(defmethod native-text-changed [w field]
  nil)

(defgeneric native-selection-changed [w sender]
  "The user chose something in w's AppKit control: an item of a combo entry's list, a tab,
a divider position.")

(defmethod native-selection-changed [w sender]
  nil)

(defgeneric layout-subviews [w width height]
  "Place the AppKit views inside w's own, after it got the size width by height; for
widgets made of several views, such as a spin button.")

(defmethod layout-subviews [w width height]
  nil)

(defgeneric native-row-count [w]
  "How many rows w's table shows (a list box or table).")

(defgeneric native-cell-text [w row column]
  "The text w's table shows in row at column (indices).")

(defgeneric native-double-action [w sender]
  "The user double-clicked a row of w's table or outline view.")

(defgeneric native-cell-edited [w field]
  "The user finished editing the text field of a cell of w's table view.")

(defgeneric native-column-clicked [w column]
  "The user clicked the title of column, an NSTableColumn of w's table.")

(defgeneric native-outline [w op item arg]
  "Answer w's outline view about the item (a pointer, null for the roots): op is :count,
:child (arg is the index), :expandable? or :text (arg is the column index).")

(defgeneric native-expanded [w item expanded]
  "The user opened (expanded true) or closed the item (a pointer) in w's outline view.")

(defgeneric native-draw [w]
  "w's canvas view is drawing: emit :draw with a graphics context.")

(defgeneric native-input [w signal button event]
  "The user acted on w's canvas view: signal is the canvas's (:mouse-down, :key-up, ...),
button the mouse button, event the NSEvent.")

(defgeneric native-natural-size [w]
  "w's natural [width height]: by default its AppKit view's fitting size.")

(defgeneric container-view [o]
  "The NSView that o's children go in: by default its own.")

(defmethod container-view [o]
  (:native o))

(defn- view [o] (:native o))

;;; ------------------------------------------------------------------------------------
;;; Callbacks: the methods of our Objective-C classes

(ffi/defcallback drain-imp void [self ptr, cmd ptr, arg ptr]
  (drain-main-thread!))

(ffi/defcallback action-imp void [self ptr, cmd ptr, sender ptr]
  (when-let [w (objc/object-for sender)]
    (native-action w sender)))

(ffi/defcallback should-close-imp bool [self ptr, cmd ptr, window ptr]
  (when-let [w (objc/object-for window)]
    (ui/close! w))
  false)

(ffi/defcallback did-resize-imp void [self ptr, cmd ptr, note ptr]
  (let [window (objc/send note (objc/sel "object"))]
    (when-let [w (objc/object-for window)]
      (let [[_ _ width height] (objc/rect-vec
                                (objc/send-rect (objc/send window (objc/sel "contentView"))
                                                (objc/sel "frame")))
            width (int (math/round width))
            height (int (math/round height))]
        (when (not= [width height] [(:width w) (:height w)])
          (ui/dismiss-popups! w :dismissed nil)
          (ui/resized-by-user! w width height))
        (when-not (:state-transition w)
          (ui/state-changed-by-user! w (ui/backend-window-state (ui/current-backend) w)))))))

(defgeneric native-link-clicked [w units]
  "The user clicked a link of w's text view at units (UTF-16) into its text.")

(ffi/defcallback link-clicked-imp bool [self ptr, cmd ptr, tv ptr, link ptr, units u64]
  (if-let [w (objc/object-for tv)]
    (boolean (native-link-clicked w units))
    false))

(ffi/defcallback text-changed-imp void [self ptr, cmd ptr, note ptr]
  (let [field (objc/send note (objc/sel "object"))]
    (when-let [w (objc/object-for field)]
      (native-text-changed w field))))

(ffi/defcallback yes-imp bool [self ptr, cmd ptr]
  true)

(ffi/defcallback selection-imp void [self ptr, cmd ptr, note ptr]
  ;; A notification whose object is the control: a combo box's choice, a split view's
  ;; divider, a clip view's bounds (scrolling).
  (let [o (objc/send note (objc/sel "object"))]
    (when-let [w (objc/object-for o)]
      (native-selection-changed w o))))

(ffi/defcallback tab-selected-imp void [self ptr, cmd ptr, tab-view ptr, item ptr]
  (when-let [w (objc/object-for tab-view)]
    (native-selection-changed w item)))

;; Tables and outline views: their data source and delegate.

(ffi/defcallback row-count-imp i64 [self ptr, cmd ptr, tv ptr]
  (if-let [w (objc/object-for tv)] (native-row-count w) 0))

(defn- column-index
  "The index in :columns of the table view's column col: its identifier, which stays when
the user drags it to another place."
  [tv col]
  (parse-long (objc/string-of (objc/send col (objc/sel "identifier")))))

(ffi/defcallback cell-value-imp ptr [self ptr, cmd ptr, tv ptr, col ptr, row i64]
  (if-let [w (objc/object-for tv)]
    (objc/ns-string (native-cell-text w row (column-index tv col)))
    (ffi/null)))

(def ^:private cell-view
  "The NSTableCellView of a list's, table's or tree's cell (defined below).")

(ffi/defcallback table-view-imp ptr [self ptr, cmd ptr, tv ptr, col ptr, row i64]
  (if-let [w (objc/object-for tv)]
    (cell-view w tv col (column-index tv col) row)
    (ffi/null)))

(ffi/defcallback outline-view-imp ptr [self ptr, cmd ptr, ov ptr, col ptr, item ptr]
  (if-let [w (objc/object-for ov)]
    (cell-view w ov col (column-index ov col) item)
    (ffi/null)))

(ffi/defcallback double-action-imp void [self ptr, cmd ptr, sender ptr]
  (when-let [w (objc/object-for sender)]
    (native-double-action w sender)))

(ffi/defcallback cell-edited-imp void [self ptr, cmd ptr, field ptr]
  ;; The field's table view is the first view it is in that stands for a widget.
  (when-let [w (loop [v (objc/send field (objc/sel "superview"))]
                 (when-not (ffi/null? v)
                   (or (objc/object-for v) (recur (objc/send v (objc/sel "superview"))))))]
    (native-cell-edited w field)))

(ffi/defcallback column-clicked-imp void [self ptr, cmd ptr, tv ptr, col ptr]
  (when-let [w (objc/object-for tv)]
    (native-column-clicked w col)))

(ffi/defcallback outline-count-imp i64 [self ptr, cmd ptr, ov ptr, item ptr]
  (if-let [w (objc/object-for ov)] (native-outline w :count item nil) 0))

(ffi/defcallback outline-child-imp ptr [self ptr, cmd ptr, ov ptr, index i64, item ptr]
  (if-let [w (objc/object-for ov)] (native-outline w :child item index) (ffi/null)))

(ffi/defcallback outline-expandable-imp bool [self ptr, cmd ptr, ov ptr, item ptr]
  (if-let [w (objc/object-for ov)] (boolean (native-outline w :expandable? item nil)) false))

(ffi/defcallback outline-value-imp ptr [self ptr, cmd ptr, ov ptr, col ptr, item ptr]
  (if-let [w (objc/object-for ov)]
    (objc/ns-string (native-outline w :text item (column-index ov col)))
    (ffi/null)))

(ffi/defcallback draw-imp void [self ptr, cmd ptr, rect objc/ns-rect]
  (when-let [w (objc/object-for self)]
    (native-draw w)))

(ffi/defcallback accepts-focus-imp bool [self ptr, cmd ptr]
  (boolean (when-let [w (objc/object-for self)] (:focusable w))))

(def ^:private input-selectors
  "Each canvas input method's signal and mouse button."
  {"mouseDown:" [:mouse-down :left] "mouseUp:" [:mouse-up :left]
   "mouseDragged:" [:mouse-drag :left] "rightMouseDown:" [:mouse-down :right]
   "rightMouseUp:" [:mouse-up :right] "rightMouseDragged:" [:mouse-drag :right]
   "otherMouseDown:" [:mouse-down :middle] "otherMouseUp:" [:mouse-up :middle]
   "otherMouseDragged:" [:mouse-drag :middle] "mouseMoved:" [:mouse-move nil]
   "mouseEntered:" [:mouse-enter nil] "mouseExited:" [:mouse-leave nil]
   "scrollWheel:" [:scroll nil] "keyDown:" [:key-down nil] "keyUp:" [:key-up nil]})

(ffi/defcallback input-imp void [self ptr, cmd ptr, event ptr]
  (when-let [w (objc/object-for self)]
    (let [[signal button] (get input-selectors (objc/sel-name cmd))]
      (native-input w signal button event))))

(def ^:private install-menu-bar!
  "Make the window's menu bar the application's main menu (defined below).")

(def ^:private auto-answer!
  "Answer the modal dialog that is open, for tests (defined below).")

(ffi/defcallback key-window-imp void [self ptr, cmd ptr, note ptr]
  (when-let [w (objc/object-for (objc/send note (objc/sel "object")))]
    (install-menu-bar! w)
    (ui/activated-by-user! w true)))

(ffi/defcallback resign-key-imp void [self ptr, cmd ptr, note ptr]
  (when-let [w (objc/object-for (objc/send note (objc/sel "object")))]
    (ui/activated-by-user! w false)))

(def ^:private window-state-noticed!
  "A window's state notice from AppKit (defined below).")

(ffi/defcallback window-state-imp void [self ptr, cmd ptr, note ptr]
  (when-let [w (objc/object-for (objc/send note (objc/sel "object")))]
    (window-state-noticed! w (objc/sel-name cmd))))

(ffi/defcallback should-zoom-imp bool [self ptr, cmd ptr, window ptr, frame objc/ns-rect]
  (when-let [w (objc/object-for window)]
    (window-state-noticed! w "windowShouldZoom:toFrame:"))
  true)

(def ^:private window-moved!
  "Report a window the user moved (defined below).")

(ffi/defcallback did-move-imp void [self ptr, cmd ptr, note ptr]
  (when-let [w (objc/object-for (objc/send note (objc/sel "object")))]
    (window-moved! w)))

(def ^:private route-input!
  "Emit an NSEvent as the input signals of the widget it is for; true if a handler
consumed it (defined below).")

(ffi/defcallback appearance-imp void [self ptr, cmd ptr]
  ;; A window's content view sees the system switch between light and dark.
  (when (objc/responds? self "window")
    (let [win (objc/send self (objc/sel "window"))]
      (when (and (not (ffi/null? win))
                 (= (ffi/address self)
                    (ffi/address (objc/send win (objc/sel "contentView")))))
        (when-let [w (objc/object-for win)]
          (ui/notify-appearance-changed! w))))))

(def ^:private storage-edited!
  "A text storage of a buffer was edited (defined below).")

(ffi/defcallback storage-edited-imp void [self ptr, cmd ptr, storage ptr, actions u64,
                                          range objc/ns-range, delta i64]
  (storage-edited! storage actions (ffi/field range objc/ns-range :location)
                   (ffi/field range objc/ns-range :length) delta))

(def ^:private editing-view
  "The code view whose text view last asked to change its text."
  (atom nil))

(ffi/defcallback should-change-imp bool [self ptr, cmd ptr, tv ptr, range objc/ns-range, s ptr]
  (let [w (objc/object-for tv)]
    (when (instance? ui/code-view-widget w) (reset! editing-view w)))
  true)

(ffi/defcallback code-undo-imp void [self ptr, cmd ptr, sender ptr]
  (when-let [w (objc/object-for self)]
    (if (= "undo:" (objc/sel-name cmd)) (ui/undo! w) (ui/redo! w))))

(def ^:private code-mouse!
  "Emit the pointer's moves over a code view (defined below).")

(ffi/defcallback code-mouse-imp void [self ptr, cmd ptr, event ptr]
  (when-let [w (objc/object-for self)]
    (code-mouse! w (objc/sel-name cmd) event)))

(ffi/defcallback no-hit-imp ptr [self ptr, cmd ptr, p objc/ns-point]
  (ffi/null))

(def ^:private popover-closed!
  "A popover closed natively (defined below).")

(ffi/defcallback popover-closed-imp void [self ptr, cmd ptr, note ptr]
  (popover-closed! (objc/send note (objc/sel "object"))))

(def ^:private tab-mouse!
  "Handle a mouse event in a tab's button (defined below).")

(ffi/defcallback tab-mouse-imp void [self ptr, cmd ptr, event ptr]
  (tab-mouse! self (objc/sel-name cmd) event))

(ffi/defcallback monitor-imp ptr [block ptr, event ptr]
  (if (route-input! event) (ffi/null) event))

(ffi/defcallback menu-opening-imp void [self ptr, cmd ptr, menu ptr]
  (when-let [m (objc/object-for menu)]
    (ui/menu-opening! m)))

(ffi/defcallback timer-fired-imp void [self ptr, cmd ptr, timer ptr]
  (when-let [t (objc/object-for timer)]
    (when-not (:repeat t)
      ;; A one-shot NSTimer is done: forget it (the core drops its handle).
      (objc/unregister! timer)
      (objc/release timer))
    (ui/timer-fired! t)))

(ffi/defcallback quit-imp void [self ptr, cmd ptr, sender ptr]
  (ui/quit!))

(ffi/defcallback auto-answer-imp void [self ptr, cmd ptr, arg ptr]
  (auto-answer!))

(defn- note-item
  "The item an outline view notification is about."
  [note]
  (objc/send-p (objc/send note (objc/sel "userInfo")) (objc/sel "objectForKey:")
               (objc/ns-string "NSObject")))

(ffi/defcallback item-expanded-imp void [self ptr, cmd ptr, note ptr]
  (when-let [w (objc/object-for (objc/send note (objc/sel "object")))]
    (native-expanded w (note-item note) true)))

(ffi/defcallback item-collapsed-imp void [self ptr, cmd ptr, note ptr]
  (when-let [w (objc/object-for (objc/send note (objc/sel "object")))]
    (native-expanded w (note-item note) false)))

;;; ------------------------------------------------------------------------------------
;;; The backend, and running on the main thread

(defclass cocoa-backend [ui/backend]
  "The Cocoa backend."
  (app :init nil :doc "The NSApplication.")
  (waker :init nil :doc "The object whose drain: runs the main thread's queued work.")
  (target :init nil :doc "The target of every control's action.")
  (window-delegate :init nil)
  (text-delegate :init nil)
  (data-source :init nil :doc "The data source and delegate of tables and outline views.")
  (modes :init nil :doc "An NSArray of the run loop modes AppKit runs in."))

(defn- define-classes! []
  (objc/define-class! "SkeinWaker" "NSObject" [["drain:" drain-imp "v@:@"]])
  (objc/define-class! "SkeinTarget" "NSObject" [["action:" action-imp "v@:@"]
                                                ["doubleAction:" double-action-imp "v@:@"]
                                                ["cellEdited:" cell-edited-imp "v@:@"]
                                                ["timerFired:" timer-fired-imp "v@:@"]
                                                ["quitAction:" quit-imp "v@:@"]
                                                ["autoAnswer:" auto-answer-imp "v@:@"]])
  (objc/define-class! "SkeinDataSource" "NSObject"
                      [["numberOfRowsInTableView:" row-count-imp "q@:@"]
                       ["tableView:objectValueForTableColumn:row:" cell-value-imp "@@:@@q"]
                       ["tableViewSelectionDidChange:" selection-imp "v@:@"]
                       ["tableView:didClickTableColumn:" column-clicked-imp "v@:@@"]
                       ["outlineView:numberOfChildrenOfItem:" outline-count-imp "q@:@@"]
                       ["outlineView:child:ofItem:" outline-child-imp "@@:@q@"]
                       ["outlineView:isItemExpandable:" outline-expandable-imp "B@:@@"]
                       ["outlineView:objectValueForTableColumn:byItem:" outline-value-imp
                        "@@:@@@"]
                       ["tableView:viewForTableColumn:row:" table-view-imp "@@:@@q"]
                       ["outlineView:viewForTableColumn:item:" outline-view-imp "@@:@@@"]
                       ["outlineViewSelectionDidChange:" selection-imp "v@:@"]
                       ["outlineViewItemDidExpand:" item-expanded-imp "v@:@"]
                       ["outlineViewItemDidCollapse:" item-collapsed-imp "v@:@"]])
  (objc/define-class! "SkeinWindowDelegate" "NSObject"
                      [["windowShouldClose:" should-close-imp "B@:@"]
                       ["windowDidResize:" did-resize-imp "v@:@"]
                       ["windowDidBecomeKey:" key-window-imp "v@:@"]
                       ["windowDidResignKey:" resign-key-imp "v@:@"]
                       ["windowDidMove:" did-move-imp "v@:@"]
                       ["windowDidMiniaturize:" window-state-imp "v@:@"]
                       ["windowDidDeminiaturize:" window-state-imp "v@:@"]
                       ["windowWillEnterFullScreen:" window-state-imp "v@:@"]
                       ["windowDidEnterFullScreen:" window-state-imp "v@:@"]
                       ["windowWillExitFullScreen:" window-state-imp "v@:@"]
                       ["windowDidExitFullScreen:" window-state-imp "v@:@"]
                       ["windowShouldZoom:toFrame:" should-zoom-imp
                        "B@:@{CGRect={CGPoint=dd}{CGSize=dd}}"]])
  (objc/define-class! "SkeinTextDelegate" "NSObject"
                      [["controlTextDidChange:" text-changed-imp "v@:@"]
                       ["textView:clickedOnLink:atIndex:" link-clicked-imp "B@:@@Q"]
                       ["textDidChange:" text-changed-imp "v@:@"]
                       ["comboBoxSelectionDidChange:" selection-imp "v@:@"]
                       ["splitViewDidResizeSubviews:" selection-imp "v@:@"]
                       ["boundsDidChange:" selection-imp "v@:@"]
                       ["tabView:didSelectTabViewItem:" tab-selected-imp "v@:@@"]
                       ["menuNeedsUpdate:" menu-opening-imp "v@:@"]
                       ["popoverDidClose:" popover-closed-imp "v@:@"]
                       ["textViewDidChangeSelection:" selection-imp "v@:@"]
                       ["textView:shouldChangeTextInRange:replacementString:" should-change-imp
                        "B@:@{_NSRange=QQ}@"]
                       ["textStorage:didProcessEditing:range:changeInLength:" storage-edited-imp
                        "v@:@Q{_NSRange=QQ}q"]])
  (objc/define-class! "SkeinCodeTextView" "NSTextView"
                      [["undo:" code-undo-imp "v@:@"] ["redo:" code-undo-imp "v@:@"]])
  (objc/define-class! "SkeinTracker" "NSObject"
                      [["mouseMoved:" code-mouse-imp "v@:@"] ["mouseEntered:" code-mouse-imp "v@:@"]
                       ["mouseExited:" code-mouse-imp "v@:@"]])
  (objc/define-class! "SkeinGutterView" "NSView"
                      [["isFlipped" yes-imp "B@:"]
                       ["drawRect:" draw-imp "v@:{CGRect={CGPoint=dd}{CGSize=dd}}"]])
  (objc/define-class! "SkeinPassiveLabel" "NSTextField"
                      [["hitTest:" no-hit-imp "@@:{CGPoint=dd}"]])
  (objc/define-class! "SkeinFlippedView" "NSView"
                      [["isFlipped" yes-imp "B@:"]
                       ["viewDidChangeEffectiveAppearance" appearance-imp "v@:"]])
  ;; A tab: an NSButton that selects on mouse down and drags, rather than tracking.
  (objc/define-class! "SkeinTabButton" "NSButton"
                      (mapv (fn [name] [name tab-mouse-imp "v@:@"])
                            ["mouseDown:" "mouseDragged:" "mouseUp:" "rightMouseDown:"
                             "otherMouseDown:"]))
  (objc/define-class! "SkeinCanvasView" "NSView"
                      (into [["isFlipped" yes-imp "B@:"]
                             ["drawRect:" draw-imp "v@:{CGRect={CGPoint=dd}{CGSize=dd}}"]
                             ["acceptsFirstResponder" accepts-focus-imp "B@:"]]
                            (map (fn [name] [name input-imp "v@:@"]) (keys input-selectors)))))

(defn backend
  "A new Cocoa backend. Make it on the main thread (in -main, or a test)."
  []
  (when-not (= :macos (system/os))
    (error "the Cocoa backend runs only on macOS"))
  (objc/load-frameworks!)
  (objc/call-with-pool
   (fn []
     (let [app (objc/send (objc/cls "NSApplication") (objc/sel "sharedApplication"))
           ;; The modes by name: CoreFoundation knows kCFRunLoopCommonModes only as its own
           ;; constant (by address), so a string of that name would be a mode of its own.
           modes (reduce (fn [a mode]
                           (objc/send-p a (objc/sel "arrayByAddingObject:") (objc/ns-string mode)))
                         (objc/send (objc/cls "NSArray") (objc/sel "array"))
                         ["kCFRunLoopDefaultMode" "NSModalPanelRunLoopMode"
                          "NSEventTrackingRunLoopMode"])]
       (objc/send-l-void app (objc/sel "setActivationPolicy:") 0)
       (define-classes!)
       ;; Every key and mouse event goes by route-input! before AppKit gives it to a
       ;; control, so handlers can see and consume! it.
       (objc/retain (objc/send-lp (objc/cls "NSEvent")
                                  (objc/sel "addLocalMonitorForEventsMatchingMask:handler:")
                                  (reduce + 0 (map (fn [t] (bit-shift-left 1 t))
                                                   [1 2 3 4 10 11 25 26]))
                                  (objc/global-block monitor-imp)))
       (make cocoa-backend :app app :modes (objc/retain modes)
             :waker (objc/new-object "SkeinWaker")
             :target (objc/new-object "SkeinTarget")
             :window-delegate (objc/new-object "SkeinWindowDelegate")
             :text-delegate (objc/new-object "SkeinTextDelegate")
             :data-source (objc/new-object "SkeinDataSource"))))))

(defn- wake-main-thread!
  "Make the event loop run the work queued for the main thread soon, also while a menu is
open, a modal dialog runs or the user drags."
  [b]
  (objc/send-ppbp-void (:waker b)
                       (objc/sel "performSelectorOnMainThread:withObject:waitUntilDone:modes:")
                       (objc/sel "drain:") (ffi/null) false (:modes b)))

(defmethod ui/backend-in-ui-thread [(b cocoa-backend) f]
  (if (objc/main-thread?)
    (objc/call-with-pool f)
    (let [t (spawn-pinned :main (objc/call-with-pool f))]
      (wake-main-thread! b)
      @t)))

(defmethod ui/backend-call-later [(b cocoa-backend) f]
  (spawn-pinned :main (objc/call-with-pool f))
  (wake-main-thread! b)
  nil)

(defmethod ui/backend-run-loop [(b cocoa-backend)]
  (objc/call-with-pool
   (fn []
     (objc/send-b-void (:app b) (objc/sel "activateIgnoringOtherApps:") true)
     (objc/send-void (:app b) (objc/sel "run")))))

(defmethod ui/backend-quit-loop [(b cocoa-backend)]
  (ui/backend-in-ui-thread
   b
   (fn []
     (objc/send-p-void (:app b) (objc/sel "stop:") (ffi/null))
     ;; stop: takes effect after the next event, so post one.
     (let [e (objc/send-event
              (objc/cls "NSEvent")
              (objc/sel (str "otherEventWithType:location:modifierFlags:timestamp:"
                             "windowNumber:context:subtype:data1:data2:"))
              15 {:x 0.0 :y 0.0} 0 0.0 0 (ffi/null) 0 0 0)]
       (objc/send-pb-void (:app b) (objc/sel "postEvent:atStart:") e true)))))

;;; ------------------------------------------------------------------------------------
;;; Objects, properties and layout

(defmethod ui/backend-realize [(b cocoa-backend) o]
  (objc/register! (make-native o) o))

(defmethod ui/backend-destroy [(b cocoa-backend) o]
  (let [n (view o)]
    (cond (instance? ui/window-widget o) (objc/send-void n (objc/sel "close"))
          (instance? ui/widget o) (objc/send-void n (objc/sel "removeFromSuperview")))
    (objc/unregister! n)
    (objc/release n)))

(defmethod ui/backend-set-property [(b cocoa-backend) o property value]
  (set-native o property value))

(defmethod ui/backend-get-property [(b cocoa-backend) o property]
  (slot o property))

(defmethod ui/backend-add-child [(b cocoa-backend) parent child]
  (objc/send-p-void (container-view parent) (objc/sel "addSubview:") (view child)))

(defmethod ui/backend-remove-child [(b cocoa-backend) parent child]
  (objc/send-void (view child) (objc/sel "removeFromSuperview")))

(defmethod native-natural-size [w]
  (let [[width height] (objc/size-vec (objc/send-size (view w) (objc/sel "fittingSize")))]
    [(int (math/ceil width)) (int (math/ceil height))]))

(defmethod ui/backend-natural-size [(b cocoa-backend) w]
  (native-natural-size w))

(defmethod ui/backend-set-bounds [(b cocoa-backend) w x y width height]
  (objc/send-r-void (view w) (objc/sel "setFrame:") (objc/rect x y width height))
  (layout-subviews w width height))

(defn- flipped-view []
  (objc/send-r (objc/alloc "SkeinFlippedView") (objc/sel "initWithFrame:") (objc/rect 0 0 0 0)))

(defn- set-string! [o selector s]
  (objc/send-p-void (view o) (objc/sel selector) (objc/ns-string (str (or s "")))))

(defn- set-bool! [o selector v]
  (objc/send-b-void (view o) (objc/sel selector) (boolean v)))

(defn- set-long! [o selector v]
  (objc/send-l-void (view o) (objc/sel selector) v))

(defn- connect-action!
  "Make the control send its action to the backend's target. Returns it."
  [n]
  (objc/send-p-void n (objc/sel "setTarget:") (:target (ui/current-backend)))
  (objc/send-p-void n (objc/sel "setAction:") (objc/sel "action:"))
  n)

(defn- init-frame
  "[[class-name alloc] initWithFrame:NSZeroRect]."
  [class-name]
  (objc/send-r (objc/alloc class-name) (objc/sel "initWithFrame:") (objc/rect 0 0 0 0)))

(defmethod set-native [(w ui/widget) (p (= :visible)) v]
  (set-bool! w "setHidden:" (not v)))

(defmethod set-native [(w ui/widget) (p (= :enabled)) v]
  (when (objc/responds? (view w) "setEnabled:")
    (set-bool! w "setEnabled:" v)))

(defmethod set-native [(w ui/widget) (p (= :tooltip)) v]
  (objc/send-p-void (view w) (objc/sel "setToolTip:") (objc/ns-string v)))

(defn- text-alignment
  "AppKit's NSTextAlignment for :left, :center or :right. Apple silicon Macs number them
as iOS does; Intel Macs put right before center."
  [a]
  (let [ios (= :aarch64 (system/arch))]
    (case a
      :center (if ios 1 2)
      :right (if ios 2 1)
      0)))

;;; ------------------------------------------------------------------------------------
;;; Windows

(defmethod make-native [(w ui/window-widget)]
  (let [b (ui/current-backend)
        win (objc/send-rllb (objc/alloc "NSWindow")
                            (objc/sel "initWithContentRect:styleMask:backing:defer:")
                            (objc/rect 0 0 400 300) 15 2 false)
        content (flipped-view)]
    (objc/send-b-void win (objc/sel "setReleasedWhenClosed:") false)
    (objc/send-p-void win (objc/sel "setContentView:") content)
    (objc/release content)
    (objc/send-p-void win (objc/sel "setDelegate:") (:window-delegate b))
    win))

(defmethod container-view [(w ui/window-widget)]
  (objc/send (view w) (objc/sel "contentView")))

(defmethod set-native [(w ui/window-widget) (p (= :title)) v]
  (set-string! w "setTitle:" v))

(defn- set-content-size! [w]
  (when (and (:width w) (:height w))
    (objc/send-z-void (view w) (objc/sel "setContentSize:")
                      {:width (f64 (:width w)) :height (f64 (:height w))})))

(defmethod set-native [(w ui/window-widget) (p (= :width)) v]
  (set-content-size! w))

(defmethod set-native [(w ui/window-widget) (p (= :height)) v]
  (set-content-size! w))

(defmethod ui/backend-show [(b cocoa-backend) w]
  (objc/send-p-void (view w) (objc/sel "makeKeyAndOrderFront:") (ffi/null)))

(defmethod ui/backend-center-window [(b cocoa-backend) w]
  (objc/send-void (view w) (objc/sel "center")))

(defmethod ui/backend-close [(b cocoa-backend) w]
  (objc/send-p-void (view w) (objc/sel "orderOut:") (ffi/null)))

;;; ------------------------------------------------------------------------------------
;;; Containers: flipped views, so children are placed from the top left

(defmethod make-native [(w ui/box-widget)] (flipped-view))
(defmethod make-native [(w ui/grid-widget)] (flipped-view))
(defmethod make-native [(w ui/spacer-widget)] (flipped-view))

(defmethod make-native [(s ui/separator-widget)]
  (let [n (init-frame "NSBox")]
    (objc/send-l-void n (objc/sel "setBoxType:") 2)
    n))

(defmethod native-natural-size [(s ui/separator-widget)]
  (if (= :vertical (:orientation s)) [1 0] [0 1]))

;;; ------------------------------------------------------------------------------------
;;; Labels, buttons and entries

(defmethod make-native [(l ui/label-widget)]
  (objc/retain (objc/send-p (objc/cls "NSTextField") (objc/sel "labelWithString:")
                            (objc/ns-string ""))))

(defmethod set-native [(l ui/label-widget) (p (= :text)) v]
  (set-string! l "setStringValue:" v))

(defmethod set-native [(l ui/label-widget) (p (= :alignment)) v]
  (set-long! l "setAlignment:" (text-alignment v)))

(defmethod set-native [(l ui/label-widget) (p (= :selectable)) v]
  (set-bool! l "setSelectable:" v))

(defmethod set-native [(l ui/label-widget) (p (= :wrap)) v]
  ;; NSLineBreakByWordWrapping is 0, NSLineBreakByTruncatingTail 4.
  (set-long! l "setLineBreakMode:" (if v 0 4))
  (set-long! l "setMaximumNumberOfLines:" (if v 0 1)))

(defmethod native-natural-size [(l ui/label-widget)]
  (if (and (:wrap l) (:width l))
    (do (objc/send-d-void (view l) (objc/sel "setPreferredMaxLayoutWidth:") (f64 (:width l)))
        (call-next-method))
    (call-next-method)))

(defmethod make-native [(b ui/button-widget)]
  (let [n (init-frame "NSButton")]
    (objc/send-l-void n (objc/sel "setButtonType:") 7)   ; NSButtonTypeMomentaryPushIn
    (objc/send-l-void n (objc/sel "setBezelStyle:") 1)   ; NSBezelStyleRounded
    (connect-action! n)))

(defmethod set-native [(b ui/button-widget) (p (= :label)) v]
  (set-string! b "setTitle:" v))

(defmethod set-native [(b ui/button-widget) (p (= :default)) v]
  (when (or v (not (:cancel b)))
    (set-string! b "setKeyEquivalent:" (if v "\r" ""))))

(defmethod set-native [(b ui/button-widget) (p (= :cancel)) v]
  (when (or v (not (:default b)))
    (set-string! b "setKeyEquivalent:" (if v "\u001b" ""))))

(defmethod set-native [(b ui/button-widget) (p (= :style)) v]
  (set-bool! b "setBordered:" (= v :push)))

(defmethod native-action [(b ui/button-widget) sender]
  (ui/emit! b (ui/event-for b :clicked)))

(defn- make-field [class-name]
  (let [n (init-frame class-name)]
    (objc/send-p-void n (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
    (connect-action! n)))

(defmethod make-native [(e ui/entry-widget)] (make-field "NSTextField"))
(defmethod make-native [(e ui/password-entry-widget)] (make-field "NSSecureTextField"))

(defmethod make-native [(e ui/search-entry-widget)]
  (let [n (make-field "NSSearchField")]
    ;; Send the action on Return only, not as the user types.
    (objc/send-b-void n (objc/sel "setSendsWholeSearchString:") true)
    n))

(defmethod set-native [(e ui/entry-widget) (p (= :text)) v]
  (set-string! e "setStringValue:" v))

(defmethod set-native [(e ui/entry-widget) (p (= :placeholder)) v]
  (objc/send-p-void (view e) (objc/sel "setPlaceholderString:") (objc/ns-string v)))

(defmethod set-native [(e ui/entry-widget) (p (= :editable)) v]
  (set-bool! e "setEditable:" v))

(defmethod set-native [(e ui/entry-widget) (p (= :alignment)) v]
  (set-long! e "setAlignment:" (text-alignment v)))

(defmethod native-natural-size [(e ui/entry-widget)]
  (let [[_ height] (call-next-method)]
    [(+ 10 (* 7 (:width-chars e))) height]))

(defmethod native-text-changed [(e ui/entry-widget) field]
  (ui/changed-by-user! e :text (objc/string-of (objc/send field (objc/sel "stringValue")))))

(defmethod native-action [(e ui/entry-widget) sender]
  (ui/emit! e (ui/event-for e :activate)))

;;; ------------------------------------------------------------------------------------
;;; Helpers for the controls below

(def ^:private quiet-depth
  "Above 0 while the backend changes a control itself, so the delegate's notification of
the change isn't taken for the user's."
  (atom 0))

(defn- quiet? [] (pos? @quiet-depth))

(defn- quietly [f]
  (swap! quiet-depth inc)
  (try (f) (finally (swap! quiet-depth dec))))

(defn- also-register!
  "Register the AppKit object o, part of w, as standing for w too. Returns o."
  [o w]
  (objc/register! o w))

(defn- set-double! [o selector v]
  (objc/send-d-void (view o) (objc/sel selector) (f64 (or v 0))))

(defn- double-of [n selector]
  (objc/send-double n (objc/sel selector)))

(defn- whole
  "x as an integer if it is a whole number, so a slider at 7.0 says 7."
  [x]
  (if (= x (math/floor x)) (int x) x))

(def ^:private color-selectors
  {:text "labelColor" :secondary-text "secondaryLabelColor" :disabled-text "tertiaryLabelColor"
   :background "textBackgroundColor" :control-background "controlBackgroundColor"
   :window-background "windowBackgroundColor" :selection "selectedContentBackgroundColor"
   :accent "controlAccentColor" :separator "separatorColor" :link "linkColor"
   :grid "gridColor" :system-red "systemRedColor" :system-orange "systemOrangeColor"
   :system-yellow "systemYellowColor" :system-green "systemGreenColor"
   :system-mint "systemMintColor" :system-teal "systemTealColor"
   :system-cyan "systemCyanColor" :system-blue "systemBlueColor"
   :system-indigo "systemIndigoColor" :system-purple "systemPurpleColor"
   :system-pink "systemPinkColor" :system-brown "systemBrownColor"
   :system-gray "systemGrayColor"
   ;; Surfaces are drawn with materials; as plain colors they are the nearest ones, as on GTK.
   :sidebar-background "windowBackgroundColor" :content-background "textBackgroundColor"
   :status-background "windowBackgroundColor" :toolbar-background "windowBackgroundColor"
   :activity-background "windowBackgroundColor" :popover-background "windowBackgroundColor"})

(defn ns-color
  "An autoreleased NSColor for the color designator d (nil for nil): a system color
keyword gives the platform's own, which follows dark mode."
  [d]
  (let [c (ui/ensure-color d)]
    (cond (nil? c) (ffi/null)
          (keyword? c) (objc/send (objc/cls "NSColor") (objc/sel (get color-selectors c)))
          ;; still dynamic: it follows dark mode as its system color does
          (ui/system-tint? c) (objc/send-d (ns-color (first c)) (objc/sel "colorWithAlphaComponent:")
                                           (f64 (second c)))
          :else (objc/send-dddd (objc/cls "NSColor")
                                (objc/sel "colorWithSRGBRed:green:blue:alpha:")
                                (f64 (ui/color-red c)) (f64 (ui/color-green c))
                                (f64 (ui/color-blue c)) (f64 (ui/color-alpha c))))))

(defn color-of
  "The skein.ui color of an NSColor, in sRGB."
  [nc]
  (let [c (objc/send-p nc (objc/sel "colorUsingColorSpace:")
                       (objc/send (objc/cls "NSColorSpace") (objc/sel "sRGBColorSpace")))]
    (ui/rgb (double-of c "redComponent") (double-of c "greenComponent")
            (double-of c "blueComponent") (double-of c "alphaComponent"))))

;;; ------------------------------------------------------------------------------------
;;; Images

(def ^:private native-images
  "image (by identity) -> its NSImage, made once and kept: images don't change."
  (atom {}))

(defn- image-from-data
  "A new NSImage of the bytes of an image file, or null."
  [bytes]
  (let [data (ffi/pin [p bytes]
               (objc/send-pl (objc/cls "NSData") (objc/sel "dataWithBytes:length:") p (count bytes)))]
    (objc/send-p (objc/alloc "NSImage") (objc/sel "initWithData:") data)))

(defn- system-ns-image
  "A new reference to the SF Symbol or named image called name, or null."
  [name]
  (let [n (objc/send-pp (objc/cls "NSImage") (objc/sel "imageWithSystemSymbolName:accessibilityDescription:")
                        (objc/ns-string name) (ffi/null))
        n (if (ffi/null? n) (objc/send-p (objc/cls "NSImage") (objc/sel "imageNamed:") (objc/ns-string name)) n)]
    (if (ffi/null? n) n (objc/retain n))))

(def ^:private text-attributes
  "An NSDictionary of a font and color for drawing text (defined below).")

(def ^:private with-app-appearance
  "Call f with the application's appearance current (defined below).")

(defn- glyph-ns-image
  "A new NSImage of a glyph image's text, centered."
  [{:keys [text font color size template]}]
  (let [render (fn []
                 (let [img (objc/send-z (objc/alloc "NSImage") (objc/sel "initWithSize:")
                                        {:width (f64 size) :height (f64 size)})
                       s (objc/autorelease
                          (objc/send-pp (objc/alloc "NSAttributedString") (objc/sel "initWithString:attributes:")
                                        (objc/ns-string text)
                                        (text-attributes font (if template (ui/rgb 0 0 0) color))))
                       [w h] (objc/size-vec (objc/send-size s (objc/sel "size")))]
                   (objc/send-void img (objc/sel "lockFocus"))
                   (try (objc/send-point-void s (objc/sel "drawAtPoint:")
                                              {:x (f64 (/ (- size w) 2)) :y (f64 (/ (- size h) 2))})
                        (finally (objc/send-void img (objc/sel "unlockFocus"))))
                   (objc/send-b-void img (objc/sel "setTemplate:") (boolean template))
                   img))]
    ;; A system color is drawn as it is in the application's appearance.
    (if (and (keyword? color) (not template)) (with-app-appearance render) (render))))

(defn ns-image
  "The NSImage of a skein.ui image, or null for nil."
  [image]
  (cond
    (nil? image) (ffi/null)
    (get @native-images image) (get @native-images image)
    :else
    (let [_ (ui/check-image image)
          n (cond
              (:path image) (objc/send-p (objc/alloc "NSImage") (objc/sel "initWithContentsOfFile:")
                                         (objc/ns-string (:path image)))
              (:data image) (image-from-data (:data image))
              (:system image) (system-ns-image (:system image))
              (:glyph image) (glyph-ns-image (:glyph image))
              :else
              (let [w (:width image) h (:height image)
                    rep (objc/send-bitmap
                         (objc/alloc "NSBitmapImageRep")
                         (objc/sel (str "initWithBitmapDataPlanes:pixelsWide:pixelsHigh:"
                                        "bitsPerSample:samplesPerPixel:hasAlpha:isPlanar:"
                                        "colorSpaceName:bytesPerRow:bitsPerPixel:"))
                         (ffi/null) w h 8 4 true false (objc/ns-string "NSDeviceRGBColorSpace")
                         (* 4 w) 32)
                    img (objc/send-z (objc/alloc "NSImage") (objc/sel "initWithSize:")
                                     {:width (f64 w) :height (f64 h)})]
                (ffi/pin [p (:pixels image)]
                  (objc/memcpy (objc/send rep (objc/sel "bitmapData")) p (* 4 w h)))
                (objc/send-p-void img (objc/sel "addRepresentation:") rep)
                (objc/release rep)
                img))]
      (when (ffi/null? n) (error "AppKit can't read the image" (pr-str (or (:path image) (:system image)))))
      (swap! native-images assoc image n)
      n)))

(defmethod ui/backend-image-data-size [(b cocoa-backend) bytes]
  (let [n (image-from-data bytes)]
    (when (ffi/null? n) (error "macOS can't read the image data"))
    (let [[w h] (objc/size-vec (objc/send-size n (objc/sel "size")))]
      (objc/release n)
      [(int (math/round w)) (int (math/round h))])))

(defmethod ui/backend-system-image-size [(b cocoa-backend) name]
  (let [n (system-ns-image name)]
    (when-not (ffi/null? n)
      (let [[w h] (objc/size-vec (objc/send-size n (objc/sel "size")))]
        (objc/release n)
        [(int (math/round w)) (int (math/round h))]))))

(defmethod ui/backend-free-image [(b cocoa-backend) image]
  (when-let [n (get @native-images image)]
    (swap! native-images dissoc image)
    (objc/release n)))

(defmethod ui/backend-font-families [(b cocoa-backend)]
  (objc/call-with-pool
   (fn []
     (let [names (objc/send (objc/send (objc/cls "NSFontManager") (objc/sel "sharedFontManager"))
                            (objc/sel "availableFontFamilies"))]
       (mapv (fn [i] (objc/string-of (objc/send-l names (objc/sel "objectAtIndex:") i)))
             (range (objc/send-long names (objc/sel "count"))))))))

(defmethod ui/backend-register-font-file [(b cocoa-backend) path]
  (let [url (objc/send-p (objc/cls "NSURL") (objc/sel "fileURLWithPath:") (objc/ns-string path))]
    (ffi/with-foreign [err (ffi/alloc ptr 1)]
      (ffi/put! err ptr (ffi/null) 0)
      ;; kCTFontManagerScopeProcess 1
      (when-not (objc/ct-register-fonts-for-url url 1 err)
        (let [e (ffi/get err ptr)
              code (when-not (ffi/null? e) (objc/cf-error-get-code e))]
          (when-not (ffi/null? e) (objc/cf-release e))
          ;; 105: registered already, perhaps by another toolkit in this process
          (when-not (= code 105)
            (error "macOS can't register the font file" (pr-str path))))))))

(defmethod ui/backend-image-size [(b cocoa-backend) path]
  (let [n (objc/send-p (objc/alloc "NSImage") (objc/sel "initWithContentsOfFile:")
                       (objc/ns-string path))]
    (when (ffi/null? n) (error "AppKit can't read the image" (pr-str path)))
    (let [[w h] (objc/size-vec (objc/send-size n (objc/sel "size")))]
      (objc/release n)
      [(int (math/round w)) (int (math/round h))])))

(defmethod make-native [(v ui/image-view-widget)] (init-frame "NSImageView"))

(defmethod set-native [(v ui/image-view-widget) (p (= :image)) image]
  (objc/send-p-void (view v) (objc/sel "setImage:") (ns-image image)))

(defmethod set-native [(v ui/image-view-widget) (p (= :scaling)) s]
  ;; NSImageScaleProportionallyDown 0, AxesIndependently 1, None 2
  (set-long! v "setImageScaling:" (case s :fill 1 :none 2 0)))

(defmethod native-natural-size [(v ui/image-view-widget)]
  (if-let [i (:image v)] [(:width i) (:height i)] [0 0]))

(defmethod set-native [(b ui/button-widget) (p (= :image)) image]
  (objc/send-p-void (view b) (objc/sel "setImage:") (ns-image image))
  ;; NSNoImage 0, NSImageOnly 1, NSImageLeft 2
  (set-long! b "setImagePosition:" (cond (nil? image) 0 (= :icon (:style b)) 1 :else 2)))

;;; ------------------------------------------------------------------------------------
;;; Toggles, check boxes and radio buttons

(defn- make-toggle [button-type]
  (let [n (init-frame "NSButton")]
    (objc/send-l-void n (objc/sel "setButtonType:") button-type)
    (when (= button-type 1) (objc/send-l-void n (objc/sel "setBezelStyle:") 1))
    (connect-action! n)))

(defmethod make-native [(t ui/toggle-button-widget)] (make-toggle 1)) ; NSButtonTypePushOnPushOff
(defmethod make-native [(t ui/check-box-widget)] (make-toggle 3))     ; NSButtonTypeSwitch
(defmethod make-native [(t ui/radio-button-widget)] (make-toggle 4))  ; NSButtonTypeRadio

(defmethod set-native [(t ui/toggle-button-widget) (p (= :label)) v]
  (set-string! t "setTitle:" v))

(defmethod set-native [(t ui/toggle-button-widget) (p (= :checked)) v]
  (set-long! t "setState:" (if v 1 0)))

(defmethod set-native [(t ui/toggle-button-widget) (p (= :image)) image]
  ;; A check box's or radio button's box is its button type's image: no image of the
  ;; program's leaves it alone.
  (when-not (and (nil? image)
                 (or (instance? ui/check-box-widget t) (instance? ui/radio-button-widget t)))
    (objc/send-p-void (view t) (objc/sel "setImage:") (ns-image image))
    (set-long! t "setImagePosition:" (cond (nil? image) 0 (= :icon (:style t)) 1 :else 2))))

(defn native-image-position
  "The NSCellImagePosition of a button or toggle (0 none, 2 left of the title, 7 leading)."
  [w]
  (objc/send-long (view w) (objc/sel "imagePosition")))

(defmethod native-action [(t ui/toggle-button-widget) sender]
  (let [on (= 1 (objc/send-long sender (objc/sel "state")))]
    (when (not= on (boolean (:checked t)))
      (ui/toggled-by-user! t on))))

;;; ------------------------------------------------------------------------------------
;;; Sliders, spin buttons, progress bars and spinners

(defmethod make-native [(s ui/slider-widget)]
  (let [n (init-frame "NSSlider")]
    (objc/send-b-void n (objc/sel "setContinuous:") true)
    (connect-action! n)))

(defmethod set-native [(s ui/slider-widget) (p (= :min)) v] (set-double! s "setMinValue:" v))
(defmethod set-native [(s ui/slider-widget) (p (= :max)) v] (set-double! s "setMaxValue:" v))
(defmethod set-native [(s ui/slider-widget) (p (= :value)) v] (set-double! s "setDoubleValue:" v))
(defmethod set-native [(s ui/slider-widget) (p (= :ticks)) v]
  (set-long! s "setNumberOfTickMarks:" (or v 0)))
(defmethod set-native [(s ui/slider-widget) (p (= :snap)) v]
  (set-bool! s "setAllowsTickMarkValuesOnly:" v))
(defmethod set-native [(s ui/slider-widget) (p (= :orientation)) v]
  (set-bool! s "setVertical:" (= v :vertical)))

(defmethod native-natural-size [(s ui/slider-widget)]
  (let [[w h] (call-next-method)]
    (if (= :vertical (:orientation s)) [w (max h 120)] [(max w 120) h])))

(defmethod native-action [(s ui/slider-widget) sender]
  (let [v (whole (double-of sender "doubleValue"))]
    (when (not= v (:value s))
      (ui/changed-by-user! s :value v))))

(defn- spin-parts
  "The field and the stepper inside a spin button's view."
  [w]
  (let [subviews (objc/send (view w) (objc/sel "subviews"))]
    [(objc/send-l subviews (objc/sel "objectAtIndex:") 0)
     (objc/send-l subviews (objc/sel "objectAtIndex:") 1)]))

(defmethod make-native [(w ui/spin-button-widget)]
  (let [n (flipped-view)
        field (init-frame "NSTextField")
        stepper (init-frame "NSStepper")]
    (connect-action! field)
    (connect-action! stepper)
    (objc/send-b-void stepper (objc/sel "setValueWraps:") false)
    (objc/send-p-void n (objc/sel "addSubview:") field)
    (objc/send-p-void n (objc/sel "addSubview:") stepper)
    (also-register! field w)
    (also-register! stepper w)
    (objc/release field)
    (objc/release stepper)
    n))

(defn- show-spin-value! [w]
  (let [[field stepper] (spin-parts w)
        v (or (:value w) 0)]
    (objc/send-d-void stepper (objc/sel "setDoubleValue:") (f64 v))
    (objc/send-p-void field (objc/sel "setStringValue:")
                      (objc/ns-string (format (str "%." (or (:digits w) 0) "f") (f64 v))))))

(defmethod set-native [(w ui/spin-button-widget) (p (= :min)) v]
  (objc/send-d-void (second (spin-parts w)) (objc/sel "setMinValue:") (f64 v)))
(defmethod set-native [(w ui/spin-button-widget) (p (= :max)) v]
  (objc/send-d-void (second (spin-parts w)) (objc/sel "setMaxValue:") (f64 v)))
(defmethod set-native [(w ui/spin-button-widget) (p (= :step)) v]
  (objc/send-d-void (second (spin-parts w)) (objc/sel "setIncrement:") (f64 v)))
(defmethod set-native [(w ui/spin-button-widget) (p (= :value)) v] (show-spin-value! w))
(defmethod set-native [(w ui/spin-button-widget) (p (= :digits)) v] (show-spin-value! w))

(defmethod native-natural-size [(w ui/spin-button-widget)]
  [(+ 64 (* 7 (or (:digits w) 0))) 22])

(defmethod layout-subviews [(w ui/spin-button-widget) width height]
  (let [[field stepper] (spin-parts w)]
    (objc/send-r-void field (objc/sel "setFrame:") (objc/rect 0 0 (max 0 (- width 19)) height))
    (objc/send-r-void stepper (objc/sel "setFrame:") (objc/rect (max 0 (- width 15)) 0 15 height))))

(defmethod native-action [(w ui/spin-button-widget) sender]
  (let [[field stepper] (spin-parts w)
        v (if (= (ffi/address sender) (ffi/address stepper))
            (double-of stepper "doubleValue")
            (math/clamp (double-of field "doubleValue") (:min w) (:max w)))
        v (whole v)]
    (ui/sync-property! w :value v)
    (show-spin-value! w)
    (ui/emit! w (ui/event-for w :changed :value v))))

(defmethod make-native [(p ui/progress-bar-widget)]
  (let [n (init-frame "NSProgressIndicator")]
    (objc/send-l-void n (objc/sel "setStyle:") 0)
    n))

(defmethod set-native [(b ui/progress-bar-widget) (p (= :min)) v] (set-double! b "setMinValue:" v))
(defmethod set-native [(b ui/progress-bar-widget) (p (= :max)) v] (set-double! b "setMaxValue:" v))
(defmethod set-native [(b ui/progress-bar-widget) (p (= :value)) v]
  (set-double! b "setDoubleValue:" v))
(defmethod set-native [(b ui/progress-bar-widget) (p (= :indeterminate)) v]
  (set-bool! b "setIndeterminate:" v)
  (objc/send-p-void (view b) (objc/sel (if v "startAnimation:" "stopAnimation:")) (ffi/null)))

(defmethod native-natural-size [(b ui/progress-bar-widget)]
  [120 (second (call-next-method))])

(defmethod make-native [(s ui/spinner-widget)]
  (let [n (init-frame "NSProgressIndicator")]
    (objc/send-l-void n (objc/sel "setStyle:") 1)
    (objc/send-b-void n (objc/sel "setDisplayedWhenStopped:") false)
    n))

(defmethod set-native [(s ui/spinner-widget) (p (= :active)) v]
  (objc/send-p-void (view s) (objc/sel (if v "startAnimation:" "stopAnimation:")) (ffi/null)))

(defmethod native-natural-size [(s ui/spinner-widget)]
  [16 16])

;;; ------------------------------------------------------------------------------------
;;; Combo boxes and combo entries

(defmethod make-native [(c ui/combo-box-widget)]
  (connect-action! (objc/send-rb (objc/alloc "NSPopUpButton")
                                 (objc/sel "initWithFrame:pullsDown:") (objc/rect 0 0 0 0) false)))

(defn- show-items! [c]
  (let [n (view c)]
    (objc/send-void n (objc/sel "removeAllItems"))
    (doseq [i (range (count (:items c)))]
      (objc/send-p-void n (objc/sel "addItemWithTitle:") (objc/ns-string (ui/item-text c i))))))

(defmethod set-native [(c ui/combo-box-widget) (p (= :items)) v]
  (show-items! c)
  (set-long! c "selectItemAtIndex:" (or (:selected-index c) -1)))

(defmethod set-native [(c ui/combo-box-widget) (p (= :item-label)) v]
  (set-native c :items (:items c)))

(defmethod set-native [(c ui/combo-box-widget) (p (= :selected-index)) v]
  (set-long! c "selectItemAtIndex:" (or v -1)))

(defmethod native-action [(c ui/combo-box-widget) sender]
  (let [i (objc/send-long sender (objc/sel "indexOfSelectedItem"))]
    (ui/chosen-by-user! c (when (>= i 0) i))))

(defmethod make-native [(c ui/combo-entry-widget)]
  (let [n (init-frame "NSComboBox")]
    (objc/send-p-void n (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
    (connect-action! n)))

(defmethod set-native [(c ui/combo-entry-widget) (p (= :items)) v]
  (objc/send-void (view c) (objc/sel "removeAllItems"))
  (doseq [i (range (count v))]
    (objc/send-p-void (view c) (objc/sel "addItemWithObjectValue:")
                      (objc/ns-string (ui/item-text c i)))))

(defmethod set-native [(c ui/combo-entry-widget) (p (= :item-label)) v]
  (set-native c :items (:items c)))

(defmethod set-native [(c ui/combo-entry-widget) (p (= :text)) v]
  (set-string! c "setStringValue:" v))

(defmethod native-text-changed [(c ui/combo-entry-widget) field]
  (ui/changed-by-user! c :text (objc/string-of (objc/send field (objc/sel "stringValue")))))

(defmethod native-selection-changed [(c ui/combo-entry-widget) sender]
  (let [i (objc/send-long sender (objc/sel "indexOfSelectedItem"))]
    (when (>= i 0)
      (ui/changed-by-user! c :text (ui/item-text c i)))))

(defmethod native-action [(c ui/combo-entry-widget) sender]
  (ui/emit! c (ui/event-for c :activate)))

(defmethod native-natural-size [(c ui/combo-entry-widget)]
  (let [[w h] (call-next-method)] [(max w 120) h]))

;;; ------------------------------------------------------------------------------------
;;; Color buttons and date pickers

(defmethod make-native [(c ui/color-button-widget)]
  (connect-action! (init-frame "NSColorWell")))

(defmethod set-native [(c ui/color-button-widget) (p (= :color)) v]
  (objc/send-p-void (view c) (objc/sel "setColor:") (ns-color v)))

(defmethod native-action [(c ui/color-button-widget) sender]
  (ui/changed-by-user! c :color (color-of (objc/send sender (objc/sel "color")))))

(defmethod native-natural-size [(c ui/color-button-widget)]
  [44 24])

(defmethod make-native [(d ui/date-picker-widget)]
  (let [n (init-frame "NSDatePicker")]
    (objc/send-l-void n (objc/sel "setDatePickerStyle:") 0)
    (connect-action! n)))

(defmethod set-native [(d ui/date-picker-widget) (p (= :date)) v]
  (objc/send-p-void (view d) (objc/sel "setDateValue:")
                    (objc/send-d (objc/cls "NSDate") (objc/sel "dateWithTimeIntervalSince1970:")
                                 (/ (f64 v) 1000.0))))

(defmethod set-native [(d ui/date-picker-widget) (p (= :mode)) v]
  ;; NSDatePickerElementFlagYearMonthDay 0xe0, HourMinuteSecond 0x0e
  (set-long! d "setDatePickerElements:" (case v :time 0x0e :date-time 0xee 0xe0)))

(defmethod native-action [(d ui/date-picker-widget) sender]
  (let [ms (int (math/round (* 1000 (double-of (objc/send sender (objc/sel "dateValue"))
                                               "timeIntervalSince1970"))))]
    (ui/changed-by-user! d :date ms)))

;;; ------------------------------------------------------------------------------------
;;; Frames

(defmethod make-native [(f ui/frame-widget)]
  (let [n (init-frame "NSBox")
        content (flipped-view)]
    (objc/send-p-void n (objc/sel "setContentView:") content)
    (objc/release content)
    n))

(defmethod container-view [(f ui/frame-widget)]
  (objc/send (view f) (objc/sel "contentView")))

(defmethod set-native [(f ui/frame-widget) (p (= :title)) v]
  ;; NSNoTitle 0, NSAtTop 2
  (set-long! f "setTitlePosition:" (if v 2 0))
  (set-string! f "setTitle:" v))

(defn- frame-decoration
  "What an NSBox adds around its content: the size it takes for a 200 by 200 content."
  [f]
  (let [n (view f)
        old (objc/send-rect n (objc/sel "frame"))
        [ox oy ow oh] (objc/rect-vec old)]
    (objc/send-r-void n (objc/sel "setFrameFromContentFrame:") (objc/rect 0 0 200 200))
    (let [[_ _ w h] (objc/rect-vec (objc/send-rect n (objc/sel "frame")))]
      (objc/send-r-void n (objc/sel "setFrame:") (objc/rect ox oy ow oh))
      [(int (math/ceil (- w 200))) (int (math/ceil (- h 200)))])))

(defmethod ui/backend-decoration-size [(b cocoa-backend) (f ui/frame-widget)]
  (frame-decoration f))

(defmethod ui/backend-content-area [(b cocoa-backend) (f ui/frame-widget) width height]
  (let [[dw dh] (frame-decoration f)]
    [0 0 (max 0 (- width dw)) (max 0 (- height dh))]))

;;; ------------------------------------------------------------------------------------
;;; Text views

(defn- text-view-of
  "The NSTextView inside a text view widget's scroll view."
  [v]
  (objc/send (view v) (objc/sel "documentView")))

(defmethod make-native [(v ui/text-view-widget)]
  (let [scroll (init-frame "NSScrollView")
        tv (objc/send-r (objc/alloc "NSTextView") (objc/sel "initWithFrame:")
                        (objc/rect 0 0 200 100))]
    (objc/send-b-void scroll (objc/sel "setHasVerticalScroller:") true)
    (objc/send-b-void tv (objc/sel "setVerticallyResizable:") true)
    (objc/send-l-void tv (objc/sel "setAutoresizingMask:") 2) ; NSViewWidthSizable
    (objc/send-b-void tv (objc/sel "setRichText:") false)
    (objc/send-p-void tv (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
    (objc/send-p-void scroll (objc/sel "setDocumentView:") tv)
    (also-register! tv v)
    (objc/release tv)
    scroll))

(defmethod set-native [(v ui/text-view-widget) (p (= :text)) s]
  (objc/send-p-void (text-view-of v) (objc/sel "setString:") (objc/ns-string (or s ""))))

(defmethod set-native [(v ui/text-view-widget) (p (= :editable)) e]
  (objc/send-b-void (text-view-of v) (objc/sel "setEditable:") (boolean e)))

(defmethod set-native [(v ui/text-view-widget) (p (= :border)) b]
  (set-long! v "setBorderType:" (if b 2 0)))   ; NSBezelBorder 2, NSNoBorder 0

(defmethod set-native [(v ui/text-view-widget) (p (= :wrap)) w]
  (let [tv (text-view-of v)
        container (objc/send tv (objc/sel "textContainer"))]
    (objc/send-b-void (view v) (objc/sel "setHasHorizontalScroller:") (not w))
    (objc/send-b-void tv (objc/sel "setHorizontallyResizable:") (not w))
    (objc/send-b-void container (objc/sel "setWidthTracksTextView:") (boolean w))
    (when-not w
      (objc/send-z-void container (objc/sel "setContainerSize:")
                        {:width 1.0e7 :height 1.0e7}))))

(defmethod set-native [(v ui/text-view-widget) (p (= :placeholder)) s]
  (let [tv (text-view-of v)]
    (when (objc/responds? tv "setPlaceholderString:")
      (objc/send-p-void tv (objc/sel "setPlaceholderString:") (objc/ns-string s)))))

(defmethod native-natural-size [(v ui/text-view-widget)]
  [240 120])

(defmethod native-text-changed [(v ui/text-view-widget) tv]
  (ui/changed-by-user! v :text (objc/string-of (objc/send tv (objc/sel "string")))))

(defmethod ui/backend-text-append [(b cocoa-backend) v s]
  (let [tv (text-view-of v)
        storage (objc/send tv (objc/sel "textStorage"))
        end (objc/send-long storage (objc/sel "length"))]
    (objc/send-range-p-void storage (objc/sel "replaceCharactersInRange:withString:")
                            {:location end :length 0} (objc/ns-string s))
    (objc/send-p-void tv (objc/sel "scrollToEndOfDocument:") (ffi/null))))

(defmethod ui/backend-text-selection [(b cocoa-backend) v]
  (let [r (objc/send-range (text-view-of v) (objc/sel "selectedRange"))
        start (ffi/field r objc/ns-range :location)]
    [start (+ start (ffi/field r objc/ns-range :length))]))

(defmethod ui/backend-set-text-selection [(b cocoa-backend) v start end]
  (objc/send-range-void (text-view-of v) (objc/sel "setSelectedRange:")
                        {:location start :length (- end start)}))

(defmethod ui/backend-text-insert [(b cocoa-backend) v s]
  (let [tv (text-view-of v)
        [start end] (ui/backend-text-selection b v)]
    (objc/send-range-p-void (objc/send tv (objc/sel "textStorage"))
                            (objc/sel "replaceCharactersInRange:withString:")
                            {:location start :length (- end start)} (objc/ns-string s))
    (ui/backend-set-text-selection b v (+ start (count s)) (+ start (count s)))))

;;; ------------------------------------------------------------------------------------
;;; Notebooks

(def ^:private pane-tabs
  "A tabbed pane's view address -> the tabless NSTabView of its pages."
  (atom {}))

(defn- tabs-of
  "The NSTabView of the notebook's pages: its own view, or a tabbed pane's inner one."
  [n]
  (or (get @pane-tabs (ffi/address (view n))) (view n)))

(defmethod make-native [(n ui/notebook-widget)]
  (let [tv (init-frame "NSTabView")]
    (objc/send-p-void tv (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
    tv))

(defn- tab-item
  "The NSTabViewItem of the notebook's page at index."
  [n index]
  (objc/send-l (tabs-of n) (objc/sel "tabViewItemAtIndex:") index))

(defn- page-item
  "The NSTabViewItem holding the notebook's page, or nil."
  [n page]
  (let [wrapper (objc/send (view page) (objc/sel "superview"))
        items (objc/send (tabs-of n) (objc/sel "tabViewItems"))]
    (first (filter (fn [item] (= (ffi/address (objc/send item (objc/sel "view")))
                                 (ffi/address wrapper)))
                   (map (fn [i] (objc/send-l items (objc/sel "objectAtIndex:") i))
                        (range (objc/send-long items (objc/sel "count"))))))))

(defmethod ui/backend-add-child [(b cocoa-backend) (n ui/notebook-widget) page]
  (let [item (objc/send-p (objc/alloc "NSTabViewItem") (objc/sel "initWithIdentifier:")
                          (ffi/null))
        wrapper (flipped-view)
        label (:tab-label page)]
    (objc/send-p-void wrapper (objc/sel "addSubview:") (view page))
    (objc/send-p-void item (objc/sel "setView:") wrapper)
    (objc/send-p-void item (objc/sel "setLabel:") (objc/ns-string (if (string? label) label "")))
    (quietly (fn [] (objc/send-p-void (tabs-of n) (objc/sel "addTabViewItem:") item)))
    (objc/release wrapper)
    (objc/release item)))

(defmethod ui/backend-remove-child [(b cocoa-backend) (n ui/notebook-widget) page]
  (let [item (page-item n page)]
    (objc/send-void (view page) (objc/sel "removeFromSuperview"))
    (when item
      (quietly (fn [] (objc/send-p-void (tabs-of n) (objc/sel "removeTabViewItem:") item))))))

(defmethod ui/backend-set-page-label [(b cocoa-backend) n page label]
  (when-let [i (index-of (:children n) page)]
    (objc/send-p-void (tab-item n i) (objc/sel "setLabel:") (objc/ns-string (or label "")))))

(defmethod set-native [(n ui/notebook-widget) (p (= :selected-index)) i]
  (when (< -1 (or i -1) (count (:children n)))
    (quietly (fn [] (objc/send-l-void (tabs-of n) (objc/sel "selectTabViewItemAtIndex:") i)))))

(defmethod set-native [(n ui/notebook-widget) (p (= :tab-position)) v]
  ;; NSTopTabsBezelBorder 0, NSLeftTabsBezelBorder 1, NSBottomTabsBezelBorder 2, right 3
  (set-long! n "setTabViewType:" (case v :left 1 :bottom 2 :right 3 0)))

(defn- tab-decoration [n]
  (let [tv (view n)
        [_ _ ow oh] (objc/rect-vec (objc/send-rect tv (objc/sel "frame")))
        _ (objc/send-z-void tv (objc/sel "setFrameSize:") {:width 300.0 :height 300.0})
        [_ _ cw ch] (objc/rect-vec (objc/send-rect tv (objc/sel "contentRect")))]
    (objc/send-z-void tv (objc/sel "setFrameSize:") {:width (f64 ow) :height (f64 oh)})
    [(int (math/ceil (- 300 cw))) (int (math/ceil (- 300 ch)))]))

(defmethod ui/backend-decoration-size [(b cocoa-backend) (n ui/notebook-widget)]
  (tab-decoration n))

(defmethod ui/backend-content-area [(b cocoa-backend) (n ui/notebook-widget) width height]
  (let [[dw dh] (tab-decoration n)]
    [0 0 (max 0 (- width dw)) (max 0 (- height dh))]))

(defmethod native-selection-changed [(n ui/notebook-widget) item]
  (when-not (quiet?)
    (let [i (objc/send-p-long (tabs-of n) (objc/sel "indexOfTabViewItem:") item)]
      (when (not= i (:selected-index n))
        (ui/page-changed-by-user! n i)))))

;;; ------------------------------------------------------------------------------------
;;; Split panes

(defmethod make-native [(p ui/paned-widget)]
  (let [n (init-frame "NSSplitView")]
    (objc/send-l-void n (objc/sel "setDividerStyle:") 2)   ; NSSplitViewDividerStyleThin
    (objc/send-p-void n (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
    n))

(defmethod set-native [(p ui/paned-widget) (k (= :orientation)) v]
  (set-bool! p "setVertical:" (= v :horizontal)))

(defmethod ui/backend-decoration-size [(b cocoa-backend) (p ui/paned-widget)]
  (let [t (int (math/ceil (double-of (view p) "dividerThickness")))] [t t]))

(defmethod native-selection-changed [(p ui/paned-widget) split-view]
  (when-not (quiet?)
    (when-let [first-pane (first (ui/visible-children p))]
      (let [[_ _ w h] (objc/rect-vec (objc/send-rect (view first-pane) (objc/sel "frame")))
            position (int (math/round (if (= :horizontal (:orientation p)) w h)))]
        (when (not= position (:position p))
          (ui/divider-moved-by-user! p position))))))

(defmethod ui/backend-set-bounds [(b cocoa-backend) (w ui/widget) x y width height]
  ;; A split view's panes are placed by layout: its own resizing notices aren't the user's.
  (quietly (fn [] (call-next-method))))

;;; ------------------------------------------------------------------------------------
;;; Scrolled windows

(defn- clip-view [s] (objc/send (view s) (objc/sel "contentView")))

(defmethod make-native [(s ui/scrolled-window-widget)]
  (let [n (init-frame "NSScrollView")
        document (flipped-view)
        clip (objc/send n (objc/sel "contentView"))
        b (ui/current-backend)]
    (objc/send-p-void n (objc/sel "setDocumentView:") document)
    (objc/release document)
    (objc/send-b-void clip (objc/sel "setPostsBoundsChangedNotifications:") true)
    (objc/send-pppp-void (objc/send (objc/cls "NSNotificationCenter") (objc/sel "defaultCenter"))
                         (objc/sel "addObserver:selector:name:object:")
                         (:text-delegate b) (objc/sel "boundsDidChange:")
                         (objc/ns-string "NSViewBoundsDidChangeNotification") clip)
    (also-register! clip s)
    n))

(defmethod container-view [(s ui/scrolled-window-widget)]
  (objc/send (view s) (objc/sel "documentView")))

(defn- set-scrollers! [s]
  (let [n (view s)
        h (:horizontal-policy s)
        v (:vertical-policy s)]
    (objc/send-b-void n (objc/sel "setHasHorizontalScroller:") (not= h :never))
    (objc/send-b-void n (objc/sel "setHasVerticalScroller:") (not= v :never))
    (objc/send-b-void n (objc/sel "setAutohidesScrollers:")
                      (not (or (= h :always) (= v :always))))))

(defmethod set-native [(s ui/scrolled-window-widget) (p (= :horizontal-policy)) v]
  (set-scrollers! s))

(defmethod set-native [(s ui/scrolled-window-widget) (p (= :vertical-policy)) v]
  (set-scrollers! s))

(defmethod set-native [(s ui/scrolled-window-widget) (p (= :border)) v]
  (set-long! s "setBorderType:" (if v 2 0)))

(defmethod ui/backend-decoration-size [(b cocoa-backend) (s ui/scrolled-window-widget)]
  (if (:border s) [2 2] [0 0]))

(defmethod ui/backend-content-area [(b cocoa-backend) (s ui/scrolled-window-widget)
                                    width height]
  (let [[w h] (objc/size-vec (objc/send-size (view s) (objc/sel "contentSize")))]
    [0 0 (int (math/floor w)) (int (math/floor h))]))

(defmethod ui/backend-set-scroll-extent [(b cocoa-backend) s width height]
  (let [n (view s)
        before (objc/size-vec (objc/send-size n (objc/sel "contentSize")))]
    (quietly
     (fn [] (objc/send-z-void (objc/send n (objc/sel "documentView")) (objc/sel "setFrameSize:")
                              {:width (f64 width) :height (f64 height)})))
    (let [after (objc/size-vec (objc/send-size n (objc/sel "contentSize")))]
      (when (not= before after)
        (mapv (fn [x] (int (math/floor x))) after)))))

(defmethod ui/backend-scroll-to [(b cocoa-backend) s x y]
  (quietly
   (fn []
     (objc/send-point-void (clip-view s) (objc/sel "scrollToPoint:") {:x (f64 x) :y (f64 y)})
     (objc/send-p-void (view s) (objc/sel "reflectScrolledClipView:") (clip-view s)))))

(defmethod native-selection-changed [(s ui/scrolled-window-widget) clip]
  (when-not (quiet?)
    (let [[x y] (objc/rect-vec (objc/send-rect clip (objc/sel "bounds")))]
      (ui/scrolled-by-user! s (int (math/round x)) (int (math/round y))))))

;;; ------------------------------------------------------------------------------------
;;; List boxes, tables and trees: NSTableView and NSOutlineView in an NSScrollView

(defn- table-of
  "The NSTableView or NSOutlineView inside the widget's scroll view."
  [w]
  (objc/send (view w) (objc/sel "documentView")))

(defn- make-table [w class-name]
  (let [scroll (init-frame "NSScrollView")
        tv (init-frame class-name)
        b (ui/current-backend)]
    (objc/send-p-void tv (objc/sel "setDataSource:") (:data-source b))
    (objc/send-p-void tv (objc/sel "setDelegate:") (:data-source b))
    (objc/send-p-void tv (objc/sel "setTarget:") (:target b))
    (objc/send-p-void tv (objc/sel "setDoubleAction:") (objc/sel "doubleAction:"))
    (objc/send-l-void tv (objc/sel "setColumnAutoresizingStyle:") 1) ; uniform
    (objc/send-b-void scroll (objc/sel "setHasVerticalScroller:") true)
    (objc/send-p-void scroll (objc/sel "setDocumentView:") tv)
    (also-register! tv w)
    (objc/release tv)
    scroll))

(defn- add-column!
  "Add a column titled title (width pixels wide, if given) to the table view. Returns the
NSTableColumn."
  [tv title width alignment]
  (let [n (objc/send-long (objc/send tv (objc/sel "tableColumns")) (objc/sel "count"))
        col (objc/send-p (objc/alloc "NSTableColumn") (objc/sel "initWithIdentifier:")
                         (objc/ns-string (str n)))]
    (objc/send-p-void (objc/send col (objc/sel "headerCell")) (objc/sel "setStringValue:")
                      (objc/ns-string (or title "")))
    (when width (objc/send-d-void col (objc/sel "setWidth:") (f64 width)))
    (when alignment
      (objc/send-l-void (objc/send col (objc/sel "dataCell")) (objc/sel "setAlignment:")
                        (text-alignment alignment)))
    (objc/send-l-void col (objc/sel "setResizingMask:") 3)
    (objc/send-p-void tv (objc/sel "addTableColumn:") col)
    (objc/release col)
    col))

(defn- remove-columns! [tv]
  (let [cols (objc/send (objc/send tv (objc/sel "tableColumns")) (objc/sel "copy"))
        n (objc/send-long cols (objc/sel "count"))]
    (doseq [i (range n)]
      (objc/send-p-void tv (objc/sel "removeTableColumn:")
                        (objc/send-l cols (objc/sel "objectAtIndex:") i)))
    (objc/release cols)))

(defn- show-headers! [tv show]
  (if show
    (let [h (objc/new-object "NSTableHeaderView")]
      (objc/send-p-void tv (objc/sel "setHeaderView:") h)
      (objc/release h))
    (objc/send-p-void tv (objc/sel "setHeaderView:") (ffi/null))))

(defn- selected-rows
  "The table view's selected rows, in order."
  [tv]
  (let [set (objc/send tv (objc/sel "selectedRowIndexes"))
        not-found 9223372036854775807]
    (loop [i (objc/send-long set (objc/sel "firstIndex")) rows []]
      (if (or (= i not-found) (< i 0))
        rows
        (recur (objc/send-l-long set (objc/sel "indexGreaterThanIndex:") i) (conj rows i))))))

(defn- select-rows! [tv rows]
  (let [set (objc/new-object "NSMutableIndexSet")]
    (doseq [r rows] (objc/send-l-void set (objc/sel "addIndex:") r))
    (quietly (fn [] (objc/send-pb-void tv (objc/sel "selectRowIndexes:byExtendingSelection:")
                                       set false)))
    (objc/release set)))

(defn- reload! [tv]
  (quietly (fn [] (objc/send-void tv (objc/sel "reloadData")))))

(defn- activated-row
  "The row a double-click or Return activated: the clicked row, else the selected one."
  [tv]
  (let [clicked (objc/send-long tv (objc/sel "clickedRow"))]
    (if (>= clicked 0) clicked (objc/send-long tv (objc/sel "selectedRow")))))

;;; List boxes

(defmethod make-native [(l ui/list-box-widget)]
  (let [scroll (make-table l "NSTableView")
        tv (objc/send scroll (objc/sel "documentView"))]
    (add-column! tv "" nil nil)
    (show-headers! tv false)
    scroll))

(defmethod native-row-count [(l ui/list-box-widget)]
  (count (:items l)))

(defmethod native-cell-text [(l ui/list-box-widget) row column]
  (ui/item-text l row))

(defmethod set-native [(l ui/list-box-widget) (p (= :items)) v]
  (reload! (table-of l))
  (select-rows! (table-of l) (:selected-indices l)))

(defmethod set-native [(l ui/list-box-widget) (p (= :item-label)) v]
  (reload! (table-of l)))

(defmethod set-native [(l ui/list-box-widget) (p (= :selected-indices)) v]
  (select-rows! (table-of l) v))

(defmethod set-native [(l ui/list-box-widget) (p (= :selection-mode)) v]
  (objc/send-b-void (table-of l) (objc/sel "setAllowsMultipleSelection:") (= v :multiple)))

(defmethod set-native [(l ui/list-box-widget) (p (= :border)) v]
  (set-long! l "setBorderType:" (if v 2 0)))

(defmethod set-native [(l ui/list-box-widget) (p (= :alternating)) v]
  (objc/send-b-void (table-of l) (objc/sel "setUsesAlternatingRowBackgroundColors:") (boolean v)))

(defmethod native-natural-size [(l ui/list-box-widget)]
  [160 120])

(defmethod native-selection-changed [(l ui/list-box-widget) tv]
  (when-not (quiet?)
    (let [rows (selected-rows tv)]
      (when (not= rows (vec (:selected-indices l)))
        (ui/selection-changed-by-user! l rows)))))

(defmethod native-double-action [(l ui/list-box-widget) tv]
  (let [row (activated-row tv)]
    (when (>= row 0)
      (ui/row-activated-by-user! l row 2))))

;;; Tables

(defmethod native-cell-text [(t ui/table-view-widget) row column]
  (ui/table-cell-text t row column))

(defn- show-sort! [t]
  (let [tv (table-of t)
        cols (objc/send tv (objc/sel "tableColumns"))
        i (when-let [c (:sort-column t)] (index-of (:columns t) c))]
    (doseq [k (range (objc/send-long cols (objc/sel "count")))]
      (objc/send-pp-void tv (objc/sel "setIndicatorImage:inTableColumn:")
                         (if (= i (column-index tv (objc/send-l cols (objc/sel "objectAtIndex:")
                                                                k)))
                           (objc/send-p (objc/cls "NSImage") (objc/sel "imageNamed:")
                                        (objc/ns-string (if (:sort-descending t)
                                                          "NSDescendingSortIndicator"
                                                          "NSAscendingSortIndicator")))
                           (ffi/null))
                         (objc/send-l cols (objc/sel "objectAtIndex:") k)))))

(defmethod set-native [(t ui/table-view-widget) (p (= :columns)) cols]
  (let [tv (table-of t)]
    (remove-columns! tv)
    (doseq [c cols] (add-column! tv (:title c) (:width c) (:alignment c)))
    (show-headers! tv (:headers t))
    (reload! tv)
    (show-sort! t)))

(defmethod set-native [(t ui/table-view-widget) (p (= :headers)) v]
  (show-headers! (table-of t) v))

(defmethod set-native [(t ui/table-view-widget) (p (= :sort-column)) v]
  (show-sort! t))

(defmethod set-native [(t ui/table-view-widget) (p (= :sort-descending)) v]
  (show-sort! t))

(defmethod native-natural-size [(t ui/table-view-widget)]
  [(max 160 (reduce + 0 (map (fn [c] (or (:width c) 100)) (:columns t)))) 120])

(defmethod native-cell-edited [(t ui/table-view-widget) field]
  ;; Report the edit, then show the cell's text from :items, which a handler may have set.
  (let [tv (table-of t)
        row (objc/send-p-long tv (objc/sel "rowForView:") field)
        col (objc/send-p-long tv (objc/sel "columnForView:") field)]
    (when (and (>= row 0) (>= col 0))
      (let [index (column-index tv (objc/send-l (objc/send tv (objc/sel "tableColumns"))
                                                (objc/sel "objectAtIndex:") col))]
        (ui/cell-edited-by-user! t row index
                                 (objc/string-of (objc/send field (objc/sel "stringValue"))))
        (when (< row (count (:items t)))
          (objc/send-p-void field (objc/sel "setStringValue:")
                            (objc/ns-string (native-cell-text t row index))))))))

(defmethod native-double-action [(t ui/table-view-widget) tv]
  ;; A double-click on an editable cell edits it; elsewhere it activates the row.
  (let [row (objc/send-long tv (objc/sel "clickedRow"))
        col (objc/send-long tv (objc/sel "clickedColumn"))
        index (when (>= col 0)
                (column-index tv (objc/send-l (objc/send tv (objc/sel "tableColumns"))
                                              (objc/sel "objectAtIndex:") col)))]
    (if (and (>= row 0) index (:editable (get (vec (:columns t)) index)))
      (objc/send-llpb-void tv (objc/sel "editColumn:row:withEvent:select:") col row (ffi/null) true)
      (let [row (activated-row tv)]
        (when (>= row 0)
          (ui/row-activated-by-user! t row 2))))))

(defmethod native-column-clicked [(t ui/table-view-widget) col]
  (ui/column-clicked-by-user! t (column-index (table-of t) col)))

;;; Trees

(def ^:private item-ids
  "The ids of tree items: [outline view address, item key] -> id, and id -> the item. An
outline view knows each item by an NSNumber of its id (a tagged pointer, so the same
object every time)."
  (atom {:next 1 :ids {} :items {}}))

(defn- item-ptr
  "The NSNumber the tree's outline view knows item by."
  [t item]
  (let [k [(ffi/address (table-of t)) ((:item-key t) item)]
        id (or (get-in @item-ids [:ids k])
               (let [{n :next} (swap! item-ids
                                      (fn [m] (-> m (update :next inc)
                                                  (assoc-in [:ids k] (:next m)))))]
                 (dec n)))]
    (swap! item-ids assoc-in [:items id] item)
    (objc/send-l (objc/cls "NSNumber") (objc/sel "numberWithLong:") id)))

(defn- item-of
  "The tree item the outline view's pointer p stands for (nil for null: the roots)."
  [p]
  (when-not (ffi/null? p)
    (get-in @item-ids [:items (objc/send-long p (objc/sel "longValue"))])))

(defmethod make-native [(t ui/tree-view-widget)]
  (let [scroll (make-table t "NSOutlineView")
        ov (objc/send scroll (objc/sel "documentView"))
        col (add-column! ov "" nil nil)]
    (objc/send-p-void ov (objc/sel "setOutlineTableColumn:") col)
    (show-headers! ov false)
    scroll))

(defmethod native-outline [(t ui/tree-view-widget) op p arg]
  (let [item (item-of p)
        children (fn [] (ui/tree-children t item))]
    (case op
      :count (count (children))
      :child (item-ptr t (nth (children) arg))
      :expandable? (seq (ui/tree-children t item))
      :text (ui/tree-cell-text t item arg))))

(defn- show-expansion!
  "Open and close the outline view's items as the tree's :expanded says, from the roots
down through the open ones."
  [t]
  (let [ov (table-of t)
        walk (fn walk [items]
               (doseq [item items]
                 (if (ui/expanded? t item)
                   (do (quietly (fn [] (objc/send-p-void ov (objc/sel "expandItem:")
                                                         (item-ptr t item))))
                       (walk (ui/tree-children t item)))
                   (quietly (fn [] (objc/send-p-void ov (objc/sel "collapseItem:")
                                                     (item-ptr t item)))))))]
    (walk (ui/tree-children t nil))))

(defn- show-tree-selection! [t]
  (let [ov (table-of t)
        rows (keep (fn [item]
                     (let [r (objc/send-p-long ov (objc/sel "rowForItem:") (item-ptr t item))]
                       (when (>= r 0) r)))
                   (:selection t))]
    (select-rows! ov (sort rows))))

(defmethod set-native [(t ui/tree-view-widget) (p (= :roots)) v]
  (reload! (table-of t))
  (show-expansion! t)
  (show-tree-selection! t))

(defmethod set-native [(t ui/tree-view-widget) (p (= :expanded)) v]
  (show-expansion! t))

(defmethod set-native [(t ui/tree-view-widget) (p (= :selection)) v]
  (show-tree-selection! t))

(defmethod set-native [(t ui/tree-view-widget) (p (= :item-label)) v]
  (reload! (table-of t)))

(defmethod set-native [(t ui/tree-view-widget) (p (= :selection-mode)) v]
  (objc/send-b-void (table-of t) (objc/sel "setAllowsMultipleSelection:") (= v :multiple)))

(defmethod set-native [(t ui/tree-view-widget) (p (= :headers)) v]
  (show-headers! (table-of t) v))

(defmethod set-native [(t ui/tree-view-widget) (p (= :columns)) cols]
  (when (seq cols)
    (let [ov (table-of t)]
      (remove-columns! ov)
      (doseq [c cols] (add-column! ov (:title c) (:width c) (:alignment c)))
      (objc/send-p-void ov (objc/sel "setOutlineTableColumn:")
                        (objc/send-l (objc/send ov (objc/sel "tableColumns"))
                                     (objc/sel "objectAtIndex:") 0))
      (reload! ov)
      (show-expansion! t))))

(defmethod ui/backend-tree-refresh [(b cocoa-backend) t item]
  (let [ov (table-of t)]
    (if item
      (quietly (fn [] (objc/send-pb-void ov (objc/sel "reloadItem:reloadChildren:")
                                         (item-ptr t item) true)))
      (reload! ov))
    (show-expansion! t)))

(defmethod native-natural-size [(t ui/tree-view-widget)]
  [160 120])

(defmethod native-expanded [(t ui/tree-view-widget) p expanded]
  (when-not (quiet?)
    (when-let [item (item-of p)]
      (ui/expansion-changed-by-user! t item expanded))))

(defmethod native-selection-changed [(t ui/tree-view-widget) ov]
  (when-not (quiet?)
    (let [items (mapv (fn [r] (item-of (objc/send-l ov (objc/sel "itemAtRow:") r)))
                      (selected-rows ov))]
      (when (not= items (vec (:selection t)))
        (ui/tree-selection-changed-by-user! t items)))))

(defmethod native-double-action [(t ui/tree-view-widget) ov]
  (let [row (activated-row ov)]
    (when (>= row 0)
      (ui/tree-item-activated-by-user! t (item-of (objc/send-l ov (objc/sel "itemAtRow:") row))))))

;;; ------------------------------------------------------------------------------------
;;; Canvases: a flipped view whose drawRect: and input methods are Skein's

(defmethod make-native [(c ui/canvas-widget)]
  (let [n (objc/send-r (objc/alloc "SkeinCanvasView") (objc/sel "initWithFrame:")
                       (objc/rect 0 0 100 100))
        ;; NSTrackingMouseEnteredAndExited 1 | MouseMoved 2 | ActiveInKeyWindow 0x20 |
        ;; InVisibleRect 0x200: :mouse-enter, :mouse-leave and :mouse-move.
        area (objc/send-rlpp (objc/alloc "NSTrackingArea")
                             (objc/sel "initWithRect:options:owner:userInfo:")
                             (objc/rect 0 0 0 0) (+ 1 2 0x20 0x200) n (ffi/null))]
    (objc/send-p-void n (objc/sel "addTrackingArea:") area)
    (objc/release area)
    n))

(defmethod native-natural-size [(c ui/canvas-widget)]
  [100 100])

(defmethod ui/backend-redraw [(b cocoa-backend) c rect]
  (if rect
    (let [[x y w h] rect]
      (objc/send-r-void (view c) (objc/sel "setNeedsDisplayInRect:") (objc/rect x y w h)))
    (objc/send-b-void (view c) (objc/sel "setNeedsDisplay:") true)))

(defn ns-font
  "The NSFont of a font map (nil for the system font)."
  [font]
  (let [f (or font (ui/font))
        size (f64 (or (:size f) (objc/send-double (objc/cls "NSFont") (objc/sel "systemFontSize"))))
        weight (case (:weight f) :light -0.4 :medium 0.23 :semibold 0.3 :bold 0.4 0.0)
        base (cond (= :system (:family f))
                   (objc/send-dd (objc/cls "NSFont") (objc/sel "systemFontOfSize:weight:")
                                 size weight)
                   (= :monospace (:family f))
                   (objc/send-dd (objc/cls "NSFont") (objc/sel "monospacedSystemFontOfSize:weight:")
                                 size weight)
                   :else
                   (let [named (objc/send-pd (objc/cls "NSFont") (objc/sel "fontWithName:size:")
                                             (objc/ns-string (:family f)) size)]
                     (if (ffi/null? named)
                       (objc/send-dd (objc/cls "NSFont") (objc/sel "systemFontOfSize:weight:")
                                     size weight)
                       named)))]
    (if (:italic f)
      (objc/send-pl (objc/send (objc/cls "NSFontManager") (objc/sel "sharedFontManager"))
                    (objc/sel "convertFont:toHaveTrait:") base 1) ; NSItalicFontMask
      base)))

(defn- text-attributes
  "An NSDictionary of the font and, if given, the color for drawing or measuring text."
  [font color]
  (let [d (objc/send (objc/cls "NSMutableDictionary") (objc/sel "dictionary"))]
    (objc/send-pp-void d (objc/sel "setObject:forKey:") (ns-font font) (objc/ns-string "NSFont"))
    (when color
      (objc/send-pp-void d (objc/sel "setObject:forKey:") (ns-color color)
                         (objc/ns-string "NSColor")))
    d))

(defn- string-size [s font]
  (let [[w h] (objc/size-vec (objc/send-p-size (objc/ns-string s) (objc/sel "sizeWithAttributes:")
                                               (text-attributes font nil)))]
    [(math/ceil w) (math/ceil h)]))

(defmethod ui/backend-text-size [(b cocoa-backend) s font]
  (string-size s font))

(defclass cocoa-context [ui/graphics-context]
  "A graphics context drawing with CoreGraphics in a canvas's view."
  (cg :init nil :doc "The CGContextRef."))

(defn- rgba
  "[r g b a] of a color designator, a system color resolved now."
  [d]
  (let [c (ui/ensure-color d)
        c (if (or (keyword? c) (ui/system-tint? c)) (color-of (ns-color c)) c)]
    [(f64 (ui/color-red c)) (f64 (ui/color-green c)) (f64 (ui/color-blue c))
     (f64 (ui/color-alpha c))]))

(defmethod ui/gc-set-fill-color [(gc cocoa-context) c]
  (let [[r g b a] (rgba c)] (objc/cg-set-fill (:cg gc) r g b a)))

(defmethod ui/gc-set-stroke-color [(gc cocoa-context) c]
  (let [[r g b a] (rgba c)] (objc/cg-set-stroke (:cg gc) r g b a)))

(defmethod ui/gc-set-line-width [(gc cocoa-context) w]
  (objc/cg-set-line-width (:cg gc) w))

(defmethod ui/gc-set-line-style [(gc cocoa-context) cap join dash]
  (objc/cg-set-line-cap (:cg gc) (case cap :round 1 :square 2 0))
  (objc/cg-set-line-join (:cg gc) (case join :round 1 :bevel 2 0))
  (if (seq dash)
    (ffi/with-foreign [lengths (ffi/alloc f64 (count dash))]
      (doseq [[i x] (map-indexed vector dash)] (ffi/put! lengths f64 (f64 x) i))
      (objc/cg-set-line-dash (:cg gc) 0.0 lengths (count dash)))
    (objc/cg-set-line-dash (:cg gc) 0.0 (ffi/null) 0)))

(defmethod ui/gc-save [(gc cocoa-context)] (objc/cg-save (:cg gc)))
(defmethod ui/gc-restore [(gc cocoa-context)] (objc/cg-restore (:cg gc)))
(defmethod ui/gc-translate [(gc cocoa-context) dx dy] (objc/cg-translate (:cg gc) dx dy))
(defmethod ui/gc-scale [(gc cocoa-context) sx sy] (objc/cg-scale (:cg gc) sx sy))
(defmethod ui/gc-rotate [(gc cocoa-context) r] (objc/cg-rotate (:cg gc) r))

(defmethod ui/gc-clip-rectangle [(gc cocoa-context) x y w h]
  (objc/cg-clip-rect (:cg gc) (objc/rect x y w h)))

(defmethod ui/gc-rectangle [(gc cocoa-context) x y w h mode]
  (if (= mode :fill)
    (objc/cg-fill-rect (:cg gc) (objc/rect x y w h))
    (objc/cg-stroke-rect (:cg gc) (objc/rect x y w h))))

(defmethod ui/gc-ellipse [(gc cocoa-context) x y w h mode]
  (if (= mode :fill)
    (objc/cg-fill-ellipse (:cg gc) (objc/rect x y w h))
    (objc/cg-stroke-ellipse (:cg gc) (objc/rect x y w h))))

(defmethod ui/gc-begin-path [(gc cocoa-context)] (objc/cg-begin-path (:cg gc)))
(defmethod ui/gc-move-to [(gc cocoa-context) x y] (objc/cg-move-to (:cg gc) x y))
(defmethod ui/gc-line-to [(gc cocoa-context) x y] (objc/cg-line-to (:cg gc) x y))

(defmethod ui/gc-curve-to [(gc cocoa-context) x1 y1 x2 y2 x y]
  (objc/cg-curve-to (:cg gc) x1 y1 x2 y2 x y))

(defmethod ui/gc-arc [(gc cocoa-context) cx cy r start end]
  ;; In a flipped view, CoreGraphics' counterclockwise is clockwise on the screen.
  (objc/cg-arc (:cg gc) cx cy r start end 0))

(defmethod ui/gc-close-path [(gc cocoa-context)] (objc/cg-close-path (:cg gc)))

(defmethod ui/gc-draw-path [(gc cocoa-context) mode]
  ;; kCGPathFill 0, kCGPathStroke 2, kCGPathFillStroke 3
  (objc/cg-draw-path (:cg gc) (case mode :stroke 2 :fill-and-stroke 3 0)))

(defmethod ui/gc-text [(gc cocoa-context) s x y font color]
  (objc/send-point-p-void (objc/ns-string s) (objc/sel "drawAtPoint:withAttributes:")
                          {:x (f64 x) :y (f64 y)} (text-attributes font color)))

(defmethod ui/gc-text-size [(gc cocoa-context) s font]
  (string-size s font))

(defmethod ui/gc-image [(gc cocoa-context) image x y w h]
  ;; NSCompositingOperationSourceOver 2; respectFlipped draws it the right way up.
  (objc/send-rrldbp-void (ns-image image)
                         (objc/sel "drawInRect:fromRect:operation:fraction:respectFlipped:hints:")
                         (objc/rect x y w h) (objc/rect 0 0 0 0) 2 1.0 true (ffi/null)))

(defn- current-cg []
  (objc/send (objc/send (objc/cls "NSGraphicsContext") (objc/sel "currentContext"))
             (objc/sel "CGContext")))

(defmethod native-draw [(c ui/canvas-widget)]
  (let [[_ _ w h] (objc/rect-vec (objc/send-rect (view c) (objc/sel "bounds")))
        gc (make cocoa-context :cg (current-cg) :width w :height h :widget c)]
    (when (:background c)
      (ui/paint! gc (:background c)))
    (ui/emit! c (ui/event-for c :draw :context gc :width w :height h))))

(def ^:private named-keys
  {36 :return 76 :return 53 :escape 48 :tab 51 :backspace 117 :delete 123 :left 124 :right
   125 :down 126 :up 115 :home 119 :end 116 :page-up 121 :page-down 49 :space
   122 :f1 120 :f2 99 :f3 118 :f4 96 :f5 97 :f6 98 :f7 100 :f8 101 :f9 109 :f10
   103 :f11 111 :f12})

(defn- event-modifiers
  "The set of modifier keys an NSEvent had."
  [e]
  (let [flags (objc/send-long e (objc/sel "modifierFlags"))]
    (set (keep (fn [[bit m]] (when (pos? (bit-and flags bit)) m))
               [[0x20000 :shift] [0x40000 :control] [0x80000 :alt] [0x100000 :command]]))))

(defmethod native-input [(c ui/canvas-widget) signal button e]
  (let [n (view c)
        mods (event-modifiers e)]
    (if (or (= signal :key-down) (= signal :key-up))
      (let [code (objc/send-long e (objc/sel "keyCode"))
            chars (objc/string-of (objc/send e (objc/sel "charactersIgnoringModifiers")))
            key (or (get named-keys code)
                    (when (seq chars) (first (string/lower-case chars))))]
        (ui/emit! c (ui/event-for c signal :key key :modifiers mods
                                  :text (or (objc/string-of (objc/send e (objc/sel "characters")))
                                            "")
                                  :repeat (and (= signal :key-down)
                                               (objc/send-bool e (objc/sel "isARepeat"))))))
      (let [p (objc/send-point-p n (objc/sel "convertPoint:fromView:")
                                 (let [w (objc/send-point e (objc/sel "locationInWindow"))]
                                   {:x (ffi/field w objc/ns-point :x)
                                    :y (ffi/field w objc/ns-point :y)})
                                 (ffi/null))
            x (ffi/field p objc/ns-point :x)
            y (ffi/field p objc/ns-point :y)]
        (when (and (= signal :mouse-down) (:focusable c))
          (objc/send-p-void (objc/send n (objc/sel "window")) (objc/sel "makeFirstResponder:") n))
        (ui/emit! c (if (= signal :scroll)
                      (ui/event-for c :scroll :x x :y y :modifiers mods
                                    :delta-x (objc/send-double e (objc/sel "scrollingDeltaX"))
                                    :delta-y (objc/send-double e (objc/sel "scrollingDeltaY"))
                                    :precise (objc/send-bool
                                              e (objc/sel "hasPreciseScrollingDeltas")))
                      (ui/event-for c signal :x x :y y :button button :modifiers mods
                                    :click-count (if (or (= signal :mouse-down)
                                                         (= signal :mouse-up))
                                                   (objc/send-long e (objc/sel "clickCount"))
                                                   0))))))))

;;; ------------------------------------------------------------------------------------
;;; Menus: NSMenu and NSMenuItem. A window's menu bar is the application's main menu
;;; while the window has the keyboard; its first menu is the application menu, which gets
;;; the items with the :about, :preferences and :quit roles.

(def ^:private command-mask 0x100000)
(def ^:private option-mask 0x80000)

(defn- add-item! [menu item] (objc/send-p-void menu (objc/sel "addItem:") item))

(defn- new-menu-item
  "A new NSMenuItem, owned."
  [title action key mask target]
  (let [item (objc/send-ppp (objc/alloc "NSMenuItem")
                            (objc/sel "initWithTitle:action:keyEquivalent:")
                            (objc/ns-string title) (objc/sel action) (objc/ns-string key))]
    (when target (objc/send-p-void item (objc/sel "setTarget:") target))
    (objc/send-l-void item (objc/sel "setKeyEquivalentModifierMask:") mask)
    item))

(defn- new-menu
  "A new NSMenu, owned, whose items we enable."
  [title]
  (let [m (objc/send-p (objc/alloc "NSMenu") (objc/sel "initWithTitle:") (objc/ns-string title))]
    (objc/send-b-void m (objc/sel "setAutoenablesItems:") false)
    (objc/send-p-void m (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
    m))

(defmethod make-native [(bar ui/menu-bar-widget)]
  (let [b (ui/current-backend)
        main (new-menu "")
        app-item (objc/new-object "NSMenuItem")
        app (new-menu "App")]
    (doseq [[title action key mask] [["Hide" "hide:" "h" command-mask]
                                     ["Hide Others" "hideOtherApplications:" "h"
                                      (+ command-mask option-mask)]
                                     ["Show All" "unhideAllApplications:" "" 0]]]
      (let [i (new-menu-item title action key mask nil)]
        (add-item! app i)
        (objc/release i)))
    (add-item! app (objc/send (objc/cls "NSMenuItem") (objc/sel "separatorItem")))
    (let [q (new-menu-item "Quit" "quitAction:" "q" command-mask (:target b))]
      (add-item! app q)
      (objc/release q))
    (objc/send-p-void app-item (objc/sel "setTitle:") (objc/ns-string ""))
    (objc/send-p-void app-item (objc/sel "setSubmenu:") app)
    (objc/release app)
    (add-item! main app-item)
    (objc/release app-item)
    main))

(defmethod make-native [(m ui/menu-widget)] (new-menu ""))

(defmethod make-native [(item ui/menu-item-widget)]
  (new-menu-item "" "action:" "" 0 (:target (ui/current-backend))))

(defmethod make-native [(s ui/menu-separator-widget)]
  (objc/retain (objc/send (objc/cls "NSMenuItem") (objc/sel "separatorItem"))))

(defn- bar-of
  "The menu bar the menu object is in, or nil."
  [o]
  (first (filter (fn [p] (instance? ui/menu-bar-widget p))
                 (take-while some? (iterate :parent o)))))

(defn- app-menu [bar]
  (objc/send (objc/send-l (view bar) (objc/sel "itemAtIndex:") 0) (objc/sel "submenu")))

(defn- items-of [menu]
  (let [items (objc/send menu (objc/sel "itemArray"))]
    (mapv (fn [i] (objc/send-l items (objc/sel "objectAtIndex:") i))
          (range (objc/send-long items (objc/sel "count"))))))

(defn- detach-item! [item]
  (let [menu (objc/send item (objc/sel "menu"))]
    (when-not (ffi/null? menu)
      (objc/send-p-void menu (objc/sel "removeItem:") item))))

(defn- place-in-app-menu!
  "Put the menu item with an application role in the bar's application menu, where macOS
has it: About first, Settings after it, Quit last, in place of the default Quit."
  [bar item]
  (let [app (app-menu bar)
        n (view item)
        insert! (fn [x i] (objc/send-pl app (objc/sel "insertItem:atIndex:") x i))
        separator (fn [] (objc/send (objc/cls "NSMenuItem") (objc/sel "separatorItem")))]
    (detach-item! n)
    (case (:role item)
      :about (do (insert! (separator) 0) (insert! n 0))
      :preferences (let [after-about (if (some (fn [i] (= :about (:role (objc/object-for i))))
                                               (items-of app))
                                       2 0)]
                     (insert! (separator) after-about)
                     (insert! n after-about))
      :quit (do (doseq [i (items-of app)]
                  (when (= "quitAction:" (objc/sel-name (objc/send i (objc/sel "action"))))
                    (objc/send-p-void app (objc/sel "removeItem:") i)))
                (add-item! app n)))))

(def ^:private app-roles #{:about :preferences :quit})

(defn- place-app-items! [bar m]
  (ui/map-menu-items (fn [item _] (when (contains? app-roles (:role item))
                                    (place-in-app-menu! bar item)))
                     m))

(defn- add-to-menu!
  "Put child's NSMenuItem (a submenu's, for a menu) in the NSMenu of parent."
  [parent child]
  (if (instance? ui/menu-widget child)
    (let [item (objc/new-object "NSMenuItem")]
      (objc/send-p-void item (objc/sel "setTitle:") (objc/ns-string (or (:title child) "")))
      (objc/send-p-void item (objc/sel "setSubmenu:") (view child))
      (add-item! (view parent) item)
      (objc/release item)
      (when-let [bar (bar-of parent)] (place-app-items! bar child)))
    (if-let [bar (when (contains? app-roles (:role child)) (bar-of parent))]
      (place-in-app-menu! bar child)
      (add-item! (view parent) (view child)))))

(defmethod ui/backend-add-child [(b cocoa-backend) (parent ui/menu-bar-widget) child]
  (add-to-menu! parent child))

(defmethod ui/backend-add-child [(b cocoa-backend) (parent ui/menu-widget) child]
  (add-to-menu! parent child))

(defn- remove-from-menu! [parent child]
  (if (instance? ui/menu-widget child)
    (let [i (objc/send-p-long (view parent) (objc/sel "indexOfItemWithSubmenu:") (view child))]
      (when (>= i 0) (objc/send-l-void (view parent) (objc/sel "removeItemAtIndex:") i)))
    (detach-item! (view child))))

(defmethod ui/backend-remove-child [(b cocoa-backend) (parent ui/menu-bar-widget) child]
  (remove-from-menu! parent child))

(defmethod ui/backend-remove-child [(b cocoa-backend) (parent ui/menu-widget) child]
  (remove-from-menu! parent child))

(defmethod set-native [(m ui/menu-widget) (p (= :title)) v]
  (let [n (view m)
        super (objc/send n (objc/sel "supermenu"))]
    (objc/send-p-void n (objc/sel "setTitle:") (objc/ns-string (or v "")))
    (when-not (ffi/null? super)
      (let [i (objc/send-p-long super (objc/sel "indexOfItemWithSubmenu:") n)]
        (when (>= i 0)
          (objc/send-p-void (objc/send-l super (objc/sel "itemAtIndex:") i) (objc/sel "setTitle:")
                            (objc/ns-string (or v ""))))))))

(defmethod set-native [(item ui/menu-item-widget) (p (= :label)) v]
  (set-string! item "setTitle:" v))

(defmethod set-native [(item ui/menu-item-widget) (p (= :enabled)) v]
  (set-bool! item "setEnabled:" v))

(defmethod set-native [(item ui/check-menu-item-widget) (p (= :checked)) v]
  (set-long! item "setState:" (if v 1 0)))

(def ^:private key-equivalents
  "The characters AppKit's key equivalents use for named keys."
  {:return "\r" :escape "\u001b" :tab "\t" :backspace "\b" :delete "" :space " "
   :up "" :down "" :left "" :right "" :home "" :end ""
   :page-up "" :page-down "" :f1 "" :f2 "" :f3 ""
   :f4 "" :f5 "" :f6 "" :f7 "" :f8 "" :f9 ""
   :f10 "" :f11 "" :f12 ""})

(defn- modifier-mask [mods]
  (reduce + 0 (keep {:shift 0x20000 :control 0x40000 :alt 0x80000 :command 0x100000} mods)))

(defmethod set-native [(item ui/menu-item-widget) (p (= :shortcut)) s]
  (let [[key mods] (if s (ui/parse-shortcut s) [nil #{}])]
    (set-string! item "setKeyEquivalent:" (cond (nil? key) ""
                                                (char? key) (str key)
                                                :else (get key-equivalents key "")))
    (set-long! item "setKeyEquivalentModifierMask:" (modifier-mask mods))))

(defmethod native-action [(item ui/menu-item-widget) sender]
  (ui/activate-menu-item! item))

(defn- install-menu-bar!
  "Make the window's menu bar, or else the application's, the main menu."
  [w]
  (when-let [bar (or (:menu-bar w) (:menu-bar ui/app))]
    (objc/send-p-void (:app (ui/current-backend)) (objc/sel "setMainMenu:") (view bar))))

(defmethod set-native [(w ui/window-widget) (p (= :menu-bar)) bar]
  (when (objc/send-bool (view w) (objc/sel "isKeyWindow"))
    (install-menu-bar! w)))

(defmethod ui/backend-popup-menu [(b cocoa-backend) m widget x y]
  (objc/send-ppointp-bool (view m) (objc/sel "popUpMenuPositioningItem:atLocation:inView:")
                          (ffi/null) {:x (f64 x) :y (f64 y)} (view widget)))

(def ^:private role-actions
  {:undo "undo:" :redo "redo:" :cut "cut:" :copy "copy:" :paste "paste:" :delete "delete:"
   :select-all "selectAll:" :minimize "performMiniaturize:" :zoom "performZoom:"
   :fullscreen "toggleFullScreen:"})

(defmethod ui/backend-perform-role [(b cocoa-backend) role]
  (when-let [action (get role-actions role)]
    ;; To the first responder: the focused field, else the key window.
    (objc/send-ppp-bool (:app b) (objc/sel "sendAction:to:from:") (objc/sel action) (ffi/null)
                        (ffi/null))))

(defmethod ui/backend-active-window [(b cocoa-backend)]
  (objc/object-for (objc/send (:app b) (objc/sel "keyWindow"))))

(defmethod ui/backend-shortcut-label [(b cocoa-backend) shortcut]
  (let [[key mods] (ui/parse-shortcut shortcut)
        symbols (apply str (keep (fn [[m s]] (when (contains? mods m) s))
                                 [[:control "⌃"] [:alt "⌥"] [:shift "⇧"] [:command "⌘"]]))
        key-label (if (char? key)
                    (string/upper-case (str key))
                    (get {:return "↩" :escape "⎋" :tab "⇥" :backspace "⌫" :delete "⌦"
                          :left "←" :right "→" :up "↑" :down "↓" :space "Space"}
                         key (string/upper-case (name key))))]
    (str symbols key-label)))

;;; ------------------------------------------------------------------------------------
;;; Dialogs: NSAlert and the open and save panels, run modally

(def ^:private next-answer
  "For tests: what the next dialog answers (answer-next-dialog!), or nil."
  (atom nil))

(def ^:private open-dialog
  "The modal dialog that is open: {:kind :alert, :prompt or :panel, :object, :field}."
  (atom nil))

(defn- run-modal [kind o field]
  (let [b (ui/current-backend)]
    (reset! open-dialog {:kind kind :object o :field field})
    (when (some? @next-answer)
      (objc/send-ppdp-void (:target b) (objc/sel "performSelector:withObject:afterDelay:inModes:")
                           (objc/sel "autoAnswer:") (ffi/null) 0.05 (:modes b)))
    (try (objc/send-long o (objc/sel "runModal"))
         (finally (reset! open-dialog nil)))))

(defn- items-of-array [a]
  (mapv (fn [i] (objc/send-l a (objc/sel "objectAtIndex:") i))
        (range (objc/send-long a (objc/sel "count")))))

(defn- click-button! [alert i]
  (objc/send-p-void (objc/send-l (objc/send alert (objc/sel "buttons"))
                                 (objc/sel "objectAtIndex:") i)
                    (objc/sel "performClick:") (ffi/null)))

(defn- auto-answer! []
  (let [{answer :answer} @next-answer
        {:keys [kind object field]} @open-dialog]
    (reset! next-answer nil)
    (case kind
      :alert (let [titles (mapv (fn [b] (objc/string-of (objc/send b (objc/sel "title"))))
                                (items-of-array (objc/send object (objc/sel "buttons"))))]
               (click-button! object (if (integer? answer) answer (or (index-of titles answer) 0))))
      :prompt (if (nil? answer)
                (click-button! object 1)
                (do (objc/send-p-void field (objc/sel "setStringValue:") (objc/ns-string answer))
                    (click-button! object 0)))
      :panel (objc/send-p-void object (objc/sel "cancel:") (ffi/null))
      nil)))

(defmethod ui/backend-message-box [(b cocoa-backend) parent message detail type labels]
  (let [alert (objc/new-object "NSAlert")]
    (objc/send-p-void alert (objc/sel "setMessageText:") (objc/ns-string message))
    (when detail (objc/send-p-void alert (objc/sel "setInformativeText:") (objc/ns-string detail)))
    ;; NSAlertStyleWarning 0, Informational 1, Critical 2
    (objc/send-l-void alert (objc/sel "setAlertStyle:") (case type :warning 0 :error 2 1))
    (doseq [l labels] (objc/send-p alert (objc/sel "addButtonWithTitle:") (objc/ns-string l)))
    (let [r (run-modal :alert alert nil)
          i (- r 1000)]
      (objc/release alert)
      (when (< -1 i (count labels)) i))))

(defmethod ui/backend-prompt-text [(b cocoa-backend) parent message detail default ok cancel]
  (let [alert (objc/new-object "NSAlert")
        field (init-frame "NSTextField")]
    (objc/send-r-void field (objc/sel "setFrame:") (objc/rect 0 0 260 24))
    (objc/send-p-void field (objc/sel "setStringValue:") (objc/ns-string default))
    (objc/send-p-void alert (objc/sel "setMessageText:") (objc/ns-string message))
    (when detail (objc/send-p-void alert (objc/sel "setInformativeText:") (objc/ns-string detail)))
    (objc/send-p alert (objc/sel "addButtonWithTitle:") (objc/ns-string ok))
    (objc/send-p alert (objc/sel "addButtonWithTitle:") (objc/ns-string cancel))
    (objc/send-p-void alert (objc/sel "setAccessoryView:") field)
    (objc/send-p-void (objc/send alert (objc/sel "window")) (objc/sel "setInitialFirstResponder:")
                      field)
    (let [r (run-modal :prompt alert field)
          text (when (= r 1000) (objc/string-of (objc/send field (objc/sel "stringValue"))))]
      (objc/release field)
      (objc/release alert)
      text)))

(defmethod ui/backend-choose-file [(b cocoa-backend) parent opts]
  (let [mode (:mode opts)
        panel (objc/send (objc/cls (if (= mode :save) "NSSavePanel" "NSOpenPanel"))
                         (objc/sel (if (= mode :save) "savePanel" "openPanel")))]
    (when (not= mode :save)
      (objc/send-b-void panel (objc/sel "setCanChooseFiles:") (= mode :open))
      (objc/send-b-void panel (objc/sel "setCanChooseDirectories:") (= mode :directory))
      (objc/send-b-void panel (objc/sel "setAllowsMultipleSelection:") (boolean (:multiple opts))))
    (when (and (= mode :save) (:name opts))
      (objc/send-p-void panel (objc/sel "setNameFieldStringValue:") (objc/ns-string (:name opts))))
    (when-let [t (:title opts)]
      (objc/send-p-void panel (objc/sel "setMessage:") (objc/ns-string t)))
    (when-let [d (:directory opts)]
      (objc/send-p-void panel (objc/sel "setDirectoryURL:")
                        (objc/send-p (objc/cls "NSURL") (objc/sel "fileURLWithPath:")
                                     (objc/ns-string d))))
    (when-let [extensions (seq (mapcat rest (:filters opts)))]
      (objc/send-p-void panel (objc/sel "setAllowedFileTypes:")
                        (reduce (fn [a e] (objc/send-p a (objc/sel "arrayByAddingObject:")
                                                       (objc/ns-string e)))
                                (objc/send (objc/cls "NSArray") (objc/sel "array"))
                                extensions)))
    (when (= 1 (run-modal :panel panel nil))
      (let [path (fn [url] (objc/string-of (objc/send url (objc/sel "path"))))]
        (if (= mode :save)
          [(path (objc/send panel (objc/sel "URL")))]
          (mapv path (items-of-array (objc/send panel (objc/sel "URLs")))))))))

(defmethod ui/backend-show-about [(b cocoa-backend) info]
  (let [d (objc/send (objc/cls "NSMutableDictionary") (objc/sel "dictionary"))
        put! (fn [k v] (objc/send-pp-void d (objc/sel "setObject:forKey:") v (objc/ns-string k)))]
    (when (:name info) (put! "ApplicationName" (objc/ns-string (:name info))))
    (when (:version info) (put! "ApplicationVersion" (objc/ns-string (:version info))))
    (when (:copyright info) (put! "Copyright" (objc/ns-string (:copyright info))))
    (when-let [credits (seq (remove nil? [(:comments info) (:website info)]))]
      (put! "Credits" (objc/autorelease
                       (objc/send-p (objc/alloc "NSAttributedString") (objc/sel "initWithString:")
                                    (objc/ns-string (string/join "\n" credits))))))
    (when (:icon info) (put! "ApplicationIcon" (ns-image (:icon info))))
    (objc/send-p-void (:app b) (objc/sel "orderFrontStandardAboutPanelWithOptions:") d)))

;;; ------------------------------------------------------------------------------------
;;; Timers, the clipboard and the system

(def ^:private run-loop-modes
  ["kCFRunLoopDefaultMode" "NSModalPanelRunLoopMode" "NSEventTrackingRunLoopMode"])

(defmethod ui/backend-start-timer [(b cocoa-backend) t]
  (let [timer (objc/retain
               (objc/send-dpppb (objc/cls "NSTimer")
                                (objc/sel "timerWithTimeInterval:target:selector:userInfo:repeats:")
                                (f64 (:interval t)) (:target b) (objc/sel "timerFired:")
                                (ffi/null) (boolean (:repeat t))))
        run-loop (objc/send (objc/cls "NSRunLoop") (objc/sel "mainRunLoop"))]
    (doseq [mode run-loop-modes]
      (objc/send-pp-void run-loop (objc/sel "addTimer:forMode:") timer (objc/ns-string mode)))
    (objc/register! timer t)))

(defmethod ui/backend-stop-timer [(b cocoa-backend) t timer]
  (objc/send-void timer (objc/sel "invalidate"))
  (objc/unregister! timer)
  (objc/release timer))

(defn- pasteboard []
  (objc/send (objc/cls "NSPasteboard") (objc/sel "generalPasteboard")))

(def ^:private text-type "public.utf8-plain-text")

(defmethod ui/backend-clipboard-text [(b cocoa-backend)]
  (objc/string-of (objc/send-p (pasteboard) (objc/sel "stringForType:")
                               (objc/ns-string text-type))))

(defmethod ui/backend-set-clipboard-text [(b cocoa-backend) s]
  (objc/send-long (pasteboard) (objc/sel "clearContents"))
  (objc/send-pp-bool (pasteboard) (objc/sel "setString:forType:") (objc/ns-string s)
                     (objc/ns-string text-type)))

(defmethod ui/backend-beep [(b cocoa-backend)]
  (objc/ns-beep))

(defmethod ui/backend-open-url [(b cocoa-backend) url]
  (objc/send-p-bool (objc/send (objc/cls "NSWorkspace") (objc/sel "sharedWorkspace"))
                    (objc/sel "openURL:")
                    (objc/send-p (objc/cls "NSURL") (objc/sel "URLWithString:")
                                 (objc/ns-string url))))

(defmethod ui/backend-system-color [(b cocoa-backend) name]
  (color-of (ns-color name)))

(defmethod ui/backend-dark-mode? [(b cocoa-backend)]
  (let [names (reduce (fn [a n] (objc/send-p a (objc/sel "arrayByAddingObject:")
                                             (objc/ns-string n)))
                      (objc/send (objc/cls "NSArray") (objc/sel "array"))
                      ["NSAppearanceNameAqua" "NSAppearanceNameDarkAqua"])]
    (= "NSAppearanceNameDarkAqua"
       (objc/string-of (objc/send-p (objc/send (:app b) (objc/sel "effectiveAppearance"))
                                    (objc/sel "bestMatchFromAppearancesWithNames:") names)))))

;;; ------------------------------------------------------------------------------------
;;; For tests: the real controls, read and acted on

(defn native-frame
  "The AppKit frame of the widget's view, [x y width height] in its container's
coordinates (from the top left)."
  [w]
  (mapv (fn [x] (int (math/round x)))
        (objc/rect-vec (objc/send-rect (view w) (objc/sel "frame")))))

(defn native-string
  "The text the widget's control shows: a button's or a window's title, or a field's
string value."
  [w]
  (let [n (view w)]
    (objc/call-with-pool
     (fn []
       (objc/string-of (objc/send n (objc/sel (if (objc/responds? n "title")
                                                "title"
                                                "stringValue"))))))))

(defn native-bool
  "The BOOL the widget's AppKit object answers to the selector named name, such as
\"isHidden\"."
  [w name]
  (objc/send-bool (view w) (objc/sel name)))

(defn click!
  "Click the button, as AppKit does for a mouse click (performClick:)."
  [b]
  (objc/send-p-void (view b) (objc/sel "performClick:") (ffi/null)))

(defn type-text!
  "Make the field's text s and tell its delegate the text changed, as typing does."
  [e s]
  (objc/call-with-pool
   (fn []
     (objc/send-p-void (view e) (objc/sel "setStringValue:") (objc/ns-string s))
     (objc/send-pp-void (objc/send (objc/cls "NSNotificationCenter") (objc/sel "defaultCenter"))
                        (objc/sel "postNotificationName:object:")
                        (objc/ns-string "NSControlTextDidChangeNotification") (view e)))))

(defn press-return!
  "Send the field's action, as pressing Return in it does."
  [e]
  (let [n (view e)]
    (objc/send-pp-void n (objc/sel "sendAction:to:")
                       (objc/send n (objc/sel "action")) (objc/send n (objc/sel "target")))))

(defn native-double
  "The double the widget's AppKit control answers to the selector named name."
  [w name]
  (objc/send-double (view w) (objc/sel name)))

(defn set-native-double!
  "Set a slider's double value and send its action, as dragging it does."
  [w v]
  (let [n (view w)]
    (objc/send-d-void n (objc/sel "setDoubleValue:") (f64 v))
    (objc/send-pp-void n (objc/sel "sendAction:to:")
                       (objc/send n (objc/sel "action")) (objc/send n (objc/sel "target")))))

(defn native-spin-text
  "The text in a spin button's field."
  [w]
  (objc/call-with-pool
   (fn [] (objc/string-of (objc/send (first (spin-parts w)) (objc/sel "stringValue"))))))

(defn native-title-of-selected
  "The title of a combo box's chosen item."
  [c]
  (objc/call-with-pool
   (fn [] (objc/string-of (objc/send (view c) (objc/sel "titleOfSelectedItem"))))))

(defn choose-item!
  "Choose the item at index in a combo box, as the user does."
  [c index]
  (let [n (view c)]
    (objc/send-l-void n (objc/sel "selectItemAtIndex:") index)
    (objc/send-pp-void n (objc/sel "sendAction:to:")
                       (objc/send n (objc/sel "action")) (objc/send n (objc/sel "target")))))

(defn native-color
  "The color a color button shows."
  [c]
  (objc/call-with-pool (fn [] (color-of (objc/send (view c) (objc/sel "color"))))))

(defn native-date
  "The date a date picker shows, in milliseconds since 1970."
  [d]
  (objc/call-with-pool
   (fn [] (int (math/round (* 1000 (double-of (objc/send (view d) (objc/sel "dateValue"))
                                              "timeIntervalSince1970")))))))

(defn has-image?
  "True if the image view or button shows an image."
  [w]
  (not (ffi/null? (objc/send (view w) (objc/sel "image")))))

(defn tab-labels
  "The labels of a notebook's tabs."
  [n]
  (objc/call-with-pool
   (fn [] (mapv (fn [i] (objc/string-of (objc/send (tab-item n i) (objc/sel "label"))))
                (range (objc/send-long (view n) (objc/sel "numberOfTabViewItems")))))))

(defn choose-tab!
  "Click the notebook's tab at index, as the user does."
  [n index]
  (objc/send-l-void (view n) (objc/sel "selectTabViewItemAtIndex:") index))

(defn scroll-origin
  "The point of a scrolled window's content at its top left, [x y]."
  [s]
  (let [[x y] (objc/rect-vec (objc/send-rect (clip-view s) (objc/sel "bounds")))]
    [(int (math/round x)) (int (math/round y))]))

(defn native-text
  "The text in a text view's NSTextView."
  [v]
  (objc/call-with-pool (fn [] (objc/string-of (objc/send (text-view-of v) (objc/sel "string"))))))

(defn row-count
  "How many rows a list box's, table's or tree's view shows."
  [w]
  (objc/send-long (table-of w) (objc/sel "numberOfRows")))

(defn cell-string
  "The text in a list box's, table's or tree's view at row and column, as AppKit draws it."
  [w row column]
  (objc/call-with-pool
   (fn [] (let [v (objc/send-llb (table-of w) (objc/sel "viewAtColumn:row:makeIfNecessary:")
                                 column row true)]
            (objc/string-of (objc/send (objc/send v (objc/sel "textField"))
                                       (objc/sel "stringValue")))))))

(defn cell-image
  "The NSImage in a list box's, table's or tree's cell at row and column, or null."
  [w row column]
  (let [v (objc/send-llb (table-of w) (objc/sel "viewAtColumn:row:makeIfNecessary:") column row true)]
    (objc/send (objc/send v (objc/sel "imageView")) (objc/sel "image"))))

(defn select-rows-natively!
  "Select rows in a list box's, table's or tree's view, as the user does."
  [w rows]
  (let [set (objc/new-object "NSMutableIndexSet")]
    (doseq [r rows] (objc/send-l-void set (objc/sel "addIndex:") r))
    (objc/send-pb-void (table-of w) (objc/sel "selectRowIndexes:byExtendingSelection:") set false)
    (objc/release set)))

(defn double-click-selected!
  "Send a list box's, table's or tree's double action for its selected row."
  [w]
  (let [tv (table-of w)]
    (objc/send-pp-void tv (objc/sel "sendAction:to:")
                       (objc/send tv (objc/sel "doubleAction"))
                       (objc/send tv (objc/sel "target")))))

(defn cell-point
  "The middle of the cell at row and column (a position in the view) of a list box's,
table's or tree's view, as its mouse events give points."
  [w row column]
  (let [r (objc/send-ll-rect (table-of w) (objc/sel "frameOfCellAtColumn:row:") column row)]
    [(+ (ffi/field r objc/ns-rect :x) (/ (ffi/field r objc/ns-rect :width) 2))
     (+ (ffi/field r objc/ns-rect :y) (/ (ffi/field r objc/ns-rect :height) 2))]))

(defn- cell-field [w row column]
  (objc/send (objc/send-llb (table-of w) (objc/sel "viewAtColumn:row:makeIfNecessary:")
                            column row true)
             (objc/sel "textField")))

(defn cell-editable?
  "Whether AppKit lets the user edit the cell at row and column (a place in the view)."
  [w row column]
  (objc/call-with-pool (fn [] (objc/send-bool (cell-field w row column) (objc/sel "isEditable")))))

(defn edit-cell-natively!
  "Edit a table's cell at row and column (a place in the view) to text, as the user does:
start editing it, type the text over it and press Return."
  [t row column text]
  (let [tv (table-of t)]
    (objc/send-llpb-void tv (objc/sel "editColumn:row:withEvent:select:")
                         column row (ffi/null) true)
    (let [editor (objc/send (cell-field t row column) (objc/sel "currentEditor"))]
      (when (ffi/null? editor) (error "AppKit didn't start editing the cell"))
      (objc/send-p-void editor (objc/sel "setString:") (objc/ns-string text))
      (objc/send-p-void editor (objc/sel "insertNewline:") (ffi/null)))))

(defn move-column-natively!
  "Drag a table's column from one place to another, as the user would."
  [t from to]
  (objc/send-ll-void (table-of t) (objc/sel "moveColumn:toColumn:") from to))

(defn click-column-title!
  "Tell a table's delegate its column at index was clicked, as AppKit does."
  [t index]
  (let [tv (table-of t)]
    (objc/send-pp-void (objc/send tv (objc/sel "delegate"))
                       (objc/sel "tableView:didClickTableColumn:")
                       tv (objc/send-l (objc/send tv (objc/sel "tableColumns"))
                                       (objc/sel "objectAtIndex:") index))))

(defn expand-natively!
  "Open the tree's item in its outline view, as clicking its disclosure triangle does."
  [t item]
  (objc/send-p-void (table-of t) (objc/sel "expandItem:") (item-ptr t item)))

(defn draw-into-image!
  "Draw the canvas into a bitmap, as AppKit draws it on the screen, and return the
bitmap's color at the point x, y of the view (from the top left)."
  [c x y]
  (let [n (view c)]
    (objc/call-with-pool
     (fn []
       (let [rep (objc/send-r n (objc/sel "bitmapImageRepForCachingDisplayInRect:")
                              (objc/send-rect n (objc/sel "bounds")))]
         (objc/send-rp-void n (objc/sel "cacheDisplayInRect:toBitmapImageRep:")
                            (objc/send-rect n (objc/sel "bounds")) rep)
         (let [[_ _ w _] (objc/rect-vec (objc/send-rect n (objc/sel "bounds")))
               scale (/ (objc/send-long rep (objc/sel "pixelsWide")) w)]
           (color-of (objc/send-ll rep (objc/sel "colorAtX:y:")
                                   (int (* scale x)) (int (* scale y))))))))))

(defn- mouse-event
  "An NSEvent of type (an NSEventType) at x, y in the view n (from the top left)."
  [n type x y]
  (let [win (objc/send n (objc/sel "window"))
        ;; to window coordinates (from the bottom left)
        p (objc/send-point-p n (objc/sel "convertPoint:toView:") {:x (f64 x) :y (f64 y)}
                             (ffi/null))]
    (objc/send-mouse-event
     (objc/cls "NSEvent")
     (objc/sel (str "mouseEventWithType:location:modifierFlags:timestamp:windowNumber:"
                    "context:eventNumber:clickCount:pressure:"))
     type {:x (ffi/field p objc/ns-point :x) :y (ffi/field p objc/ns-point :y)} 0 0.0
     (objc/send-long win (objc/sel "windowNumber")) (ffi/null) 0 1 1.0)))

(defn send-mouse!
  "Send the canvas's view a mouse event of type (an NSEventType: 1 down, 2 up) at x, y in
the view (from the top left), as AppKit does for a click."
  [c type x y]
  (objc/send-p-void (view c) (objc/sel (if (= type 1) "mouseDown:" "mouseUp:"))
                    (mouse-event (view c) type x y)))

(defn answer-next-dialog!
  "For tests: make the next modal dialog answer by itself, as the user clicking would: a
message box clicks the button with the label (or index) answer; a text prompt types the
text answer and clicks OK, or clicks Cancel for nil; a file chooser is cancelled."
  [answer]
  (reset! next-answer {:answer answer})
  nil)

(defn run-for!
  "Run the main thread's run loop for seconds, so timers fire, outside ui/run!."
  [seconds]
  (objc/call-with-pool
   (fn []
     (objc/send-p-void (objc/send (objc/cls "NSRunLoop") (objc/sel "currentRunLoop"))
                       (objc/sel "runUntilDate:")
                       (objc/send-d (objc/cls "NSDate") (objc/sel "dateWithTimeIntervalSinceNow:")
                                    (f64 seconds))))))

(defn menu-titles
  "The titles of the items of a menu bar's or menu's NSMenu."
  [m]
  (objc/call-with-pool
   (fn [] (mapv (fn [i] (objc/string-of (objc/send i (objc/sel "title")))) (items-of (view m))))))

(defn app-menu-titles
  "The titles of the items of a menu bar's application menu."
  [bar]
  (objc/call-with-pool
   (fn [] (mapv (fn [i] (objc/string-of (objc/send i (objc/sel "title"))))
                (items-of (app-menu bar))))))

(defn key-equivalent
  "A menu item's key equivalent and modifier mask, [string mask]."
  [item]
  (objc/call-with-pool
   (fn [] [(objc/string-of (objc/send (view item) (objc/sel "keyEquivalent")))
           (objc/send-long (view item) (objc/sel "keyEquivalentModifierMask"))])))

(defn choose-menu-item-natively!
  "Choose the menu item as AppKit does for a click: its menu performs it."
  [item]
  (let [menu (objc/send (view item) (objc/sel "menu"))
        i (objc/send-p-long menu (objc/sel "indexOfItem:") (view item))]
    (objc/send-l-void menu (objc/sel "performActionForItemAtIndex:") i)))

;;; ------------------------------------------------------------------------------------
;;; Fonts, colors, focus and context menus

(defn- font-target
  "The AppKit object whose font a widget's :font sets."
  [w]
  (if (instance? ui/text-view-widget w) (text-view-of w) (view w)))

(defmethod set-native [(w ui/widget) (p (= :font)) f]
  (let [n (font-target w)]
    (when (objc/responds? n "setFont:")
      (objc/send-p-void n (objc/sel "setFont:")
                        (if f
                          (ns-font (ui/ensure-font f))
                          (objc/send-d (objc/cls "NSFont") (objc/sel "systemFontOfSize:")
                                       (objc/send-double (objc/cls "NSFont")
                                                         (objc/sel "systemFontSize"))))))))

(defmethod set-native [(l ui/label-widget) (p (= :text-color)) c]
  (objc/send-p-void (view l) (objc/sel "setTextColor:")
                    (if c (ns-color c) (objc/send (objc/cls "NSColor") (objc/sel "labelColor")))))

(defmethod set-native [(l ui/label-widget) (p (= :background)) c]
  (objc/send-b-void (view l) (objc/sel "setDrawsBackground:") (some? c))
  (when c (objc/send-p-void (view l) (objc/sel "setBackgroundColor:") (ns-color c))))

(defn- menu-target
  "The view whose menu a widget's :context-menu sets: a list's table view."
  [w]
  (cond (or (instance? ui/list-box-widget w) (instance? ui/tree-view-widget w)) (table-of w)
        (instance? ui/text-view-widget w) (text-view-of w)
        :else (view w)))

(def ^:private point-target
  "The view a widget's mouse points are in: its menu target's, or a code view's text view,
whose content position-at-point takes (defined with code views).")

(defmethod set-native [(w ui/widget) (p (= :context-menu)) m]
  ;; A combo box's NSPopUpButton keeps its items in its menu: leave that alone.
  (when-not (instance? ui/combo-box-widget w)
    (objc/send-p-void (menu-target w) (objc/sel "setMenu:") (if m (view m) (ffi/null)))))

(defmethod ui/backend-focus [(b cocoa-backend) w]
  (let [n (menu-target w)]
    (objc/send-p-bool (objc/send n (objc/sel "window")) (objc/sel "makeFirstResponder:") n)))

(defn- widget-of-view
  "The widget a view (or one of the views it is in) stands for, or nil; with input, only
a widget with input signals other than a canvas, which handles its own."
  ([v] (widget-of-view v false))
  ([v input]
   (loop [v v]
     (when-not (ffi/null? v)
       (let [w (objc/object-for v)]
         (if (and w (instance? ui/widget w)
                  (or (not input)
                      (and (contains? (ui/signals w) :key-down)
                           (not (instance? ui/canvas-widget w)))))
           w
           (recur (if (objc/responds? v "superview")
                    (objc/send v (objc/sel "superview"))
                    (ffi/null)))))))))

(defmethod ui/backend-focused-widget [(b cocoa-backend)]
  (let [win (objc/send (:app b) (objc/sel "keyWindow"))]
    (when-not (ffi/null? win)
      (widget-of-view (objc/send win (objc/sel "firstResponder"))))))

;;; ------------------------------------------------------------------------------------
;;; Input events of the controls, through the event monitor

(defn- key-fields
  "The fields of a key event for an NSEvent."
  [e]
  (let [code (objc/send-long e (objc/sel "keyCode"))
        chars (objc/string-of (objc/send e (objc/sel "charactersIgnoringModifiers")))]
    {:key (or (get named-keys code) (when (seq chars) (first (string/lower-case chars))))
     :modifiers (event-modifiers e)
     :text (or (objc/string-of (objc/send e (objc/sel "characters"))) "")}))

(defn- emit-input! [w signal & kvs]
  (let [e (apply ui/event-for w signal kvs)]
    ;; The native control acts on what no handler consumes.
    (binding [ui/*native-input* true]
      (ui/emit! w e))
    (ui/consumed? e)))

(defn- printable? [s]
  (and (seq s) (every? (fn [c] (let [n (int c)] (and (>= n 32) (not= n 127) (< n 0xf700))))
                       s)))

(defn- route-input! [e]
  (let [type (objc/send-long e (objc/sel "type"))
        window (objc/send e (objc/sel "window"))]
    (when-not (ffi/null? window)
      (case type
        (10 11)
        (when-let [w (widget-of-view (objc/send window (objc/sel "firstResponder")) true)]
          (let [{:keys [key modifiers text]} (key-fields e)]
            (if (= type 11)
              (emit-input! w :key-up :key key :modifiers modifiers :text text)
              (or (emit-input! w :key-down :key key :modifiers modifiers :text text
                               :repeat (objc/send-bool e (objc/sel "isARepeat")))
                  (and (printable? text) (not (contains? modifiers :command))
                       (emit-input! w :text-input :text text :modifiers modifiers))))))
        (1 2 3 4 25 26)
        (let [_ (when (contains? #{1 3 25} type)
                  ;; A click in a window closes its completion popups (one in the popup
                  ;; is in the popup's own panel).
                  (when-let [w (objc/object-for window)]
                    (when (instance? ui/window-widget w) (ui/dismiss-popups! w :dismissed nil))))
              loc (objc/send-point e (objc/sel "locationInWindow"))
              point {:x (ffi/field loc objc/ns-point :x) :y (ffi/field loc objc/ns-point :y)}
              frame-view (objc/send (objc/send window (objc/sel "contentView"))
                                    (objc/sel "superview"))
              hit (objc/send-pt frame-view (objc/sel "hitTest:") point)]
          (when-let [w (widget-of-view hit true)]
            (let [p (objc/send-point-p (point-target w) (objc/sel "convertPoint:fromView:") point
                                       (ffi/null))
                  x (ffi/field p objc/ns-point :x)
                  y (ffi/field p objc/ns-point :y)
                  mods (event-modifiers e)
                  button (case type (1 2) :left (3 4) :right :middle)
                  down (contains? #{1 3 25} type)
                  clicks (objc/send-long e (objc/sel "clickCount"))]
              (or (emit-input! w (if down :mouse-down :mouse-up) :x x :y y :button button
                               :click-count clicks :modifiers mods)
                  (and down (or (= button :right) (contains? mods :control))
                       (emit-input! w :context-request :x x :y y :button button
                                    :click-count clicks :modifiers mods))))))
        false))))

;;; The row and cell at a point (Skein's M3.6, D-108). A list's mouse events give points
;;; in its table view, which rowAtPoint: and columnAtPoint: take.

(defmethod ui/backend-cell-at-point [(b cocoa-backend) w x y]
  (let [tv (table-of w)
        p {:x (f64 x) :y (f64 y)}
        row (objc/send-point-long tv (objc/sel "rowAtPoint:") p)
        col (objc/send-point-long tv (objc/sel "columnAtPoint:") p)]
    (when (>= row 0)
      [(if (instance? ui/tree-view-widget w)
         (item-of (objc/send-l tv (objc/sel "itemAtRow:") row))
         (get (vec (:items w)) row))
       (when (>= col 0)
         (column-index tv (objc/send-l (objc/send tv (objc/sel "tableColumns"))
                                       (objc/sel "objectAtIndex:") col)))])))

;;; Snapshots (Skein's M3.6, D-108): the content view drawn into a bitmap, as PNG.

(defmethod ui/backend-snapshot [(b cocoa-backend) w]
  ;; The window's frame view draws its background and every control; the content view
  ;; alone leaves some out. Its content area is the content view's frame in it.
  (let [cv (objc/send (view w) (objc/sel "contentView"))
        fv (objc/send cv (objc/sel "superview"))
        r (objc/send-rect cv (objc/sel "frame"))
        bounds (objc/rect (ffi/field r objc/ns-rect :x) (ffi/field r objc/ns-rect :y)
                          (ffi/field r objc/ns-rect :width) (ffi/field r objc/ns-rect :height))
        _ (objc/send-void fv (objc/sel "displayIfNeeded"))
        rep (objc/send-r fv (objc/sel "bitmapImageRepForCachingDisplayInRect:") bounds)
        _ (objc/send-rp-void fv (objc/sel "cacheDisplayInRect:toBitmapImageRep:") bounds rep)
        data (objc/send-lp rep (objc/sel "representationUsingType:properties:") 4   ; PNG
                           (objc/send (objc/cls "NSDictionary") (objc/sel "dictionary")))
        n (objc/send-long data (objc/sel "length"))
        bytes (make-array u8 n)]
    (ffi/pin [p bytes]
      (objc/memcpy p (objc/send data (objc/sel "bytes")) n))
    bytes))

;;; ------------------------------------------------------------------------------------
;;; Windows' options, modal runs and the application

(defn- style-mask [w]
  ;; titled 1, closable 2, miniaturizable 4, resizable 8
  (+ 1 4 (if (:closable w) 2 0) (if (:resizable w) 8 0)))

(defmethod set-native [(w ui/window-widget) (p (= :resizable)) v]
  (objc/send-l-void (view w) (objc/sel "setStyleMask:") (style-mask w)))

(defmethod set-native [(w ui/window-widget) (p (= :closable)) v]
  (objc/send-l-void (view w) (objc/sel "setStyleMask:") (style-mask w)))

(defn- screen-height []
  (let [[_ _ _ h] (objc/rect-vec (objc/send-rect (objc/send (objc/cls "NSScreen")
                                                            (objc/sel "mainScreen"))
                                                 (objc/sel "frame")))]
    h))

(defmethod set-native [(w ui/window-widget) (p (= :position)) pos]
  (when-let [[x y] pos]
    (quietly
     (fn [] (objc/send-point-void (view w) (objc/sel "setFrameTopLeftPoint:")
                                  {:x (f64 x) :y (f64 (- (screen-height) y))})))))

(defn- window-moved! [w]
  (ui/dismiss-popups! w :dismissed nil)
  (when-not (quiet?)
    (let [[x y _ h] (objc/rect-vec (objc/send-rect (view w) (objc/sel "frame")))
          pos [(int (math/round x)) (int (math/round (- (screen-height) (+ y h))))]]
      (when (not= pos (:position w))
        (apply ui/moved-by-user! w pos)))))

(defmethod set-native [(w ui/window-widget) (p (= :min-size)) size]
  (when-let [[mw mh] size]
    (objc/send-z-void (view w) (objc/sel "setContentMinSize:")
                      {:width (f64 mw) :height (f64 mh)})))

(def ^:private modal-results
  "A window's address -> the value end-modal! gave."
  (atom {}))

(defmethod ui/backend-run-modal [(b cocoa-backend) w]
  (objc/send-p-long (:app b) (objc/sel "runModalForWindow:") (view w))
  (let [a (ffi/address (view w))
        v (get @modal-results a)]
    (swap! modal-results dissoc a)
    v))

(defmethod ui/backend-end-modal [(b cocoa-backend) w value]
  (swap! modal-results assoc (ffi/address (view w)) value)
  (objc/send-void (:app b) (objc/sel "stopModal")))

(defmethod ui/backend-set-application-icon [(b cocoa-backend) image]
  (objc/send-p-void (:app b) (objc/sel "setApplicationIconImage:") (ns-image image)))

(defmethod ui/backend-install-menu-bar [(b cocoa-backend) bar]
  (let [key (objc/object-for (objc/send (:app b) (objc/sel "keyWindow")))]
    (when (and bar (not (and key (:menu-bar key))))
      (objc/send-p-void (:app b) (objc/sel "setMainMenu:") (view bar)))))

(defn send-key!
  "Make an NSEvent of the key (a character or a key code, with the modifiers) in the
window's first responder, and route it as the event monitor does. True if a handler
consumed it."
  [w ch]
  (let [win (if (instance? ui/window-widget w) (view w) (objc/send (view w) (objc/sel "window")))
        e (objc/send-key-event
           (objc/cls "NSEvent")
           (objc/sel (str "keyEventWithType:location:modifierFlags:timestamp:windowNumber:"
                          "context:characters:charactersIgnoringModifiers:isARepeat:keyCode:"))
           10 {:x 0.0 :y 0.0} 0 0.0 (objc/send-long win (objc/sel "windowNumber")) (ffi/null)
           (objc/ns-string (str ch)) (objc/ns-string (str ch)) false 0)]
    (boolean (route-input! e))))

(defn native-font-size
  "The point size of the widget's AppKit font."
  [w]
  (objc/send-double (objc/send (font-target w) (objc/sel "font")) (objc/sel "pointSize")))

(defn native-resizable?
  "True if the window's style mask lets the user resize it."
  [w]
  (pos? (bit-and 8 (objc/send-long (view w) (objc/sel "styleMask")))))

(defn native-top-left
  "The window's top left corner on the screen, [x y] from the top left."
  [w]
  (let [[x y _ h] (objc/rect-vec (objc/send-rect (view w) (objc/sel "frame")))]
    [(int (math/round x)) (int (math/round (- (screen-height) (+ y h))))]))

;;; ------------------------------------------------------------------------------------
;;; Appearance, control sizes, surfaces and palettes

(defn- ns-appearance
  "The NSAppearance for :light or :dark, or null to inherit (:inherit, :system)."
  [a]
  (case a
    :light (objc/send-p (objc/cls "NSAppearance") (objc/sel "appearanceNamed:")
                        (objc/ns-string "NSAppearanceNameAqua"))
    :dark (objc/send-p (objc/cls "NSAppearance") (objc/sel "appearanceNamed:")
                       (objc/ns-string "NSAppearanceNameDarkAqua"))
    (ffi/null)))

(defmethod set-native [(w ui/widget) (p (= :appearance)) a]
  (objc/send-p-void (view w) (objc/sel "setAppearance:") (ns-appearance a)))

(defmethod set-native [(w ui/window-widget) (p (= :appearance)) a]
  (objc/send-p-void (view w) (objc/sel "setAppearance:") (ns-appearance a)))

(defn- dark-appearance? [appearance]
  (let [names (reduce (fn [a n] (objc/send-p a (objc/sel "arrayByAddingObject:")
                                              (objc/ns-string n)))
                      (objc/send (objc/cls "NSArray") (objc/sel "array"))
                      ["NSAppearanceNameAqua" "NSAppearanceNameDarkAqua"])]
    (= "NSAppearanceNameDarkAqua"
       (objc/string-of (objc/send-p appearance (objc/sel "bestMatchFromAppearancesWithNames:")
                                    names)))))

(defmethod ui/backend-widget-appearance [(b cocoa-backend) w]
  (objc/call-with-pool
   (fn [] (if (dark-appearance? (objc/send (view w) (objc/sel "effectiveAppearance")))
            :dark
            :light))))

(defmethod ui/backend-color-in-appearance [(b cocoa-backend) name w]
  ;; Resolve the dynamic NSColor with the widget's appearance as the current one.
  (objc/call-with-pool
   (fn []
     (let [old (objc/send (objc/cls "NSAppearance") (objc/sel "currentAppearance"))]
       (objc/send-p-void (objc/cls "NSAppearance") (objc/sel "setCurrentAppearance:")
                         (objc/send (view w) (objc/sel "effectiveAppearance")))
       (try (color-of (ns-color name))
            (finally (objc/send-p-void (objc/cls "NSAppearance") (objc/sel "setCurrentAppearance:")
                                       old)))))))

(defmethod set-native [(w ui/widget) (p (= :control-size)) size]
  (let [n (font-target w)]
    (when (objc/responds? n "setControlSize:")
      (let [code (case size :small 1 :mini 2 :large 3 0)]
        (objc/send-l-void n (objc/sel "setControlSize:") code)
        (when (and (nil? (:font w)) (objc/responds? n "setFont:"))
          (let [points (objc/send-l-double (objc/cls "NSFont")
                                           (objc/sel "systemFontSizeForControlSize:") code)]
            (objc/send-p-void n (objc/sel "setFont:")
                              (objc/send-d (objc/cls "NSFont") (objc/sel "systemFontOfSize:")
                                           points))))))))

(def ^:private surface-materials
  "A surface role -> the NSVisualEffectMaterial that draws it."
  {:window 12 :sidebar 7 :content 18 :status 12 :toolbar 3 :activity 7 :popover 6})

(def ^:private backdrops
  "A host view's address -> {:color an NSBox, :material an NSVisualEffectView}, behind a
container's children."
  (atom {}))

(defn- surface-hosts
  "The views a container's surface is drawn in: where its children go (each page of a
notebook)."
  [c]
  (if (instance? ui/notebook-widget c)
    (mapv (fn [page] (objc/send (view page) (objc/sel "superview"))) (:children c))
    [(container-view c)]))

(defn- make-backdrop [host kind]
  (let [v (objc/send-r (objc/alloc (if (= kind :material) "NSVisualEffectView" "NSBox"))
                       (objc/sel "initWithFrame:") (objc/send-rect host (objc/sel "bounds")))]
    (when (= kind :color)
      (objc/send-l-void v (objc/sel "setBoxType:") 4)         ; NSBoxCustom
      (objc/send-l-void v (objc/sel "setTitlePosition:") 0)
      (objc/send-d-void v (objc/sel "setCornerRadius:") 0.0)
      (objc/send-d-void v (objc/sel "setBorderWidth:") 0.0)
      (objc/send-b-void v (objc/sel "setTransparent:") false))
    (objc/send-l-void v (objc/sel "setAutoresizingMask:") 18)  ; width and height sizable
    ;; Behind the container's children: NSWindowBelow, relative to none.
    (objc/send-plp-void host (objc/sel "addSubview:positioned:relativeTo:") v -1 (ffi/null))
    (objc/release v)
    v))

(def ^:private backdrop-hosts
  "A container's view address -> the addresses of the hosts of its backdrops."
  (atom {}))

(defn- palette-ns-color
  "An NSColor of the designator as the widget shows it: a palette's color, or else the
platform's dynamic one."
  [w d]
  (let [k (if (vector? d) (first d) d)]
    (if (and (keyword? k) (ui/palette-color w k)) (ns-color (ui/widget-color w d)) (ns-color d))))

(defn- card? [c]
  (or (pos? (or (:corner-radius c) 0)) (some? (:border-color c))))

(defn- refresh-surface! [c]
  (let [role (:surface c)
        color (ui/container-fill c)
        ;; a card is drawn by the color backdrop, clear inside if it has no color
        boxed (or color (card? c))]
    (doseq [host (surface-hosts c)]
      (let [a (ffi/address host)
            _ (swap! backdrop-hosts update (ffi/address (view c)) (fnil conj #{}) a)
            data (or (get @backdrops a) {})
            data (if (and boxed (not (:color data)))
                   (assoc data :color (make-backdrop host :color))
                   data)
            data (if (and (nil? color) (not= role :automatic) (not (:material data))
                          (get surface-materials role))
                   (assoc data :material (make-backdrop host :material))
                   data)]
        (when-let [box (:color data)]
          (when boxed
            (objc/send-p-void box (objc/sel "setFillColor:")
                              (palette-ns-color c (or color :transparent)))
            (objc/send-d-void box (objc/sel "setCornerRadius:") (f64 (or (:corner-radius c) 0)))
            (objc/send-d-void box (objc/sel "setBorderWidth:")
                              (f64 (if (:border-color c) (or (:border-width c) 1) 0)))
            (when-let [b (:border-color c)]
              (objc/send-p-void box (objc/sel "setBorderColor:") (palette-ns-color c b))))
          (objc/send-b-void box (objc/sel "setHidden:") (not boxed)))
        (when-let [m (:material data)]
          (objc/send-l-void m (objc/sel "setMaterial:") (get surface-materials role 12))
          (objc/send-l-void m (objc/sel "setBlendingMode:")
                            (if (contains? #{:sidebar :activity :window} role) 0 1))
          (objc/send-l-void m (objc/sel "setState:") 0)
          (objc/send-b-void m (objc/sel "setHidden:") (boolean (or color (= role :automatic)))))
        (swap! backdrops assoc a data)))))

(defmethod ui/backend-destroy :before [(b cocoa-backend) (c ui/container-widget)]
  ;; Its views go, and AppKit may give a new view the same address. (Its pages are gone
  ;; already, so the hosts are those noted when its backdrops were made.)
  (let [k (ffi/address (view c))]
    (doseq [a (get @backdrop-hosts k)] (swap! backdrops dissoc a))
    (swap! backdrop-hosts dissoc k)))

(defmethod set-native [(c ui/container-widget) (p (= :surface)) v] (refresh-surface! c))
(defmethod set-native [(c ui/container-widget) (p (= :background)) v] (refresh-surface! c))
(defmethod set-native [(c ui/container-widget) (p (= :corner-radius)) v] (refresh-surface! c))
(defmethod set-native [(c ui/container-widget) (p (= :border-color)) v] (refresh-surface! c))
(defmethod set-native [(c ui/container-widget) (p (= :border-width)) v] (refresh-surface! c))

(defn native-card
  "A container's card as AppKit draws it: {:corner-radius :border-width :border-color
:fill}, the colors as skein.ui colors, or nil if it has no backdrop box."
  [c]
  (when-let [box (:color (get @backdrops (ffi/address (first (surface-hosts c)))))]
    (when-not (objc/send-bool box (objc/sel "isHidden"))
      {:corner-radius (objc/send-double box (objc/sel "cornerRadius"))
       :border-width (objc/send-double box (objc/sel "borderWidth"))
       :border-color (color-of (objc/send box (objc/sel "borderColor")))
       :fill (color-of (objc/send box (objc/sel "fillColor")))})))

(defmethod ui/backend-add-child :after [(b cocoa-backend) (c ui/notebook-widget) child]
  (refresh-surface! c))

(defmethod set-native [(w ui/window-widget) (p (= :background)) v]
  (objc/send-p-void (view w) (objc/sel "setBackgroundColor:")
                    (ns-color (or (ui/container-fill w) :window-background))))

(def ^:private recolor-code-view!
  "Give a code view its palette's colors again (defined with code views).")

(defmethod ui/backend-apply-palette [(b cocoa-backend) w]
  (cond
    (instance? ui/label-widget w)
    (objc/send-p-void (view w) (objc/sel "setTextColor:")
                      (palette-ns-color w (or (:text-color w) :text)))
    (instance? ui/entry-widget w)
    (do (objc/send-p-void (view w) (objc/sel "setTextColor:") (palette-ns-color w :text))
        (when (ui/palette-color w :background)
          (objc/send-b-void (view w) (objc/sel "setDrawsBackground:") true)
          (objc/send-p-void (view w) (objc/sel "setBackgroundColor:")
                            (palette-ns-color w :background))))
    (instance? ui/text-view-widget w)
    (let [tv (text-view-of w)]
      (objc/send-p-void tv (objc/sel "setTextColor:") (palette-ns-color w :text))
      (objc/send-p-void tv (objc/sel "setBackgroundColor:") (palette-ns-color w :background))
      (objc/send-p-void tv (objc/sel "setInsertionPointColor:") (palette-ns-color w :caret)))
    (instance? ui/code-view-widget w) (recolor-code-view! w)
    (or (instance? ui/list-box-widget w) (instance? ui/tree-view-widget w))
    (objc/send-p-void (table-of w) (objc/sel "setBackgroundColor:")
                      (palette-ns-color w :control-background))
    (instance? ui/container-widget w) (refresh-surface! w)
    (instance? ui/window-widget w)
    (objc/send-p-void (view w) (objc/sel "setBackgroundColor:")
                      (ns-color (or (ui/container-fill w) :window-background)))
    :else nil))

(defn has-material?
  "True if a container's surface is drawn by a visual effect view."
  [c]
  (some (fn [host] (some? (:material (get @backdrops (ffi/address host))))) (surface-hosts c)))

;;; ------------------------------------------------------------------------------------
;;; Stacks and tabbed panes. A tabbed pane is a flipped view holding its tab bar and a
;;; tabless NSTabView of its pages. The bar is a flipped view whose tabs, NSButtons each
;;; with a close button, sit in a scroll view, with buttons to scroll the rest and list
;;; them all when they don't fit.

(defmethod make-native [(s ui/stack-widget)] (flipped-view))

(defmethod make-native [(pane ui/tabbed-pane-widget)]
  (let [root (flipped-view)
        tabs (init-frame "NSTabView")]
    (objc/send-l-void tabs (objc/sel "setTabViewType:") 6)     ; NSNoTabsNoBorder
    (objc/send-p-void tabs (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
    (objc/send-p-void root (objc/sel "addSubview:") tabs)
    (objc/release tabs)
    (also-register! tabs pane)
    (swap! pane-tabs assoc (ffi/address root) tabs)
    root))

(defmethod ui/backend-destroy :before [(b cocoa-backend) (pane ui/tabbed-pane-widget)]
  (let [a (ffi/address (view pane))]
    (when-let [tabs (get @pane-tabs a)] (objc/unregister! tabs))
    (swap! pane-tabs dissoc a)))

(defmethod ui/backend-add-child [(b cocoa-backend) (pane ui/tabbed-pane-widget) child]
  (if (instance? ui/tab-bar-widget child)
    (objc/send-p-void (view pane) (objc/sel "addSubview:") (view child))
    (call-next-method)))

(defmethod set-native [(pane ui/tabbed-pane-widget) (p (= :tab-position)) v]
  nil)

(defmethod ui/backend-set-page-label [(b cocoa-backend) (pane ui/tabbed-pane-widget) page label]
  ;; backend-tab-update shows the label.
  nil)

(def ^:private tab-bars
  "A tab bar's view address -> {:scroll :document :overflow (the buttons that scroll and
list the tabs) :headers {a page's view address -> {:view :label :close :covers}} :drag
{:page :dragging :x :y} :drop-target :overlay}."
  (atom {}))

(def ^:private tab-controls
  "A tab bar button's address -> [action page]."
  (atom {}))

(defn- bar-state [bar] (get @tab-bars (ffi/address (view bar))))

(defn- update-bar-state! [bar f & args]
  (swap! tab-bars (fn [m] (apply update m (ffi/address (view bar)) f args))))

(defn- tab-control
  "A button of the tab bar, of the class, doing action ([kind page])."
  [bar title action class-name]
  (let [b (init-frame class-name)]
    (objc/send-p-void b (objc/sel "setTitle:") (objc/ns-string title))
    (objc/send-l-void b (objc/sel "setBezelStyle:") 11)
    (connect-action! b)
    (also-register! b bar)
    (swap! tab-controls assoc (ffi/address b) action)
    b))

(defmethod make-native [(bar ui/tab-bar-widget)]
  (let [root (flipped-view)
        scroll (init-frame "NSScrollView")
        document (flipped-view)]
    (objc/send-b-void scroll (objc/sel "setDrawsBackground:") false)
    (objc/send-l-void scroll (objc/sel "setBorderType:") 0)
    (objc/send-b-void scroll (objc/sel "setHasHorizontalScroller:") false)
    (objc/send-p-void scroll (objc/sel "setDocumentView:") document)
    (objc/send-p-void root (objc/sel "addSubview:") scroll)
    (objc/release scroll)
    (objc/release document)
    (let [overflow (mapv (fn [[title kind label]]
                           (let [b (tab-control bar title [kind nil] "NSButton")]
                             (objc/send-p-void b (objc/sel "setAccessibilityLabel:")
                                               (objc/ns-string label))
                             (objc/send-b-void b (objc/sel "setHidden:") true)
                             (objc/send-p-void root (objc/sel "addSubview:") b)
                             (objc/release b)
                             b))
                         [["‹" :previous "Scroll tabs left"] ["›" :next "Scroll tabs right"]
                          ["▾" :menu "All tabs"]])]
      (swap! tab-bars assoc (ffi/address root)
             {:scroll scroll :document document :overflow overflow :headers {}}))
    root))

(defn- forget-controls! [controls]
  (doseq [c controls]
    (objc/unregister! c)
    (swap! tab-controls dissoc (ffi/address c))))

(defmethod ui/backend-destroy :before [(b cocoa-backend) (bar ui/tab-bar-widget)]
  (when-let [st (bar-state bar)]
    (forget-controls! (concat (:overflow st)
                              (mapcat (fn [info] (into [(:label info) (:close info)] (:covers info)))
                                      (vals (:headers st)))))
    (when-let [o (:overlay st)]
      (objc/send-void o (objc/sel "removeFromSuperview"))
      (objc/release o))
    (swap! tab-bars dissoc (ffi/address (view bar)))))

(defmethod native-natural-size [(bar ui/tab-bar-widget)]
  [0 32])

(defn- header-of [pane page]
  (get-in (bar-state (:tab-bar pane)) [:headers (ffi/address (view page))]))

(defn- tab-header!
  "The views of the page's tab, made the first time."
  [pane page]
  (or (header-of pane page)
      (let [bar (:tab-bar pane)
            v (flipped-view)
            label (tab-control bar "" [:select page] "SkeinTabButton")
            close (tab-control bar "×" [:close page] "NSButton")
            ;; Transparent tabs over a widget label or accessory that takes no input,
            ;; so a click there still selects and drags the tab.
            covers (mapv (fn [_]
                           (let [c (tab-control bar "" [:select page] "SkeinTabButton")]
                             (objc/send-b-void c (objc/sel "setTransparent:") true)
                             c))
                         [:label :accessory])
            info {:view v :label label :close close :covers covers}]
        (objc/send-l-void label (objc/sel "setButtonType:") 1)        ; push on, push off
        (objc/send-b-void close (objc/sel "setBordered:") false)
        (doseq [c (into [label close] covers)]
          (objc/send-p-void v (objc/sel "addSubview:") c)
          (objc/release c))
        (objc/send-p-void (:document (bar-state bar)) (objc/sel "addSubview:") v)
        (objc/release v)
        (update-bar-state! bar assoc-in [:headers (ffi/address (view page))] info)
        info)))

(defn- show-tab-states! [pane]
  (doseq [[i page] (map-indexed vector (:children pane))]
    (when-let [info (header-of pane page)]
      (objc/send-l-void (:label info) (objc/sel "setState:")
                        (if (= i (:selected-index pane)) 1 0)))))

(defmethod set-native :after [(pane ui/tabbed-pane-widget) (p (= :selected-index)) i]
  (show-tab-states! pane))

(defn- passive?
  "True if w and the widgets in it take no input of their own."
  [w]
  (not-any? (fn [x] (contains? (ui/signals x) :key-down)) (ui/widgets-in w)))

(defmethod ui/backend-tab-update [(b cocoa-backend) pane page]
  (let [info (tab-header! pane page)
        l (:tab-label page)
        title (ui/tab-title pane page)
        button (:label info)
        icon (:tab-icon page)]
    (objc/send-p-void button (objc/sel "setTitle:")
                      (objc/ns-string (if (instance? ui/widget l) "" title)))
    (objc/send-p-void button (objc/sel "setAccessibilityLabel:") (objc/ns-string title))
    (objc/send-p-void button (objc/sel "setToolTip:")
                      (if-let [t (:tab-tooltip page)] (objc/ns-string t) (ffi/null)))
    (objc/send-p-void button (objc/sel "setImage:") (ns-image icon))
    ;; The icon before the title (NSImageLeading), scaled down to fit.
    (objc/send-l-void button (objc/sel "setImagePosition:") (if icon 7 0))
    (objc/send-l-void button (objc/sel "setImageScaling:") 3)
    (objc/send-b-void (:close info) (objc/sel "setHidden:") (not (:tab-closable page)))
    (objc/send-p-void (:close info) (objc/sel "setAccessibilityLabel:")
                      (objc/ns-string (str "Close " title)))
    (doseq [w [l (:tab-accessory page)]]
      (when (instance? ui/widget w)
        (objc/send-p-void (:view info) (objc/sel "addSubview:") (view w))))
    ;; The covers go on top again.
    (doseq [c (:covers info)]
      (objc/retain c)
      (objc/send-void c (objc/sel "removeFromSuperview"))
      (objc/send-p-void (:view info) (objc/sel "addSubview:") c)
      (objc/release c))
    (when-let [item (page-item pane page)]
      (objc/send-p-void item (objc/sel "setLabel:") (objc/ns-string title)))
    (show-tab-states! pane)))

(def ^:private show-drop-target!
  "Mark the pane a dragged tab would drop on (defined below).")

(defmethod ui/backend-remove-child [(b cocoa-backend) (pane ui/tabbed-pane-widget) page]
  (let [bar (:tab-bar pane)]
    (when-let [info (and (instance? ui/widget page) (header-of pane page))]
      (when (identical? page (:page (:drag (bar-state bar))))
        (update-bar-state! bar dissoc :drag)
        (show-drop-target! bar nil))
      (forget-controls! (into [(:label info) (:close info)] (:covers info)))
      (objc/send-void (:view info) (objc/sel "removeFromSuperview"))
      (update-bar-state! bar update :headers dissoc (ffi/address (view page)))))
  (call-next-method))

(defn- descendant? [w ancestor]
  (some (fn [o] (identical? o ancestor)) (take-while some? (iterate :parent w))))

(defmethod ui/backend-tab-move [(b cocoa-backend) pane page old index]
  (let [tabs (tabs-of pane)
        item (page-item pane page)
        focused (ui/backend-focused-widget b)]
    (when item
      (objc/retain item)
      (quietly
       (fn []
         (objc/send-p-void tabs (objc/sel "removeTabViewItem:") item)
         (objc/send-pl tabs (objc/sel "insertTabViewItem:atIndex:") item index)
         (when-let [i (:selected-index pane)]
           (objc/send-l-void tabs (objc/sel "selectTabViewItemAtIndex:") i))))
      (objc/release item)
      (show-tab-states! pane)
      (when (and focused (descendant? focused pane))
        (ui/backend-focus b focused)))))

(defn- tab-width
  "How wide the page's tab is: its title (at most 220), icon, close button and accessory."
  [pane page]
  (let [l (:tab-label page)
        a (:tab-accessory page)]
    (+ 20
       (if (instance? ui/widget l)
         (first (ui/outer-size l))
         (min 220 (int (first (string-size (ui/tab-title pane page) nil)))))
       (if (:tab-icon page) 20 0)
       (if (:tab-closable page) 24 0)
       (if a (+ 6 (first (ui/outer-size a))) 0))))

(defn- layout-tab-header! [pane page x width height]
  (when-let [info (header-of pane page)]
    (let [l (:tab-label page)
          a (:tab-accessory page)
          cw (if (:tab-closable page) 24 0)
          aw (if a (first (ui/outer-size a)) 0)
          label-cell [8 4 (max 0 (- width cw aw 20)) (max 0 (- height 8))]
          accessory-cell [(- width cw aw 6) 4 aw (max 0 (- height 8))]]
      (objc/send-r-void (:view info) (objc/sel "setFrame:") (objc/rect x 0 width height))
      ;; The tab's button spans the whole tab; the close button and accessory are on top.
      (objc/send-r-void (:label info) (objc/sel "setFrame:")
                        (objc/rect 1 3 (max 0 (- width 2)) (max 0 (- height 6))))
      (objc/send-l-void (:label info) (objc/sel "setAlignment:") (text-alignment :left))
      (objc/send-r-void (:close info) (objc/sel "setFrame:")
                        (objc/rect (- width cw 5) 4 cw (max 0 (- height 8))))
      (when a (apply ui/allocate-in-cell a accessory-cell))
      (when (instance? ui/widget l) (apply ui/allocate-in-cell l label-cell))
      (doseq [[c w cell] (map vector (:covers info) [l a] [label-cell accessory-cell])]
        (objc/send-r-void c (objc/sel "setFrame:") (apply objc/rect cell))
        (objc/send-b-void c (objc/sel "setHidden:")
                          (not (and (instance? ui/widget w) (:visible w) (passive? w))))))))

(defn- reveal-tab! [pane page]
  (when-let [info (header-of pane page)]
    (objc/send-r (:document (bar-state (:tab-bar pane))) (objc/sel "scrollRectToVisible:")
                 (objc/send-rect (:view info) (objc/sel "frame")))))

(defmethod ui/backend-tab-layout [(b cocoa-backend) pane width height]
  (let [bar (:tab-bar pane)
        {:keys [scroll document overflow]} (bar-state bar)
        bh (or (last (:allocation bar)) 0)
        sw (first (ui/outer-size (:start bar)))
        ew (first (ui/outer-size (:end bar)))
        widths (mapv (fn [page] (tab-width pane page)) (:children pane))
        total (reduce + 0 widths)
        over (> total (- width sw ew))
        vw (max 0 (- width sw ew (if over 72 0)))]
    (objc/send-r-void (tabs-of pane) (objc/sel "setFrame:")
                      (objc/rect 0 (if (= :bottom (:tab-position pane)) 0 bh)
                                 width (max 0 (- height bh))))
    (objc/send-r-void scroll (objc/sel "setFrame:") (objc/rect sw 0 vw bh))
    (objc/send-z-void document (objc/sel "setFrameSize:")
                      {:width (f64 (max vw total)) :height (f64 bh)})
    (doseq [[i c] (map-indexed vector overflow)]
      (objc/send-b-void c (objc/sel "setHidden:") (not over))
      (objc/send-r-void c (objc/sel "setFrame:") (objc/rect (+ sw vw (* i 24)) 3 24
                                                            (max 0 (- bh 6)))))
    (reduce (fn [x [page w]] (layout-tab-header! pane page x w bh) (+ x w))
            0 (map vector (:children pane) widths))
    (objc/send-void scroll (objc/sel "tile"))
    (when-let [page (ui/selected-page pane)] (reveal-tab! pane page))))

(defmethod ui/backend-tab-reveal [(b cocoa-backend) pane page]
  (reveal-tab! pane page))

(defmethod ui/backend-tab-at-point [(b cocoa-backend) pane x y]
  (let [bar (:tab-bar pane)
        {:keys [scroll document]} (bar-state bar)
        [sx sy sw sh] (objc/rect-vec (objc/send-rect scroll (objc/sel "frame")))]
    (when (and (<= sx x) (< x (+ sx sw)) (<= sy y) (< y (+ sy sh)))
      (let [p (objc/send-point-p document (objc/sel "convertPoint:fromView:")
                                 {:x (f64 x) :y (f64 y)} (view bar))
            dx (ffi/field p objc/ns-point :x)
            dy (ffi/field p objc/ns-point :y)]
        (first (filter (fn [page]
                         (when-let [info (header-of pane page)]
                           (let [[hx hy hw hh] (objc/rect-vec (objc/send-rect (:view info)
                                                                              (objc/sel "frame")))]
                             (and (<= hx dx) (< dx (+ hx hw)) (<= hy dy) (< dy (+ hy hh))))))
                       (:children pane)))))))

(defn- scroll-tabs! [bar delta]
  (let [{:keys [scroll document]} (bar-state bar)
        [x _ w _] (objc/rect-vec (objc/send-rect (objc/send scroll (objc/sel "contentView"))
                                                 (objc/sel "bounds")))
        [_ _ total _] (objc/rect-vec (objc/send-rect document (objc/sel "frame")))]
    (objc/send-point-void document (objc/sel "scrollPoint:")
                          {:x (f64 (max 0 (min (max 0 (- total w)) (+ x delta)))) :y 0.0})))

(defmethod native-action [(bar ui/tab-bar-widget) sender]
  (let [pane (:pane bar)
        [kind page] (get @tab-controls (ffi/address sender))
        live (and page (index-of (:children pane) page))]
    (when (:enabled pane)
      (cond
        (= kind :select) (when live (ui/select-page! pane page))
        (= kind :close)
        (when (and live (:tab-closable page))
          ;; Closing takes the button away while AppKit still dispatches its click.
          (objc/retain sender)
          (try (ui/close-page! pane page)
               (finally (ui/backend-call-later (ui/current-backend)
                                               (fn [] (objc/release sender))))))
        (= kind :previous) (scroll-tabs! bar -120)
        (= kind :next) (scroll-tabs! bar 120)
        (= kind :menu) (ui/show-tab-menu pane)
        :else nil))))

(defn- event-point
  "Where the NSEvent happened in the view's coordinates, as [x y]."
  [v e]
  (let [w (objc/send-point e (objc/sel "locationInWindow"))
        p (objc/send-point-p v (objc/sel "convertPoint:fromView:")
                             {:x (ffi/field w objc/ns-point :x) :y (ffi/field w objc/ns-point :y)}
                             (ffi/null))]
    [(ffi/field p objc/ns-point :x) (ffi/field p objc/ns-point :y)]))

(defn- drop-target
  "The pane other than the bar's that its tab dragged to the NSEvent's point would drop
on, or nil: hit-testing finds the pane under the pointer, so covered panes don't count."
  [bar e]
  (let [from (:pane bar)
        win (objc/send (view bar) (objc/sel "window"))]
    (when (and (:drag-group from) (not (ffi/null? win)))
      (let [loc (objc/send-point e (objc/sel "locationInWindow"))
            frame-view (objc/send (objc/send win (objc/sel "contentView")) (objc/sel "superview"))
            hit (objc/send-pt frame-view (objc/sel "hitTest:")
                              {:x (ffi/field loc objc/ns-point :x)
                               :y (ffi/field loc objc/ns-point :y)})
            w (widget-of-view hit)
            pane (when w
                   (first (filter (fn [o] (and (instance? ui/tabbed-pane-widget o)
                                               (= (:drag-group o) (:drag-group from))))
                                  (take-while some? (iterate :parent w)))))]
        (when (and pane (ui/page-drop-target? pane from)) pane)))))

(defn- show-drop-target! [bar target]
  (let [st (bar-state bar)]
    (when-not (identical? target (:drop-target st))
      (when-let [o (:overlay st)]
        (objc/send-void o (objc/sel "removeFromSuperview"))
        (objc/release o))
      (if target
        (let [o (init-frame "NSBox")
              accent (ns-color :accent)]
          (objc/send-l-void o (objc/sel "setBoxType:") 4)              ; NSBoxCustom
          (objc/send-l-void o (objc/sel "setTitlePosition:") 0)
          (objc/send-d-void o (objc/sel "setBorderWidth:") 2.0)
          (objc/send-d-void o (objc/sel "setCornerRadius:") 4.0)
          (objc/send-p-void o (objc/sel "setBorderColor:") accent)
          (objc/send-p-void o (objc/sel "setFillColor:")
                            (objc/send-d accent (objc/sel "colorWithAlphaComponent:") 0.15))
          (objc/send-r-void o (objc/sel "setFrame:")
                            (objc/send-rect (view target) (objc/sel "bounds")))
          (objc/send-p-void (view target) (objc/sel "addSubview:") o)
          (update-bar-state! bar assoc :drop-target target :overlay o))
        (update-bar-state! bar assoc :drop-target nil :overlay nil)))))

(defn- drop-index
  "Where a tab dropped at the NSEvent's point goes in pane: before the tab there, else
last."
  [pane e]
  (let [[x y] (event-point (view (:tab-bar pane)) e)
        page (ui/tab-at-point pane x y)]
    (if page (index-of (:children pane) page) (count (:children pane)))))

(defn- tab-dragged! [bar e]
  (let [pane (:pane bar)
        d (:drag (bar-state bar))]
    (when (and d (index-of (:children pane) (:page d)))
      (let [[x y] (event-point (view bar) e)]
        (when (or (:dragging d) (> (abs (- x (:x d))) 5) (> (abs (- y (:y d))) 5))
          (update-bar-state! bar assoc-in [:drag :dragging] true)
          (show-drop-target! bar (drop-target bar e))
          (when (and (:reorderable pane) (nil? (:drop-target (bar-state bar))))
            (let [target (ui/tab-at-point pane x y)]
              (when (and target (not (identical? target (:page d))))
                (ui/page-moved-by-user! pane (:page d) (index-of (:children pane) target))
                (ui/flush-layouts!)))
            ;; Reaching an end of the visible tabs scrolls to show more.
            (let [[sx _ sw _] (objc/rect-vec (objc/send-rect (:scroll (bar-state bar))
                                                             (objc/sel "frame")))]
              (cond (< x (+ sx 12)) (scroll-tabs! bar -20)
                    (> x (- (+ sx sw) 12)) (scroll-tabs! bar 20)
                    :else nil))))))))

(defn- tab-released! [bar e]
  (let [st (bar-state bar)
        d (:drag st)
        target (:drop-target st)]
    (update-bar-state! bar dissoc :drag)
    (show-drop-target! bar nil)
    (when (and d target (not (:destroyed target)))
      ;; Moving the page takes this button away: drop once AppKit is done with the event.
      (let [index (drop-index target e)]
        (ui/backend-call-later (ui/current-backend)
                               (fn [] (ui/page-dropped-by-user! (:page d) target index)))))))

(defn- tab-mouse! [button selector e]
  (let [bar (objc/object-for button)
        [kind page] (get @tab-controls (ffi/address button))
        pane (when bar (:pane bar))
        live (and pane page (index-of (:children pane) page))]
    (when (and pane (:enabled pane))
      (cond
        (or (= selector "rightMouseDown:")
            (and (= selector "mouseDown:") (contains? (event-modifiers e) :control)))
        (let [[x y] (event-point (view bar) e)]
          (ui/tab-context-requested! pane x y (event-modifiers e)))
        (= selector "mouseDown:")
        (when (and live (= kind :select))
          (ui/select-page! pane page)
          (let [[x y] (event-point (view bar) e)]
            (update-bar-state! bar assoc :drag {:page page :dragging false :x x :y y})))
        (= selector "mouseDragged:") (tab-dragged! bar e)
        (= selector "mouseUp:") (tab-released! bar e)
        (= selector "otherMouseDown:")
        (when (and live (:tab-closable page) (= 2 (objc/send-long e (objc/sel "buttonNumber"))))
          (objc/retain button)
          (try (ui/close-page! pane page)
               (finally (ui/backend-call-later (ui/current-backend)
                                               (fn [] (objc/release button))))))
        :else nil))))

(defn native-tab
  "What the page's tab shows: {:title :selected :closable :tooltip}."
  [page]
  (let [info (header-of (:parent page) page)
        b (:label info)]
    {:title (objc/string-of (objc/send b (objc/sel "title")))
     :selected (= 1 (objc/send-long b (objc/sel "state")))
     :closable (not (objc/send-bool (:close info) (objc/sel "isHidden")))
     :tooltip (objc/string-of (objc/send b (objc/sel "toolTip")))}))

(defn native-tab-point
  "The middle of the page's tab, [x y] in its tab bar's view."
  ([page] (native-tab-point page (:tab-bar (:parent page))))
  ([page in]
   (let [v (:view (header-of (:parent page) page))
         [_ _ w h] (objc/rect-vec (objc/send-rect v (objc/sel "bounds")))
         p (objc/send-point-p v (objc/sel "convertPoint:toView:")
                              {:x (f64 (/ w 2)) :y (f64 (/ h 2))} (view in))]
     [(ffi/field p objc/ns-point :x) (ffi/field p objc/ns-point :y)])))

(defn native-page-area
  "The frame of the tabbed pane's page area, [x y width height] in the pane's view."
  [pane]
  (mapv (fn [x] (int (math/round x)))
        (objc/rect-vec (objc/send-rect (tabs-of pane) (objc/sel "frame")))))

(defn send-tab-mouse!
  "Send the page's tab a mouse event of type (an NSEventType: 1 down, 6 drag, 2 up, 3
right down) at x, y in its tab bar's view, as AppKit does."
  [page type x y]
  (let [pane (:parent page)
        button (:label (header-of pane page))]
    (objc/send-p-void button (objc/sel (case type 1 "mouseDown:" 6 "mouseDragged:" 2 "mouseUp:"
                                             3 "rightMouseDown:"))
                      (mouse-event (view (:tab-bar pane)) type x y))))

(defn click-tab!
  "Click the page's tab, as the user would."
  [page]
  (let [[x y] (native-tab-point page)]
    (send-tab-mouse! page 1 x y)
    (send-tab-mouse! page 2 x y)))

(defn drag-tab!
  "Drag the page's tab to the middle of the widget (another tab's page, or a pane) and
let go, as the user would."
  [page to]
  (let [[x y] (native-tab-point page)
        bar (view (:tab-bar (:parent page)))
        [tx ty] (if (instance? ui/tabbed-pane-widget (:parent to))
                  (native-tab-point to (:tab-bar (:parent page)))
                  (let [[_ _ w h] (objc/rect-vec (objc/send-rect (view to) (objc/sel "bounds")))
                        p (objc/send-point-p (view to) (objc/sel "convertPoint:toView:")
                                             {:x (f64 (/ w 2)) :y (f64 (/ h 2))} bar)]
                    [(ffi/field p objc/ns-point :x) (ffi/field p objc/ns-point :y)]))]
    (send-tab-mouse! page 1 x y)
    (send-tab-mouse! page 6 (/ (+ x tx) 2) (/ (+ y ty) 2))
    (send-tab-mouse! page 6 tx ty)
    (send-tab-mouse! page 2 tx ty)))

(defn click-tab-close!
  "Click the close button of the page's tab, as the user would."
  [page]
  (objc/send-p-void (:close (header-of (:parent page) page)) (objc/sel "performClick:")
                    (ffi/null)))

;;; ------------------------------------------------------------------------------------
;;; Popovers and completion popups: a surface's view is a flipped view inside its shell,
;;; an NSPopover (through a view controller) or a non-activating borderless NSPanel.

(def ^:private shells
  "A surface's view address -> its NSPopover or NSPanel."
  (atom {}))

(def ^:private closing
  "The addresses of the popovers the program is closing, whose delegate notice isn't the
user's doing."
  (atom #{}))

(defn- shell-of [s] (get @shells (ffi/address (view s))))

(defmethod make-native [(s ui/surface-widget)]
  (let [host (flipped-view)
        shell (if (instance? ui/popover-widget s)
                (let [p (objc/new-object "NSPopover")
                      controller (objc/new-object "NSViewController")]
                  (objc/send-p-void controller (objc/sel "setView:") host)
                  (objc/send-p-void p (objc/sel "setContentViewController:") controller)
                  (objc/send-p-void p (objc/sel "setDelegate:")
                                    (:text-delegate (ui/current-backend)))
                  (objc/send-b-void p (objc/sel "setAnimates:") false)
                  (objc/release controller)
                  p)
                ;; borderless (0) and non-activating (128), buffered (2)
                (let [panel (objc/send-rllb (objc/alloc "NSPanel")
                                            (objc/sel "initWithContentRect:styleMask:backing:defer:")
                                            (objc/rect 0 0 100 100) 128 2 false)]
                  (objc/send-b-void panel (objc/sel "setReleasedWhenClosed:") false)
                  (objc/send-p-void panel (objc/sel "setContentView:") host)
                  ;; The core closes it when its window loses the keyboard; hiding with the
                  ;; application too would hide it where no application is active (CI).
                  (objc/send-b-void panel (objc/sel "setHidesOnDeactivate:") false)
                  (objc/send-b-void panel (objc/sel "setHasShadow:") true)
                  (objc/send-b-void panel (objc/sel "setBecomesKeyOnlyIfNeeded:") true)
                  panel))]
    (also-register! shell s)
    (swap! shells assoc (ffi/address host) shell)
    host))

(defmethod ui/backend-destroy :before [(b cocoa-backend) (s ui/surface-widget)]
  (when-let [shell (shell-of s)]
    (when (instance? ui/popover-widget s)
      (objc/send-p-void shell (objc/sel "setDelegate:") (ffi/null)))
    (objc/unregister! shell)
    (swap! shells dissoc (ffi/address (view s)))
    (objc/release shell)))

(def ^:private place-panel!
  "Put a shown completion popup by its anchor (defined below).")

(defmethod set-native [(s ui/surface-widget) (p (= :size)) size]
  (when-let [[w h] size]
    (objc/send-z-void (view s) (objc/sel "setFrameSize:") {:width (f64 w) :height (f64 h)})
    (objc/send-z-void (shell-of s) (objc/sel "setContentSize:") {:width (f64 w) :height (f64 h)})
    (when (and (instance? ui/completion-popup-widget s) (:shown s))
      (place-panel! s (:owner s) (:anchor s)))))

(defmethod set-native [(s ui/popover-widget) (p (= :behavior)) v]
  (objc/send-l-void (shell-of s) (objc/sel "setBehavior:")
                    (case v :application-defined 0 :semi-transient 2 1)))

(defn- flipped? [v] (objc/send-bool v (objc/sel "isFlipped")))

(defn- anchor-rect
  "The rectangle [x y width height] from the top left of the widget's view, in that view's
own coordinates."
  [w [x y width height]]
  (let [v (view w)
        [_ _ _ vh] (objc/rect-vec (objc/send-rect v (objc/sel "bounds")))]
    (objc/rect x (if (flipped? v) y (- vh y height)) width height)))

(defmethod ui/backend-show-popover [(b cocoa-backend) p widget rectangle edge]
  (let [shell (shell-of p)
        v (view widget)]
    ;; NSRectEdge: MinX 0, MinY 1, MaxX 2, MaxY 3; the bottom is MaxY in a flipped view.
    (objc/send-p-void shell (objc/sel "setAppearance:") (objc/send v (objc/sel "effectiveAppearance")))
    (objc/send-rpl-void shell (objc/sel "showRelativeToRect:ofView:preferredEdge:")
                        (anchor-rect widget rectangle) v
                        (case edge :left 0 :right 2
                              :top (if (flipped? v) 1 3)
                              (if (flipped? v) 3 1)))))

(defmethod ui/backend-close-popover [(b cocoa-backend) p]
  (let [shell (shell-of p)
        a (ffi/address shell)]
    (swap! closing conj a)
    (try (objc/send-void shell (objc/sel "close"))
         (finally (swap! closing disj a)))))

(defn- popover-closed! [shell]
  (when-not (contains? @closing (ffi/address shell))
    (when-let [p (objc/object-for shell)]
      (ui/surface-closed! p :dismissed))))

(def ^:private code-text-view
  "A code view's NSTextView (defined below).")

(defn- text-view-or-view [w]
  (cond (instance? ui/text-view-widget w) (text-view-of w)
        (instance? ui/code-view-widget w) (code-text-view w)
        :else (view w)))

(defmethod ui/backend-caret-rectangle [(b cocoa-backend) w position]
  ;; NSTextInputClient gives a screen rectangle: through the window to the widget's view.
  (objc/call-with-pool
   (fn []
     (let [tv (text-view-or-view w)
           win (objc/send tv (objc/sel "window"))
           units (if (instance? ui/code-view-widget w)
                   (ui/buffer-utf16-position (:buffer w) position)
                   position)
           screen-rect (objc/send-rangep-rect tv (objc/sel "firstRectForCharacterRange:actualRange:")
                                              {:location units :length 0} (ffi/null))
           window-rect (objc/send-r-rect win (objc/sel "convertRectFromScreen:") screen-rect)
           v (view w)
           [x y width height] (objc/rect-vec (objc/send-rp-rect v (objc/sel "convertRect:fromView:")
                                                                window-rect (ffi/null)))
           [_ _ _ vh] (objc/rect-vec (objc/send-rect v (objc/sel "bounds")))]
       (mapv (fn [n] (int (math/round n)))
             [x (if (flipped? v) y (- vh y height)) (max 1 width) height])))))

(defn- place-panel! [s widget anchor]
  (let [v (view widget)
        owner (objc/send v (objc/sel "window"))
        shell (shell-of s)]
    (when (and (not (ffi/null? owner)) (objc/send-bool owner (objc/sel "isVisible")))
      (let [rectangle (if (vector? anchor)
                        anchor
                        (ui/backend-caret-rectangle (ui/current-backend) widget
                                                    (if (= anchor :caret)
                                                      (ui/caret-position widget)
                                                      anchor)))
            window-rect (objc/send-rp-rect v (objc/sel "convertRect:toView:")
                                           (anchor-rect widget rectangle) (ffi/null))
            [ax ay aw ah] (objc/rect-vec (objc/send-r-rect owner (objc/sel "convertRectToScreen:")
                                                           window-rect))
            screen (let [sc (objc/send owner (objc/sel "screen"))]
                     (if (ffi/null? sc) (objc/send (objc/cls "NSScreen") (objc/sel "mainScreen")) sc))
            [sx sy sw sh] (objc/rect-vec (objc/send-rect screen (objc/sel "visibleFrame")))
            ;; From the top: y grows downward as place-popup expects.
            [x y _] (ui/place-popup [ax (- (+ ay ah)) aw ah] (:size s) [sx (- (+ sy sh)) sw sh])
            parent (objc/send shell (objc/sel "parentWindow"))]
        (objc/send-p-void shell (objc/sel "setAppearance:")
                          (objc/send v (objc/sel "effectiveAppearance")))
        (when-not (ffi/null? parent)
          (objc/send-p-void parent (objc/sel "removeChildWindow:") shell))
        (objc/send-point-void shell (objc/sel "setFrameTopLeftPoint:") {:x (f64 x) :y (f64 (- y))})
        (objc/send-pl owner (objc/sel "addChildWindow:ordered:") shell 1)   ; NSWindowAbove
        (objc/send-p-void shell (objc/sel "orderFront:") (ffi/null))))))

(def ^:private placements
  "A completion popup's view address -> the number of its latest placement."
  (atom {}))

(def ^:private placement-count (atom 0))

(defmethod ui/backend-show-panel [(b cocoa-backend) s widget anchor]
  ;; A text view tells of a change before its selection moves: place the popup at the
  ;; caret on the next turn of the loop; a newer placement makes this one stale.
  (let [token (swap! placement-count inc)
        a (ffi/address (view s))]
    (swap! placements assoc a token)
    (ui/backend-call-later b (fn []
                               (when (and (= token (get @placements a)) (:shown s)
                                          (not (:destroyed s)) (not (:destroyed widget)))
                                 (place-panel! s widget anchor))))))

(defmethod ui/backend-close-panel [(b cocoa-backend) s]
  (swap! placements dissoc (ffi/address (view s)))
  (let [shell (shell-of s)
        parent (objc/send shell (objc/sel "parentWindow"))]
    (when-not (ffi/null? parent)
      (objc/send-p-void parent (objc/sel "removeChildWindow:") shell))
    (objc/send-p-void shell (objc/sel "orderOut:") (ffi/null))))

(defn native-surface-shown?
  "True if the popover's NSPopover or the completion popup's NSPanel is shown."
  [s]
  (let [shell (shell-of s)]
    (if (instance? ui/popover-widget s)
      (objc/send-bool shell (objc/sel "isShown"))
      (objc/send-bool shell (objc/sel "isVisible")))))

(defn native-panel-frame
  "The completion popup's panel frame on the screen, [x y width height] from the top left
of the main screen."
  [s]
  (let [[x y w h] (objc/rect-vec (objc/send-rect (shell-of s) (objc/sel "frame")))]
    (mapv (fn [n] (int (math/round n))) [x (- (screen-height) y h) w h])))

(defn native-screen-rect
  "Where the rectangle [x y width height] in the widget is on the screen, [x y width
height] from the top left of the main screen."
  [w rectangle]
  (let [v (view w)
        win (objc/send v (objc/sel "window"))
        [x y rw rh] (objc/rect-vec
                     (objc/send-r-rect win (objc/sel "convertRectToScreen:")
                                       (objc/send-rp-rect v (objc/sel "convertRect:toView:")
                                                          (anchor-rect w rectangle) (ffi/null))))]
    (mapv (fn [n] (int (math/round n))) [x (- (screen-height) y rh) rw rh])))

;;; ------------------------------------------------------------------------------------
;;; Code views: an NSTextView over a text storage shared by the buffer's views. Each text
;;; buffer with views has one NSTextStorage; each code view is a flipped view holding a
;;; gutter of line numbers and, beside it, an NSScrollView with an NSTextView that has its
;;; own NSLayoutManager and NSTextContainer on the shared storage (TextKit's way of showing
;;; one text in several views). The core's edits reach the storage through
;;; backend-buffer-replaced; the storage's own (typing, pasting, input methods) come back
;;; from textStorage:didProcessEditing:... as native-buffer-edited!. AppKit hasn't told the
;;; layout managers of an edit when that runs, so what the core asks of the views meanwhile
;;; is done just after. Runs are layout-manager temporary attributes, so they are per
;;; view; bold and italic change the font, which only the shared storage can.

(def ^:private code-parts
  "A code view's view address -> {:inner :scroll :layout :gutter :clip :tracker
:placeholder :gutter-thickness :visible-lines :font-runs}."
  (atom {}))

(def ^:private storages
  "A text buffer -> [its NSTextStorage, the number of views on it]."
  (atom {}))

(def ^:private pushing
  "Above 0 while skein-ui changes a storage or selection itself, so the delegate methods
that report the user's changes ignore it."
  (atom 0))

(defn- pushing! [f]
  (swap! pushing inc)
  (try (f) (finally (swap! pushing dec))))

(def ^:private in-storage-edit
  "True while a storage edit is being reported, before the layout managers know of it."
  (atom false))

(def ^:private deferred
  "Calls on code views waiting for the storage edit being reported to finish."
  (atom []))

(defn- flush-deferred! []
  (loop []
    (let [[calls _] (reset-vals! deferred [])]
      (when (seq calls)
        (doseq [f calls] (f))
        (recur)))))

(defn- defer-native!
  "Call f now, or during a storage edit as soon as the text view has finished it
(textDidChange:), or failing that from the event loop."
  [f]
  (if @in-storage-edit
    (do (when (empty? @deferred)
          (ui/backend-call-later (ui/current-backend) flush-deferred!))
        (swap! deferred conj f))
    (do (flush-deferred!) (f))))

(defn- parts [w] (get @code-parts (ffi/address (view w))))
(defn- code-text-view [w] (:inner (parts w)))

(defn- point-target [w]
  (if (instance? ui/code-view-widget w) (code-text-view w) (menu-target w)))

(defn- u16 [w position] (ui/buffer-utf16-position (:buffer w) position))
(defn- from-u16 [w units] (ui/buffer-position-from-utf16 (:buffer w) units))

(defn- base-attributes
  "The attributes of plain text in the code view: its font, text color and tab stops."
  [w]
  (let [d (text-attributes (:font w) nil)
        style (objc/send (objc/send (objc/cls "NSParagraphStyle") (objc/sel "defaultParagraphStyle"))
                         (objc/sel "mutableCopy"))]
    (objc/send-p-void style (objc/sel "setTabStops:") (objc/send (objc/cls "NSArray") (objc/sel "array")))
    (objc/send-d-void style (objc/sel "setDefaultTabInterval:")
                      (f64 (* (max 1 (:tab-width w)) (first (string-size " " (:font w))))))
    (objc/autorelease style)
    (objc/send-pp-void d (objc/sel "setObject:forKey:") (palette-ns-color w :text)
                       (objc/ns-string "NSColor"))
    (objc/send-pp-void d (objc/sel "setObject:forKey:") style (objc/ns-string "NSParagraphStyle"))
    d))

(defn- attributed [s attributes]
  (objc/autorelease (objc/send-pp (objc/alloc "NSAttributedString")
                                  (objc/sel "initWithString:attributes:")
                                  (objc/ns-string s) attributes)))

(defn- storage-of [buffer] (first (get @storages buffer)))

(defn- storage-length [storage] (objc/send-long storage (objc/sel "length")))

(def ^:private update-gutter!
  "Size the gutter for the number of lines, and redraw it (defined below).")

(def ^:private update-placeholder!
  "Show the code view's placeholder while it is empty (defined below).")

(defn- apply-base-attributes!
  "Give the code view's storage its font and tab stops, and its text view the same for
typing."
  [w]
  (let [storage (storage-of (:buffer w))
        attributes (base-attributes w)]
    (when storage
      (pushing! (fn []
                  (objc/send-void storage (objc/sel "beginEditing"))
                  (objc/send-prange-void storage (objc/sel "setAttributes:range:") attributes
                                         {:location 0 :length (storage-length storage)})
                  (objc/send-void storage (objc/sel "endEditing")))))
    (objc/send-p-void (code-text-view w) (objc/sel "setTypingAttributes:") attributes)
    (update-gutter! w)))

(defn- recolor-code-view!
  ;; Plain text's color is in its attributes, made from the palette: made again, and the
  ;; runs given back their fonts and paragraph styles, which that overwrites.
  [w]
  (apply-base-attributes! w)
  (when (ui/palette-color w :caret)
    (objc/send-p-void (code-text-view w) (objc/sel "setInsertionPointColor:")
                      (palette-ns-color w :caret)))
  (ui/set-text-runs! w (ui/text-runs w)))

(defn- attach-storage!
  "Put the code view's layout manager on its buffer's storage, making the storage first."
  [w]
  (let [buffer (:buffer w)]
    (when-not (get @storages buffer)
      (let [storage (objc/new-object "NSTextStorage")]
        (pushing! (fn [] (objc/send-range-p-void storage (objc/sel "replaceCharactersInRange:withAttributedString:")
                                                 {:location 0 :length 0}
                                                 (attributed (ui/buffer-text buffer) (base-attributes w)))))
        (objc/send-p-void storage (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
        (objc/register! storage buffer)
        (swap! storages assoc buffer [storage 0])))
    (swap! storages update-in [buffer 1] inc)
    (objc/send-p-void (storage-of buffer) (objc/sel "addLayoutManager:") (:layout (parts w)))
    (swap! code-parts assoc-in [(ffi/address (view w)) :storage-buffer] buffer)
    (apply-base-attributes! w)))

(defn- detach-storage! [w]
  (when-let [buffer (:storage-buffer (parts w))]
    (when-let [[storage n] (get @storages buffer)]
      (objc/send-p-void storage (objc/sel "removeLayoutManager:") (:layout (parts w)))
      (swap! code-parts update (ffi/address (view w)) dissoc :storage-buffer)
      (if (> n 1)
        (swap! storages update-in [buffer 1] dec)
        (do (objc/unregister! storage)
            (objc/send-p-void storage (objc/sel "setDelegate:") (ffi/null))
            (objc/release storage)
            (swap! storages dissoc buffer))))))

(defmethod make-native [(w ui/code-view-widget)]
  (let [big 1.0e7
        b (ui/current-backend)
        host (flipped-view)
        scroll (init-frame "NSScrollView")
        container (objc/send-z (objc/alloc "NSTextContainer") (objc/sel "initWithSize:")
                               {:width big :height big})
        layout (objc/new-object "NSLayoutManager")
        tv (objc/send-rp (objc/alloc "SkeinCodeTextView") (objc/sel "initWithFrame:textContainer:")
                         (objc/rect 0 0 300 200) container)
        gutter (init-frame "SkeinGutterView")
        clip (objc/send scroll (objc/sel "contentView"))
        tracker (objc/new-object "SkeinTracker")]
    (objc/send-b-void container (objc/sel "setWidthTracksTextView:") false)
    (objc/send-p-void layout (objc/sel "addTextContainer:") container)
    (objc/send-b-void layout (objc/sel "setAllowsNonContiguousLayout:") true)
    (objc/release container)
    (doseq [setting ["setRichText:" "setAllowsUndo:" "setUsesRuler:" "setImportsGraphics:"
                     "setAutomaticQuoteSubstitutionEnabled:" "setAutomaticDashSubstitutionEnabled:"
                     "setAutomaticTextReplacementEnabled:" "setAutomaticSpellingCorrectionEnabled:"
                     "setContinuousSpellCheckingEnabled:" "setGrammarCheckingEnabled:"
                     "setSmartInsertDeleteEnabled:" "setAutomaticLinkDetectionEnabled:"]]
      (objc/send-b-void tv (objc/sel setting) false))
    ;; The pointer over the text: one tracking area that follows the visible rectangle.
    (let [area (objc/send-rlpp (objc/alloc "NSTrackingArea") (objc/sel "initWithRect:options:owner:userInfo:")
                               (objc/rect 0 0 0 0) (+ 0x01 0x02 0x40 0x200) tracker (ffi/null))]
      (objc/send-p-void tv (objc/sel "addTrackingArea:") area)
      (objc/release area))
    (objc/send-b-void tv (objc/sel "setUsesFindBar:") true)
    (objc/send-b-void tv (objc/sel "setIncrementalSearchingEnabled:") true)
    (objc/send-b-void tv (objc/sel "setHorizontallyResizable:") true)
    (objc/send-b-void tv (objc/sel "setVerticallyResizable:") true)
    (objc/send-z-void tv (objc/sel "setMaxSize:") {:width big :height big})
    (objc/send-l-void tv (objc/sel "setAutoresizingMask:") 18)
    (objc/send-z-void tv (objc/sel "setTextContainerInset:") {:width 2.0 :height 4.0})
    (objc/send-p-void tv (objc/sel "setDelegate:") (:text-delegate b))
    (objc/send-p-void scroll (objc/sel "setDocumentView:") tv)
    (objc/send-b-void scroll (objc/sel "setHasVerticalScroller:") true)
    (objc/send-b-void scroll (objc/sel "setHasHorizontalScroller:") true)
    (objc/send-b-void scroll (objc/sel "setAutohidesScrollers:") true)
    (objc/send-l-void scroll (objc/sel "setBorderType:") 0)
    (objc/send-p-void host (objc/sel "addSubview:") gutter)
    (objc/send-p-void host (objc/sel "addSubview:") scroll)
    (objc/release gutter)
    (objc/release scroll)
    (objc/release tv)
    (objc/send-b-void clip (objc/sel "setPostsBoundsChangedNotifications:") true)
    (objc/send-pppp-void (objc/send (objc/cls "NSNotificationCenter") (objc/sel "defaultCenter"))
                         (objc/sel "addObserver:selector:name:object:")
                         (:text-delegate b) (objc/sel "boundsDidChange:")
                         (objc/ns-string "NSViewBoundsDidChangeNotification") clip)
    (doseq [o [tv gutter clip tracker]] (also-register! o w))
    (swap! code-parts assoc (ffi/address host)
           {:inner tv :scroll scroll :layout layout :gutter gutter :clip clip :tracker tracker})
    host))

(defmethod ui/backend-destroy :before [(b cocoa-backend) (w ui/code-view-widget)]
  (let [{:keys [inner layout gutter clip tracker]} (parts w)]
    (objc/send-ppp-void (objc/send (objc/cls "NSNotificationCenter") (objc/sel "defaultCenter"))
                        (objc/sel "removeObserver:name:object:") (:text-delegate b)
                        (objc/ns-string "NSViewBoundsDidChangeNotification") clip)
    (objc/send-p-void inner (objc/sel "setDelegate:") (ffi/null))
    (detach-storage! w)
    (doseq [o [inner gutter clip tracker]] (objc/unregister! o))
    (objc/release layout)
    (objc/release tracker)
    (swap! code-parts dissoc (ffi/address (view w)))))

(defn- gutter-thickness [w]
  (f64 (math/ceil (+ 20 (* (max 3 (count (str (ui/buffer-line-count (:buffer w)))))
                           (first (string-size "0" (:font w))))))))

(defn- place-parts!
  "Put the gutter at the code view's left and the scroll view in the rest."
  [w]
  (let [{:keys [gutter scroll]} (parts w)
        [_ _ width height] (objc/rect-vec (objc/send-rect (view w) (objc/sel "bounds")))
        g (if (:line-numbers w) (gutter-thickness w) 0.0)]
    (objc/send-b-void gutter (objc/sel "setHidden:") (zero? g))
    (objc/send-r-void gutter (objc/sel "setFrame:") (objc/rect 0 0 g height))
    (objc/send-r-void scroll (objc/sel "setFrame:") (objc/rect g 0 (max 0 (- width g)) height))
    (swap! code-parts assoc-in [(ffi/address (view w)) :gutter-thickness] g)))

(defn- update-gutter! [w]
  (when-let [gutter (:gutter (parts w))]
    (when (and (:line-numbers w) (not= (gutter-thickness w) (:gutter-thickness (parts w))))
      (place-parts! w))
    (objc/send-b-void gutter (objc/sel "setNeedsDisplay:") true)))

(defmethod layout-subviews [(w ui/code-view-widget) width height]
  (place-parts! w)
  (update-placeholder! w))

(defmethod native-natural-size [(w ui/code-view-widget)] [300 200])

(defmethod set-native [(w ui/code-view-widget) (p (= :buffer)) buffer]
  (detach-storage! w)
  (attach-storage! w)
  (update-placeholder! w))

(defmethod set-native [(w ui/code-view-widget) (p (= :font)) f]
  (apply-base-attributes! w)
  (update-placeholder! w))

(defmethod set-native [(w ui/code-view-widget) (p (= :tab-width)) v]
  (apply-base-attributes! w))

(defmethod set-native [(w ui/code-view-widget) (p (= :editable)) v]
  (objc/send-b-void (code-text-view w) (objc/sel "setEditable:") (boolean (and v (:enabled w)))))

(defmethod set-native [(w ui/code-view-widget) (p (= :enabled)) v]
  (objc/send-b-void (code-text-view w) (objc/sel "setSelectable:") (boolean v))
  (objc/send-b-void (code-text-view w) (objc/sel "setEditable:") (boolean (and v (:editable w)))))

(defmethod set-native [(w ui/code-view-widget) (p (= :line-numbers)) v]
  (place-parts! w))

(defmethod set-native [(w ui/code-view-widget) (p (= :wrap)) v]
  (let [{:keys [inner scroll]} (parts w)
        container (objc/send inner (objc/sel "textContainer"))]
    (objc/send-b-void scroll (objc/sel "setHasHorizontalScroller:") (not v))
    (objc/send-b-void inner (objc/sel "setHorizontallyResizable:") (not v))
    (objc/send-b-void container (objc/sel "setWidthTracksTextView:") (boolean v))
    (if v
      (let [[cw _] (objc/size-vec (objc/send-size scroll (objc/sel "contentSize")))
            [_ _ _ th] (objc/rect-vec (objc/send-rect inner (objc/sel "frame")))]
        (objc/send-z-void inner (objc/sel "setFrameSize:") {:width cw :height th}))
      (objc/send-z-void container (objc/sel "setContainerSize:") {:width 1.0e7 :height 1.0e7}))
    (place-parts! w)))

(defmethod set-native [(w ui/code-view-widget) (p (= :placeholder)) v]
  (update-placeholder! w))

;;; Edits both ways

(defmethod ui/backend-buffer-replaced [(b cocoa-backend) buffer start old-end text removed]
  (let [storage (storage-of buffer)
        w (first (filter ui/realized? (:views buffer)))]
    (when (and storage w)
      (pushing! (fn []
                  (objc/send-void storage (objc/sel "beginEditing"))
                  (objc/send-range-p-void storage (objc/sel "replaceCharactersInRange:withAttributedString:")
                                          {:location (ui/buffer-utf16-position buffer start)
                                           :length (ui/utf16-length removed)}
                                          (attributed text (base-attributes w)))
                  (objc/send-void storage (objc/sel "endEditing")))))))

(defn- storage-edited! [storage actions location len delta]
  ;; NSTextStorageEditedCharacters 2
  (let [buffer (objc/object-for storage)]
    (when (and buffer (pos? (bit-and actions 2)) (zero? @pushing))
      (let [start (ui/buffer-position-from-utf16 buffer location)
            old-end (ui/buffer-position-from-utf16 buffer (+ location (- len delta)))
            text (objc/string-of (objc/send-range-p (objc/send storage (objc/sel "string"))
                                                    (objc/sel "substringWithRange:")
                                                    {:location location :length len}))
            origin (let [v @editing-view] (when (and v (identical? (:buffer v) buffer)) v))]
        (reset! in-storage-edit true)
        (try (ui/native-buffer-edited! buffer start old-end (or text "") origin)
             (finally (reset! in-storage-edit false)))))
    (when buffer
      (doseq [v (:views buffer)] (when (ui/realized? v) (update-placeholder! v))))))

(defmethod native-text-changed [(w ui/code-view-widget) tv]
  (flush-deferred!))

(defmethod native-selection-changed [(w ui/code-view-widget) o]
  (let [{:keys [inner gutter]} (parts w)]
    (if (= (ffi/address o) (ffi/address inner))
      (when (and (zero? @pushing) (not @in-storage-edit))
        (let [r (objc/send-range inner (objc/sel "selectedRange"))
              location (ffi/field r objc/ns-range :location)
              start (from-u16 w location)
              end (from-u16 w (+ location (ffi/field r objc/ns-range :length)))
              upstream (zero? (objc/send-long inner (objc/sel "selectionAffinity")))
              [anchor cursor] (cond (= start end) [start start]
                                    (= (:anchor w) start) [start end]
                                    (= (:anchor w) end) [end start]
                                    upstream [end start]
                                    :else [start end])]
          (ui/native-selection-changed! w anchor cursor)
          (objc/send-b-void gutter (objc/sel "setNeedsDisplay:") true)))
      ;; Its clip view scrolled.
      (when-not (:destroyed w)
        (objc/send-b-void gutter (objc/sel "setNeedsDisplay:") true)
        (ui/code-view-scrolled! w)))))

(defmethod ui/backend-code-set-selection [(b cocoa-backend) w anchor cursor]
  (defer-native!
   (fn []
     (when-not (:destroyed w)
       ;; The selection when this runs, which may be later than the call.
       (let [n (ui/text-length w)
             anchor (min (:anchor w) n)
             cursor (min (:cursor w) n)
             a (u16 w anchor)
             c (u16 w cursor)]
         (pushing! (fn [] (objc/send-range-lb-void (code-text-view w)
                                                   (objc/sel "setSelectedRange:affinity:stillSelecting:")
                                                   {:location (min a c) :length (abs (- a c))}
                                                   (if (< cursor anchor) 0 1) false)))
         (objc/send-b-void (:gutter (parts w)) (objc/sel "setNeedsDisplay:") true))))))

(defmethod ui/backend-redraw [(b cocoa-backend) (w ui/code-view-widget) rect]
  (defer-native! (fn [] (when-not (:destroyed w) (update-gutter! w)))))

;;; Geometry

(defn- container-origin [w]
  (let [p (objc/send-point (code-text-view w) (objc/sel "textContainerOrigin"))]
    [(ffi/field p objc/ns-point :x) (ffi/field p objc/ns-point :y)]))

(defn- visible-character-range
  "[location length] of the UTF-16 units the code view shows."
  [w]
  (let [tv (code-text-view w)
        [x y vw vh] (objc/rect-vec (objc/send-rect tv (objc/sel "visibleRect")))
        [ox oy] (container-origin w)
        layout (:layout (parts w))
        glyphs (objc/send-rp-range layout (objc/sel "glyphRangeForBoundingRect:inTextContainer:")
                                   (objc/rect (- x ox) (- y oy) vw vh)
                                   (objc/send tv (objc/sel "textContainer")))
        chars (objc/send-rangep-range layout (objc/sel "characterRangeForGlyphRange:actualGlyphRange:")
                                      {:location (ffi/field glyphs objc/ns-range :location)
                                       :length (ffi/field glyphs objc/ns-range :length)}
                                      (ffi/null))]
    [(ffi/field chars objc/ns-range :location) (ffi/field chars objc/ns-range :length)]))

(defmethod ui/backend-code-visible-lines [(b cocoa-backend) w]
  (if @in-storage-edit
    (or (:visible-lines (parts w)) [0 0])
    (let [buffer (:buffer w)
          [location len] (visible-character-range w)
          lines [(ui/position-line buffer (from-u16 w location))
                 (ui/position-line buffer (from-u16 w (+ location len)))]]
      (swap! code-parts assoc-in [(ffi/address (view w)) :visible-lines] lines)
      lines)))

(defn- default-line-height [w]
  (objc/send-p-double (:layout (parts w)) (objc/sel "defaultLineHeightForFont:") (ns-font (:font w))))

(defn- line-fragment
  "[x y width height], in the text view, of the line fragment holding the UTF-16 offset
units."
  [w units]
  (let [layout (:layout (parts w))
        length (storage-length (objc/send (code-text-view w) (objc/sel "textStorage")))
        [ox oy] (container-origin w)
        glyph-rect (fn [u] (objc/rect-vec
                            (objc/send-lp-rect layout (objc/sel "lineFragmentRectForGlyphAtIndex:effectiveRange:")
                                               (objc/send-l-long layout (objc/sel "glyphIndexForCharacterAtIndex:") u)
                                               (ffi/null))))
        [x y fw fh] (if (>= units length)
                      (do (when (pos? length)
                            (objc/send-range-void layout (objc/sel "ensureLayoutForCharacterRange:")
                                                  {:location (dec length) :length 1}))
                          (let [[ex ey ew eh] (objc/rect-vec (objc/send-rect layout (objc/sel "extraLineFragmentRect")))]
                            (if (or (pos? eh) (zero? length))
                              [ex ey ew (if (pos? eh) eh (default-line-height w))]
                              (glyph-rect (dec length)))))
                      (glyph-rect units))]
    [(+ x ox) (+ y oy) fw fh]))

(defmethod ui/backend-code-position-at-point [(b cocoa-backend) w x y]
  (from-u16 w (objc/send-point-long (code-text-view w) (objc/sel "characterIndexForInsertionAtPoint:")
                                    {:x (f64 x) :y (f64 y)})))

(defmethod ui/backend-code-point-at-position [(b cocoa-backend) w position]
  (let [units (u16 w position)
        tv (code-text-view w)
        layout (:layout (parts w))
        container (objc/send tv (objc/sel "textContainer"))
        length (storage-length (objc/send tv (objc/sel "textStorage")))
        [fx fy _ fh] (line-fragment w units)
        [ox _] (container-origin w)
        glyph-x (fn [u] (objc/rect-vec
                         (objc/send-rangep-rect layout (objc/sel "boundingRectForGlyphRange:inTextContainer:")
                                                {:location (objc/send-l-long layout (objc/sel "glyphIndexForCharacterAtIndex:") u)
                                                 :length 1}
                                                container)))
        text (ui/code-text w)
        x (cond (< units length) (+ ox (first (glyph-x units)))
                (or (zero? length) (= \newline (last text)))
                (+ fx (objc/send-double container (objc/sel "lineFragmentPadding")))
                :else (let [[bx _ bw _] (glyph-x (dec length))] (+ ox bx bw)))]
    [x fy fh]))

(defmethod ui/backend-code-scroll-to-position [(b cocoa-backend) w position]
  (defer-native!
   (fn []
     (when-not (:destroyed w)
       (objc/send-range-void (code-text-view w) (objc/sel "scrollRangeToVisible:")
                             {:location (u16 w (min position (ui/text-length w))) :length 0})))))

(defmethod ui/backend-code-gutter-width [(b cocoa-backend) w]
  (int (gutter-thickness w)))

(defmethod native-draw [(w ui/code-view-widget)]
  ;; The gutter: line numbers beside the lines that show, the caret's line in full color.
  (let [{:keys [gutter inner]} (parts w)
        [_ gy gw gh] (objc/rect-vec (objc/send-rect gutter (objc/sel "bounds")))
        gc (make cocoa-context :cg (current-cg) :width gw :height gh :widget w)
        buffer (:buffer w)
        f (:font w)
        current (ui/position-line buffer (:cursor w))
        [location len] (visible-character-range w)]
    (ui/fill-rectangle! gc 0 gy gw gh {:color (ui/widget-color w :gutter-background)})
    (ui/fill-rectangle! gc (- gw 1) gy 1 gh {:color (ui/widget-color w :separator)})
    (doseq [line (range (ui/position-line buffer (from-u16 w location))
                        (inc (ui/position-line buffer (from-u16 w (+ location len)))))]
      (let [[_ fy] (line-fragment w (u16 w (ui/line-start buffer line)))
            p (objc/send-point-p gutter (objc/sel "convertPoint:fromView:") {:x 0.0 :y (f64 fy)} inner)
            label (str (inc line))]
        (ui/draw-text! gc label (- gw 10) (ffi/field p objc/ns-point :y)
                       {:font f :align :right
                        :color (ui/widget-color w (if (= line current) :text :gutter-text))})))))

;;; Runs

(def ^:private run-dictionaries
  "[color background underline strikethrough] -> a retained NSDictionary of temporary
attributes."
  (atom {}))

(def ^:private temporary-attributes
  ["NSColor" "NSBackgroundColor" "NSUnderline" "NSStrikethrough"])

(defn- temporary-run? [a]
  (or (:color a) (:background a) (:underline a) (:strikethrough a)))

(defn- run-dictionary [attrs]
  (let [k [(:color attrs) (:background attrs) (boolean (:underline attrs))
           (boolean (:strikethrough attrs))]]
    (or (get @run-dictionaries k)
        (let [d (objc/retain (objc/send (objc/cls "NSMutableDictionary") (objc/sel "dictionary")))]
          (when-let [c (first k)]
            (objc/send-pp-void d (objc/sel "setObject:forKey:") (ns-color c) (objc/ns-string "NSColor")))
          (when-let [c (second k)]
            (objc/send-pp-void d (objc/sel "setObject:forKey:") (ns-color c)
                               (objc/ns-string "NSBackgroundColor")))
          (when (nth k 2)
            (objc/send-pp-void d (objc/sel "setObject:forKey:")
                               (objc/send-l (objc/cls "NSNumber") (objc/sel "numberWithInteger:") 1)
                               (objc/ns-string "NSUnderline")))
          (when (nth k 3)
            (objc/send-pp-void d (objc/sel "setObject:forKey:")
                               (objc/send-l (objc/cls "NSNumber") (objc/sel "numberWithInteger:") 1)
                               (objc/ns-string "NSStrikethrough")))
          (swap! run-dictionaries assoc k d)
          d))))

(defn- storage-run?
  "Whether a run's attributes need the text storage: a font of its own, or a paragraph's."
  [a]
  (or (:bold a) (:italic a) (:size a) (:family a) (:image a)
      (some (fn [k] (contains? a k)) ui/run-paragraph-attributes)))

(defn- text-attachment
  "An NSTextAttachment showing a run's :image at its :image-width by :image-height."
  [a]
  (let [t (objc/autorelease (objc/new-object "NSTextAttachment"))]
    (objc/send-p-void t (objc/sel "setImage:") (ns-image (:image a)))
    (objc/send-r-void t (objc/sel "setBounds:") (objc/rect 0 0 (:image-width a) (:image-height a)))
    t))

(defn- run-font
  "The code view's font changed as a run's attributes say."
  [w a]
  (cond-> (:font w)
    (:size a) (assoc :size (:size a))
    (:family a) (assoc :family (:family a))
    (contains? a :bold) (assoc :weight (if (:bold a) :bold :regular))
    (contains? a :italic) (assoc :italic (boolean (:italic a)))))

(defn- paragraph-style
  "An NSParagraphStyle of a run's paragraph attributes: indents, spacing, tab stops, and a
block (NSTextBlock) the text view's whole width for a background."
  [a]
  (let [p (objc/autorelease (objc/new-object "NSMutableParagraphStyle"))
        indent (f64 (or (:indent a) 0))]
    (objc/send-d-void p (objc/sel "setHeadIndent:") indent)
    (objc/send-d-void p (objc/sel "setFirstLineHeadIndent:")
                      (max 0.0 (+ indent (f64 (or (:first-indent a) 0)))))
    (when-let [x (:space-above a)]
      (objc/send-d-void p (objc/sel "setParagraphSpacingBefore:") (f64 x)))
    (when-let [x (:space-below a)]
      (objc/send-d-void p (objc/sel "setParagraphSpacing:") (f64 x)))
    (when-let [tabs (:tabs a)]
      (let [array (objc/send (objc/cls "NSMutableArray") (objc/sel "array"))
            none (objc/send (objc/cls "NSDictionary") (objc/sel "dictionary"))]
        (doseq [t tabs]
          (objc/send-p-void array (objc/sel "addObject:")
                            (objc/autorelease
                             (objc/send-ldp (objc/alloc "NSTextTab")
                                            (objc/sel "initWithTextAlignment:location:options:")
                                            0 (f64 t) none))))     ; left
        (objc/send-p-void p (objc/sel "setTabStops:") array)))
    (when-let [c (:block-background a)]
      (let [block (objc/autorelease (objc/new-object "NSTextBlock"))]
        (objc/send-p-void block (objc/sel "setBackgroundColor:") (ns-color c))
        ;; 100 percent (NSTextBlockPercentageValueType) of the width (NSTextBlockWidth).
        (objc/send-dll-void block (objc/sel "setValue:type:forDimension:") 100.0 1 0)
        (objc/send-p-void p (objc/sel "setTextBlocks:")
                          (objc/send-p (objc/cls "NSArray") (objc/sel "arrayWithObject:") block))))
    p))

(defmethod ui/backend-code-apply-runs [(b cocoa-backend) w start end runs]
  (defer-native!
   (fn []
     (when-not (:destroyed w)
       (let [layout (:layout (parts w))
             n (ui/text-length w)
             start (min start n)
             end (min end n)
             s16 (u16 w start)
             whole {:location s16 :length (- (u16 w end) s16)}
             storage? (or (:storage-runs (parts w)) (some (fn [[_ _ a]] (storage-run? a)) runs))]
         (doseq [name temporary-attributes]
           (objc/send-prange-void layout (objc/sel "removeTemporaryAttribute:forCharacterRange:")
                                  (objc/ns-string name) whole))
         (doseq [[rs re a] runs]
           (when (temporary-run? a)
             (let [x (u16 w (min rs n))]
               (objc/send-prange-void layout (objc/sel "addTemporaryAttributes:forCharacterRange:")
                                      (run-dictionary a)
                                      {:location x :length (- (u16 w (min re n)) x)}))))
         ;; Fonts and paragraph styles: attributes of the shared storage. A paragraph style
         ;; covers the whole lines its run touches.
         (when storage?
           (swap! code-parts assoc-in [(ffi/address (view w)) :storage-runs] true)
           (let [storage (objc/send (code-text-view w) (objc/sel "textStorage"))
                 text (objc/send storage (objc/sel "string"))]
             (pushing!
              (fn []
                (objc/send-void storage (objc/sel "beginEditing"))
                (objc/send-pprange-void storage (objc/sel "addAttribute:value:range:")
                                        (objc/ns-string "NSFont") (ns-font (:font w)) whole)
                ;; The core restyles whole lines, so their paragraphs' runs are all here.
                (objc/send-prange-void storage (objc/sel "removeAttribute:range:")
                                       (objc/ns-string "NSAttachment") whole)
                (objc/send-prange-void storage (objc/sel "removeAttribute:range:")
                                       (objc/ns-string "NSParagraphStyle")
                                       (objc/send-range-range
                                        text (objc/sel "paragraphRangeForRange:") whole))
                (doseq [[rs re a] runs]
                  (let [x (u16 w (min rs n))
                        r {:location x :length (- (u16 w (min re n)) x)}]
                    (when (some (fn [k] (contains? a k)) [:bold :italic :size :family])
                      (objc/send-pprange-void storage (objc/sel "addAttribute:value:range:")
                                              (objc/ns-string "NSFont") (ns-font (run-font w a)) r))
                    (when (:image a)
                      (objc/send-pprange-void storage (objc/sel "addAttribute:value:range:")
                                              (objc/ns-string "NSAttachment") (text-attachment a)
                                              r))
                    (when (some (fn [k] (contains? a k)) ui/run-paragraph-attributes)
                      (objc/send-pprange-void
                       storage (objc/sel "addAttribute:value:range:")
                       (objc/ns-string "NSParagraphStyle") (paragraph-style a)
                       (objc/send-range-range text (objc/sel "paragraphRangeForRange:") r)))))
                (objc/send-void storage (objc/sel "endEditing")))))))))))

;;; Rich text's links: the text storage's own (NSLinkAttributeName), which AppKit shows
;;; with a pointing hand and reports clicks on (textView:clickedOnLink:atIndex:).

(defmethod ui/backend-native-links? [(b cocoa-backend)] true)

(defmethod ui/backend-show-links [(b cocoa-backend) w links]
  (defer-native!
   (fn []
     (when-not (:destroyed w)
       (let [storage (objc/send (code-text-view w) (objc/sel "textStorage"))
             n (ui/text-length w)]
         (pushing!
          (fn []
            (objc/send-void storage (objc/sel "beginEditing"))
            (objc/send-prange-void storage (objc/sel "removeAttribute:range:")
                                   (objc/ns-string "NSLink") {:location 0 :length (u16 w n)})
            (doseq [[i [s e _]] (map-indexed vector links)]
              (let [x (u16 w (min s n))]
                (objc/send-pprange-void storage (objc/sel "addAttribute:value:range:")
                                        (objc/ns-string "NSLink") (objc/ns-string (str i))
                                        {:location x :length (- (u16 w (min e n)) x)})))
            (objc/send-void storage (objc/sel "endEditing")))))))))

(defmethod native-link-clicked [(w ui/rich-text-widget) units]
  (some? (ui/link-clicked-by-user! w (from-u16 w units))))

(defmethod native-link-clicked [w units] false)

(defn click-link!
  "For tests: tell the rich text's text view its link at position was clicked, as AppKit
does."
  [w position]
  (let [tv (code-text-view w)]
    (objc/send-ppl-bool (objc/send tv (objc/sel "delegate"))
                        (objc/sel "textView:clickedOnLink:atIndex:")
                        tv (objc/ns-string "") (u16 w position))))

(defn link-at-native
  "For tests: the NSLink attribute's value at position in the code view's text storage, or
nil."
  [w position]
  (let [v (objc/send-plp (objc/send (code-text-view w) (objc/sel "textStorage"))
                         (objc/sel "attribute:atIndex:effectiveRange:")
                         (objc/ns-string "NSLink") (u16 w position) (ffi/null))]
    (when-not (ffi/null? v) (objc/string-of v))))

;;; The pointer over the text, and the placeholder

(defn- code-mouse! [w selector e]
  (when (:enabled w)
    (let [[x y] (event-point (code-text-view w) e)
          signal (cond (= selector "mouseMoved:") :mouse-move
                       (= selector "mouseEntered:") :mouse-enter
                       :else :mouse-leave)]
      (ui/emit! w (ui/event-for w signal :x x :y y :modifiers (event-modifiers e))))))

(defn- placeholder-label [w]
  (or (:placeholder (parts w))
      (let [label (objc/send (objc/alloc "SkeinPassiveLabel") (objc/sel "init"))]
        (objc/send-b-void label (objc/sel "setBezeled:") false)
        (objc/send-b-void label (objc/sel "setDrawsBackground:") false)
        (objc/send-b-void label (objc/sel "setEditable:") false)
        (objc/send-b-void label (objc/sel "setSelectable:") false)
        (objc/send-p-void label (objc/sel "setTextColor:")
                          (objc/send (objc/cls "NSColor") (objc/sel "placeholderTextColor")))
        (objc/send-p-void (code-text-view w) (objc/sel "addSubview:") label)
        (objc/release label)
        (swap! code-parts assoc-in [(ffi/address (view w)) :placeholder] label)
        label)))

(defn- update-placeholder! [w]
  (when-let [tv (code-text-view w)]
    (let [text (:placeholder w)
          shown (and (seq (str (or text "")))
                     (zero? (storage-length (objc/send tv (objc/sel "textStorage")))))]
      (when (or shown (:placeholder (parts w)))
        (let [label (placeholder-label w)]
          (objc/send-b-void label (objc/sel "setHidden:") (not shown))
          (when shown
            (objc/send-p-void label (objc/sel "setFont:") (ns-font (:font w)))
            (objc/send-p-void label (objc/sel "setStringValue:") (objc/ns-string text))
            (let [[ox oy] (container-origin w)
                  padding (objc/send-double (objc/send tv (objc/sel "textContainer"))
                                            (objc/sel "lineFragmentPadding"))
                  [_ _ bw _] (objc/rect-vec (objc/send-rect tv (objc/sel "bounds")))
                  [_ lh] (objc/size-vec (objc/send-size label (objc/sel "fittingSize")))
                  x (+ ox padding)]
              (objc/send-r-void label (objc/sel "setFrame:")
                                (objc/rect x oy (max 0 (- bw x ox padding)) lh)))))))))

(defn native-code-text
  "The text of the code view's NSTextView."
  [w]
  (objc/string-of (objc/send (code-text-view w) (objc/sel "string"))))

(defn code-text-attributes
  "What the code view's text storage has at position: its font's :size, :monospace and
:bold, and its paragraph style's :indent, :first-indent (from :indent), :space-above,
:space-below, :tabs and :block-background (whether it has a block with a background); an
attachment's [width height] as :attachment; its text's :color, as hex; and from the
layout's temporary attributes, :strikethrough."
  [w position]
  (objc/call-with-pool
   (fn []
     (let [storage (objc/send (code-text-view w) (objc/sel "textStorage"))
           i (u16 w position)
           at (fn [name] (objc/send-plp storage (objc/sel "attribute:atIndex:effectiveRange:")
                                        (objc/ns-string name) i (ffi/null)))
           font (at "NSFont")
           p (at "NSParagraphStyle")
           attachment (at "NSAttachment")
           text-color (at "NSColor")
           struck (objc/send-plp (:layout (parts w))
                                 (objc/sel "temporaryAttribute:atCharacterIndex:effectiveRange:")
                                 (objc/ns-string "NSStrikethrough") i (ffi/null))
           traits (objc/send-long (objc/send font (objc/sel "fontDescriptor"))
                                  (objc/sel "symbolicTraits"))
           nth-of (fn [array k] (objc/send-l array (objc/sel "objectAtIndex:") k))]
       (merge {:size (objc/send-double font (objc/sel "pointSize"))
               :monospace (objc/send-bool font (objc/sel "isFixedPitch"))
               :bold (pos? (bit-and traits 2))
               :strikethrough (not (ffi/null? struck))
               :color (when-not (ffi/null? text-color) (ui/color-hex (color-of text-color)))}
              (when-not (ffi/null? attachment)
                (let [r (objc/send-rect attachment (objc/sel "bounds"))]
                  {:attachment [(ffi/field r objc/ns-rect :width)
                                (ffi/field r objc/ns-rect :height)]}))
              (when-not (ffi/null? p)
                (let [tabs (objc/send p (objc/sel "tabStops"))
                      blocks (objc/send p (objc/sel "textBlocks"))
                      head (objc/send-double p (objc/sel "headIndent"))]
                  {:indent head
                   :first-indent (- (objc/send-double p (objc/sel "firstLineHeadIndent")) head)
                   :space-above (objc/send-double p (objc/sel "paragraphSpacingBefore"))
                   :space-below (objc/send-double p (objc/sel "paragraphSpacing"))
                   :tabs (mapv (fn [k] (objc/send-double (nth-of tabs k) (objc/sel "location")))
                               (range (objc/send-long tabs (objc/sel "count"))))
                   :block-background
                   (and (pos? (objc/send-long blocks (objc/sel "count")))
                        (not (ffi/null? (objc/send (nth-of blocks 0)
                                                   (objc/sel "backgroundColor")))))})))))))

(defn type-into-code-view!
  "Type s into the code view's NSTextView as the keyboard does (insertText:), at its
selection."
  [w s]
  ;; NSNotFound: at the selection
  (objc/send-prange-void (code-text-view w) (objc/sel "insertText:replacementRange:")
                         (objc/ns-string s) {:location 9223372036854775807 :length 0})
  (flush-deferred!))

(defn native-code-selection
  "The code view's NSTextView selection, [location length] in UTF-16 units."
  [w]
  (let [r (objc/send-range (code-text-view w) (objc/sel "selectedRange"))]
    [(ffi/field r objc/ns-range :location) (ffi/field r objc/ns-range :length)]))

(defn code-placeholder-shown?
  "True if the code view shows its placeholder."
  [w]
  (boolean (when-let [l (:placeholder (parts w))] (not (objc/send-bool l (objc/sel "isHidden"))))))

;;; ------------------------------------------------------------------------------------
;;; Row icons: lists, tables and trees are view-based, each cell an NSTableCellView with a
;;; label and an image view, so an icon and its text share the row's selection and
;;; appearance.

(defn- with-app-appearance [f]
  (let [old (objc/send (objc/cls "NSAppearance") (objc/sel "currentAppearance"))]
    (objc/send-p-void (objc/cls "NSAppearance") (objc/sel "setCurrentAppearance:")
                      (objc/send (:app (ui/current-backend)) (objc/sel "effectiveAppearance")))
    (try (f)
         (finally (objc/send-p-void (objc/cls "NSAppearance") (objc/sel "setCurrentAppearance:") old)))))

(defn- cell-parts
  "[text image alignment] of a cell."
  [w index row-or-item]
  (cond
    (instance? ui/tree-view-widget w)
    (let [item (item-of row-or-item)]
      [(ui/tree-cell-text w item index) (ui/row-icon w item index)
       (:alignment (get (vec (:columns w)) index))])
    :else
    (let [items (vec (:items w))
          row row-or-item]
      [(native-cell-text w row index)
       (when (< -1 row (count items)) (ui/row-icon w (nth items row) index))
       (:alignment (get (vec (:columns w)) index))])))

(defn- cell-view [w table col index row-or-item]
  (let [[text image alignment] (cell-parts w index row-or-item)
        id (objc/ns-string "skein-cell")
        made (objc/send-pp table (objc/sel "makeViewWithIdentifier:owner:") id (ffi/null))
        cell (if (ffi/null? made)
               (let [c (objc/autorelease (objc/new-object "NSTableCellView"))
                     label (objc/send-p (objc/cls "NSTextField") (objc/sel "labelWithString:")
                                        (objc/ns-string ""))
                     icon (objc/autorelease (objc/new-object "NSImageView"))]
                 (objc/send-p-void c (objc/sel "setIdentifier:") id)
                 (objc/send-l-void label (objc/sel "setLineBreakMode:") 4)    ; truncate tail
                 (objc/send-l-void icon (objc/sel "setImageScaling:") 3)      ; proportionally
                 (objc/send-p-void c (objc/sel "addSubview:") label)
                 (objc/send-p-void c (objc/sel "addSubview:") icon)
                 (objc/send-p-void c (objc/sel "setTextField:") label)
                 (objc/send-p-void c (objc/sel "setImageView:") icon)
                 c)
               made)
        width (objc/send-double col (objc/sel "width"))
        height (objc/send-double table (objc/sel "rowHeight"))
        label (objc/send cell (objc/sel "textField"))
        icon (objc/send cell (objc/sel "imageView"))
        offset (if image 22 2)
        ;; An icon alone in its cell sits where the column aligns its contents.
        icon-x (if (and image (= "" text))
                 (case alignment :center (/ (- width 16) 2) :right (- width 18) 2)
                 2)]
    (objc/send-r-void cell (objc/sel "setFrame:") (objc/rect 0 0 width height))
    (objc/send-r-void label (objc/sel "setFrame:")
                      (objc/rect offset (max 0 (/ (- height 17) 2)) (max 0 (- width offset 2)) 17))
    (objc/send-p-void label (objc/sel "setStringValue:") (objc/ns-string (str text)))
    (objc/send-l-void label (objc/sel "setAlignment:") (text-alignment (or alignment :left)))
    ;; Cells are reused across columns: each is editable as its column says, and tells the
    ;; target when editing ends.
    (let [editable (and (instance? ui/table-view-widget w)
                        (boolean (:editable (get (vec (:columns w)) index))))]
      (objc/send-b-void label (objc/sel "setEditable:") editable)
      (when editable
        (objc/send-p-void label (objc/sel "setTarget:") (:target (ui/current-backend)))
        (objc/send-p-void label (objc/sel "setAction:") (objc/sel "cellEdited:"))
        (objc/send-b-void (objc/send label (objc/sel "cell"))
                          (objc/sel "setSendsActionOnEndEditing:") true)))
    (objc/send-r-void icon (objc/sel "setFrame:") (objc/rect (max 0 icon-x) (/ (- height 16) 2) 16 16))
    ;; A reused cell is cleared when there is no icon.
    (objc/send-p-void icon (objc/sel "setImage:") (ns-image image))
    (objc/send-b-void icon (objc/sel "setHidden:") (nil? image))
    cell))

(defmethod set-native [(l ui/list-box-widget) (p (= :icon-fn)) f]
  (reload! (table-of l)))

(defmethod set-native [(t ui/tree-view-widget) (p (= :icon-fn)) f]
  (reload! (table-of t)))

;;; ------------------------------------------------------------------------------------
;;; Window states. Zooming and miniaturizing take effect at once; full screen animates
;;; into a space of its own, so a state asked for meanwhile waits for it to finish.

(defmethod ui/backend-window-state [(b cocoa-backend) w]
  (let [n (view w)]
    (cond (objc/send-bool n (objc/sel "isMiniaturized")) :minimized
          (pos? (bit-and (bit-shift-left 1 14) (objc/send-long n (objc/sel "styleMask")))) :fullscreen
          (objc/send-bool n (objc/sel "isZoomed")) :maximized
          :else :normal)))

(def ^:private deferred-states
  "A window's address -> the state asked for during a full-screen transition, or to take
after leaving full screen."
  (atom {}))

(defn- settle-state! [w]
  (when-not (:state-transition w)
    (ui/state-changed-by-user! w (ui/backend-window-state (ui/current-backend) w))))

(defn- remember-normal-frame! [w]
  (when (and (:shown w) (= :normal (ui/backend-window-state (ui/current-backend) w)))
    (set-slot! w :normal-frame {:position (:position w) :size [(:width w) (:height w)]})))

(defn- apply-window-state! [w state]
  (let [b (ui/current-backend)
        n (view w)
        a (ffi/address n)
        now (ui/backend-window-state b w)]
    (cond
      (:state-transition w) (swap! deferred-states assoc a state)
      (= now state) (settle-state! w)
      (and (= now :fullscreen) (not= state :fullscreen))
      (do (swap! deferred-states assoc a state)
          ;; AppKit starts the transition a moment later: until it ends, states wait.
          (set-slot! w :state-transition true)
          (objc/send-p-void n (objc/sel "toggleFullScreen:") (ffi/null)))
      :else
      (do (remember-normal-frame! w)
          (when (and (= now :minimized) (not= state :minimized))
            (objc/send-p-void n (objc/sel "deminiaturize:") (ffi/null)))
          (cond
            (= state :fullscreen) (do (set-slot! w :state-transition true)
                                      (objc/send-p-void n (objc/sel "toggleFullScreen:") (ffi/null)))
            (= state :minimized) (objc/send-p-void n (objc/sel "miniaturize:") (ffi/null))
            (not= (= state :maximized) (objc/send-bool n (objc/sel "isZoomed")))
            (do (set-slot! w :state-transition true)
                (try (objc/send-p-void n (objc/sel "zoom:") (ffi/null))
                     (finally (set-slot! w :state-transition false))))
            :else nil)
          (when-not (= state :fullscreen) (settle-state! w))))))

(defmethod set-native [(w ui/window-widget) (p (= :state)) state]
  ;; Before the window shows, show applies it. (A miniaturized window isn't visible.)
  (when (:shown w)
    (apply-window-state! w state)))

(defmethod ui/backend-show :after [(b cocoa-backend) (w ui/window-widget)]
  (when (not= (:state w) (ui/backend-window-state b w))
    (when (nil? (:normal-frame w))
      (set-slot! w :normal-frame {:position (:position w) :size [(:width w) (:height w)]}))
    (apply-window-state! w (:state w))))

(defn- window-state-noticed! [w selector]
  (let [a (ffi/address (view w))
        ;; AppKit ignores a full-screen toggle from inside its notice that one ended.
        take-deferred! (fn []
                         (let [state (get @deferred-states a)]
                           (swap! deferred-states dissoc a)
                           (when state
                             (ui/after 0.1 (fn [] (when-not (:destroyed w)
                                                    (apply-window-state! w state)))))))]
    (cond
      (or (= selector "windowWillEnterFullScreen:") (= selector "windowWillExitFullScreen:"))
      (do (when (= selector "windowWillEnterFullScreen:") (remember-normal-frame! w))
          (set-slot! w :state-transition true))
      (or (= selector "windowDidEnterFullScreen:") (= selector "windowDidExitFullScreen:"))
      (do (set-slot! w :state-transition false)
          (settle-state! w)
          (take-deferred!))
      (= selector "windowShouldZoom:toFrame:")
      ;; The user zooms from the title bar: keep the normal frame through the resizes.
      (when-not (:state-transition w)
        (remember-normal-frame! w)
        (set-slot! w :state-transition true)
        (ui/backend-call-later (ui/current-backend)
                               (fn [] (set-slot! w :state-transition false) (settle-state! w))))
      :else (settle-state! w))))

;;; ------------------------------------------------------------------------------------
;;; Web views: WKWebView, WebKit loaded the first time one is made. A delegate object of
;;; our own is the view's navigation delegate and its pages' message handler; a script's
;;; result comes back to a block that carries a token for the script.

(def ^:private webkit-loaded (atom false))

(defn- url-string [url]
  (when-not (ffi/null? url) (objc/string-of (objc/send url (objc/sel "absoluteString")))))

(defn- error-message [err]
  (or (when-not (ffi/null? err) (objc/string-of (objc/send err (objc/sel "localizedDescription"))))
      "the web engine failed"))

(def ^:private web-delegates
  "A WKWebView's address -> its delegate object."
  (atom {}))

(def ^:private web-scripts
  "A script block's token -> [web view, script id, the block]."
  (atom {}))

(def ^:private web-script-tokens (atom 0))

(defn- json-text
  "The JSON text of a Foundation object (fragments allowed), or nil for null."
  [o]
  (when-not (ffi/null? o)
    (ffi/with-foreign [err (ffi/alloc ptr 1)]
      (ffi/put! err ptr (ffi/null) 0)
      ;; NSJSONWritingFragmentsAllowed 4
      (let [data (objc/send-plp (objc/cls "NSJSONSerialization")
                                (objc/sel "dataWithJSONObject:options:error:") o 4 err)]
        (when (ffi/null? data) (error (error-message (ffi/get err ptr 0))))
        (let [s (objc/send-pl (objc/alloc "NSString") (objc/sel "initWithData:encoding:") data 4)]
          (try (objc/string-of s) (finally (objc/release s))))))))

(ffi/defcallback web-script-result-imp void [block ptr, result ptr, failure ptr]
  (let [token (objc/block-token block)]
    (when-let [[v id b] (get @web-scripts token)]
      (swap! web-scripts dissoc token)
      (let [[json err] (if (ffi/null? failure)
                         (try [(json-text result) nil]
                              (catch error e [nil (ex-message e)]))
                         [nil (error-message failure)])]
        (ui/web-script-completed! v id json err))
      ;; WebKit releases the block after this returns: free it once it surely has.
      (ui/after 5 (fn [] (ffi/free b))))))

(ffi/defcallback web-decide-imp void [self ptr, cmd ptr, web ptr, action ptr, handler ptr]
  ;; WebKit wants exactly one decision, even when a handler fails.
  (let [policy (atom 0)]
    (try
      (when-let [v (objc/object-for web)]
        (let [frame (objc/send action (objc/sel "targetFrame"))
              new-window (ffi/null? frame)
              url (url-string (objc/send (objc/send action (objc/sel "request")) (objc/sel "URL")))
              kind (case (objc/send-long action (objc/sel "navigationType"))
                     0 :link 1 :form 2 :back-forward 3 :reload 4 :form-resubmitted :other)]
          (when (ui/web-navigation-requested!
                 v url {:kind kind :new-window new-window
                        :main-frame (or new-window (objc/send-bool frame (objc/sel "isMainFrame")))})
            (if new-window
              ;; A page's new window opens here instead.
              (ui/after 0 (fn [] (when-not (:destroyed v) (set-slot! v :url url))))
              (reset! policy 1)))))
      (finally (objc/invoke-block-with-long! handler @policy)))))

(ffi/defcallback web-started-imp void [self ptr, cmd ptr, web ptr, navigation ptr]
  (when-let [v (objc/object-for web)] (ui/web-load-started! v)))

(ffi/defcallback web-finished-imp void [self ptr, cmd ptr, web ptr, navigation ptr]
  (when-let [v (objc/object-for web)]
    (ui/web-load-finished! v (url-string (objc/send web (objc/sel "URL"))))))

(ffi/defcallback web-failed-imp void [self ptr, cmd ptr, web ptr, navigation ptr, err ptr]
  ;; -999: a navigation superseded or cancelled on purpose, not a failure.
  (when-let [v (objc/object-for web)]
    (when-not (= -999 (objc/send-long err (objc/sel "code")))
      (ui/web-load-failed! v (error-message err)
                           (or (objc/string-of (objc/send-p (objc/send err (objc/sel "userInfo"))
                                                            (objc/sel "objectForKey:")
                                                            (objc/ns-string "NSErrorFailingURLStringKey")))
                               (url-string (objc/send web (objc/sel "URL"))))))))

(ffi/defcallback web-terminated-imp void [self ptr, cmd ptr, web ptr]
  (when-let [v (objc/object-for web)]
    (ui/web-load-failed! v "the web content process ended" (:current-url v))))

(defn- web-context-message!
  "A right-click in a trusted page, reported as JSON {x y shift control alt command}."
  [v text]
  (let [data (objc/send-l (objc/ns-string text) (objc/sel "dataUsingEncoding:") 4)
        o (objc/send-plp (objc/cls "NSJSONSerialization") (objc/sel "JSONObjectWithData:options:error:")
                         data 0 (ffi/null))]
    (when-not (ffi/null? o)
      (let [field (fn [k] (objc/send-p o (objc/sel "objectForKey:") (objc/ns-string k)))
            number (fn [k] (let [n (field k)] (if (ffi/null? n) 0.0 (objc/send-double n (objc/sel "doubleValue")))))
            flag (fn [k] (let [n (field k)] (and (not (ffi/null? n)) (objc/send-bool n (objc/sel "boolValue")))))
            x (number "x")
            y (number "y")
            mods (set (keep (fn [[k m]] (when (flag k) m))
                            [["shift" :shift] ["control" :control] ["alt" :alt] ["command" :command]]))
            e (ui/event-for v :context-request :x x :y y :button :right :click-count 1 :modifiers mods)]
        (ui/emit! v e)
        (when (and (not (ui/consumed? e)) (:context-menu v))
          (ui/popup-menu! (:context-menu v) v x y))))))

(ffi/defcallback web-message-imp void [self ptr, cmd ptr, controller ptr, message ptr]
  (when-let [v (objc/object-for self)]
    (let [frame (objc/send message (objc/sel "frameInfo"))
          source (url-string (objc/send (objc/send frame (objc/sel "request")) (objc/sel "URL")))
          body (objc/send message (objc/sel "body"))
          text (if (objc/send-p-bool body (objc/sel "isKindOfClass:") (objc/cls "NSString"))
                 (objc/string-of body)
                 (json-text body))
          main (objc/send-bool frame (objc/sel "isMainFrame"))]
      (when (ui/web-message-allowed? v source main)
        (if (= "skeinContext" (objc/string-of (objc/send message (objc/sel "name"))))
          (when (or (:custom-context-menu v) (:context-menu v)) (web-context-message! v text))
          (ui/web-message-received! v text source main))))))

(defn- ensure-webkit! []
  (when-not @webkit-loaded
    (ffi/load-library {:macos "/System/Library/Frameworks/WebKit.framework/WebKit"})
    (objc/define-class! "SkeinWebDelegate" "NSObject"
                        [["webView:decidePolicyForNavigationAction:decisionHandler:" web-decide-imp
                          "v@:@@@?"]
                         ["webView:didStartProvisionalNavigation:" web-started-imp "v@:@@"]
                         ["webView:didFinishNavigation:" web-finished-imp "v@:@@"]
                         ["webView:didFailProvisionalNavigation:withError:" web-failed-imp "v@:@@@"]
                         ["webView:didFailNavigation:withError:" web-failed-imp "v@:@@@"]
                         ["webViewWebContentProcessDidTerminate:" web-terminated-imp "v@:@"]
                         ["userContentController:didReceiveScriptMessage:" web-message-imp "v@:@@"]])
    (objc/add-protocol! "SkeinWebDelegate" "WKNavigationDelegate")
    (objc/add-protocol! "SkeinWebDelegate" "WKScriptMessageHandler")
    (reset! webkit-loaded true)))

(defmethod ui/backend-web-engine-info [(b cocoa-backend) engine]
  (ensure-webkit!)
  (let [bundle (objc/send-p (objc/cls "NSBundle") (objc/sel "bundleWithIdentifier:")
                            (objc/ns-string "com.apple.WebKit"))]
    {:engine :webkit
     :version (when-not (ffi/null? bundle)
                (objc/string-of (objc/send-p bundle (objc/sel "objectForInfoDictionaryKey:")
                                             (objc/ns-string "CFBundleVersion"))))
     :capabilities [:file-loading :html :script-results :messages :navigation-policy
                    :context-menu]}))

(defn- bridge-script [v]
  (str "(()=>{const send=v=>window.webkit.messageHandlers.skein.postMessage("
       "typeof v==='string'?v:JSON.stringify(v));"
       "Object.defineProperty(window,'skein',{value:Object.freeze({postMessage:send})});"
       (if (or (:custom-context-menu v) (:context-menu v))
         (str "document.addEventListener('contextmenu',e=>{e.preventDefault();"
              "window.webkit.messageHandlers.skeinContext.postMessage(JSON.stringify("
              "{x:e.clientX,y:e.clientY,shift:e.shiftKey,control:e.ctrlKey,alt:e.altKey,"
              "command:e.metaKey}));});")
         "")
       "})();"))

(defmethod make-native [(v ui/web-view-widget)]
  (ensure-webkit!)
  (let [config (objc/new-object "WKWebViewConfiguration")
        controller (objc/send config (objc/sel "userContentController"))
        delegate (objc/new-object "SkeinWebDelegate")
        ;; WKUserScriptInjectionTimeAtDocumentStart 0, main frame only
        script (objc/send-plb (objc/alloc "WKUserScript") (objc/sel "initWithSource:injectionTime:forMainFrameOnly:")
                              (objc/ns-string (bridge-script v)) 0 true)]
    (objc/send-pp-void controller (objc/sel "addScriptMessageHandler:name:") delegate (objc/ns-string "skein"))
    (objc/send-pp-void controller (objc/sel "addScriptMessageHandler:name:") delegate
                       (objc/ns-string "skeinContext"))
    (objc/send-p-void controller (objc/sel "addUserScript:") script)
    (let [web (objc/send-rp (objc/alloc "WKWebView") (objc/sel "initWithFrame:configuration:")
                            (objc/rect 0 0 400 300) config)]
      (objc/send-p-void web (objc/sel "setNavigationDelegate:") delegate)
      (also-register! delegate v)
      (swap! web-delegates assoc (ffi/address web) delegate)
      (objc/release script)
      (objc/release config)
      web)))

(defmethod native-natural-size [(v ui/web-view-widget)] [400 300])

(defn- web-ns-url
  "An NSURL of a URL, or of a file path."
  [source]
  (if (ui/web-url? source)
    (let [u (objc/send-p (objc/cls "NSURL") (objc/sel "URLWithString:") (objc/ns-string source))]
      (when (ffi/null? u) (error "not a URL:" (pr-str source)))
      u)
    (objc/send-p (objc/cls "NSURL") (objc/sel "fileURLWithPath:")
                 (objc/ns-string (io/absolute-path source)))))

(defmethod ui/backend-web-load [(b cocoa-backend) v kind source base read-access]
  (let [web (view v)]
    (if (= kind :html)
      (let [base-url (if base (web-ns-url base) (ffi/null))]
        (when (or (ffi/null? base-url) (objc/send-bool base-url (objc/sel "isFileURL")))
          (set-slot! v :local-document (or (url-string base-url) "about:blank")))
        (objc/send-pp web (objc/sel "loadHTMLString:baseURL:") (objc/ns-string source) base-url))
      (let [url (web-ns-url source)]
        (if (objc/send-bool url (objc/sel "isFileURL"))
          (let [scope (if read-access (web-ns-url read-access) url)]
            (set-slot! v :local-document (url-string url))
            (objc/send-pp web (objc/sel "loadFileURL:allowingReadAccessToURL:") url scope))
          (objc/send-p web (objc/sel "loadRequest:")
                       (objc/send-p (objc/cls "NSURLRequest") (objc/sel "requestWithURL:") url)))))))

(defmethod ui/backend-web-run-script [(b cocoa-backend) v script id]
  (let [token (swap! web-script-tokens inc)
        block (objc/token-block web-script-result-imp token)]
    (swap! web-scripts assoc token [v id block])
    (objc/send-pp-void (view v) (objc/sel "evaluateJavaScript:completionHandler:")
                       (objc/ns-string script) block)))

(defmethod ui/backend-web-destroy [(b cocoa-backend) v]
  (let [web (view v)
        a (ffi/address web)
        controller (objc/send (objc/send web (objc/sel "configuration")) (objc/sel "userContentController"))]
    (objc/send-void web (objc/sel "stopLoading"))
    (objc/send-p-void web (objc/sel "setNavigationDelegate:") (ffi/null))
    (doseq [n ["skein" "skeinContext"]]
      (objc/send-p-void controller (objc/sel "removeScriptMessageHandlerForName:") (objc/ns-string n)))
    ;; Results still to come find no script.
    (swap! web-scripts (fn [m] (into {} (remove (fn [[_ [x]]] (identical? x v)) m))))
    (when-let [d (get @web-delegates a)]
      (objc/unregister! d)
      (objc/release d)
      (swap! web-delegates dissoc a))))
