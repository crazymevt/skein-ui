(ns skein.ui.cocoa
  "The Cocoa backend (Skein's M2.14, D-097): skein.ui's widgets as AppKit's own controls,
on macOS, through the Objective-C runtime (skein.ui.cocoa.objc).

  (ui/use-backend! (cocoa/backend))

AppKit runs on the main thread: -main runs there, and ui/run! runs the event loop there.
A call from another fiber is queued for the main thread, which the backend wakes from
the event loop to run it, while the fiber waits for its result.

Containers are flipped views, so layout's coordinates (from the top left) are AppKit's
too. For tests, click!, type-text!, press-return!, native-string and native-frame act on
and read the real controls."
  (:require [skein.ui :as ui]
            [skein.ui.cocoa.objc :as objc]
            [skein.ffi :as ffi]
            [skein.math :as math]
            [skein.system :as system]))

;;; ------------------------------------------------------------------------------------
;;; What each widget class implements here

(defgeneric make-native [w]
  "Make w's AppKit object, owned (+1), without its properties: the core sets them next.")

(defgeneric set-native [w property value]
  "Show value, w's new property, in its AppKit object. The default ignores the property.")

(defmethod set-native [w property value]
  nil)

(defgeneric native-action [w sender]
  "w's AppKit control sent its action (a click, Return): emit what the user did.")

(defmethod native-action [w sender]
  nil)

(defgeneric native-text-changed [w field]
  "The user edited the text of w's AppKit field.")

(defmethod native-text-changed [w field]
  nil)

(defgeneric native-selection-changed [w sender]
  "The user chose something in w's AppKit control: an item of a combo entry's list, a tab,
a divider position.")

(defmethod native-selection-changed [w sender]
  nil)

(defgeneric layout-subviews [w width height]
  "Place the AppKit views inside w's own, after it got the size width by height; for
widgets made of several views, such as a spin button.")

(defmethod layout-subviews [w width height]
  nil)

(defgeneric native-row-count [w]
  "How many rows w's table shows (a list box or table).")

(defgeneric native-cell-text [w row column]
  "The text w's table shows in row at column (indices).")

(defgeneric native-double-action [w sender]
  "The user double-clicked a row of w's table or outline view.")

(defgeneric native-column-clicked [w column]
  "The user clicked the title of column, an NSTableColumn of w's table.")

(defgeneric native-outline [w op item arg]
  "Answer w's outline view about the item (a pointer, null for the roots): op is :count,
:child (arg is the index), :expandable? or :text (arg is the column index).")

(defgeneric native-expanded [w item expanded]
  "The user opened (expanded true) or closed the item (a pointer) in w's outline view.")

(defgeneric native-natural-size [w]
  "w's natural [width height]: by default its AppKit view's fitting size.")

(defgeneric container-view [o]
  "The NSView that o's children go in: by default its own.")

(defmethod container-view [o]
  (:native o))

(defn- view [o] (:native o))

;;; ------------------------------------------------------------------------------------
;;; Callbacks: the methods of our Objective-C classes

(ffi/defcallback drain-imp void [self ptr, cmd ptr, arg ptr]
  (drain-main-thread!))

(ffi/defcallback action-imp void [self ptr, cmd ptr, sender ptr]
  (when-let [w (objc/object-for sender)]
    (native-action w sender)))

(ffi/defcallback should-close-imp bool [self ptr, cmd ptr, window ptr]
  (when-let [w (objc/object-for window)]
    (ui/close! w))
  false)

(ffi/defcallback did-resize-imp void [self ptr, cmd ptr, note ptr]
  (let [window (objc/send note (objc/sel "object"))]
    (when-let [w (objc/object-for window)]
      (let [[_ _ width height] (objc/rect-vec
                                (objc/send-rect (objc/send window (objc/sel "contentView"))
                                                (objc/sel "frame")))
            width (int (math/round width))
            height (int (math/round height))]
        (when (not= [width height] [(:width w) (:height w)])
          (ui/resized-by-user! w width height))))))

(ffi/defcallback text-changed-imp void [self ptr, cmd ptr, note ptr]
  (let [field (objc/send note (objc/sel "object"))]
    (when-let [w (objc/object-for field)]
      (native-text-changed w field))))

(ffi/defcallback yes-imp bool [self ptr, cmd ptr]
  true)

(ffi/defcallback selection-imp void [self ptr, cmd ptr, note ptr]
  ;; A notification whose object is the control: a combo box's choice, a split view's
  ;; divider, a clip view's bounds (scrolling).
  (let [o (objc/send note (objc/sel "object"))]
    (when-let [w (objc/object-for o)]
      (native-selection-changed w o))))

(ffi/defcallback tab-selected-imp void [self ptr, cmd ptr, tab-view ptr, item ptr]
  (when-let [w (objc/object-for tab-view)]
    (native-selection-changed w item)))

;; Tables and outline views: their data source and delegate.

(ffi/defcallback row-count-imp i64 [self ptr, cmd ptr, tv ptr]
  (if-let [w (objc/object-for tv)] (native-row-count w) 0))

(defn- column-index [tv col]
  (objc/send-p-long (objc/send tv (objc/sel "tableColumns")) (objc/sel "indexOfObject:") col))

(ffi/defcallback cell-value-imp ptr [self ptr, cmd ptr, tv ptr, col ptr, row i64]
  (if-let [w (objc/object-for tv)]
    (objc/ns-string (native-cell-text w row (column-index tv col)))
    (ffi/null)))

(ffi/defcallback double-action-imp void [self ptr, cmd ptr, sender ptr]
  (when-let [w (objc/object-for sender)]
    (native-double-action w sender)))

(ffi/defcallback column-clicked-imp void [self ptr, cmd ptr, tv ptr, col ptr]
  (when-let [w (objc/object-for tv)]
    (native-column-clicked w col)))

(ffi/defcallback outline-count-imp i64 [self ptr, cmd ptr, ov ptr, item ptr]
  (if-let [w (objc/object-for ov)] (native-outline w :count item nil) 0))

(ffi/defcallback outline-child-imp ptr [self ptr, cmd ptr, ov ptr, index i64, item ptr]
  (if-let [w (objc/object-for ov)] (native-outline w :child item index) (ffi/null)))

(ffi/defcallback outline-expandable-imp bool [self ptr, cmd ptr, ov ptr, item ptr]
  (if-let [w (objc/object-for ov)] (boolean (native-outline w :expandable? item nil)) false))

(ffi/defcallback outline-value-imp ptr [self ptr, cmd ptr, ov ptr, col ptr, item ptr]
  (if-let [w (objc/object-for ov)]
    (objc/ns-string (native-outline w :text item (column-index ov col)))
    (ffi/null)))

(defn- note-item
  "The item an outline view notification is about."
  [note]
  (objc/send-p (objc/send note (objc/sel "userInfo")) (objc/sel "objectForKey:")
               (objc/ns-string "NSObject")))

(ffi/defcallback item-expanded-imp void [self ptr, cmd ptr, note ptr]
  (when-let [w (objc/object-for (objc/send note (objc/sel "object")))]
    (native-expanded w (note-item note) true)))

(ffi/defcallback item-collapsed-imp void [self ptr, cmd ptr, note ptr]
  (when-let [w (objc/object-for (objc/send note (objc/sel "object")))]
    (native-expanded w (note-item note) false)))

;;; ------------------------------------------------------------------------------------
;;; The backend, and running on the main thread

(defclass cocoa-backend [ui/backend]
  "The Cocoa backend."
  (app :init nil :doc "The NSApplication.")
  (waker :init nil :doc "The object whose drain: runs the main thread's queued work.")
  (target :init nil :doc "The target of every control's action.")
  (window-delegate :init nil)
  (text-delegate :init nil)
  (data-source :init nil :doc "The data source and delegate of tables and outline views.")
  (modes :init nil :doc "An NSArray of the run loop modes AppKit runs in."))

(defn- define-classes! []
  (objc/define-class! "SkeinWaker" "NSObject" [["drain:" drain-imp "v@:@"]])
  (objc/define-class! "SkeinTarget" "NSObject" [["action:" action-imp "v@:@"]
                                                ["doubleAction:" double-action-imp "v@:@"]])
  (objc/define-class! "SkeinDataSource" "NSObject"
                      [["numberOfRowsInTableView:" row-count-imp "q@:@"]
                       ["tableView:objectValueForTableColumn:row:" cell-value-imp "@@:@@q"]
                       ["tableViewSelectionDidChange:" selection-imp "v@:@"]
                       ["tableView:didClickTableColumn:" column-clicked-imp "v@:@@"]
                       ["outlineView:numberOfChildrenOfItem:" outline-count-imp "q@:@@"]
                       ["outlineView:child:ofItem:" outline-child-imp "@@:@q@"]
                       ["outlineView:isItemExpandable:" outline-expandable-imp "B@:@@"]
                       ["outlineView:objectValueForTableColumn:byItem:" outline-value-imp
                        "@@:@@@"]
                       ["outlineViewSelectionDidChange:" selection-imp "v@:@"]
                       ["outlineViewItemDidExpand:" item-expanded-imp "v@:@"]
                       ["outlineViewItemDidCollapse:" item-collapsed-imp "v@:@"]])
  (objc/define-class! "SkeinWindowDelegate" "NSObject"
                      [["windowShouldClose:" should-close-imp "B@:@"]
                       ["windowDidResize:" did-resize-imp "v@:@"]])
  (objc/define-class! "SkeinTextDelegate" "NSObject"
                      [["controlTextDidChange:" text-changed-imp "v@:@"]
                       ["textDidChange:" text-changed-imp "v@:@"]
                       ["comboBoxSelectionDidChange:" selection-imp "v@:@"]
                       ["splitViewDidResizeSubviews:" selection-imp "v@:@"]
                       ["boundsDidChange:" selection-imp "v@:@"]
                       ["tabView:didSelectTabViewItem:" tab-selected-imp "v@:@@"]])
  (objc/define-class! "SkeinFlippedView" "NSView" [["isFlipped" yes-imp "B@:"]]))

(defn backend
  "A new Cocoa backend. Make it on the main thread (in -main, or a test)."
  []
  (when-not (= :macos (system/os))
    (error "the Cocoa backend runs only on macOS"))
  (objc/load-frameworks!)
  (objc/call-with-pool
   (fn []
     (let [app (objc/send (objc/cls "NSApplication") (objc/sel "sharedApplication"))
           ;; The modes by name: CoreFoundation knows kCFRunLoopCommonModes only as its own
           ;; constant (by address), so a string of that name would be a mode of its own.
           modes (reduce (fn [a mode]
                           (objc/send-p a (objc/sel "arrayByAddingObject:") (objc/ns-string mode)))
                         (objc/send (objc/cls "NSArray") (objc/sel "array"))
                         ["kCFRunLoopDefaultMode" "NSModalPanelRunLoopMode"
                          "NSEventTrackingRunLoopMode"])]
       (objc/send-l-void app (objc/sel "setActivationPolicy:") 0)
       (define-classes!)
       (make cocoa-backend :app app :modes (objc/retain modes)
             :waker (objc/new-object "SkeinWaker")
             :target (objc/new-object "SkeinTarget")
             :window-delegate (objc/new-object "SkeinWindowDelegate")
             :text-delegate (objc/new-object "SkeinTextDelegate")
             :data-source (objc/new-object "SkeinDataSource"))))))

(defn- wake-main-thread!
  "Make the event loop run the work queued for the main thread soon, also while a menu is
open, a modal dialog runs or the user drags."
  [b]
  (objc/send-ppbp-void (:waker b)
                       (objc/sel "performSelectorOnMainThread:withObject:waitUntilDone:modes:")
                       (objc/sel "drain:") (ffi/null) false (:modes b)))

(defmethod ui/backend-in-ui-thread [(b cocoa-backend) f]
  (if (objc/main-thread?)
    (objc/call-with-pool f)
    (let [t (spawn-pinned :main (objc/call-with-pool f))]
      (wake-main-thread! b)
      @t)))

(defmethod ui/backend-call-later [(b cocoa-backend) f]
  (spawn-pinned :main (objc/call-with-pool f))
  (wake-main-thread! b)
  nil)

(defmethod ui/backend-run-loop [(b cocoa-backend)]
  (objc/call-with-pool
   (fn []
     (objc/send-b-void (:app b) (objc/sel "activateIgnoringOtherApps:") true)
     (objc/send-void (:app b) (objc/sel "run")))))

(defmethod ui/backend-quit-loop [(b cocoa-backend)]
  (ui/backend-in-ui-thread
   b
   (fn []
     (objc/send-p-void (:app b) (objc/sel "stop:") (ffi/null))
     ;; stop: takes effect after the next event, so post one.
     (let [e (objc/send-event
              (objc/cls "NSEvent")
              (objc/sel (str "otherEventWithType:location:modifierFlags:timestamp:"
                             "windowNumber:context:subtype:data1:data2:"))
              15 {:x 0.0 :y 0.0} 0 0.0 0 (ffi/null) 0 0 0)]
       (objc/send-pb-void (:app b) (objc/sel "postEvent:atStart:") e true)))))

;;; ------------------------------------------------------------------------------------
;;; Objects, properties and layout

(defmethod ui/backend-realize [(b cocoa-backend) o]
  (objc/register! (make-native o) o))

(defmethod ui/backend-destroy [(b cocoa-backend) o]
  (let [n (view o)]
    (cond (instance? ui/window-widget o) (objc/send-void n (objc/sel "close"))
          (instance? ui/widget o) (objc/send-void n (objc/sel "removeFromSuperview")))
    (objc/unregister! n)
    (objc/release n)))

(defmethod ui/backend-set-property [(b cocoa-backend) o property value]
  (set-native o property value))

(defmethod ui/backend-get-property [(b cocoa-backend) o property]
  (slot o property))

(defmethod ui/backend-add-child [(b cocoa-backend) parent child]
  (objc/send-p-void (container-view parent) (objc/sel "addSubview:") (view child)))

(defmethod ui/backend-remove-child [(b cocoa-backend) parent child]
  (objc/send-void (view child) (objc/sel "removeFromSuperview")))

(defmethod native-natural-size [w]
  (let [[width height] (objc/size-vec (objc/send-size (view w) (objc/sel "fittingSize")))]
    [(int (math/ceil width)) (int (math/ceil height))]))

(defmethod ui/backend-natural-size [(b cocoa-backend) w]
  (native-natural-size w))

(defmethod ui/backend-set-bounds [(b cocoa-backend) w x y width height]
  (objc/send-r-void (view w) (objc/sel "setFrame:") (objc/rect x y width height))
  (layout-subviews w width height))

(defn- flipped-view []
  (objc/send-r (objc/alloc "SkeinFlippedView") (objc/sel "initWithFrame:") (objc/rect 0 0 0 0)))

(defn- set-string! [o selector s]
  (objc/send-p-void (view o) (objc/sel selector) (objc/ns-string (str (or s "")))))

(defn- set-bool! [o selector v]
  (objc/send-b-void (view o) (objc/sel selector) (boolean v)))

(defn- set-long! [o selector v]
  (objc/send-l-void (view o) (objc/sel selector) v))

(defn- connect-action!
  "Make the control send its action to the backend's target. Returns it."
  [n]
  (objc/send-p-void n (objc/sel "setTarget:") (:target (ui/current-backend)))
  (objc/send-p-void n (objc/sel "setAction:") (objc/sel "action:"))
  n)

(defn- init-frame
  "[[class-name alloc] initWithFrame:NSZeroRect]."
  [class-name]
  (objc/send-r (objc/alloc class-name) (objc/sel "initWithFrame:") (objc/rect 0 0 0 0)))

(defmethod set-native [(w ui/widget) (p (= :visible)) v]
  (set-bool! w "setHidden:" (not v)))

(defmethod set-native [(w ui/widget) (p (= :enabled)) v]
  (when (objc/responds? (view w) "setEnabled:")
    (set-bool! w "setEnabled:" v)))

(defmethod set-native [(w ui/widget) (p (= :tooltip)) v]
  (objc/send-p-void (view w) (objc/sel "setToolTip:") (objc/ns-string v)))

(defn- text-alignment
  "AppKit's NSTextAlignment for :left, :center or :right. Apple silicon Macs number them
as iOS does; Intel Macs put right before center."
  [a]
  (let [ios (= :aarch64 (system/arch))]
    (case a
      :center (if ios 1 2)
      :right (if ios 2 1)
      0)))

;;; ------------------------------------------------------------------------------------
;;; Windows

(defmethod make-native [(w ui/window-widget)]
  (let [b (ui/current-backend)
        win (objc/send-rllb (objc/alloc "NSWindow")
                            (objc/sel "initWithContentRect:styleMask:backing:defer:")
                            (objc/rect 0 0 400 300) 15 2 false)
        content (flipped-view)]
    (objc/send-b-void win (objc/sel "setReleasedWhenClosed:") false)
    (objc/send-p-void win (objc/sel "setContentView:") content)
    (objc/release content)
    (objc/send-p-void win (objc/sel "setDelegate:") (:window-delegate b))
    win))

(defmethod container-view [(w ui/window-widget)]
  (objc/send (view w) (objc/sel "contentView")))

(defmethod set-native [(w ui/window-widget) (p (= :title)) v]
  (set-string! w "setTitle:" v))

(defn- set-content-size! [w]
  (when (and (:width w) (:height w))
    (objc/send-z-void (view w) (objc/sel "setContentSize:")
                      {:width (f64 (:width w)) :height (f64 (:height w))})))

(defmethod set-native [(w ui/window-widget) (p (= :width)) v]
  (set-content-size! w))

(defmethod set-native [(w ui/window-widget) (p (= :height)) v]
  (set-content-size! w))

(defmethod ui/backend-show [(b cocoa-backend) w]
  (objc/send-void (view w) (objc/sel "center"))
  (objc/send-p-void (view w) (objc/sel "makeKeyAndOrderFront:") (ffi/null)))

(defmethod ui/backend-close [(b cocoa-backend) w]
  (objc/send-p-void (view w) (objc/sel "orderOut:") (ffi/null)))

;;; ------------------------------------------------------------------------------------
;;; Containers: flipped views, so children are placed from the top left

(defmethod make-native [(w ui/box-widget)] (flipped-view))
(defmethod make-native [(w ui/grid-widget)] (flipped-view))
(defmethod make-native [(w ui/spacer-widget)] (flipped-view))

(defmethod make-native [(s ui/separator-widget)]
  (let [n (init-frame "NSBox")]
    (objc/send-l-void n (objc/sel "setBoxType:") 2)
    n))

(defmethod native-natural-size [(s ui/separator-widget)]
  (if (= :vertical (:orientation s)) [1 0] [0 1]))

;;; ------------------------------------------------------------------------------------
;;; Labels, buttons and entries

(defmethod make-native [(l ui/label-widget)]
  (objc/retain (objc/send-p (objc/cls "NSTextField") (objc/sel "labelWithString:")
                            (objc/ns-string ""))))

(defmethod set-native [(l ui/label-widget) (p (= :text)) v]
  (set-string! l "setStringValue:" v))

(defmethod set-native [(l ui/label-widget) (p (= :alignment)) v]
  (set-long! l "setAlignment:" (text-alignment v)))

(defmethod set-native [(l ui/label-widget) (p (= :selectable)) v]
  (set-bool! l "setSelectable:" v))

(defmethod set-native [(l ui/label-widget) (p (= :wrap)) v]
  ;; NSLineBreakByWordWrapping is 0, NSLineBreakByTruncatingTail 4.
  (set-long! l "setLineBreakMode:" (if v 0 4))
  (set-long! l "setMaximumNumberOfLines:" (if v 0 1)))

(defmethod native-natural-size [(l ui/label-widget)]
  (if (and (:wrap l) (:width l))
    (do (objc/send-d-void (view l) (objc/sel "setPreferredMaxLayoutWidth:") (f64 (:width l)))
        (call-next-method))
    (call-next-method)))

(defmethod make-native [(b ui/button-widget)]
  (let [n (init-frame "NSButton")]
    (objc/send-l-void n (objc/sel "setButtonType:") 7)   ; NSButtonTypeMomentaryPushIn
    (objc/send-l-void n (objc/sel "setBezelStyle:") 1)   ; NSBezelStyleRounded
    (connect-action! n)))

(defmethod set-native [(b ui/button-widget) (p (= :label)) v]
  (set-string! b "setTitle:" v))

(defmethod set-native [(b ui/button-widget) (p (= :default)) v]
  (when (or v (not (:cancel b)))
    (set-string! b "setKeyEquivalent:" (if v "\r" ""))))

(defmethod set-native [(b ui/button-widget) (p (= :cancel)) v]
  (when (or v (not (:default b)))
    (set-string! b "setKeyEquivalent:" (if v "\u001b" ""))))

(defmethod set-native [(b ui/button-widget) (p (= :style)) v]
  (set-bool! b "setBordered:" (= v :push)))

(defmethod native-action [(b ui/button-widget) sender]
  (ui/emit! b (ui/event-for b :clicked)))

(defn- make-field [class-name]
  (let [n (init-frame class-name)]
    (objc/send-p-void n (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
    (connect-action! n)))

(defmethod make-native [(e ui/entry-widget)] (make-field "NSTextField"))
(defmethod make-native [(e ui/password-entry-widget)] (make-field "NSSecureTextField"))

(defmethod make-native [(e ui/search-entry-widget)]
  (let [n (make-field "NSSearchField")]
    ;; Send the action on Return only, not as the user types.
    (objc/send-b-void n (objc/sel "setSendsWholeSearchString:") true)
    n))

(defmethod set-native [(e ui/entry-widget) (p (= :text)) v]
  (set-string! e "setStringValue:" v))

(defmethod set-native [(e ui/entry-widget) (p (= :placeholder)) v]
  (objc/send-p-void (view e) (objc/sel "setPlaceholderString:") (objc/ns-string v)))

(defmethod set-native [(e ui/entry-widget) (p (= :editable)) v]
  (set-bool! e "setEditable:" v))

(defmethod set-native [(e ui/entry-widget) (p (= :alignment)) v]
  (set-long! e "setAlignment:" (text-alignment v)))

(defmethod native-natural-size [(e ui/entry-widget)]
  (let [[_ height] (call-next-method)]
    [(+ 10 (* 7 (:width-chars e))) height]))

(defmethod native-text-changed [(e ui/entry-widget) field]
  (ui/changed-by-user! e :text (objc/string-of (objc/send field (objc/sel "stringValue")))))

(defmethod native-action [(e ui/entry-widget) sender]
  (ui/emit! e (ui/event-for e :activate)))

;;; ------------------------------------------------------------------------------------
;;; Helpers for the controls below

(def ^:private quiet-depth
  "Above 0 while the backend changes a control itself, so the delegate's notification of
the change isn't taken for the user's."
  (atom 0))

(defn- quiet? [] (pos? @quiet-depth))

(defn- quietly [f]
  (swap! quiet-depth inc)
  (try (f) (finally (swap! quiet-depth dec))))

(defn- also-register!
  "Register the AppKit object o, part of w, as standing for w too. Returns o."
  [o w]
  (objc/register! o w))

(defn- set-double! [o selector v]
  (objc/send-d-void (view o) (objc/sel selector) (f64 (or v 0))))

(defn- double-of [n selector]
  (objc/send-double n (objc/sel selector)))

(defn- whole
  "x as an integer if it is a whole number, so a slider at 7.0 says 7."
  [x]
  (if (= x (math/floor x)) (int x) x))

(def ^:private color-selectors
  {:text "labelColor" :secondary-text "secondaryLabelColor" :disabled-text "tertiaryLabelColor"
   :background "textBackgroundColor" :control-background "controlBackgroundColor"
   :window-background "windowBackgroundColor" :selection "selectedContentBackgroundColor"
   :accent "controlAccentColor" :separator "separatorColor" :link "linkColor"
   :grid "gridColor" :system-red "systemRedColor" :system-orange "systemOrangeColor"
   :system-yellow "systemYellowColor" :system-green "systemGreenColor"
   :system-mint "systemMintColor" :system-teal "systemTealColor"
   :system-cyan "systemCyanColor" :system-blue "systemBlueColor"
   :system-indigo "systemIndigoColor" :system-purple "systemPurpleColor"
   :system-pink "systemPinkColor" :system-brown "systemBrownColor"
   :system-gray "systemGrayColor"})

(defn ns-color
  "An autoreleased NSColor for the color designator d (nil for nil): a system color
keyword gives the platform's own, which follows dark mode."
  [d]
  (let [c (ui/ensure-color d)]
    (cond (nil? c) (ffi/null)
          (keyword? c) (objc/send (objc/cls "NSColor") (objc/sel (get color-selectors c)))
          :else (objc/send-dddd (objc/cls "NSColor")
                                (objc/sel "colorWithSRGBRed:green:blue:alpha:")
                                (f64 (ui/color-red c)) (f64 (ui/color-green c))
                                (f64 (ui/color-blue c)) (f64 (ui/color-alpha c))))))

(defn color-of
  "The skein.ui color of an NSColor, in sRGB."
  [nc]
  (let [c (objc/send-p nc (objc/sel "colorUsingColorSpace:")
                       (objc/send (objc/cls "NSColorSpace") (objc/sel "sRGBColorSpace")))]
    (ui/rgb (double-of c "redComponent") (double-of c "greenComponent")
            (double-of c "blueComponent") (double-of c "alphaComponent"))))

;;; ------------------------------------------------------------------------------------
;;; Images

(def ^:private native-images
  "image (by identity) -> its NSImage, made once and kept: images don't change."
  (atom {}))

(defn ns-image
  "The NSImage of a skein.ui image, or null for nil."
  [image]
  (cond
    (nil? image) (ffi/null)
    (get @native-images image) (get @native-images image)
    :else
    (let [n (if (:path image)
              (objc/send-p (objc/alloc "NSImage") (objc/sel "initWithContentsOfFile:")
                           (objc/ns-string (:path image)))
              (let [w (:width image) h (:height image)
                    rep (objc/send-bitmap
                         (objc/alloc "NSBitmapImageRep")
                         (objc/sel (str "initWithBitmapDataPlanes:pixelsWide:pixelsHigh:"
                                        "bitsPerSample:samplesPerPixel:hasAlpha:isPlanar:"
                                        "colorSpaceName:bytesPerRow:bitsPerPixel:"))
                         (ffi/null) w h 8 4 true false (objc/ns-string "NSDeviceRGBColorSpace")
                         (* 4 w) 32)
                    img (objc/send-z (objc/alloc "NSImage") (objc/sel "initWithSize:")
                                     {:width (f64 w) :height (f64 h)})]
                (ffi/pin [p (:pixels image)]
                  (objc/memcpy (objc/send rep (objc/sel "bitmapData")) p (* 4 w h)))
                (objc/send-p-void img (objc/sel "addRepresentation:") rep)
                (objc/release rep)
                img))]
      (when (ffi/null? n) (error "AppKit can't read the image" (pr-str (:path image))))
      (swap! native-images assoc image n)
      n)))

(defmethod ui/backend-image-size [(b cocoa-backend) path]
  (let [n (objc/send-p (objc/alloc "NSImage") (objc/sel "initWithContentsOfFile:")
                       (objc/ns-string path))]
    (when (ffi/null? n) (error "AppKit can't read the image" (pr-str path)))
    (let [[w h] (objc/size-vec (objc/send-size n (objc/sel "size")))]
      (objc/release n)
      [(int (math/round w)) (int (math/round h))])))

(defmethod make-native [(v ui/image-view-widget)] (init-frame "NSImageView"))

(defmethod set-native [(v ui/image-view-widget) (p (= :image)) image]
  (objc/send-p-void (view v) (objc/sel "setImage:") (ns-image image)))

(defmethod set-native [(v ui/image-view-widget) (p (= :scaling)) s]
  ;; NSImageScaleProportionallyDown 0, AxesIndependently 1, None 2
  (set-long! v "setImageScaling:" (case s :fill 1 :none 2 0)))

(defmethod native-natural-size [(v ui/image-view-widget)]
  (if-let [i (:image v)] [(:width i) (:height i)] [0 0]))

(defmethod set-native [(b ui/button-widget) (p (= :image)) image]
  (objc/send-p-void (view b) (objc/sel "setImage:") (ns-image image))
  ;; NSNoImage 0, NSImageOnly 1, NSImageLeft 2
  (set-long! b "setImagePosition:" (cond (nil? image) 0 (= :icon (:style b)) 1 :else 2)))

;;; ------------------------------------------------------------------------------------
;;; Toggles, check boxes and radio buttons

(defn- make-toggle [button-type]
  (let [n (init-frame "NSButton")]
    (objc/send-l-void n (objc/sel "setButtonType:") button-type)
    (when (= button-type 1) (objc/send-l-void n (objc/sel "setBezelStyle:") 1))
    (connect-action! n)))

(defmethod make-native [(t ui/toggle-button-widget)] (make-toggle 1)) ; NSButtonTypePushOnPushOff
(defmethod make-native [(t ui/check-box-widget)] (make-toggle 3))     ; NSButtonTypeSwitch
(defmethod make-native [(t ui/radio-button-widget)] (make-toggle 4))  ; NSButtonTypeRadio

(defmethod set-native [(t ui/toggle-button-widget) (p (= :label)) v]
  (set-string! t "setTitle:" v))

(defmethod set-native [(t ui/toggle-button-widget) (p (= :checked)) v]
  (set-long! t "setState:" (if v 1 0)))

(defmethod set-native [(t ui/toggle-button-widget) (p (= :image)) image]
  (objc/send-p-void (view t) (objc/sel "setImage:") (ns-image image))
  (set-long! t "setImagePosition:" (cond (nil? image) 0 (= :icon (:style t)) 1 :else 2)))

(defmethod native-action [(t ui/toggle-button-widget) sender]
  (let [on (= 1 (objc/send-long sender (objc/sel "state")))]
    (when (not= on (boolean (:checked t)))
      (ui/toggled-by-user! t on))))

;;; ------------------------------------------------------------------------------------
;;; Sliders, spin buttons, progress bars and spinners

(defmethod make-native [(s ui/slider-widget)]
  (let [n (init-frame "NSSlider")]
    (objc/send-b-void n (objc/sel "setContinuous:") true)
    (connect-action! n)))

(defmethod set-native [(s ui/slider-widget) (p (= :min)) v] (set-double! s "setMinValue:" v))
(defmethod set-native [(s ui/slider-widget) (p (= :max)) v] (set-double! s "setMaxValue:" v))
(defmethod set-native [(s ui/slider-widget) (p (= :value)) v] (set-double! s "setDoubleValue:" v))
(defmethod set-native [(s ui/slider-widget) (p (= :ticks)) v]
  (set-long! s "setNumberOfTickMarks:" (or v 0)))
(defmethod set-native [(s ui/slider-widget) (p (= :snap)) v]
  (set-bool! s "setAllowsTickMarkValuesOnly:" v))
(defmethod set-native [(s ui/slider-widget) (p (= :orientation)) v]
  (set-bool! s "setVertical:" (= v :vertical)))

(defmethod native-natural-size [(s ui/slider-widget)]
  (let [[w h] (call-next-method)]
    (if (= :vertical (:orientation s)) [w (max h 120)] [(max w 120) h])))

(defmethod native-action [(s ui/slider-widget) sender]
  (let [v (whole (double-of sender "doubleValue"))]
    (when (not= v (:value s))
      (ui/changed-by-user! s :value v))))

(defn- spin-parts
  "The field and the stepper inside a spin button's view."
  [w]
  (let [subviews (objc/send (view w) (objc/sel "subviews"))]
    [(objc/send-l subviews (objc/sel "objectAtIndex:") 0)
     (objc/send-l subviews (objc/sel "objectAtIndex:") 1)]))

(defmethod make-native [(w ui/spin-button-widget)]
  (let [n (flipped-view)
        field (init-frame "NSTextField")
        stepper (init-frame "NSStepper")]
    (connect-action! field)
    (connect-action! stepper)
    (objc/send-b-void stepper (objc/sel "setValueWraps:") false)
    (objc/send-p-void n (objc/sel "addSubview:") field)
    (objc/send-p-void n (objc/sel "addSubview:") stepper)
    (also-register! field w)
    (also-register! stepper w)
    (objc/release field)
    (objc/release stepper)
    n))

(defn- show-spin-value! [w]
  (let [[field stepper] (spin-parts w)
        v (or (:value w) 0)]
    (objc/send-d-void stepper (objc/sel "setDoubleValue:") (f64 v))
    (objc/send-p-void field (objc/sel "setStringValue:")
                      (objc/ns-string (format (str "%." (or (:digits w) 0) "f") (f64 v))))))

(defmethod set-native [(w ui/spin-button-widget) (p (= :min)) v]
  (objc/send-d-void (second (spin-parts w)) (objc/sel "setMinValue:") (f64 v)))
(defmethod set-native [(w ui/spin-button-widget) (p (= :max)) v]
  (objc/send-d-void (second (spin-parts w)) (objc/sel "setMaxValue:") (f64 v)))
(defmethod set-native [(w ui/spin-button-widget) (p (= :step)) v]
  (objc/send-d-void (second (spin-parts w)) (objc/sel "setIncrement:") (f64 v)))
(defmethod set-native [(w ui/spin-button-widget) (p (= :value)) v] (show-spin-value! w))
(defmethod set-native [(w ui/spin-button-widget) (p (= :digits)) v] (show-spin-value! w))

(defmethod native-natural-size [(w ui/spin-button-widget)]
  [(+ 64 (* 7 (or (:digits w) 0))) 22])

(defmethod layout-subviews [(w ui/spin-button-widget) width height]
  (let [[field stepper] (spin-parts w)]
    (objc/send-r-void field (objc/sel "setFrame:") (objc/rect 0 0 (max 0 (- width 19)) height))
    (objc/send-r-void stepper (objc/sel "setFrame:") (objc/rect (max 0 (- width 15)) 0 15 height))))

(defmethod native-action [(w ui/spin-button-widget) sender]
  (let [[field stepper] (spin-parts w)
        v (if (= (ffi/address sender) (ffi/address stepper))
            (double-of stepper "doubleValue")
            (math/clamp (double-of field "doubleValue") (:min w) (:max w)))
        v (whole v)]
    (ui/sync-property! w :value v)
    (show-spin-value! w)
    (ui/emit! w (ui/event-for w :changed :value v))))

(defmethod make-native [(p ui/progress-bar-widget)]
  (let [n (init-frame "NSProgressIndicator")]
    (objc/send-l-void n (objc/sel "setStyle:") 0)
    n))

(defmethod set-native [(b ui/progress-bar-widget) (p (= :min)) v] (set-double! b "setMinValue:" v))
(defmethod set-native [(b ui/progress-bar-widget) (p (= :max)) v] (set-double! b "setMaxValue:" v))
(defmethod set-native [(b ui/progress-bar-widget) (p (= :value)) v]
  (set-double! b "setDoubleValue:" v))
(defmethod set-native [(b ui/progress-bar-widget) (p (= :indeterminate)) v]
  (set-bool! b "setIndeterminate:" v)
  (objc/send-p-void (view b) (objc/sel (if v "startAnimation:" "stopAnimation:")) (ffi/null)))

(defmethod native-natural-size [(b ui/progress-bar-widget)]
  [120 (second (call-next-method))])

(defmethod make-native [(s ui/spinner-widget)]
  (let [n (init-frame "NSProgressIndicator")]
    (objc/send-l-void n (objc/sel "setStyle:") 1)
    (objc/send-b-void n (objc/sel "setDisplayedWhenStopped:") false)
    n))

(defmethod set-native [(s ui/spinner-widget) (p (= :active)) v]
  (objc/send-p-void (view s) (objc/sel (if v "startAnimation:" "stopAnimation:")) (ffi/null)))

(defmethod native-natural-size [(s ui/spinner-widget)]
  [16 16])

;;; ------------------------------------------------------------------------------------
;;; Combo boxes and combo entries

(defmethod make-native [(c ui/combo-box-widget)]
  (connect-action! (objc/send-rb (objc/alloc "NSPopUpButton")
                                 (objc/sel "initWithFrame:pullsDown:") (objc/rect 0 0 0 0) false)))

(defn- show-items! [c]
  (let [n (view c)]
    (objc/send-void n (objc/sel "removeAllItems"))
    (doseq [i (range (count (:items c)))]
      (objc/send-p-void n (objc/sel "addItemWithTitle:") (objc/ns-string (ui/item-text c i))))))

(defmethod set-native [(c ui/combo-box-widget) (p (= :items)) v]
  (show-items! c)
  (set-long! c "selectItemAtIndex:" (or (:selected-index c) -1)))

(defmethod set-native [(c ui/combo-box-widget) (p (= :item-label)) v]
  (set-native c :items (:items c)))

(defmethod set-native [(c ui/combo-box-widget) (p (= :selected-index)) v]
  (set-long! c "selectItemAtIndex:" (or v -1)))

(defmethod native-action [(c ui/combo-box-widget) sender]
  (let [i (objc/send-long sender (objc/sel "indexOfSelectedItem"))]
    (ui/chosen-by-user! c (when (>= i 0) i))))

(defmethod make-native [(c ui/combo-entry-widget)]
  (let [n (init-frame "NSComboBox")]
    (objc/send-p-void n (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
    (connect-action! n)))

(defmethod set-native [(c ui/combo-entry-widget) (p (= :items)) v]
  (objc/send-void (view c) (objc/sel "removeAllItems"))
  (doseq [i (range (count v))]
    (objc/send-p-void (view c) (objc/sel "addItemWithObjectValue:")
                      (objc/ns-string (ui/item-text c i)))))

(defmethod set-native [(c ui/combo-entry-widget) (p (= :item-label)) v]
  (set-native c :items (:items c)))

(defmethod set-native [(c ui/combo-entry-widget) (p (= :text)) v]
  (set-string! c "setStringValue:" v))

(defmethod native-text-changed [(c ui/combo-entry-widget) field]
  (ui/changed-by-user! c :text (objc/string-of (objc/send field (objc/sel "stringValue")))))

(defmethod native-selection-changed [(c ui/combo-entry-widget) sender]
  (let [i (objc/send-long sender (objc/sel "indexOfSelectedItem"))]
    (when (>= i 0)
      (ui/changed-by-user! c :text (ui/item-text c i)))))

(defmethod native-action [(c ui/combo-entry-widget) sender]
  (ui/emit! c (ui/event-for c :activate)))

(defmethod native-natural-size [(c ui/combo-entry-widget)]
  (let [[w h] (call-next-method)] [(max w 120) h]))

;;; ------------------------------------------------------------------------------------
;;; Color buttons and date pickers

(defmethod make-native [(c ui/color-button-widget)]
  (connect-action! (init-frame "NSColorWell")))

(defmethod set-native [(c ui/color-button-widget) (p (= :color)) v]
  (objc/send-p-void (view c) (objc/sel "setColor:") (ns-color v)))

(defmethod native-action [(c ui/color-button-widget) sender]
  (ui/changed-by-user! c :color (color-of (objc/send sender (objc/sel "color")))))

(defmethod native-natural-size [(c ui/color-button-widget)]
  [44 24])

(defmethod make-native [(d ui/date-picker-widget)]
  (let [n (init-frame "NSDatePicker")]
    (objc/send-l-void n (objc/sel "setDatePickerStyle:") 0)
    (connect-action! n)))

(defmethod set-native [(d ui/date-picker-widget) (p (= :date)) v]
  (objc/send-p-void (view d) (objc/sel "setDateValue:")
                    (objc/send-d (objc/cls "NSDate") (objc/sel "dateWithTimeIntervalSince1970:")
                                 (/ (f64 v) 1000.0))))

(defmethod set-native [(d ui/date-picker-widget) (p (= :mode)) v]
  ;; NSDatePickerElementFlagYearMonthDay 0xe0, HourMinuteSecond 0x0e
  (set-long! d "setDatePickerElements:" (case v :time 0x0e :date-time 0xee 0xe0)))

(defmethod native-action [(d ui/date-picker-widget) sender]
  (let [ms (int (math/round (* 1000 (double-of (objc/send sender (objc/sel "dateValue"))
                                               "timeIntervalSince1970"))))]
    (ui/changed-by-user! d :date ms)))

;;; ------------------------------------------------------------------------------------
;;; Frames

(defmethod make-native [(f ui/frame-widget)]
  (let [n (init-frame "NSBox")
        content (flipped-view)]
    (objc/send-p-void n (objc/sel "setContentView:") content)
    (objc/release content)
    n))

(defmethod container-view [(f ui/frame-widget)]
  (objc/send (view f) (objc/sel "contentView")))

(defmethod set-native [(f ui/frame-widget) (p (= :title)) v]
  ;; NSNoTitle 0, NSAtTop 2
  (set-long! f "setTitlePosition:" (if v 2 0))
  (set-string! f "setTitle:" v))

(defn- frame-decoration
  "What an NSBox adds around its content: the size it takes for a 200 by 200 content."
  [f]
  (let [n (view f)
        old (objc/send-rect n (objc/sel "frame"))
        [ox oy ow oh] (objc/rect-vec old)]
    (objc/send-r-void n (objc/sel "setFrameFromContentFrame:") (objc/rect 0 0 200 200))
    (let [[_ _ w h] (objc/rect-vec (objc/send-rect n (objc/sel "frame")))]
      (objc/send-r-void n (objc/sel "setFrame:") (objc/rect ox oy ow oh))
      [(int (math/ceil (- w 200))) (int (math/ceil (- h 200)))])))

(defmethod ui/backend-decoration-size [(b cocoa-backend) (f ui/frame-widget)]
  (frame-decoration f))

(defmethod ui/backend-content-area [(b cocoa-backend) (f ui/frame-widget) width height]
  (let [[dw dh] (frame-decoration f)]
    [0 0 (max 0 (- width dw)) (max 0 (- height dh))]))

;;; ------------------------------------------------------------------------------------
;;; Text views

(defn- text-view-of
  "The NSTextView inside a text view widget's scroll view."
  [v]
  (objc/send (view v) (objc/sel "documentView")))

(defmethod make-native [(v ui/text-view-widget)]
  (let [scroll (init-frame "NSScrollView")
        tv (objc/send-r (objc/alloc "NSTextView") (objc/sel "initWithFrame:")
                        (objc/rect 0 0 200 100))]
    (objc/send-b-void scroll (objc/sel "setHasVerticalScroller:") true)
    (objc/send-b-void tv (objc/sel "setVerticallyResizable:") true)
    (objc/send-l-void tv (objc/sel "setAutoresizingMask:") 2) ; NSViewWidthSizable
    (objc/send-b-void tv (objc/sel "setRichText:") false)
    (objc/send-p-void tv (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
    (objc/send-p-void scroll (objc/sel "setDocumentView:") tv)
    (also-register! tv v)
    (objc/release tv)
    scroll))

(defmethod set-native [(v ui/text-view-widget) (p (= :text)) s]
  (objc/send-p-void (text-view-of v) (objc/sel "setString:") (objc/ns-string (or s ""))))

(defmethod set-native [(v ui/text-view-widget) (p (= :editable)) e]
  (objc/send-b-void (text-view-of v) (objc/sel "setEditable:") (boolean e)))

(defmethod set-native [(v ui/text-view-widget) (p (= :border)) b]
  (set-long! v "setBorderType:" (if b 2 0)))   ; NSBezelBorder 2, NSNoBorder 0

(defmethod set-native [(v ui/text-view-widget) (p (= :wrap)) w]
  (let [tv (text-view-of v)
        container (objc/send tv (objc/sel "textContainer"))]
    (objc/send-b-void (view v) (objc/sel "setHasHorizontalScroller:") (not w))
    (objc/send-b-void tv (objc/sel "setHorizontallyResizable:") (not w))
    (objc/send-b-void container (objc/sel "setWidthTracksTextView:") (boolean w))
    (when-not w
      (objc/send-z-void container (objc/sel "setContainerSize:")
                        {:width 1.0e7 :height 1.0e7}))))

(defmethod set-native [(v ui/text-view-widget) (p (= :placeholder)) s]
  (let [tv (text-view-of v)]
    (when (objc/responds? tv "setPlaceholderString:")
      (objc/send-p-void tv (objc/sel "setPlaceholderString:") (objc/ns-string s)))))

(defmethod native-natural-size [(v ui/text-view-widget)]
  [240 120])

(defmethod native-text-changed [(v ui/text-view-widget) tv]
  (ui/changed-by-user! v :text (objc/string-of (objc/send tv (objc/sel "string")))))

(defmethod ui/backend-text-append [(b cocoa-backend) v s]
  (let [tv (text-view-of v)
        storage (objc/send tv (objc/sel "textStorage"))
        end (objc/send-long storage (objc/sel "length"))]
    (objc/send-range-p-void storage (objc/sel "replaceCharactersInRange:withString:")
                            {:location end :length 0} (objc/ns-string s))
    (objc/send-p-void tv (objc/sel "scrollToEndOfDocument:") (ffi/null))))

(defmethod ui/backend-text-selection [(b cocoa-backend) v]
  (let [r (objc/send-range (text-view-of v) (objc/sel "selectedRange"))
        start (ffi/field r objc/ns-range :location)]
    [start (+ start (ffi/field r objc/ns-range :length))]))

(defmethod ui/backend-set-text-selection [(b cocoa-backend) v start end]
  (objc/send-range-void (text-view-of v) (objc/sel "setSelectedRange:")
                        {:location start :length (- end start)}))

(defmethod ui/backend-text-insert [(b cocoa-backend) v s]
  (let [tv (text-view-of v)
        [start end] (ui/backend-text-selection b v)]
    (objc/send-range-p-void (objc/send tv (objc/sel "textStorage"))
                            (objc/sel "replaceCharactersInRange:withString:")
                            {:location start :length (- end start)} (objc/ns-string s))
    (ui/backend-set-text-selection b v (+ start (count s)) (+ start (count s)))))

;;; ------------------------------------------------------------------------------------
;;; Notebooks

(defmethod make-native [(n ui/notebook-widget)]
  (let [tv (init-frame "NSTabView")]
    (objc/send-p-void tv (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
    tv))

(defn- tab-item
  "The NSTabViewItem of the notebook's page at index."
  [n index]
  (objc/send-l (view n) (objc/sel "tabViewItemAtIndex:") index))

(defmethod ui/backend-add-child [(b cocoa-backend) (n ui/notebook-widget) page]
  (let [item (objc/send-p (objc/alloc "NSTabViewItem") (objc/sel "initWithIdentifier:")
                          (ffi/null))
        wrapper (flipped-view)]
    (objc/send-p-void wrapper (objc/sel "addSubview:") (view page))
    (objc/send-p-void item (objc/sel "setView:") wrapper)
    (objc/send-p-void item (objc/sel "setLabel:") (objc/ns-string (or (:tab-label page) "")))
    (quietly (fn [] (objc/send-p-void (view n) (objc/sel "addTabViewItem:") item)))
    (objc/release wrapper)
    (objc/release item)))

(defmethod ui/backend-remove-child [(b cocoa-backend) (n ui/notebook-widget) page]
  (let [wrapper (objc/send (view page) (objc/sel "superview"))
        items (objc/send (view n) (objc/sel "tabViewItems"))
        n-items (objc/send-long items (objc/sel "count"))]
    (objc/send-void (view page) (objc/sel "removeFromSuperview"))
    (doseq [i (range n-items)]
      (let [item (objc/send-l items (objc/sel "objectAtIndex:") i)]
        (when (= (ffi/address (objc/send item (objc/sel "view"))) (ffi/address wrapper))
          (quietly (fn [] (objc/send-p-void (view n) (objc/sel "removeTabViewItem:") item))))))))

(defmethod ui/backend-set-page-label [(b cocoa-backend) n page label]
  (when-let [i (index-of (:children n) page)]
    (objc/send-p-void (tab-item n i) (objc/sel "setLabel:") (objc/ns-string (or label "")))))

(defmethod set-native [(n ui/notebook-widget) (p (= :selected-index)) i]
  (when (< -1 (or i -1) (count (:children n)))
    (quietly (fn [] (set-long! n "selectTabViewItemAtIndex:" i)))))

(defmethod set-native [(n ui/notebook-widget) (p (= :tab-position)) v]
  ;; NSTopTabsBezelBorder 0, NSLeftTabsBezelBorder 1, NSBottomTabsBezelBorder 2, right 3
  (set-long! n "setTabViewType:" (case v :left 1 :bottom 2 :right 3 0)))

(defn- tab-decoration [n]
  (let [tv (view n)
        [_ _ ow oh] (objc/rect-vec (objc/send-rect tv (objc/sel "frame")))
        _ (objc/send-z-void tv (objc/sel "setFrameSize:") {:width 300.0 :height 300.0})
        [_ _ cw ch] (objc/rect-vec (objc/send-rect tv (objc/sel "contentRect")))]
    (objc/send-z-void tv (objc/sel "setFrameSize:") {:width (f64 ow) :height (f64 oh)})
    [(int (math/ceil (- 300 cw))) (int (math/ceil (- 300 ch)))]))

(defmethod ui/backend-decoration-size [(b cocoa-backend) (n ui/notebook-widget)]
  (tab-decoration n))

(defmethod ui/backend-content-area [(b cocoa-backend) (n ui/notebook-widget) width height]
  (let [[dw dh] (tab-decoration n)]
    [0 0 (max 0 (- width dw)) (max 0 (- height dh))]))

(defmethod native-selection-changed [(n ui/notebook-widget) item]
  (when-not (quiet?)
    (let [i (objc/send-p-long (view n) (objc/sel "indexOfTabViewItem:") item)]
      (when (not= i (:selected-index n))
        (ui/page-changed-by-user! n i)))))

;;; ------------------------------------------------------------------------------------
;;; Split panes

(defmethod make-native [(p ui/paned-widget)]
  (let [n (init-frame "NSSplitView")]
    (objc/send-l-void n (objc/sel "setDividerStyle:") 2)   ; NSSplitViewDividerStyleThin
    (objc/send-p-void n (objc/sel "setDelegate:") (:text-delegate (ui/current-backend)))
    n))

(defmethod set-native [(p ui/paned-widget) (k (= :orientation)) v]
  (set-bool! p "setVertical:" (= v :horizontal)))

(defmethod ui/backend-decoration-size [(b cocoa-backend) (p ui/paned-widget)]
  (let [t (int (math/ceil (double-of (view p) "dividerThickness")))] [t t]))

(defmethod native-selection-changed [(p ui/paned-widget) split-view]
  (when-not (quiet?)
    (when-let [first-pane (first (ui/visible-children p))]
      (let [[_ _ w h] (objc/rect-vec (objc/send-rect (view first-pane) (objc/sel "frame")))
            position (int (math/round (if (= :horizontal (:orientation p)) w h)))]
        (when (not= position (:position p))
          (ui/divider-moved-by-user! p position))))))

(defmethod ui/backend-set-bounds [(b cocoa-backend) (w ui/widget) x y width height]
  ;; A split view's panes are placed by layout: its own resizing notices aren't the user's.
  (quietly (fn [] (call-next-method))))

;;; ------------------------------------------------------------------------------------
;;; Scrolled windows

(defn- clip-view [s] (objc/send (view s) (objc/sel "contentView")))

(defmethod make-native [(s ui/scrolled-window-widget)]
  (let [n (init-frame "NSScrollView")
        document (flipped-view)
        clip (objc/send n (objc/sel "contentView"))
        b (ui/current-backend)]
    (objc/send-p-void n (objc/sel "setDocumentView:") document)
    (objc/release document)
    (objc/send-b-void clip (objc/sel "setPostsBoundsChangedNotifications:") true)
    (objc/send-pppp-void (objc/send (objc/cls "NSNotificationCenter") (objc/sel "defaultCenter"))
                         (objc/sel "addObserver:selector:name:object:")
                         (:text-delegate b) (objc/sel "boundsDidChange:")
                         (objc/ns-string "NSViewBoundsDidChangeNotification") clip)
    (also-register! clip s)
    n))

(defmethod container-view [(s ui/scrolled-window-widget)]
  (objc/send (view s) (objc/sel "documentView")))

(defn- set-scrollers! [s]
  (let [n (view s)
        h (:horizontal-policy s)
        v (:vertical-policy s)]
    (objc/send-b-void n (objc/sel "setHasHorizontalScroller:") (not= h :never))
    (objc/send-b-void n (objc/sel "setHasVerticalScroller:") (not= v :never))
    (objc/send-b-void n (objc/sel "setAutohidesScrollers:")
                      (not (or (= h :always) (= v :always))))))

(defmethod set-native [(s ui/scrolled-window-widget) (p (= :horizontal-policy)) v]
  (set-scrollers! s))

(defmethod set-native [(s ui/scrolled-window-widget) (p (= :vertical-policy)) v]
  (set-scrollers! s))

(defmethod set-native [(s ui/scrolled-window-widget) (p (= :border)) v]
  (set-long! s "setBorderType:" (if v 2 0)))

(defmethod ui/backend-decoration-size [(b cocoa-backend) (s ui/scrolled-window-widget)]
  (if (:border s) [2 2] [0 0]))

(defmethod ui/backend-content-area [(b cocoa-backend) (s ui/scrolled-window-widget)
                                    width height]
  (let [[w h] (objc/size-vec (objc/send-size (view s) (objc/sel "contentSize")))]
    [0 0 (int (math/floor w)) (int (math/floor h))]))

(defmethod ui/backend-set-scroll-extent [(b cocoa-backend) s width height]
  (let [n (view s)
        before (objc/size-vec (objc/send-size n (objc/sel "contentSize")))]
    (quietly
     (fn [] (objc/send-z-void (objc/send n (objc/sel "documentView")) (objc/sel "setFrameSize:")
                              {:width (f64 width) :height (f64 height)})))
    (let [after (objc/size-vec (objc/send-size n (objc/sel "contentSize")))]
      (when (not= before after)
        (mapv (fn [x] (int (math/floor x))) after)))))

(defmethod ui/backend-scroll-to [(b cocoa-backend) s x y]
  (quietly
   (fn []
     (objc/send-point-void (clip-view s) (objc/sel "scrollToPoint:") {:x (f64 x) :y (f64 y)})
     (objc/send-p-void (view s) (objc/sel "reflectScrolledClipView:") (clip-view s)))))

(defmethod native-selection-changed [(s ui/scrolled-window-widget) clip]
  (when-not (quiet?)
    (let [[x y] (objc/rect-vec (objc/send-rect clip (objc/sel "bounds")))]
      (ui/scrolled-by-user! s (int (math/round x)) (int (math/round y))))))

;;; ------------------------------------------------------------------------------------
;;; List boxes, tables and trees: NSTableView and NSOutlineView in an NSScrollView

(defn- table-of
  "The NSTableView or NSOutlineView inside the widget's scroll view."
  [w]
  (objc/send (view w) (objc/sel "documentView")))

(defn- make-table [w class-name]
  (let [scroll (init-frame "NSScrollView")
        tv (init-frame class-name)
        b (ui/current-backend)]
    (objc/send-p-void tv (objc/sel "setDataSource:") (:data-source b))
    (objc/send-p-void tv (objc/sel "setDelegate:") (:data-source b))
    (objc/send-p-void tv (objc/sel "setTarget:") (:target b))
    (objc/send-p-void tv (objc/sel "setDoubleAction:") (objc/sel "doubleAction:"))
    (objc/send-l-void tv (objc/sel "setColumnAutoresizingStyle:") 1) ; uniform
    (objc/send-b-void scroll (objc/sel "setHasVerticalScroller:") true)
    (objc/send-p-void scroll (objc/sel "setDocumentView:") tv)
    (also-register! tv w)
    (objc/release tv)
    scroll))

(defn- add-column!
  "Add a column titled title (width pixels wide, if given) to the table view. Returns the
NSTableColumn."
  [tv title width alignment]
  (let [n (objc/send-long (objc/send tv (objc/sel "tableColumns")) (objc/sel "count"))
        col (objc/send-p (objc/alloc "NSTableColumn") (objc/sel "initWithIdentifier:")
                         (objc/ns-string (str n)))]
    (objc/send-p-void (objc/send col (objc/sel "headerCell")) (objc/sel "setStringValue:")
                      (objc/ns-string (or title "")))
    (when width (objc/send-d-void col (objc/sel "setWidth:") (f64 width)))
    (when alignment
      (objc/send-l-void (objc/send col (objc/sel "dataCell")) (objc/sel "setAlignment:")
                        (text-alignment alignment)))
    (objc/send-l-void col (objc/sel "setResizingMask:") 3)
    (objc/send-p-void tv (objc/sel "addTableColumn:") col)
    (objc/release col)
    col))

(defn- remove-columns! [tv]
  (let [cols (objc/send (objc/send tv (objc/sel "tableColumns")) (objc/sel "copy"))
        n (objc/send-long cols (objc/sel "count"))]
    (doseq [i (range n)]
      (objc/send-p-void tv (objc/sel "removeTableColumn:")
                        (objc/send-l cols (objc/sel "objectAtIndex:") i)))
    (objc/release cols)))

(defn- show-headers! [tv show]
  (if show
    (let [h (objc/new-object "NSTableHeaderView")]
      (objc/send-p-void tv (objc/sel "setHeaderView:") h)
      (objc/release h))
    (objc/send-p-void tv (objc/sel "setHeaderView:") (ffi/null))))

(defn- selected-rows
  "The table view's selected rows, in order."
  [tv]
  (let [set (objc/send tv (objc/sel "selectedRowIndexes"))
        not-found 9223372036854775807]
    (loop [i (objc/send-long set (objc/sel "firstIndex")) rows []]
      (if (or (= i not-found) (< i 0))
        rows
        (recur (objc/send-l-long set (objc/sel "indexGreaterThanIndex:") i) (conj rows i))))))

(defn- select-rows! [tv rows]
  (let [set (objc/new-object "NSMutableIndexSet")]
    (doseq [r rows] (objc/send-l-void set (objc/sel "addIndex:") r))
    (quietly (fn [] (objc/send-pb-void tv (objc/sel "selectRowIndexes:byExtendingSelection:")
                                       set false)))
    (objc/release set)))

(defn- reload! [tv]
  (quietly (fn [] (objc/send-void tv (objc/sel "reloadData")))))

(defn- activated-row
  "The row a double-click or Return activated: the clicked row, else the selected one."
  [tv]
  (let [clicked (objc/send-long tv (objc/sel "clickedRow"))]
    (if (>= clicked 0) clicked (objc/send-long tv (objc/sel "selectedRow")))))

;;; List boxes

(defmethod make-native [(l ui/list-box-widget)]
  (let [scroll (make-table l "NSTableView")
        tv (objc/send scroll (objc/sel "documentView"))]
    (add-column! tv "" nil nil)
    (show-headers! tv false)
    scroll))

(defmethod native-row-count [(l ui/list-box-widget)]
  (count (:items l)))

(defmethod native-cell-text [(l ui/list-box-widget) row column]
  (ui/item-text l row))

(defmethod set-native [(l ui/list-box-widget) (p (= :items)) v]
  (reload! (table-of l))
  (select-rows! (table-of l) (:selected-indices l)))

(defmethod set-native [(l ui/list-box-widget) (p (= :item-label)) v]
  (reload! (table-of l)))

(defmethod set-native [(l ui/list-box-widget) (p (= :selected-indices)) v]
  (select-rows! (table-of l) v))

(defmethod set-native [(l ui/list-box-widget) (p (= :selection-mode)) v]
  (objc/send-b-void (table-of l) (objc/sel "setAllowsMultipleSelection:") (= v :multiple)))

(defmethod set-native [(l ui/list-box-widget) (p (= :border)) v]
  (set-long! l "setBorderType:" (if v 2 0)))

(defmethod set-native [(l ui/list-box-widget) (p (= :alternating)) v]
  (objc/send-b-void (table-of l) (objc/sel "setUsesAlternatingRowBackgroundColors:") (boolean v)))

(defmethod native-natural-size [(l ui/list-box-widget)]
  [160 120])

(defmethod native-selection-changed [(l ui/list-box-widget) tv]
  (when-not (quiet?)
    (let [rows (selected-rows tv)]
      (when (not= rows (vec (:selected-indices l)))
        (ui/selection-changed-by-user! l rows)))))

(defmethod native-double-action [(l ui/list-box-widget) tv]
  (let [row (activated-row tv)]
    (when (>= row 0)
      (ui/row-activated-by-user! l row 2))))

;;; Tables

(defmethod native-cell-text [(t ui/table-view-widget) row column]
  (ui/table-cell-text t row column))

(defn- show-sort! [t]
  (let [tv (table-of t)
        cols (objc/send tv (objc/sel "tableColumns"))
        i (when-let [c (:sort-column t)] (index-of (:columns t) c))]
    (doseq [k (range (objc/send-long cols (objc/sel "count")))]
      (objc/send-pp-void tv (objc/sel "setIndicatorImage:inTableColumn:")
                         (if (= k i)
                           (objc/send-p (objc/cls "NSImage") (objc/sel "imageNamed:")
                                        (objc/ns-string (if (:sort-descending t)
                                                          "NSDescendingSortIndicator"
                                                          "NSAscendingSortIndicator")))
                           (ffi/null))
                         (objc/send-l cols (objc/sel "objectAtIndex:") k)))))

(defmethod set-native [(t ui/table-view-widget) (p (= :columns)) cols]
  (let [tv (table-of t)]
    (remove-columns! tv)
    (doseq [c cols] (add-column! tv (:title c) (:width c) (:alignment c)))
    (show-headers! tv (:headers t))
    (reload! tv)
    (show-sort! t)))

(defmethod set-native [(t ui/table-view-widget) (p (= :headers)) v]
  (show-headers! (table-of t) v))

(defmethod set-native [(t ui/table-view-widget) (p (= :sort-column)) v]
  (show-sort! t))

(defmethod set-native [(t ui/table-view-widget) (p (= :sort-descending)) v]
  (show-sort! t))

(defmethod native-natural-size [(t ui/table-view-widget)]
  [(max 160 (reduce + 0 (map (fn [c] (or (:width c) 100)) (:columns t)))) 120])

(defmethod native-column-clicked [(t ui/table-view-widget) col]
  (ui/column-clicked-by-user! t (column-index (table-of t) col)))

;;; Trees

(def ^:private item-ids
  "The ids of tree items: [outline view address, item key] -> id, and id -> the item. An
outline view knows each item by an NSNumber of its id (a tagged pointer, so the same
object every time)."
  (atom {:next 1 :ids {} :items {}}))

(defn- item-ptr
  "The NSNumber the tree's outline view knows item by."
  [t item]
  (let [k [(ffi/address (table-of t)) ((:item-key t) item)]
        id (or (get-in @item-ids [:ids k])
               (let [{n :next} (swap! item-ids
                                      (fn [m] (-> m (update :next inc)
                                                  (assoc-in [:ids k] (:next m)))))]
                 (dec n)))]
    (swap! item-ids assoc-in [:items id] item)
    (objc/send-l (objc/cls "NSNumber") (objc/sel "numberWithLong:") id)))

(defn- item-of
  "The tree item the outline view's pointer p stands for (nil for null: the roots)."
  [p]
  (when-not (ffi/null? p)
    (get-in @item-ids [:items (objc/send-long p (objc/sel "longValue"))])))

(defmethod make-native [(t ui/tree-view-widget)]
  (let [scroll (make-table t "NSOutlineView")
        ov (objc/send scroll (objc/sel "documentView"))
        col (add-column! ov "" nil nil)]
    (objc/send-p-void ov (objc/sel "setOutlineTableColumn:") col)
    (show-headers! ov false)
    scroll))

(defmethod native-outline [(t ui/tree-view-widget) op p arg]
  (let [item (item-of p)
        children (fn [] (ui/tree-children t item))]
    (case op
      :count (count (children))
      :child (item-ptr t (nth (children) arg))
      :expandable? (seq (ui/tree-children t item))
      :text (ui/tree-cell-text t item arg))))

(defn- show-expansion!
  "Open and close the outline view's items as the tree's :expanded says, from the roots
down through the open ones."
  [t]
  (let [ov (table-of t)
        walk (fn walk [items]
               (doseq [item items]
                 (if (ui/expanded? t item)
                   (do (quietly (fn [] (objc/send-p-void ov (objc/sel "expandItem:")
                                                         (item-ptr t item))))
                       (walk (ui/tree-children t item)))
                   (quietly (fn [] (objc/send-p-void ov (objc/sel "collapseItem:")
                                                     (item-ptr t item)))))))]
    (walk (ui/tree-children t nil))))

(defn- show-tree-selection! [t]
  (let [ov (table-of t)
        rows (keep (fn [item]
                     (let [r (objc/send-p-long ov (objc/sel "rowForItem:") (item-ptr t item))]
                       (when (>= r 0) r)))
                   (:selection t))]
    (select-rows! ov (sort rows))))

(defmethod set-native [(t ui/tree-view-widget) (p (= :roots)) v]
  (reload! (table-of t))
  (show-expansion! t)
  (show-tree-selection! t))

(defmethod set-native [(t ui/tree-view-widget) (p (= :expanded)) v]
  (show-expansion! t))

(defmethod set-native [(t ui/tree-view-widget) (p (= :selection)) v]
  (show-tree-selection! t))

(defmethod set-native [(t ui/tree-view-widget) (p (= :item-label)) v]
  (reload! (table-of t)))

(defmethod set-native [(t ui/tree-view-widget) (p (= :selection-mode)) v]
  (objc/send-b-void (table-of t) (objc/sel "setAllowsMultipleSelection:") (= v :multiple)))

(defmethod set-native [(t ui/tree-view-widget) (p (= :headers)) v]
  (show-headers! (table-of t) v))

(defmethod set-native [(t ui/tree-view-widget) (p (= :columns)) cols]
  (when (seq cols)
    (let [ov (table-of t)]
      (remove-columns! ov)
      (doseq [c cols] (add-column! ov (:title c) (:width c) (:alignment c)))
      (objc/send-p-void ov (objc/sel "setOutlineTableColumn:")
                        (objc/send-l (objc/send ov (objc/sel "tableColumns"))
                                     (objc/sel "objectAtIndex:") 0))
      (reload! ov)
      (show-expansion! t))))

(defmethod ui/backend-tree-refresh [(b cocoa-backend) t item]
  (let [ov (table-of t)]
    (if item
      (quietly (fn [] (objc/send-pb-void ov (objc/sel "reloadItem:reloadChildren:")
                                         (item-ptr t item) true)))
      (reload! ov))
    (show-expansion! t)))

(defmethod native-natural-size [(t ui/tree-view-widget)]
  [160 120])

(defmethod native-expanded [(t ui/tree-view-widget) p expanded]
  (when-not (quiet?)
    (when-let [item (item-of p)]
      (ui/expansion-changed-by-user! t item expanded))))

(defmethod native-selection-changed [(t ui/tree-view-widget) ov]
  (when-not (quiet?)
    (let [items (mapv (fn [r] (item-of (objc/send-l ov (objc/sel "itemAtRow:") r)))
                      (selected-rows ov))]
      (when (not= items (vec (:selection t)))
        (ui/tree-selection-changed-by-user! t items)))))

(defmethod native-double-action [(t ui/tree-view-widget) ov]
  (let [row (activated-row ov)]
    (when (>= row 0)
      (ui/tree-item-activated-by-user! t (item-of (objc/send-l ov (objc/sel "itemAtRow:") row))))))

;;; ------------------------------------------------------------------------------------
;;; For tests: the real controls, read and acted on

(defn native-frame
  "The AppKit frame of the widget's view, [x y width height] in its container's
coordinates (from the top left)."
  [w]
  (mapv (fn [x] (int (math/round x)))
        (objc/rect-vec (objc/send-rect (view w) (objc/sel "frame")))))

(defn native-string
  "The text the widget's control shows: a button's or a window's title, or a field's
string value."
  [w]
  (let [n (view w)]
    (objc/call-with-pool
     (fn []
       (objc/string-of (objc/send n (objc/sel (if (objc/responds? n "title")
                                                "title"
                                                "stringValue"))))))))

(defn native-bool
  "The BOOL the widget's AppKit object answers to the selector named name, such as
\"isHidden\"."
  [w name]
  (objc/send-bool (view w) (objc/sel name)))

(defn click!
  "Click the button, as AppKit does for a mouse click (performClick:)."
  [b]
  (objc/send-p-void (view b) (objc/sel "performClick:") (ffi/null)))

(defn type-text!
  "Make the field's text s and tell its delegate the text changed, as typing does."
  [e s]
  (objc/call-with-pool
   (fn []
     (objc/send-p-void (view e) (objc/sel "setStringValue:") (objc/ns-string s))
     (objc/send-pp-void (objc/send (objc/cls "NSNotificationCenter") (objc/sel "defaultCenter"))
                        (objc/sel "postNotificationName:object:")
                        (objc/ns-string "NSControlTextDidChangeNotification") (view e)))))

(defn press-return!
  "Send the field's action, as pressing Return in it does."
  [e]
  (let [n (view e)]
    (objc/send-pp-void n (objc/sel "sendAction:to:")
                       (objc/send n (objc/sel "action")) (objc/send n (objc/sel "target")))))

(defn native-double
  "The double the widget's AppKit control answers to the selector named name."
  [w name]
  (objc/send-double (view w) (objc/sel name)))

(defn set-native-double!
  "Set a slider's double value and send its action, as dragging it does."
  [w v]
  (let [n (view w)]
    (objc/send-d-void n (objc/sel "setDoubleValue:") (f64 v))
    (objc/send-pp-void n (objc/sel "sendAction:to:")
                       (objc/send n (objc/sel "action")) (objc/send n (objc/sel "target")))))

(defn native-spin-text
  "The text in a spin button's field."
  [w]
  (objc/call-with-pool
   (fn [] (objc/string-of (objc/send (first (spin-parts w)) (objc/sel "stringValue"))))))

(defn native-title-of-selected
  "The title of a combo box's chosen item."
  [c]
  (objc/call-with-pool
   (fn [] (objc/string-of (objc/send (view c) (objc/sel "titleOfSelectedItem"))))))

(defn choose-item!
  "Choose the item at index in a combo box, as the user does."
  [c index]
  (let [n (view c)]
    (objc/send-l-void n (objc/sel "selectItemAtIndex:") index)
    (objc/send-pp-void n (objc/sel "sendAction:to:")
                       (objc/send n (objc/sel "action")) (objc/send n (objc/sel "target")))))

(defn native-color
  "The color a color button shows."
  [c]
  (objc/call-with-pool (fn [] (color-of (objc/send (view c) (objc/sel "color"))))))

(defn native-date
  "The date a date picker shows, in milliseconds since 1970."
  [d]
  (objc/call-with-pool
   (fn [] (int (math/round (* 1000 (double-of (objc/send (view d) (objc/sel "dateValue"))
                                              "timeIntervalSince1970")))))))

(defn has-image?
  "True if the image view or button shows an image."
  [w]
  (not (ffi/null? (objc/send (view w) (objc/sel "image")))))

(defn tab-labels
  "The labels of a notebook's tabs."
  [n]
  (objc/call-with-pool
   (fn [] (mapv (fn [i] (objc/string-of (objc/send (tab-item n i) (objc/sel "label"))))
                (range (objc/send-long (view n) (objc/sel "numberOfTabViewItems")))))))

(defn choose-tab!
  "Click the notebook's tab at index, as the user does."
  [n index]
  (objc/send-l-void (view n) (objc/sel "selectTabViewItemAtIndex:") index))

(defn scroll-origin
  "The point of a scrolled window's content at its top left, [x y]."
  [s]
  (let [[x y] (objc/rect-vec (objc/send-rect (clip-view s) (objc/sel "bounds")))]
    [(int (math/round x)) (int (math/round y))]))

(defn native-text
  "The text in a text view's NSTextView."
  [v]
  (objc/call-with-pool (fn [] (objc/string-of (objc/send (text-view-of v) (objc/sel "string"))))))

(defn row-count
  "How many rows a list box's, table's or tree's view shows."
  [w]
  (objc/send-long (table-of w) (objc/sel "numberOfRows")))

(defn cell-string
  "The text in a list box's, table's or tree's view at row and column, as AppKit draws it."
  [w row column]
  (objc/call-with-pool
   (fn [] (objc/string-of (objc/send (objc/send-ll (table-of w)
                                                   (objc/sel "preparedCellAtColumn:row:")
                                                   column row)
                                     (objc/sel "stringValue"))))))

(defn select-rows-natively!
  "Select rows in a list box's, table's or tree's view, as the user does."
  [w rows]
  (let [set (objc/new-object "NSMutableIndexSet")]
    (doseq [r rows] (objc/send-l-void set (objc/sel "addIndex:") r))
    (objc/send-pb-void (table-of w) (objc/sel "selectRowIndexes:byExtendingSelection:") set false)
    (objc/release set)))

(defn double-click-selected!
  "Send a list box's, table's or tree's double action for its selected row."
  [w]
  (let [tv (table-of w)]
    (objc/send-pp-void tv (objc/sel "sendAction:to:")
                       (objc/send tv (objc/sel "doubleAction")) (objc/send tv (objc/sel "target")))))

(defn click-column-title!
  "Tell a table's delegate its column at index was clicked, as AppKit does."
  [t index]
  (let [tv (table-of t)]
    (objc/send-pp-void (objc/send tv (objc/sel "delegate")) (objc/sel "tableView:didClickTableColumn:")
                       tv (objc/send-l (objc/send tv (objc/sel "tableColumns"))
                                       (objc/sel "objectAtIndex:") index))))

(defn expand-natively!
  "Open the tree's item in its outline view, as clicking its disclosure triangle does."
  [t item]
  (objc/send-p-void (table-of t) (objc/sel "expandItem:") (item-ptr t item)))
