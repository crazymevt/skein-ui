(ns skein.ui
  "Native desktop user interfaces from Skein objects and events (Skein's M2.14, D-090,
D-097), after the design of LGT, Jessie's Common Lisp toolkit.

  (ui/use-backend! (headless/backend))
  (def w (ui/window {:title \"Hello\"}
           (ui/vbox {:spacing 8}
             (ui/label {:text \"Name\"})
             (ui/button {:label \"Save\" :on-clicked (fn [e] (save!))}))))
  (ui/show! w)

A widget is an instance of a class backed by the platform's own control. Constructors
take an option map and then children; the classes have a -widget suffix (button-widget),
for defclass and defmethod. Properties are cell slots: (:text label) reads one, and
(set-slot! label :text \"Hi\") or (update-slot! slider :value + 5) changes it, and the
native control follows (property-changed). Events are objects emitted under a signal
(:clicked) on a widget: connect handlers with on, or :on-clicked in a constructor's
options, or specialize handle-event. A handler is a function; written (fn [e] (save! e))
it calls save! through its var, so redefining save! takes effect while the program runs.

Layout is done here, the same on every platform: boxes and grids divide their space
among their children by the children's natural sizes and their :hexpand, :vexpand,
:expand, :halign, :valign and :margin options. Backends only move and size the native
controls.

The backend protocol is a set of generic functions on a backend object (backend-realize,
backend-set-property, ...), which skein.ui.headless, skein.ui.cocoa, skein.ui.win32 and
skein.ui.gtk implement. The core calls them through backend-in-ui-thread."
  (:require [skein.math :as math]
            [skein.string :as string]
            [skein.system :as system]
            [skein.time :as time]))

;;; ------------------------------------------------------------------------------------
;;; Backends

(defclass backend []
  "The superclass of UI backends: a backend implements the backend- generic functions."
  (layout-queue :cell :atom :init [] :doc "The windows waiting to be laid out again."))

(def ^:private current (atom nil))

(defn use-backend!
  "Make b the backend widgets are made with. Returns b."
  [b]
  (when-not (instance? backend b)
    (error "use-backend! needs a UI backend, not" (pr-str b)))
  (reset! current b)
  b)

(defn current-backend
  "The backend in use."
  []
  (or @current (error "no UI backend: call (ui/use-backend! ...) first")))

(defgeneric backend-in-ui-thread [backend f]
  "Call f, a function of no arguments, on the backend's UI thread and return its value.")

(defgeneric backend-call-later [backend f]
  "Call f, a function of no arguments, on the UI thread soon, after the event being
handled. Returns at once.")

(defgeneric backend-realize [backend object]
  "Make and return the native counterpart of object: a widget or a window. Its properties
are set afterwards with backend-set-property.")

(defgeneric backend-destroy [backend object]
  "Destroy object's native counterpart. Its children have been destroyed already.")

(defgeneric backend-set-property [backend object property value]
  "Show value, the new value of object's property (a keyword such as :text), in its native
counterpart.")

(defgeneric backend-get-property [backend object property]
  "The value of object's property as its native counterpart has it, for properties the core
reads back.")

(defgeneric backend-add-child [backend parent child]
  "Put child's native counterpart inside parent's, at the end.")

(defgeneric backend-remove-child [backend parent child]
  "Take child's native counterpart out of parent's without destroying it.")

(defgeneric backend-show [backend window]
  "Show the window on the screen.")

(defgeneric backend-close [backend window]
  "Close the window: take it off the screen.")

(defgeneric backend-natural-size [backend widget]
  "The natural [width height] of widget's native control, in pixels, for its contents.")

(defgeneric backend-set-bounds [backend widget x y width height]
  "Move and size widget's native control to x, y, width, height in pixels, relative to the
top left of its container's.")

(defgeneric backend-decoration-size [backend widget]
  "The [width height] that a container's native control, such as a frame's border and
title, adds around its content.")

(defmethod backend-decoration-size [(b backend) widget]
  [0 0])

(defgeneric backend-content-area [backend widget width height]
  "For a container of width by height, the [x y width height] its content goes in.")

(defmethod backend-content-area [(b backend) widget width height]
  [0 0 width height])

(defgeneric backend-image-size [backend path]
  "The [width height] in pixels of the image in the file at path.")

(defgeneric backend-focus [backend widget]
  "Give the widget's native control the keyboard focus.")

(defmethod backend-focus [(b backend) widget]
  nil)

(defgeneric backend-focused-widget [backend]
  "The widget whose native control has the keyboard focus in the active window, or nil.")

(defmethod backend-focused-widget [(b backend)]
  nil)

(defgeneric backend-center-window [backend window]
  "Put the window in the middle of the screen.")

(defmethod backend-center-window [(b backend) window]
  nil)

(defgeneric backend-run-modal [backend window]
  "Run the event loop until backend-end-modal is called for the window, keeping the other
windows from the user. Returns the value backend-end-modal was given.")

(defgeneric backend-end-modal [backend window value]
  "Make backend-run-modal return value for the window.")

(defgeneric backend-set-application-icon [backend image]
  "Show image (or the default for nil) as the application's icon, such as its Dock icon.")

(defmethod backend-set-application-icon [(b backend) image]
  nil)

(defgeneric backend-install-menu-bar [backend menu-bar]
  "Use menu-bar (or nil) as the application's menu bar while no window with one of its
own is active.")

(defmethod backend-install-menu-bar [(b backend) menu-bar]
  nil)

(defgeneric backend-dialog-button-order [backend]
  "Where the platform puts a dialog's affirmative buttons (OK, Save): :affirmative-last
(macOS, GNOME) or :affirmative-first (Windows).")

(defmethod backend-dialog-button-order [(b backend)]
  :affirmative-last)

(defgeneric backend-run-loop [backend]
  "Run the native event loop until backend-quit-loop.")

(defgeneric backend-quit-loop [backend]
  "Make backend-run-loop return.")

(defn- in-ui
  "f's value, called on the UI thread of the backend in use."
  [f]
  (backend-in-ui-thread (current-backend) f))

;;; ------------------------------------------------------------------------------------
;;; Events

(defclass event []
  "The superclass of events: what happened (signal, such as :clicked) to source, and
when (:time, milliseconds since 1970)."
  (source :init nil)
  (signal :init nil)
  (time :init (time/epoch-millis)))

(defclass action-event [event]
  "Something was activated: a button clicked, a menu item chosen, Return in an entry.")

(defclass value-event [event]
  "A value changed: text edited, a slider moved, a check box toggled. :value is the new
value."
  (value :init nil))

(defclass selection-event [event]
  "An item was chosen: :index is its index (nil for none) and :value the item."
  (index :init nil)
  (value :init nil))

(defclass resize-event [event]
  "A widget got a new size: :width by :height pixels."
  (width :init 0)
  (height :init 0))

(defclass item-event [event]
  "Something happened to one item of a list, table or tree: a row activated (double
clicked, or Return), a tree item opened or closed. :item is the item, :index its row (nil
in a tree), :click-count the clicks (0 from the keyboard)."
  (item :init nil)
  (index :init nil)
  (click-count :init 0))

(defclass column-event [event]
  "A table's column title was clicked: :column is the column, :index its index."
  (column :init nil)
  (index :init nil))

(defclass draw-event [event]
  "A canvas needs drawing: draw with :context, a graphics context of :width by :height,
during the handler."
  (context :init nil)
  (width :init 0)
  (height :init 0))

(defclass timer-event [event]
  "A timer's interval passed. :source is the timer.")

(defclass input-event [event]
  "The superclass of mouse and key events. :modifiers is the set of modifier keys held,
of :shift, :control, :alt and :command. A handler that deals with one itself calls
consume!, and the native control skips what it would have done."
  (modifiers :init #{})
  (consumed :cell :atom :init false))

(defn consume!
  "Mark the input event as dealt with, so the native control doesn't act on it: the key
isn't typed, the click doesn't select. Returns the event."
  [e]
  (set-slot! e :consumed true)
  e)

(defn consumed?
  "True if a handler consumed the input event."
  [e]
  (boolean (:consumed e)))

(defn primary-modifier
  "The modifier of shortcuts on this platform: :command on macOS, :control elsewhere."
  []
  (if (= :macos (system/os)) :command :control))

(defn modifier-down?
  "True if modifier was held during the input event: :shift, :control, :alt, :command, or
:primary (primary-modifier)."
  [e modifier]
  (contains? (set (:modifiers e)) (if (= modifier :primary) (primary-modifier) modifier)))

(defclass mouse-event [input-event]
  "The pointer moved, or a button went down or up, over a widget: :x and :y in the
widget from its top left, :button (:left, :right, :middle or nil) and :click-count."
  (x :init 0)
  (y :init 0)
  (button :init nil)
  (click-count :init 0))

(defclass scroll-event [mouse-event]
  "The wheel turned or the trackpad scrolled: :delta-x and :delta-y, in pixels when
:precise (a trackpad), else in lines."
  (delta-x :init 0)
  (delta-y :init 0)
  (precise :init false))

(defclass key-event [input-event]
  "A key went down or up in the focused widget: :key is a character for a printing key
(lower case) or a keyword such as :return, :escape, :tab, :backspace, :delete, :left,
:right, :up, :down, :home, :end, :page-up, :page-down, :space or :f1 to :f12; :text is
what it types; :repeat is true when it auto-repeats."
  (key :init nil)
  (text :init "")
  (repeat :init false))

(defclass text-input-event [input-event]
  "Text is about to be typed into a widget (:text): one character, or several from an
input method. A handler that calls consume! keeps it from being inserted."
  (text :init ""))

(defclass vetoable-event [event]
  "An event a handler can refuse with veto, such as a window being asked to close."
  (vetoed :cell :atom :init false))

(defclass close-event [vetoable-event]
  "A window is asked to close. veto keeps it open.")

(defgeneric veto [event]
  "Refuse the vetoable event: the window stays open. Returns the event.")

(defmethod veto [(e vetoable-event)]
  (set-slot! e :vetoed true)
  e)

(defn vetoed?
  "True if a handler vetoed the event."
  [e]
  (boolean (and (instance? vetoable-event e) (:vetoed e))))

;;; ------------------------------------------------------------------------------------
;;; Objects, properties and signals

(defclass emitter []
  "Anything that emits events to handlers: widgets, windows, menus, timers and the
application."
  (handlers :cell :atom :init {})
  (blocked :cell :atom :init {}
           :doc "signal (or :all) -> how many with-handlers-blocked block it."))

(defclass ui-object [emitter]
  "Anything with a native counterpart: widgets, windows and menus."
  (native :cell :atom :init nil)
  (name :init nil)
  (parent :cell :atom :init nil)
  (children :cell :atom :init [])
  (destroyed :cell :atom :init false)
  (user-data :cell :atom :init nil :doc "Anything a program wants to keep with the object.")
  (size-cache :cell :atom :init nil :doc "The preferred size, until invalidate-size!.")
  (allocation :cell :atom :init nil
              :doc "[x y width height], where layout put it in its container."))

(def ^:private declared
  "class -> {:properties [keyword ...] :layout [keyword ...] :signals {signal event-class}},
what each widget class declares itself."
  (atom {}))

(defn declare-widget!
  "Declare which of class's cell slots are properties (keywords) shown by the native
control, which change its size or place (:layout, which may overlap the properties), and
its signals, a map of signal to event class. Constructors take :on-<signal> options for
them."
  [class {:keys [properties layout signals]}]
  (swap! declared assoc class {:properties (vec properties) :layout (vec layout)
                               :signals (or signals {})})
  class)

(defn- declared-for [object k]
  (mapcat (fn [c] (get-in @declared [c k])) (reverse (class-precedence-list (class-of object)))))

(defn properties
  "The properties of object: the keywords of the cell slots its native control shows."
  [object]
  (vec (distinct (declared-for object :properties))))

(defn signals
  "object's signals, a map of signal to event class."
  [object]
  (into {} (declared-for object :signals)))

(def ^:dynamic *syncing*
  "True while a backend stores a value the user changed in a native control, which isn't
sent back to it."
  false)

(defn sync-property!
  "Store value, which the user changed in object's native control, as its property
without sending it back (backends call this before they emit the change)."
  [object property value]
  (binding [*syncing* true]
    (set-slot! object property value)))

(defn realized?
  "True if object has its native counterpart."
  [object]
  (and (some? (:native object)) (not (:destroyed object))))

;;; Laying out again

(defgeneric layout-root? [object]
  "True for objects laid out on their own, such as windows, rather than by a container.")

(defmethod layout-root? [object]
  false)

(defgeneric update-layout! [root]
  "Lay out root, such as a window, and everything in it, in its current size.")

(defn- layout-root
  "The window object is in, object included, or nil."
  [object]
  (let [top (loop [o object] (if-let [p (:parent o)] (recur p) o))]
    (when (layout-root? top) top)))

(defn flush-layouts!
  "Lay out every window that asked for it. The event loop does this soon after a change;
call it to see a change's layout at once."
  []
  (let [q (cell (current-backend) :layout-queue)]
    (loop []
      (let [[old _] (swap-vals! q (fn [ws] (vec (rest ws))))]
        (when-let [w (first old)]
          (when (realized? w) (update-layout! w))
          (recur))))))

(defn- schedule-layout!
  "Lay window out again soon, once however many changes ask for it."
  [window]
  (when (realized? window)
    (let [b (current-backend)
          [old _] (swap-vals! (cell b :layout-queue)
                              (fn [ws] (if (some (fn [w] (identical? w window)) ws)
                                         ws
                                         (conj ws window))))]
      (when (empty? old)
        (backend-call-later b flush-layouts!)))))

(defn invalidate-size!
  "Forget object's measured size and its containers', and lay its window out again soon.
Custom widgets call this when something changes their natural size."
  [object]
  (loop [o object]
    (when o
      (set-slot! o :size-cache nil)
      (recur (:parent o))))
  (when-let [root (layout-root object)]
    (schedule-layout! root))
  nil)

;;; Property changes

(defgeneric property-changed [object property value]
  "Called when object's property changed to value (not by the native control itself):
the default shows it in the native control, and lays the window out again for a layout
property. Specialize it to react to property changes.")

(def ^:private appearance-property-changed!)

(defmethod property-changed :after [(o ui-object) property value]
  (when (contains? #{:appearance :palette} property)
    (appearance-property-changed! o property)))

(defmethod property-changed [(o ui-object) property value]
  (when (realized? o)
    (when (some #{property} (properties o))
      (let [b (current-backend)]
        (in-ui (fn [] (backend-set-property b o property value)))))
    (when (some #{property} (declared-for o :layout))
      (invalidate-size! o))))

(defn realize!
  "Make object's native counterpart, give it object's properties, and watch them. make
does this, so programs rarely call it."
  [object]
  (when-not (:native object)
    (let [b (current-backend)
          props (properties object)]
      (in-ui (fn []
               (set-slot! object :native (backend-realize b object))
               (doseq [p props] (backend-set-property b object p (slot object p)))))
      (doseq [p (distinct (concat props (declared-for object :layout)))]
        (add-watch (cell object p) ::property
                   (fn [_ _ old new]
                     (when (and (not *syncing*) (not= old new))
                       (property-changed object p new)))))))
  object)

(defmethod initialize :after [(o ui-object)]
  (realize! o))

(defgeneric destroy! [object]
  "Destroy object's native counterpart, and its children's. The object stays, but can't
be shown again.")

(defmethod destroy! [(o ui-object)]
  (when-not (:destroyed o)
    (doseq [c (:children o)] (destroy! c))
    (when (:native o)
      (let [b (current-backend)]
        (in-ui (fn [] (backend-destroy b o)))))
    (set-slot! o :destroyed true))
  nil)

;;; Handlers

(def ^:private handler-ids (atom 0))

(defn on
  "Call (f event) when object emits signal; handlers run in the order they were
connected. Returns an id that off takes."
  [object signal f]
  (when-not (contains? (signals object) signal)
    (error (str (pr-str (class-name (class-of object))) " has no signal " (pr-str signal))))
  (let [id (swap! handler-ids inc)]
    (update-slot! object :handlers update signal (fnil conj []) [id f])
    id))

(defn off
  "Disconnect the handler with id from object's signal, or every handler of signal."
  ([object signal]
   (update-slot! object :handlers dissoc signal)
   nil)
  ([object signal id]
   (update-slot! object :handlers update signal
                 (fn [hs] (vec (remove (fn [[i _]] (= i id)) hs))))
   nil))

(defgeneric handle-event [object event]
  "Called for each event object emits: the default runs the handlers connected to the
event's signal. Specialize it to react to events in a subclass.")

(defmethod handle-event [(o emitter) e]
  (let [blocked (:blocked o)]
    (when-not (or (pos? (get blocked :all 0)) (pos? (get blocked (:signal e) 0)))
      (doseq [[_ f] (get (:handlers o) (:signal e))]
        (f e)))))

(defn call-with-handlers-blocked
  "Call f with object's handlers for the signals (all of them, if signals is empty) not
called. with-handlers-blocked is usually clearer."
  [object signals f]
  (let [ks (if (seq signals) signals [:all])
        change! (fn [d] (update-slot! object :blocked
                                      (fn [m] (reduce (fn [m k] (update m k (fnil + 0) d)) m ks))))]
    (change! 1)
    (try (f) (finally (change! -1)))))

(defmacro with-handlers-blocked
  "Run body with object's handlers for the signals (all its signals if none are given)
not called: (with-handlers-blocked [entry :changed] (set-slot! entry :text \"\"))."
  [[object & signals] & body]
  `(call-with-handlers-blocked ~object [~@signals] (fn [] ~@body)))

(defn emit!
  "Emit event (made with its :source and :signal) on object: handle-event gets it.
Returns the event, so a caller can ask whether it was vetoed."
  [object event]
  (handle-event object event)
  event)

(defn event-for
  "A new event of the class object declares for signal, with the slots in kvs."
  [object signal & kvs]
  (let [class (or (get (signals object) signal)
                  (error (str (pr-str (class-name (class-of object))) " has no signal "
                              (pr-str signal))))]
    (apply make class :source object :signal signal kvs)))

(defn changed-by-user!
  "Backends call this when the user changed object's property to value in its native
control (text typed, a slider moved): it stores the value without sending it back, then
emits :changed with it. Returns the event."
  [object property value]
  (sync-property! object property value)
  (emit! object (event-for object :changed :value value)))

;;; Children

(defgeneric add! [parent child]
  "Put child in the container parent, after its other children. Returns child. Containers
specialize it (:before) to check or place the child.")

(defmethod add! [(parent ui-object) child]
  (when (some? (:parent child))
    (error "the widget is in a container already; remove! it first"))
  (update-slot! parent :children conj child)
  (set-slot! child :parent parent)
  (let [b (current-backend)]
    (in-ui (fn [] (backend-add-child b parent child))))
  (invalidate-size! parent)
  child)

(defgeneric removed-from! [parent child index]
  "Called after child, which was at index, was taken out of parent: containers specialize
it to choose another page. The default does nothing.")

(defmethod removed-from! [parent child index]
  nil)

(defn remove!
  "Take child out of its container parent. Returns child."
  [parent child]
  (let [index (index-of (:children parent) child)]
    (update-slot! parent :children (fn [cs] (vec (remove (fn [c] (identical? c child)) cs))))
    (set-slot! child :parent nil)
    (let [b (current-backend)]
      (in-ui (fn [] (backend-remove-child b parent child))))
    (invalidate-size! parent)
    (when index (removed-from! parent child index))
    child))

(defn content
  "The one widget in a window or frame, or nil."
  [container]
  (first (:children container)))

(defn set-content!
  "Make w (or nil) the content of a window or frame, destroying the content it had.
Returns w."
  [container w]
  (doseq [c (:children container)]
    (when-not (identical? c w)
      (remove! container c)
      (destroy! c)))
  (when (and w (not (identical? (:parent w) container)))
    (add! container w))
  w)

(defn- check-one-child [container]
  (when (seq (:children container))
    (error (str (pr-str (class-name (class-of container)))
                " holds one widget, and has one already: put a box in it to hold more"))))

(defn widgets-in
  "root and every widget inside it, depth first."
  [root]
  (tree-seq (fn [o] (seq (:children o))) :children root))

(defn find-widget
  "The widget named name (its :name option) in root or inside it, or nil."
  [root name]
  (first (filter (fn [w] (= name (:name w))) (widgets-in root))))

(defn widgets-of-type
  "Every widget in root, root included, that is an instance of class."
  [root class]
  (filterv (fn [w] (instance? class w)) (widgets-in root)))

(defn map-widgets
  "Call (f w) on root and every widget inside it, parents before children."
  [f root]
  (doseq [w (widgets-in root)] (f w))
  root)

(defn clear!
  "Destroy all of container's children. Returns it."
  [container]
  (doseq [c (:children container)]
    (remove! container c)
    (destroy! c))
  container)

(defn focus!
  "Give the widget the keyboard focus. Returns it."
  [w]
  (let [b (current-backend)]
    (in-ui (fn [] (backend-focus b w))))
  w)

(defn focused-widget
  "The widget that has the keyboard focus in the active window, or nil."
  []
  (let [b (current-backend)]
    (in-ui (fn [] (backend-focused-widget b)))))

;;; Building widgets

(defn- signal-option
  "For an option key :on-clicked, the signal :clicked; else nil."
  [k]
  (let [n (name k)]
    (when (and (> (count n) 3) (= "on-" (subs n 0 3)))
      (keyword (subs n 3)))))

(defn build
  "Make a widget of class with the options in opts (its slots, and :on-<signal>
handlers) and add the children to it. Constructors call this."
  [class opts children]
  (let [handlers (keep (fn [[k f]] (when-let [s (signal-option k)] [s f])) opts)
        initargs (remove (fn [[k _]] (signal-option k)) opts)
        w (apply make class (mapcat identity initargs))]
    (doseq [[s f] handlers] (on w s f))
    (doseq [c children] (add! w c))
    w))

;;; ------------------------------------------------------------------------------------
;;; Widgets

(def input-signals
  "The keyboard and mouse signals of text views, entries, lists, tables, trees and
canvases. Handlers and handle-event methods see each event before the native control
does, and can consume! it to replace what the control would do: :key-down and :key-up
(key events), :text-input (text about to be typed), :mouse-down and :mouse-up (mouse
events), and :context-request (a right-click, before the :context-menu shows; consume!
it to show none)."
  {:key-down key-event :key-up key-event :text-input text-input-event
   :mouse-down mouse-event :mouse-up mouse-event :context-request mouse-event})

(defclass widget [ui-object]
  "The superclass of widgets: what windows and containers hold. Its layout options:
:hexpand and :vexpand (true, false or :auto, when a child expands) say whether it takes
extra width or height; :expand true makes it take extra space along a box; :halign and
:valign (:fill, :start, :center or :end) place it across the space it gets; :margin is
the space around it (a number, [vertical horizontal] or [top right bottom left]); :width
and :height are the least size it asks for; :column, :row, :column-span and :row-span
place it in a grid; :tab-label names its page in a notebook."
  (visible :cell :atom :init true :doc "Whether the widget is shown.")
  (enabled :cell :atom :init true :doc "Whether the widget responds to the user.")
  (tooltip :cell :atom :init nil :doc "Text shown when the pointer rests on it, or nil.")
  (hexpand :cell :atom :init :auto)
  (vexpand :cell :atom :init :auto)
  (expand :cell :atom :init false)
  (halign :cell :atom :init :fill)
  (valign :cell :atom :init :fill)
  (margin :cell :atom :init 0)
  (width :cell :atom :init nil)
  (height :cell :atom :init nil)
  (column :cell :atom :init nil)
  (row :cell :atom :init nil)
  (column-span :cell :atom :init 1)
  (row-span :cell :atom :init 1)
  (tab-label :cell :atom :init nil
             :doc "In a notebook or stack, its page's name; in a tabbed pane, a string or a widget.")
  (tab-tooltip :cell :atom :init nil :doc "In a tabbed pane, its tab's tooltip, or nil.")
  (tab-icon :cell :atom :init nil :doc "In a tabbed pane, an image beside its tab's label, or nil.")
  (tab-closable :cell :atom :init true :doc "In a tabbed pane, whether its tab has a close button.")
  (tab-accessory :cell :atom :init nil :doc "In a tabbed pane, a widget beside its tab's label.")
  (font :cell :atom :init nil :doc "Its font (a font designator), or nil for the platform's.")
  (context-menu :cell :atom :init nil :doc "A menu shown when the user right-clicks it, or nil.")
  (appearance :cell :atom :init :inherit
              :doc ":inherit (its container's), :light or :dark (windows also :system).")
  (control-size :cell :atom :init :regular :doc ":regular, :small, :mini or :large.")
  (palette :cell :atom :init nil
           :doc "Color overrides for it and what it holds: a map of palette roles to colors.")
  (last-appearance :cell :atom :init nil))

(declare-widget! widget {:properties [:visible :enabled :tooltip :font :context-menu
                                      :appearance :control-size :palette]
                         :signals {:appearance-changed value-event}
                         :layout [:visible :hexpand :vexpand :expand :halign :valign :margin
                                  :width :height :column :row :column-span :row-span
                                  :tab-label :tab-tooltip :tab-icon :tab-closable
                                  :tab-accessory :font :control-size]})

;;; ------------------------------------------------------------------------------------
;;; Layout
;;
;; Each widget has a natural size: leaves ask the backend, containers add up their
;; children's. A window gives its content its whole area; each container then divides
;; what it gets among its children (arrange), top down.

(defn sides
  "A margin or padding m as [top right bottom left]: m is a number for all four sides,
[vertical horizontal], or [top right bottom left]."
  [m]
  (cond (nil? m) [0 0 0 0]
        (number? m) [m m m m]
        (and (vector? m) (= 2 (count m))) (let [[v h] m] [v h v h])
        (and (vector? m) (= 4 (count m))) m
        :else (error "a margin is a number, [vertical horizontal] or [top right bottom left],"
                     "not" (pr-str m))))

(defn- px
  "x as a whole number of pixels."
  [x]
  (int (math/round x)))

(defgeneric measure [widget]
  "widget's natural [width height], without its margin: the default asks the backend,
and containers measure their children. Specialize it to give a custom widget a natural
size; preferred-size caches it until invalidate-size!.")

(defmethod measure [(w widget)]
  (let [b (current-backend)]
    (in-ui (fn [] (backend-natural-size b w)))))

(defn preferred-size
  "widget's natural size, at least its :width and :height, as [width height], without its
margin. A hidden widget's is [0 0]."
  [w]
  (cond (not (:visible w)) [0 0]
        (:size-cache w) (:size-cache w)
        :else (let [[mw mh] (measure w)
                    size [(max (int (math/ceil mw)) (or (:width w) 0))
                          (max (int (math/ceil mh)) (or (:height w) 0))]]
                (set-slot! w :size-cache size)
                size)))

(defn outer-size
  "widget's preferred size with its margin, as [width height]."
  [w]
  (if (:visible w)
    (let [[pw ph] (preferred-size w)
          [top right bottom left] (sides (:margin w))]
      [(+ pw left right) (+ ph top bottom)])
    [0 0]))

(defgeneric main-axis [container]
  "The orientation along which container hands out extra space to children with :expand
(:horizontal or :vertical), or nil if it doesn't.")

(defmethod main-axis [container]
  nil)

(defn expands?
  "Whether widget wants extra space along orientation (:horizontal or :vertical). An
explicit :hexpand or :vexpand wins; :auto means true when it has :expand in a container
of that orientation, or a child of it expands."
  [w orientation]
  (let [flag (if (= orientation :horizontal) (:hexpand w) (:vexpand w))]
    (cond (not (:visible w)) false
          (= flag :auto) (boolean (or (and (:expand w)
                                           (= orientation (main-axis (:parent w))))
                                      (some (fn [c] (expands? c orientation)) (:children w))))
          :else (boolean flag))))

(defgeneric arrange [widget width height]
  "Place widget's children in its area of width by height, by calling allocate (or
allocate-in-cell) on each. Containers define methods; leaves have nothing to place.")

(defmethod arrange [(w widget) width height]
  nil)

(defn allocate
  "Give widget the area x, y, width, height in its container's coordinates, then let it
arrange its children."
  [w x y width height]
  (let [a [(px x) (px y) (max 0 (px width)) (max 0 (px height))]
        [ax ay aw ah] a]
    (let [old (:allocation w)]
      (when (not= a old)
        (set-slot! w :allocation a)
        (let [b (current-backend)]
          (in-ui (fn [] (backend-set-bounds b w ax ay aw ah)))))
      (arrange w aw ah)
      (when (and (contains? (signals w) :resize)
                 (not= [aw ah] (when old [(nth old 2) (nth old 3)])))
        (emit! w (event-for w :resize :width aw :height ah))))))

(defn- align-in
  "[start size] of something of natural size pref aligned by align in avail pixels from
start."
  [align start avail pref]
  (let [size (if (= align :fill) avail (min pref avail))]
    [(case align
       :fill start
       :start start
       :center (+ start (quot (- avail size) 2))
       :end (+ start (- avail size))
       (error "an alignment is :fill, :start, :center or :end, not" (pr-str align)))
     size]))

(defn allocate-in-cell
  "Place widget in the cell x, y, width, height, after taking off its margin, by its
:halign and :valign."
  [w x y width height]
  (when (:visible w)
    (let [[top right bottom left] (sides (:margin w))
          [pw ph] (preferred-size w)
          [ax aw] (align-in (:halign w) (+ x left) (max 0 (- width left right)) pw)
          [ay ah] (align-in (:valign w) (+ y top) (max 0 (- height top bottom)) ph)]
      (allocate w ax ay aw ah))))

(defn distribute
  "Split total pixels among items of the natural sizes given: when there is more, the
items that expanding (booleans, one per item) marks share the extra equally; when less,
all shrink in proportion. With homogeneous every item gets the same size. Returns a
vector of sizes."
  ([total sizes expanding] (distribute total sizes expanding false))
  ([total sizes expanding homogeneous]
   (let [n (count sizes)
         natural (reduce + 0 sizes)
         k (count (filter identity expanding))]
     (cond
       (zero? n) []
       homogeneous (let [each (quot total n) more (rem total n)]
                     (mapv (fn [i] (+ each (if (< i more) 1 0))) (range n)))
       (and (>= total natural) (zero? k)) (vec sizes)
       (>= total natural)
       (let [extra (- total natural) each (quot extra k) more (rem extra k)
             ;; for each item, how many expanding items come before it
             ranks (reductions + 0 (map (fn [e] (if e 1 0)) expanding))]
         (mapv (fn [s e r] (if e (+ s each (if (< r more) 1 0)) s)) sizes expanding ranks))
       (pos? natural)
       (let [out (mapv (fn [s] (quot (* s total) natural)) sizes)]
         (update out (dec n) + (- total (reduce + 0 out))))
       :else (vec sizes)))))

;;; ------------------------------------------------------------------------------------
;;; Containers

(defn visible-children
  "container's children that are shown."
  [container]
  (filterv :visible (:children container)))

;;; Box

;;; Containers have a surface and a background

(def surface-roles
  "The semantic surfaces a container can be: :automatic keeps its native or inherited one."
  #{:automatic :window :sidebar :content :status :toolbar :activity :popover})

(defclass container-widget [widget]
  "The superclass of widgets that hold others. :surface is a semantic surface role (one of
surface-roles), drawn with the platform's material or theme color; :background, when set,
fills it with a color instead."
  (surface :cell :atom :init :automatic)
  (background :cell :atom :init nil))

(declare-widget! container-widget {:properties [:surface :background]})

(defclass box-widget [container-widget]
  "Lays its children out in a column or a row. Children with :vexpand (in a column) or
:hexpand (in a row), or with :expand, share the extra space."
  (orientation :cell :atom :init :vertical :doc ":vertical or :horizontal.")
  (spacing :cell :atom :init 6 :doc "Pixels between children.")
  (padding :cell :atom :init 0 :doc "Space around the children, as for a margin.")
  (homogeneous :cell :atom :init false :doc "Whether every child gets the same size."))

(declare-widget! box-widget {:layout [:orientation :spacing :padding :homogeneous]})

(defn box
  "A box: (box {:orientation :horizontal :spacing 8} child ...)."
  [opts & children]
  (build box-widget opts children))

(defn vbox
  "A column of children: (vbox {:spacing 8} child ...)."
  [opts & children]
  (build box-widget (assoc opts :orientation :vertical) children))

(defn hbox
  "A row of children: (hbox {:spacing 8} child ...)."
  [opts & children]
  (build box-widget (assoc opts :orientation :horizontal) children))

(defmethod main-axis [(b box-widget)]
  (:orientation b))

(defmethod measure [(b box-widget)]
  (let [kids (visible-children b)
        horizontal (= :horizontal (:orientation b))
        sizes (map outer-size kids)
        mains (map (fn [[w h]] (if horizontal w h)) sizes)
        cross (reduce max 0 (map (fn [[w h]] (if horizontal h w)) sizes))
        main (+ (if (:homogeneous b)
                  (* (count kids) (reduce max 0 mains))
                  (reduce + 0 mains))
                (* (:spacing b) (max 0 (dec (count kids)))))
        [top right bottom left] (sides (:padding b))]
    (if horizontal
      [(+ main left right) (+ cross top bottom)]
      [(+ cross left right) (+ main top bottom)])))

(defmethod arrange [(b box-widget) width height]
  (let [[top right bottom left] (sides (:padding b))
        kids (visible-children b)
        horizontal (= :horizontal (:orientation b))
        gap (:spacing b)
        inner-main (- (if horizontal (- width left right) (- height top bottom))
                      (* gap (max 0 (dec (count kids)))))
        inner-cross (if horizontal (- height top bottom) (- width left right))
        sizes (mapv (fn [c] (let [[w h] (outer-size c)] (if horizontal w h))) kids)
        expanding (mapv (fn [c] (expands? c (:orientation b))) kids)
        alloc (distribute (max 0 inner-main) sizes expanding (:homogeneous b))]
    (reduce (fn [pos [c size]]
              (if horizontal
                (allocate-in-cell c pos top size inner-cross)
                (allocate-in-cell c left pos inner-cross size))
              (+ pos size gap))
            (if horizontal left top)
            (map vector kids alloc))
    nil))

;;; Grid

(defclass grid-widget [container-widget]
  "Lays its children out in rows and columns. Give each child :column and :row (and
optionally :column-span and :row-span), or set the grid's :columns and add children in
reading order. A column expands when a child in it has :hexpand; a row, when one has
:vexpand."
  (column-spacing :cell :atom :init 8 :doc "Pixels between columns.")
  (row-spacing :cell :atom :init 6 :doc "Pixels between rows.")
  (padding :cell :atom :init 0 :doc "Space around the cells, as for a margin.")
  (columns :cell :atom :init nil
           :doc "When set, children added without :column and :row fill this many
columns, row by row.")
  (column-homogeneous :cell :atom :init false)
  (row-homogeneous :cell :atom :init false)
  (next-cell :cell :atom :init 0))

(declare-widget! grid-widget {:layout [:column-spacing :row-spacing :padding
                                       :column-homogeneous :row-homogeneous]})

(defn grid
  "A grid: (grid {:columns 2} (label {:text \"Name\"}) (entry {}) ...)."
  [opts & children]
  (build grid-widget opts children))

(defmethod add! :before [(g grid-widget) child]
  (when (and (nil? (:column child)) (nil? (:row child)))
    (if-let [n (:columns g)]
      (let [span (:column-span child)
            cell (:next-cell g)
            cell (if (> (+ (mod cell n) span) n) (* n (quot (+ cell n -1) n)) cell)]
        (set-slot! child :column (mod cell n))
        (set-slot! child :row (quot cell n))
        (set-slot! g :next-cell (+ cell span)))
      (do (set-slot! child :column 0)
          (set-slot! child :row (inc (reduce max -1 (map (fn [c] (or (:row c) 0))
                                                         (:children g)))))))))

(defn attach!
  "Add child to grid at column and row, counting from 0, spanning column-span columns and
row-span rows (1 by default). Returns child."
  ([grid child column row] (attach! grid child column row 1 1))
  ([grid child column row column-span row-span]
   (set-slot! child :column column)
   (set-slot! child :row row)
   (set-slot! child :column-span column-span)
   (set-slot! child :row-span row-span)
   (add! grid child)))

(defn- grid-tracks
  "For axis :column or :row: [sizes expanding], the natural size of each column or row,
and whether it expands."
  [g axis]
  (let [cols? (= axis :column)
        pos (fn [c] (or (if cols? (:column c) (:row c)) 0))
        span (fn [c] (if cols? (:column-span c) (:row-span c)))
        tracks (fn [c] (range (pos c) (+ (pos c) (span c))))
        size-of (fn [c] (let [[w h] (outer-size c)] (if cols? w h)))
        gap (if cols? (:column-spacing g) (:row-spacing g))
        kids (visible-children g)
        n (reduce max 0 (map (fn [c] (+ (pos c) (span c))) kids))
        expanding (reduce (fn [ex c]
                            (if (expands? c (if cols? :horizontal :vertical))
                              (reduce (fn [ex k] (assoc ex k true)) ex (tracks c))
                              ex))
                          (vec (repeat n false)) kids)
        ;; Children in one track size it; then spanning ones widen their tracks if needed.
        singles (reduce (fn [s c] (if (= 1 (span c)) (update s (pos c) max (size-of c)) s))
                        (vec (repeat n 0)) kids)
        sizes (reduce (fn [s c]
                        (let [have (+ (* gap (dec (span c)))
                                      (reduce + 0 (map (fn [k] (nth s k)) (tracks c))))
                              need (- (size-of c) have)]
                          (if (and (> (span c) 1) (pos? need))
                            (reduce (fn [s [k share]] (update s k + share))
                                    s
                                    (map vector (tracks c)
                                         (distribute need (repeat (span c) 0) nil true)))
                            s)))
                      singles kids)]
    [sizes expanding]))

(defn- tracks-total [sizes gap homogeneous]
  (+ (if homogeneous (* (count sizes) (reduce max 0 sizes)) (reduce + 0 sizes))
     (* gap (max 0 (dec (count sizes))))))

(defmethod measure [(g grid-widget)]
  (let [[top right bottom left] (sides (:padding g))]
    [(+ left right (tracks-total (first (grid-tracks g :column)) (:column-spacing g)
                                 (:column-homogeneous g)))
     (+ top bottom (tracks-total (first (grid-tracks g :row)) (:row-spacing g)
                                 (:row-homogeneous g)))]))

(defmethod arrange [(g grid-widget) width height]
  (let [[cols col-expand] (grid-tracks g :column)
        [rows row-expand] (grid-tracks g :row)
        [top right bottom left] (sides (:padding g))
        cg (:column-spacing g)
        rg (:row-spacing g)
        cw (distribute (max 0 (- width left right (* cg (max 0 (dec (count cols))))))
                       cols col-expand (:column-homogeneous g))
        rh (distribute (max 0 (- height top bottom (* rg (max 0 (dec (count rows))))))
                       rows row-expand (:row-homogeneous g))
        start (fn [sizes gap i origin] (+ origin (reduce + 0 (map (fn [s] (+ s gap))
                                                                 (take i sizes)))))
        extent (fn [sizes gap i span] (+ (* gap (dec span))
                                         (reduce + 0 (take span (drop i sizes)))))]
    (doseq [c (visible-children g)]
      (let [col (or (:column c) 0) row (or (:row c) 0)]
        (allocate-in-cell c (start cw cg col left) (start rh rg row top)
                          (extent cw cg col (:column-span c))
                          (extent rh rg row (:row-span c)))))))

;;; Frame

(defclass bin-widget [container-widget]
  "A container of at most one widget, its content.")

(defmethod add! :before [(b bin-widget) child]
  (check-one-child b))

(defmethod measure [(b bin-widget)]
  (let [[dw dh] (backend-decoration-size (current-backend) b)
        [cw ch] (if-let [c (content b)] (outer-size c) [0 0])]
    [(+ cw dw) (+ ch dh)]))

(defmethod arrange [(b bin-widget) width height]
  (when-let [c (content b)]
    (let [[x y w h] (backend-content-area (current-backend) b width height)]
      (allocate-in-cell c x y w h))))

(defclass frame-widget [bin-widget]
  "A border with an optional title around one widget."
  (title :cell :atom :init nil :doc "The frame's title, or nil for none."))

(declare-widget! frame-widget {:properties [:title] :layout [:title]})

(defn frame
  "A frame: (frame {:title \"Options\"} content)."
  [opts & children]
  (build frame-widget opts children))

;;; Separator and spacer

(defclass separator-widget [widget]
  "A thin line between groups of widgets."
  (orientation :cell :atom :init :horizontal
               :doc ":horizontal for a line across, :vertical for one down.")
  (hexpand :cell :atom :init false)
  (vexpand :cell :atom :init false))

(declare-widget! separator-widget {:properties [:orientation] :layout [:orientation]})

(defn separator
  "A separator: (separator {:orientation :vertical})."
  ([] (separator {}))
  ([opts] (build separator-widget opts nil)))

(defclass spacer-widget [widget]
  "Empty space that takes the room left over in a box, pushing the widgets after it to
the end."
  (expand :cell :atom :init true))

(defn spacer
  "A spacer: (hbox {} (label {:text \"Total\"}) (spacer) (label {:text \"42\"}))."
  ([] (spacer {}))
  ([opts] (build spacer-widget opts nil)))

(defmethod measure [(s spacer-widget)]
  [0 0])

;;; ------------------------------------------------------------------------------------
;;; The application

(defclass application [emitter]
  "The running program; there is one, application. It emits :quit-request (a
vetoable-event) when asked to quit, :started when run! starts the event loop, and
:reopen when, on macOS, the user clicks its Dock icon with no window open."
  (name :cell :atom :init "Skein" :doc "Its name, in its menus and About box.")
  (version :cell :atom :init nil)
  (icon :cell :atom :init nil :doc "The image shown as its icon, or nil for the default.")
  (menu-bar :cell :atom :init nil :doc "The menu bar while no window with its own is active.")
  (quit-on-last-window-closed :cell :atom :init true
                              :doc "Whether run! returns when the last window closes.")
  (running :cell :atom :init false))

(declare-widget! application {:signals {:quit-request vetoable-event :started event
                                        :reopen event}})

(def app
  "The application object. Connect to its signals with on; change its :name, :version,
:icon and :menu-bar with set-slot! (set-application-icon! and set-application-menu-bar!
show them)."
  (make application))

(defn set-application-icon!
  "Show image as the application's icon (its Dock icon on macOS); nil for the default."
  [image]
  (let [b (current-backend)]
    (in-ui (fn [] (backend-set-application-icon b image))))
  (set-slot! app :icon image))

(defn set-application-menu-bar!
  "Use menu-bar while no window with a menu bar of its own is active (on macOS, the menu
bar at the top of the screen)."
  [menu-bar]
  (let [b (current-backend)]
    (in-ui (fn [] (backend-install-menu-bar b menu-bar))))
  (set-slot! app :menu-bar menu-bar))

(defn run!
  "Run the event loop until quit!, or, unless :keep-alive, until the last window closes.
opts: :name (the application's), :quit-on-last-window-closed (true), :keep-alive (false;
true keeps running with no window open, as a REPL session wants). Call it on the main
thread."
  ([] (run! {}))
  ([opts]
   (when (contains? opts :name) (set-slot! app :name (:name opts)))
   (set-slot! app :quit-on-last-window-closed
              (and (get opts :quit-on-last-window-closed true) (not (:keep-alive opts))))
   (set-slot! app :running true)
   (try
     (let [b (current-backend)]
       (backend-call-later b (fn [] (emit! app (event-for app :started))))
       (backend-run-loop b))
     (finally (set-slot! app :running false)))
   nil))

(defn quit!
  "Ask the application to quit: it emits :quit-request and, unless a handler vetoes, run!
returns. Windows stay open. True if it quits."
  []
  (when-not (vetoed? (emit! app (event-for app :quit-request)))
    (backend-quit-loop (current-backend))
    true))

;;; ------------------------------------------------------------------------------------
;;; Windows

(defclass window-widget [ui-object]
  "A top-level window, holding one widget. It emits :close-request (a close-event, which
veto refuses) when asked to close, and :closed once it closed; :shown when shown,
:resize (a resize-event) when its content area gets a new size, :activated and
:deactivated as it gets and loses the keyboard, and :moved (a value-event with [x y])."
  (title :cell :atom :init "")
  (width :cell :atom :init nil :doc "The width of its content area; nil to fit the content.")
  (height :cell :atom :init nil :doc "The height of its content area; nil to fit the content.")
  (min-size :cell :atom :init [0 0] :doc "The least content size: the content's natural size.")
  (position :cell :atom :init nil
            :doc "Its top left corner on the screen, [x y], or nil to center it when first shown.")
  (resizable :cell :atom :init true :doc "Whether the user can resize it.")
  (closable :cell :atom :init true :doc "Whether it has a close button.")
  (shown :cell :atom :init false)
  (menu-bar :cell :atom :init nil :doc "The window's menu bar, or nil.")
  (shortcuts :cell :atom :init [] :doc "The window's own shortcuts (add-shortcut!).")
  (appearance :cell :atom :init :system :doc ":system (the system's), :light or :dark.")
  (palette :cell :atom :init nil :doc "Color overrides for everything in it, as a widget's.")
  (surface :cell :atom :init :window)
  (background :cell :atom :init nil)
  (last-appearance :cell :atom :init nil))

(declare-widget! window-widget {:properties [:title :width :height :menu-bar :min-size
                                             :position :resizable :closable :appearance
                                             :palette :surface :background]
                                :layout [:width :height]
                                :signals {:close-request close-event :closed event
                                          :shown event :resize resize-event
                                          :activated event :deactivated event
                                          :moved value-event :key-down key-event
                                          :appearance-changed value-event}})

(def ^:private open-windows
  "The windows made and not yet closed, oldest first."
  (atom []))

(defmethod initialize :after [(w window-widget)]
  (swap! open-windows conj w))

(defn windows
  "The windows that are shown, oldest first."
  []
  (filterv :shown @open-windows))

(defn window
  "A window: (window {:title \"Hello\" :menu-bar (menu-bar {} ...)} content)."
  [opts & children]
  (build window-widget opts children))

(defmethod add! :before [(w window-widget) child]
  (check-one-child w))

(defmethod layout-root? [(w window-widget)]
  true)

(defmethod update-layout! [(w window-widget)]
  ;; The window grows when its content no longer fits.
  (let [[cw ch] (if-let [c (content w)] (outer-size c) [0 0])]
    (when (not= [cw ch] (:min-size w)) (set-slot! w :min-size [cw ch]))
    (when (and (:width w) (< (:width w) cw)) (set-slot! w :width cw))
    (when (and (:height w) (< (:height w) ch)) (set-slot! w :height ch))
    (when-let [c (content w)]
      (allocate-in-cell c 0 0 (or (:width w) cw) (or (:height w) ch)))))

(defn center!
  "Put the window in the middle of the screen. Returns it."
  [w]
  (let [b (current-backend)]
    (in-ui (fn [] (backend-center-window b w))))
  w)

(defn show!
  "Show the window and make it the active one. The first time, it gets its content's
natural size unless it has :width and :height, and is centered unless it has a
:position. Returns it."
  [w]
  (let [first-time (nil? (:width w))
        [cw ch] (if-let [c (content w)] (outer-size c) [0 0])]
    (when (nil? (:width w)) (set-slot! w :width cw))
    (when (nil? (:height w)) (set-slot! w :height ch))
    (update-layout! w)
    (let [b (current-backend)]
      (when (and first-time (nil? (:position w)))
        (in-ui (fn [] (backend-center-window b w))))
      (in-ui (fn [] (backend-show b w))))
    (set-slot! w :shown true)
    (emit! w (event-for w :shown))
    w))

(defn hide!
  "Take the window off the screen without closing it; show! brings it back."
  [w]
  (let [b (current-backend)]
    (in-ui (fn [] (backend-close b w))))
  (set-slot! w :shown false)
  w)

(def ^:private modal-windows (atom []))

(defn modal?
  "True while the window runs modally (run-modal)."
  [w]
  (boolean (some (fn [m] (identical? m w)) @modal-windows)))

(defn end-modal!
  "Make run-modal of the window return value."
  ([w] (end-modal! w nil))
  ([w value]
   (when (modal? w)
     (let [b (current-backend)]
       (in-ui (fn [] (backend-end-modal b w value)))))
   nil))

(defn- window-closed! [w]
  (when (modal? w) (end-modal! w nil))
  (swap! open-windows (fn [ws] (filterv (fn [x] (not (identical? x w))) ws)))
  (emit! w (event-for w :closed))
  (destroy! w)
  (when (and (:running app) (:quit-on-last-window-closed app) (empty? (windows)))
    (backend-quit-loop (current-backend))))

(defn close!
  "Ask the window to close, as its close button does: it emits :close-request, and
unless a handler vetoes (or with force), it closes, emits :closed and is destroyed. True
if it closed."
  ([w] (close! w false))
  ([w force]
   (if (and (not force) (vetoed? (emit! w (event-for w :close-request))))
     false
     (let [b (current-backend)]
       (in-ui (fn [] (backend-close b w)))
       (set-slot! w :shown false)
       (window-closed! w)
       true))))

(defn run-modal
  "Show the window and run the event loop until end-modal! is called for it, keeping the
other windows from the user. Returns the value given to end-modal!."
  [w]
  (show! w)
  (swap! modal-windows conj w)
  (try
    (let [b (current-backend)]
      (in-ui (fn [] (backend-run-modal b w))))
    (finally
      (swap! modal-windows (fn [ms] (filterv (fn [m] (not (identical? m w))) ms))))))

(defn resized-by-user!
  "Backends call this when the user resized the window's content area to width by
height: it lays the window out at once and emits :resize."
  [w width height]
  (when (not= [width height] [(:width w) (:height w)])
    (sync-property! w :width width)
    (sync-property! w :height height)
    (update-layout! w)
    (emit! w (event-for w :resize :width width :height height))))

(defn activated-by-user!
  "Backends call this when the window became (active true) or stopped being the active
window."
  [w active]
  (emit! w (event-for w (if active :activated :deactivated))))

(defn moved-by-user!
  "Backends call this when the user moved the window's top left corner to x, y."
  [w x y]
  (sync-property! w :position [x y])
  (emit! w (event-for w :moved :value [x y])))

;;; ------------------------------------------------------------------------------------
;;; Images

(defclass image []
  "A picture that image views and buttons show: from a file (image-from-file) or from
RGBA pixels (image-from-pixels)."
  (path :init nil)
  (pixels :init nil :doc "A byte array of width × height RGBA pixels, row by row.")
  (width :init 0)
  (height :init 0))

(defn image-from-file
  "The image in the file at path (PNG, and the formats the platform reads)."
  [path]
  (let [b (current-backend)
        [w h] (in-ui (fn [] (backend-image-size b path)))]
    (make image :path path :width w :height h)))

(defn image-from-pixels
  "An image of width by height pixels from pixels, RGBA bytes row by row."
  [width height pixels]
  (when-not (= (count pixels) (* 4 width height))
    (error "an image of" width "by" height "needs" (* 4 width height) "bytes, not"
           (count pixels)))
  (make image :pixels pixels :width width :height height))

;;; ------------------------------------------------------------------------------------
;;; Text

(defclass label-widget [widget]
  "Text that the user can't edit."
  (text :cell :atom :init "")
  (alignment :cell :atom :init :left :doc "How lines line up: :left, :center or :right.")
  (wrap :cell :atom :init false :doc "Whether long text wraps (set :width to say where).")
  (selectable :cell :atom :init false :doc "Whether the user can select and copy the text.")
  (text-color :cell :atom :init nil :doc "The text's color (a color designator), or nil.")
  (background :cell :atom :init nil :doc "A background color, or nil for none."))

(declare-widget! label-widget {:properties [:text :alignment :wrap :selectable :text-color
                                            :background]
                               :layout [:text :wrap]})

(defn label
  "A label: (label {:text \"Name\"})."
  ([] (label {}))
  ([opts] (build label-widget opts nil)))

(defclass entry-widget [widget]
  "A one-line text field. It emits :changed (a value-event) as the user edits, and
:activate on Return."
  (text :cell :atom :init "")
  (placeholder :cell :atom :init nil :doc "Text shown, greyed, while it's empty.")
  (editable :cell :atom :init true :doc "Whether the user can change the text.")
  (alignment :cell :atom :init :left :doc ":left, :center or :right.")
  (width-chars :cell :atom :init 20 :doc "About how many characters wide it is naturally."))

(declare-widget! entry-widget {:properties [:text :placeholder :editable :alignment :width-chars]
                               :layout [:width-chars]
                               :signals (merge input-signals
                                               {:changed value-event :activate action-event})})

(defn entry
  "An entry: (entry {:placeholder \"Your name\" :on-changed f})."
  ([] (entry {}))
  ([opts] (build entry-widget opts nil)))

(defclass password-entry-widget [entry-widget]
  "An entry that hides what is typed.")

(defn password-entry
  "A password entry: (password-entry {:on-activate f})."
  ([] (password-entry {}))
  ([opts] (build password-entry-widget opts nil)))

(defclass search-entry-widget [entry-widget]
  "An entry styled for searching, with a clear button.")

(defn search-entry
  "A search entry: (search-entry {:placeholder \"Search\" :on-changed f})."
  ([] (search-entry {}))
  ([opts] (build search-entry-widget opts nil)))

;;; Buttons

(defclass button-widget [widget]
  "A push button. It emits :clicked."
  (label :cell :atom :init "")
  (image :cell :atom :init nil :doc "An image shown on the button, or nil.")
  (default :cell :atom :init false :doc "Whether Return presses it.")
  (cancel :cell :atom :init false :doc "Whether Escape presses it.")
  (style :cell :atom :init :push
         :doc ":push, :flat or :borderless, or :icon to show only the image."))

(declare-widget! button-widget {:properties [:label :image :default :cancel :style]
                                :layout [:label :image :style]
                                :signals {:clicked action-event}})

(defn button
  "A button: (button {:label \"Save\" :on-clicked f})."
  ([] (button {}))
  ([opts] (build button-widget opts nil)))

(defclass toggle-button-widget [widget]
  "A button that stays pressed in until clicked again. It emits :toggled (a value-event
with the new state) when the user turns it on or off."
  (label :cell :atom :init "")
  (image :cell :atom :init nil :doc "An image shown on the button, or nil.")
  (style :cell :atom :init :push :doc "As for a button.")
  (checked :cell :atom :init false :doc "Whether it is on."))

(declare-widget! toggle-button-widget {:properties [:label :image :style :checked]
                                       :layout [:label :image :style]
                                       :signals {:toggled value-event}})

(defn toggle-button
  "A toggle button: (toggle-button {:label \"Bold\" :on-toggled f})."
  ([] (toggle-button {}))
  ([opts] (build toggle-button-widget opts nil)))

(defclass check-box-widget [toggle-button-widget]
  "A box with a check mark that the user turns on and off, and a label.")

(defn check-box
  "A check box: (check-box {:label \"Wrap lines\" :checked true :on-toggled f})."
  ([] (check-box {}))
  ([opts] (build check-box-widget opts nil)))

(defclass radio-button-widget [toggle-button-widget]
  "One of a set of choices, of which one is on at a time. The radio buttons of one
choice share a :group (any value); those without one form a group with the others in
their container."
  (group :init nil))

(defn radio-button
  "A radio button: (radio-button {:label \"Small\" :group :size})."
  ([] (radio-button {}))
  ([opts] (build radio-button-widget opts nil)))

(defn- root-of [w]
  (loop [w w] (if-let [p (:parent w)] (recur p) w)))

(defn radio-group
  "The radio buttons in button's group, button included, in order."
  [button]
  (if-let [g (:group button)]
    (filterv (fn [w] (and (instance? radio-button-widget w) (= g (:group w))))
             (widgets-in (root-of button)))
    (if-let [p (:parent button)]
      (filterv (fn [w] (and (instance? radio-button-widget w) (nil? (:group w))))
               (:children p))
      [button])))

(defn radio-selection
  "The radio button that is on in button's group, or nil."
  [button]
  (first (filter :checked (radio-group button))))

(defn- others-off!
  "Turn off the radio buttons in button's group other than button; returns those that
were on."
  [button]
  (let [on (filterv (fn [o] (and (not (identical? o button)) (:checked o)))
                    (radio-group button))]
    (doseq [o on] (set-slot! o :checked false))
    on))

(defmethod property-changed :after [(b radio-button-widget) property value]
  (when (and (= property :checked) value)
    (others-off! b)))

(defn toggled-by-user!
  "Backends call this when the user turned button on or off: it stores the state, turns
the rest of a radio button's group off (each emitting :toggled), and emits :toggled.
Returns the event."
  [button value]
  (sync-property! button :checked value)
  (when (and value (instance? radio-button-widget button))
    (doseq [o (others-off! button)]
      (emit! o (event-for o :toggled :value false))))
  (emit! button (event-for button :toggled :value value)))

;;; Numbers in a range

(defclass range-widget [widget]
  "The superclass of widgets showing a number between :min and :max."
  (min :cell :atom :init 0 :doc "The smallest value.")
  (max :cell :atom :init 100 :doc "The largest value.")
  (value :cell :atom :init 0 :doc "The current value."))

(declare-widget! range-widget {:properties [:min :max :value]})

(defclass slider-widget [range-widget]
  "A knob the user drags along a track to choose a number. It emits :changed (a
value-event) as the user moves it."
  (orientation :cell :atom :init :horizontal :doc ":horizontal or :vertical.")
  (ticks :cell :atom :init 0 :doc "How many tick marks to draw; 0 for none.")
  (snap :cell :atom :init false :doc "Whether the value stops only at ticks."))

(declare-widget! slider-widget {:properties [:orientation :ticks :snap]
                                :layout [:orientation :ticks]
                                :signals {:changed value-event}})

(defn slider
  "A slider: (slider {:min 0 :max 10 :value 5 :on-changed f})."
  ([] (slider {}))
  ([opts] (build slider-widget opts nil)))

(defclass spin-button-widget [range-widget]
  "A number field with up and down arrows. It emits :changed (a value-event)."
  (step :cell :atom :init 1 :doc "How much the arrows change the value.")
  (digits :cell :atom :init 0 :doc "How many digits to show after the decimal point."))

(declare-widget! spin-button-widget {:properties [:step :digits] :layout [:digits]
                                     :signals {:changed value-event}})

(defn spin-button
  "A spin button: (spin-button {:min 1 :max 99 :value 1 :on-changed f})."
  ([] (spin-button {}))
  ([opts] (build spin-button-widget opts nil)))

(defclass progress-bar-widget [range-widget]
  "Shows how much of a task is done; :value runs from 0 to 1 unless :max says otherwise."
  (max :cell :atom :init 1)
  (indeterminate :cell :atom :init false
                 :doc "Whether it shows activity without saying how much is done."))

(declare-widget! progress-bar-widget {:properties [:indeterminate]})

(defn progress-bar
  "A progress bar: (progress-bar {:value 0.25})."
  ([] (progress-bar {}))
  ([opts] (build progress-bar-widget opts nil)))

(defclass spinner-widget [widget]
  "A small spinning wheel that says the program is busy."
  (active :cell :atom :init true :doc "Whether it spins."))

(declare-widget! spinner-widget {:properties [:active]})

(defn spinner
  "A spinner: (spinner {:active true})."
  ([] (spinner {}))
  ([opts] (build spinner-widget opts nil)))

;;; Choosing from items

(defclass item-widget [widget]
  "The superclass of widgets showing a vector of items, of any kind: :item-label is a
function from an item to the text shown for it (str by default)."
  (items :cell :atom :init [])
  (item-label :cell :atom :init str))

(declare-widget! item-widget {:properties [:items :item-label] :layout [:items :item-label]})

(defn item-text
  "The text w shows for its item at index i, or \"\"."
  [w i]
  (let [items (vec (:items w))]
    (if (and (integer? i) (< -1 i (count items)))
      (str ((:item-label w) (nth items i)))
      "")))

(defn add-item!
  "Add item at the end of w's items. Returns item."
  [w item]
  (update-slot! w :items (fn [items] (conj (vec items) item)))
  item)

(defn remove-item!
  "Remove item (the ones = to it) from w's items. Returns item."
  [w item]
  (update-slot! w :items (fn [items] (vec (remove (fn [x] (= x item)) items))))
  item)

(defclass combo-box-widget [item-widget]
  "A button that pops up a list of items to choose one from. It emits :changed (a
selection-event) when the user chooses one."
  (selected-index :cell :atom :init nil :doc "The index of the chosen item, or nil."))

(declare-widget! combo-box-widget {:properties [:selected-index]
                                   :signals {:changed selection-event}})

(defn combo-box
  "A combo box: (combo-box {:items [\"Red\" \"Green\"] :selected-index 0 :on-changed f})."
  ([] (combo-box {}))
  ([opts] (build combo-box-widget opts nil)))

(defmethod property-changed :after [(c combo-box-widget) property value]
  (when (and (= property :items)
             (some? (:selected-index c))
             (>= (:selected-index c) (count value)))
    (set-slot! c :selected-index nil)))

(defgeneric selected-item [w]
  "The chosen item of a combo box, or the first selected one of a list box, table or
tree; nil if none.")

(defmethod selected-item [(w combo-box-widget)]
  (when-let [i (:selected-index w)]
    (get (vec (:items w)) i)))

(defn chosen-by-user!
  "Backends call this when the user chose the item at index (or nil) in w: it stores the
index and emits :changed. Returns the event."
  [w index]
  (sync-property! w :selected-index index)
  (emit! w (event-for w :changed :index index
                      :value (when index (get (vec (:items w)) index)))))

(defclass combo-entry-widget [item-widget]
  "A text field with a list of suggestions. It emits :changed (a value-event with the
text) when the user types or chooses, and :activate on Return."
  (text :cell :atom :init ""))

(declare-widget! combo-entry-widget {:properties [:text]
                                     :signals {:changed value-event :activate action-event}})

(defn combo-entry
  "A combo entry: (combo-entry {:items [\"8\" \"10\" \"12\"] :text \"10\"})."
  ([] (combo-entry {}))
  ([opts] (build combo-entry-widget opts nil)))

;;; Images

(defclass image-view-widget [widget]
  "Shows an image."
  (image :cell :atom :init nil :doc "The image shown, or nil.")
  (scaling :cell :atom :init :fit
           :doc ":none at its size, :fit scaled down to fit keeping its shape, :fill stretched."))

(declare-widget! image-view-widget {:properties [:image :scaling] :layout [:image]})

(defn image-view
  "An image view: (image-view {:image (image-from-file \"logo.png\")})."
  ([] (image-view {}))
  ([opts] (build image-view-widget opts nil)))

;;; ------------------------------------------------------------------------------------
;;; Dialogs of the program's own

(def response-labels
  "Responses whose buttons get a standard label."
  {:ok "OK" :cancel "Cancel" :yes "Yes" :no "No" :close "Close" :apply "Apply" :save "Save"
   :discard "Don't Save" :help "Help" :open "Open" :delete "Delete" :retry "Retry"})

(defn- response-label [r]
  (or (get response-labels r) (string/capitalize (string/replace (name r) "-" " "))))

(def ^:private affirmative #{:ok :yes :save :apply :open :delete :retry})
(def ^:private dismissive #{:cancel :no :close})

(defclass response-event [value-event vetoable-event]
  "A dialog's button was clicked: :value is its response. veto keeps the dialog open,
for example when what the user typed isn't valid.")

(defclass dialog-widget [window-widget]
  "A window with a row of buttons along the bottom that the user answers. Its children
go in its content area, a vbox. run-dialog shows it modally and returns the response of
the button clicked; it emits :response (a response-event) as one is clicked."
  (buttons :init [:cancel :ok]
           :doc "Its buttons: responses such as :ok, or [label response]; the platform
orders them.")
  (resizable :cell :atom :init false)
  (response :cell :atom :init nil :doc "The response that closed it, or :close.")
  (content-area :cell :atom :init nil)
  (button-box :cell :atom :init nil))

(declare-widget! dialog-widget {:signals {:response response-event}})

(def ^:dynamic *dialog-itself*
  "True while a dialog adds its own parts, rather than the program's to its content area."
  false)

(defmethod add! :around [(d dialog-widget) child]
  (if (or *dialog-itself* (nil? (:content-area d)))
    (call-next-method)
    (add! (:content-area d) child)))

(def ^:private respond!)

(defmethod initialize :after [(d dialog-widget)]
  (let [area (build box-widget {:orientation :vertical :spacing 8 :hexpand true :vexpand true}
                    nil)
        row (build box-widget {:orientation :horizontal :spacing 8 :halign :end} nil)
        top (build box-widget {:orientation :vertical :spacing 16 :margin [16 20]} nil)
        specs (mapv (fn [b] (if (vector? b) b [(response-label b) b])) (:buttons d))
        yes (filterv (fn [[_ r]] (contains? affirmative r)) specs)
        others (filterv (fn [[_ r]] (not (contains? affirmative r))) specs)
        ordered (if (= :affirmative-first (backend-dialog-button-order (current-backend)))
                  (into yes others)
                  (into others yes))]
    (doseq [[label response] ordered]
      (let [b (build button-widget {:label label :width 80
                                    :default (contains? affirmative response)
                                    :cancel (contains? dismissive response)}
                     nil)]
        (on b :clicked (fn [_] (respond! d response)))
        (add! row b)))
    (binding [*dialog-itself* true]
      (add! d top)
      (add! top area)
      (add! top row))
    (set-slot! d :content-area area)
    (set-slot! d :button-box row)))

(defn dialog
  "A dialog: (dialog {:title \"Rename\" :buttons [:cancel :ok]} (entry {:name :new-name}))."
  [opts & children]
  (build dialog-widget opts children))

(defn respond!
  "Answer the dialog with response, as its button would: it emits :response and, unless a
handler vetoes, closes (ending run-dialog)."
  [d response]
  (let [e (emit! d (event-for d :response :value response))]
    (when-not (vetoed? e)
      (set-slot! d :response response)
      (if (modal? d)
        (end-modal! d response)
        (close! d true)))))

(defn run-dialog
  "Show the dialog modally and return the response of the button that closed it, or
:close if the user closed its window. The dialog is closed afterwards."
  [d]
  (set-slot! d :response :close)
  (let [result (run-modal d)]
    (when-not (:destroyed d) (close! d true))
    (or result (:response d) :close)))

;;; ------------------------------------------------------------------------------------
;;; Colors and fonts

(defstruct color :value
  "An sRGB color: each component an f32 from 0 to 1. Make one with rgb, rgb255, hsv or
parse-color; properties and drawing also take a string such as \"#3a7bd5\", a named color
keyword such as :steelblue, or a system color keyword such as :accent."
  (red f32) (green f32) (blue f32) (alpha f32))

(defn- unit [x] (f32 (math/clamp x 0 1)))

(defn rgb
  "A color from red, green, blue and alpha (1 if not given) between 0 and 1."
  ([r g b] (rgb r g b 1))
  ([r g b a] (color (unit r) (unit g) (unit b) (unit a))))

(defn rgb255
  "A color from red, green, blue and alpha (255 if not given) between 0 and 255."
  ([r g b] (rgb255 r g b 255))
  ([r g b a] (rgb (/ r 255.0) (/ g 255.0) (/ b 255.0) (/ a 255.0))))

(defn- hex2 [x] (format "%02x" (int (math/round (* 255 x)))))

(defn color-hex
  "The color as a string such as \"#3a7bd5\"."
  [c]
  (str "#" (hex2 (color-red c)) (hex2 (color-green c)) (hex2 (color-blue c))))

(def named-colors
  "The colors named by keywords, which color designators and parse-color take."
  {:black (rgb255 0 0 0) :white (rgb255 255 255 255) :red (rgb255 220 50 47)
   :green (rgb255 46 160 67) :blue (rgb255 38 110 220) :yellow (rgb255 245 200 30)
   :orange (rgb255 245 130 32) :purple (rgb255 136 84 208) :pink (rgb255 232 92 160)
   :gray (rgb255 128 128 128) :grey (rgb255 128 128 128) :light-gray (rgb255 211 211 211)
   :dark-gray (rgb255 64 64 64) :brown (rgb255 140 90 50) :cyan (rgb255 30 190 210)
   :magenta (rgb255 200 50 200) :navy (rgb255 20 40 110) :teal (rgb255 20 128 128)
   :steelblue (rgb255 70 130 180) :transparent (rgb255 0 0 0 0)})

(def system-colors
  "Keywords naming the platform's colors, which follow light and dark mode: the backend
resolves them when they are used (system-color gives one's value now)."
  #{:text :secondary-text :disabled-text :background :control-background :window-background
    :selection :accent :separator :link :grid
    :sidebar-background :content-background :status-background :toolbar-background
    :activity-background :popover-background
    :system-red :system-orange :system-yellow :system-green :system-mint :system-teal
    :system-cyan :system-blue :system-indigo :system-purple :system-pink :system-brown
    :system-gray})

(defn- parse-hex [s]
  (reduce (fn [n ch]
            (let [d (string/index-of "0123456789abcdef" ch)]
              (when-not d (error "bad hex digit" (pr-str ch) "in a color"))
              (+ (* 16 n) d)))
          0
          (string/lower-case s)))

(defn parse-color
  "The color s names: \"#rgb\", \"#rrggbb\", \"#rrggbbaa\", or a named color such as
\"steelblue\" (named-colors)."
  [s]
  (let [s (string/trim s)
        hex (fn [a b] (parse-hex (subs s a b)))]
    (if (string/starts-with? s "#")
      (case (count s)
        4 (rgb255 (* 17 (hex 1 2)) (* 17 (hex 2 3)) (* 17 (hex 3 4)))
        7 (rgb255 (hex 1 3) (hex 3 5) (hex 5 7))
        9 (rgb255 (hex 1 3) (hex 3 5) (hex 5 7) (hex 7 9))
        (error "bad color" (pr-str s)))
      (or (get named-colors (keyword (string/lower-case (string/replace s " " ""))))
          (error "unknown color" (pr-str s))))))

(defn ensure-color
  "The color designator d as a color, or as a system color keyword, which the backend
resolves; nil stays nil. d is a color, a string parse-color takes, or a keyword of
named-colors or system-colors."
  [d]
  (cond (nil? d) nil
        (instance? color d) d
        (string? d) (parse-color d)
        (contains? system-colors d) d
        (keyword? d) (or (get named-colors d) (error "unknown color" (pr-str d)))
        :else (error "a color is a color, a string such as \"#3a7bd5\" or a keyword, not"
                     (pr-str d))))

(defn color-lerp
  "The color fraction of the way from color a to color b."
  [a b fraction]
  (let [mix (fn [x y] (+ x (* fraction (- y x))))]
    (rgb (mix (color-red a) (color-red b)) (mix (color-green a) (color-green b))
         (mix (color-blue a) (color-blue b)) (mix (color-alpha a) (color-alpha b)))))

(defn hsv
  "A color from hue in degrees and saturation and value between 0 and 1."
  ([hue saturation value] (hsv hue saturation value 1))
  ([hue saturation value alpha]
   (let [h (/ (mod hue 360) 60.0)
         c (* value saturation)
         x (* c (- 1 (abs (- (mod h 2) 1))))
         m (- value c)
         [r g b] (case (int (math/floor h))
                   0 [c x 0] 1 [x c 0] 2 [0 c x] 3 [0 x c] 4 [x 0 c] [c 0 x])]
     (rgb (+ r m) (+ g m) (+ b m) alpha))))

(def ^:private font-weights #{:light :regular :medium :semibold :bold})

(defn font
  "A font, a map: :family is :system (the platform's interface font), :monospace or a
family name; :size is in points, or nil for the platform's normal size; :weight is :light,
:regular, :medium, :semibold or :bold; :italic is true or false."
  ([] (font {}))
  ([opts]
   (let [f (merge {:family :system :size nil :weight :regular :italic false} opts)]
     (when-not (contains? font-weights (:weight f))
       (error "a font's weight is :light, :regular, :medium, :semibold or :bold, not"
              (pr-str (:weight f))))
     f)))

(defn ensure-font
  "The font designator d as a font: a font map, nil (the default font), :system,
:monospace, :bold, a number (the system font at that size) or a family name."
  [d]
  (cond (nil? d) nil
        (map? d) (font d)
        (number? d) (font {:size d})
        (= d :system) (font)
        (= d :monospace) (font {:family :monospace})
        (= d :bold) (font {:weight :bold})
        (string? d) (font {:family d})
        :else (error "a font is a map, a size, a family name, :system, :monospace or :bold,"
                     "not" (pr-str d))))

;;; ------------------------------------------------------------------------------------
;;; Text views

(defgeneric backend-text-append [backend view s]
  "Add s at the end of the text view's text, and scroll to it.")

(defgeneric backend-text-insert [backend view s]
  "Replace the text view's selection with s, or insert s at its insertion point.")

(defgeneric backend-text-selection [backend view]
  "The text view's selection as [start end]; they are equal, at the insertion point, when
nothing is selected.")

(defgeneric backend-set-text-selection [backend view start end]
  "Select the text view's text from start to end.")

(defclass text-view-widget [widget]
  "Lines of text the user edits, with their own scroll bars. It emits :changed (a
value-event with the text) as the user edits."
  (text :cell :atom :init "")
  (editable :cell :atom :init true :doc "Whether the user can change the text.")
  (wrap :cell :atom :init true :doc "Whether lines wrap at the edge; if not, it scrolls sideways.")
  (border :cell :atom :init true :doc "Whether to draw a border around it.")
  (placeholder :cell :atom :init nil :doc "Dimmed text shown while it's empty, or nil.")
  (hexpand :cell :atom :init true)
  (vexpand :cell :atom :init true))

(declare-widget! text-view-widget {:properties [:text :editable :wrap :border :placeholder]
                                   :signals (merge input-signals {:changed value-event})})

(defn text-view
  "A text view: (text-view {:text \"Notes\" :on-changed f})."
  ([] (text-view {}))
  ([opts] (build text-view-widget opts nil)))

(defn append-text!
  "Add s at the end of the text view's text and scroll to it. Returns the view."
  [v s]
  (sync-property! v :text (str (:text v) s))
  (let [b (current-backend)]
    (in-ui (fn [] (backend-text-append b v s))))
  v)

(defn text-selection
  "The text view's selection as [start end], positions in its text; they are equal when
nothing is selected: that is where the insertion point is."
  [v]
  (let [b (current-backend)]
    (in-ui (fn [] (backend-text-selection b v)))))

(defn set-text-selection!
  "Select the text view's text from start to end. Returns the view."
  [v start end]
  (let [b (current-backend)]
    (in-ui (fn [] (backend-set-text-selection b v start end))))
  v)

(defn insert-text!
  "Replace the text view's selection with s, or insert s at the insertion point. Returns
the view."
  [v s]
  (let [[start end] (text-selection v)
        t (:text v)]
    (sync-property! v :text (str (subs t 0 start) s (subs t end)))
    (let [b (current-backend)]
      (in-ui (fn [] (backend-text-insert b v s))))
    v))

;;; ------------------------------------------------------------------------------------
;;; Lists, tables and trees

(defgeneric selected-items [w]
  "The selected items of a list box, table or tree, in order.")

(defclass list-box-widget [item-widget]
  "A scrolling list of items to select from. It emits :selection-changed (a
selection-event) when the user changes the selection, and :row-activated (an item-event)
when the user double-clicks a row or presses Return on it."
  (icon-fn :cell :atom :init nil
           :doc "A function from an item to the image before its text, or nil.")
  (selection-mode :cell :atom :init :single :doc ":single or :multiple.")
  (selected-indices :cell :atom :init [] :doc "The indices of the selected items, in order.")
  (border :cell :atom :init true :doc "Whether to draw a border around it.")
  (alternating :cell :atom :init false :doc "Whether rows alternate background colors.")
  (hexpand :cell :atom :init true)
  (vexpand :cell :atom :init true))

(declare-widget! list-box-widget {:properties [:icon-fn :selection-mode :selected-indices
                                               :border :alternating]
                                  :signals (merge input-signals
                                                  {:selection-changed selection-event
                                                   :row-activated item-event})})

(defn list-box
  "A list box: (list-box {:items [\"One\" \"Two\"] :on-selection-changed f})."
  ([] (list-box {}))
  ([opts] (build list-box-widget opts nil)))

(defmethod selected-items [(w list-box-widget)]
  (let [items (vec (:items w))]
    (vec (keep (fn [i] (get items i)) (:selected-indices w)))))

(defmethod selected-item [(w list-box-widget)]
  (first (selected-items w)))

(defmethod property-changed :after [(w list-box-widget) property value]
  (when (= property :items)
    (let [n (count value)
          kept (filterv (fn [i] (< i n)) (:selected-indices w))]
      (when (not= kept (:selected-indices w))
        (set-slot! w :selected-indices kept)))))

(defn selection-changed-by-user!
  "Backends call this when the user changed the selection of a list box or table to the
rows at indices: it stores them and emits :selection-changed. Returns the event."
  [w indices]
  (sync-property! w :selected-indices (vec indices))
  (let [i (first indices)]
    (emit! w (event-for w :selection-changed :index i :value (when i (get (vec (:items w)) i))))))

(defn row-activated-by-user!
  "Backends call this when the user double-clicked (click-count 2) or pressed Return
(click-count 0) on the row at index of a list box or table. Returns the event."
  ([w index] (row-activated-by-user! w index 2))
  ([w index click-count]
   (emit! w (event-for w :row-activated :index index :item (get (vec (:items w)) index)
                       :click-count click-count))))

(defn compare-values
  "A comparator of mixed values, for sorting table rows: numbers by size, then strings
without regard to case, then anything else by its printed form."
  [a b]
  (cond (and (number? a) (number? b)) (compare a b)
        (number? a) -1
        (number? b) 1
        (and (string? a) (string? b)) (compare (string/lower-case a) (string/lower-case b))
        (string? a) -1
        (string? b) 1
        :else (compare (pr-str a) (pr-str b))))

(defclass table-column []
  "A column of a table or tree: its :title, and how to show a row in it: :key (a function
of the row), :format (a function from that value to its text), :width (pixels, or nil to
share the width left), :alignment (:left, :center or :right), :sort (a comparator, or
nil if the column can't sort the table) and :icon-fn (a function from the row to an image
or nil)."
  (title :init "")
  (key :init identity)
  (format :init str)
  (width :init nil)
  (alignment :init :left)
  (sort :init compare-values)
  (icon-fn :init nil))

(defn column
  "A table column titled title whose cells show (key row): key is a function, a keyword
(read from a map row) or an integer (an index into a vector row). opts are the column's
:width, :alignment, :format, :sort and :icon-fn."
  ([title key] (column title key {}))
  ([title key opts]
   (apply make table-column :title title
          :key (if (integer? key) (fn [row] (nth row key)) key)
          (mapcat identity opts))))

(defn cell-text
  "The text column shows for row."
  [col row]
  (str ((:format col) ((:key col) row))))

(defclass table-view-widget [list-box-widget]
  "Rows of items shown in columns: :items are the rows, and each of :columns (made with
column) says what to show of a row. Clicking a column title emits :column-clicked (a
column-event) and, when :sortable, sorts the rows by that column."
  (columns :cell :atom :init [])
  (headers :cell :atom :init true :doc "Whether to show the column titles.")
  (sortable :cell :atom :init true :doc "Whether clicking a column title sorts by it.")
  (sort-column :cell :atom :init nil :doc "The column the rows are sorted by, or nil.")
  (sort-descending :cell :atom :init false)
  (alternating :cell :atom :init true))

(declare-widget! table-view-widget {:properties [:columns :headers :sort-column
                                                 :sort-descending]
                                    :layout [:columns]
                                    :signals {:column-clicked column-event}})

(defn table-view
  "A table: (table-view {:columns [(column \"Name\" :name)] :items rows})."
  ([] (table-view {}))
  ([opts] (build table-view-widget opts nil)))

(defn table-cell-text
  "The text the table shows at row-index in the column at column-index."
  [t row-index column-index]
  (let [items (vec (:items t))
        col (get (vec (:columns t)) column-index)]
    (if (and col (< -1 row-index (count items)))
      (cell-text col (nth items row-index))
      "")))

(defn sort-table!
  "Sort the table's rows by column (descending if asked), keeping the selected rows
selected. Returns the table."
  ([t col] (sort-table! t col false))
  ([t col descending]
   (let [items (vec (:items t))
         key (:key col)
         cmp (or (:sort col) compare-values)
         order (vec (sort-by (fn [i] (key (nth items i)))
                             (if descending (fn [a b] (cmp b a)) cmp)
                             (range (count items))))
         new-index (into {} (map-indexed (fn [pos i] [i pos]) order))
         selected (vec (sort (keep new-index (:selected-indices t))))]
     (set-slot! t :items (mapv (fn [i] (nth items i)) order))
     (set-slot! t :selected-indices selected)
     (set-slot! t :sort-column col)
     (set-slot! t :sort-descending descending)
     t)))

(defmethod handle-event :after [(t table-view-widget) (e column-event)]
  (let [col (:column e)]
    (when (and (:sortable t) (:sort col))
      (sort-table! t col (and (identical? col (:sort-column t)) (not (:sort-descending t)))))))

(defn column-clicked-by-user!
  "Backends call this when the user clicked the title of the table's column at index.
Returns the event."
  [t index]
  (emit! t (event-for t :column-clicked :column (get (vec (:columns t)) index) :index index)))

(defgeneric backend-tree-refresh [backend tree item]
  "The children of item in the tree, or of every item if item is nil, may have changed:
ask tree-children for them again.")

(defclass tree-view-widget [widget]
  "Items in a hierarchy the user opens and closes. Give it :roots and :children-fn, a
function from an item to its children; :item-key gives each item a key (compared with =)
that keeps it open or selected when the items are made again. With :columns it shows a
table whose first column holds the tree; without, each item's :item-label text. It emits
:selection-changed, :row-activated (an item-event), and :expanded and :collapsed (item
events) when the user opens or closes an item."
  (roots :cell :atom :init [])
  (children-fn :cell :atom :init (fn [item] []))
  (item-key :cell :atom :init identity)
  (item-label :cell :atom :init str)
  (icon-fn :cell :atom :init nil)
  (columns :cell :atom :init [])
  (headers :cell :atom :init false)
  (selection-mode :cell :atom :init :single :doc ":single or :multiple.")
  (selection :cell :atom :init [] :doc "The selected items, in row order.")
  (expanded :cell :atom :init #{} :doc "The keys of the open items.")
  (child-cache :cell :atom :init {})
  (hexpand :cell :atom :init true)
  (vexpand :cell :atom :init true))

(declare-widget! tree-view-widget {:properties [:roots :item-label :icon-fn :columns :headers
                                                :selection-mode :selection :expanded]
                                   :layout [:columns]
                                   :signals (merge input-signals
                                                   {:selection-changed selection-event
                                                    :row-activated item-event
                                                    :expanded item-event
                                                    :collapsed item-event})})

(defn tree-view
  "A tree: (tree-view {:roots [root] :children-fn :children})."
  ([] (tree-view {}))
  ([opts] (build tree-view-widget opts nil)))

(defmethod property-changed :before [(t tree-view-widget) property value]
  (when (= property :roots)
    (set-slot! t :child-cache {}))
  (when (and (= property :selection) (= :single (:selection-mode t)) (> (count value) 1))
    (error "the tree selects one item at a time; set its :selection-mode to :multiple")))

(defn tree-children
  "The children of item in the tree, or its roots if item is nil, as a vector; asked of
:children-fn once until refresh-tree!."
  [t item]
  (if (nil? item)
    (vec (:roots t))
    (let [k ((:item-key t) item)]
      (or (get (:child-cache t) k)
          (let [cs (vec ((:children-fn t) item))]
            (update-slot! t :child-cache assoc k cs)
            cs)))))

(defn refresh-tree!
  "Ask :children-fn again for item's children, or every item's. Returns the tree."
  ([t] (refresh-tree! t nil))
  ([t item]
   (if item
     (update-slot! t :child-cache dissoc ((:item-key t) item))
     (set-slot! t :child-cache {}))
   (let [b (current-backend)]
     (in-ui (fn [] (backend-tree-refresh b t item))))
   t))

(defn expanded?
  "True if item is open in the tree."
  [t item]
  (contains? (:expanded t) ((:item-key t) item)))

(defn expand!
  "Open item in the tree (the roots, for nil); with all, its descendants too. Returns the
tree."
  ([t item] (expand! t item false))
  ([t item all]
   (let [start (if (nil? item) (tree-children t nil) [item])
         items (if all
                 (mapcat (fn [i] (tree-seq (fn [_] true) (fn [x] (tree-children t x)) i)) start)
                 start)]
     (update-slot! t :expanded into (map (:item-key t) items))
     t)))

(defn collapse!
  "Close item in the tree. Returns the tree."
  [t item]
  (update-slot! t :expanded disj ((:item-key t) item))
  t)

(defn visible-tree-items
  "The tree's items that show, in row order: the roots, and the children of open items."
  [t]
  (let [visit (fn visit [item]
                (cons item (when (expanded? t item)
                             (mapcat visit (tree-children t item)))))]
    (vec (mapcat visit (tree-children t nil)))))

(defn tree-cell-text
  "The text the tree shows for item in the column at column-index."
  [t item column-index]
  (if-let [col (get (vec (:columns t)) column-index)]
    (cell-text col item)
    (str ((:item-label t) item))))

(defmethod selected-items [(t tree-view-widget)]
  (vec (:selection t)))

(defmethod selected-item [(t tree-view-widget)]
  (first (:selection t)))

(defn expansion-changed-by-user!
  "Backends call this when the user opened (expanded true) or closed an item of the
tree: it records it and emits :expanded or :collapsed."
  [t item expanded]
  (let [k ((:item-key t) item)
        was (contains? (:expanded t) k)]
    (sync-property! t :expanded ((if expanded conj disj) (:expanded t) k))
    (when (not= was (boolean expanded))
      (emit! t (event-for t (if expanded :expanded :collapsed) :item item)))))

(defn tree-selection-changed-by-user!
  "Backends call this when the user selected items in the tree: it stores them and emits
:selection-changed, whose :value is the first. Returns the event."
  [t items]
  (sync-property! t :selection (vec items))
  (emit! t (event-for t :selection-changed :value (first items))))

(defn tree-item-activated-by-user!
  "Backends call this when the user double-clicked an item of the tree, or pressed Return
on it. Returns the event."
  ([t item] (tree-item-activated-by-user! t item 2))
  ([t item click-count]
   (emit! t (event-for t :row-activated :item item :click-count click-count))))

;;; ------------------------------------------------------------------------------------
;;; Color and date pickers

(defclass color-button-widget [widget]
  "A swatch of a color that opens the platform's color chooser. It emits :changed (a
value-event with the color) when the user picks one."
  (color :cell :atom :init (rgb 0 0 0) :doc "The color, or a color designator."))

(declare-widget! color-button-widget {:properties [:color] :signals {:changed value-event}})

(defn color-button
  "A color button: (color-button {:color :steelblue :on-changed f})."
  ([] (color-button {}))
  ([opts] (build color-button-widget opts nil)))

(defclass date-picker-widget [widget]
  "A field for picking a date or a time. It emits :changed (a value-event with the new
time) when the user changes it."
  (date :cell :atom :init (time/epoch-millis)
        :doc "The date and time, in milliseconds since 1970 (UTC); now, at first.")
  (mode :cell :atom :init :date :doc ":date, :time or :date-time: what the user picks."))

(declare-widget! date-picker-widget {:properties [:date :mode] :layout [:mode]
                                     :signals {:changed value-event}})

(defn date-picker
  "A date picker: (date-picker {:mode :date-time :on-changed f})."
  ([] (date-picker {}))
  ([opts] (build date-picker-widget opts nil)))

;;; ------------------------------------------------------------------------------------
;;; Notebooks, split panes and scrolled windows

(defgeneric backend-set-page-label [backend notebook page label]
  "Show label on the tab of the notebook's page.")

(defclass notebook-widget [container-widget]
  "Pages of widgets, one shown at a time, chosen with tabs. Each child is a page, and its
:tab-label is the tab's text (\"Page n\" if it has none). It emits :page-changed (a
selection-event with the page) when the user picks another tab."
  (selected-index :cell :atom :init 0 :doc "The index of the page shown.")
  (tab-position :cell :atom :init :top :doc ":top, :bottom, :left or :right."))

(declare-widget! notebook-widget {:properties [:selected-index :tab-position]
                                  :layout [:tab-position]
                                  :signals {:page-changed selection-event}})

(defn notebook
  "A notebook: (notebook {} (vbox {:tab-label \"General\"} ...) ...)."
  [opts & children]
  (build notebook-widget opts children))

(defmethod add! :before [(n notebook-widget) child]
  (when (nil? (:tab-label child))
    (set-slot! child :tab-label (str "Page " (inc (count (:children n)))))))

(defn add-page!
  "Add child to the notebook as a page whose tab says label. Returns child."
  [n child label]
  (set-slot! child :tab-label label)
  (add! n child))

(defn selected-page
  "The page the notebook shows, or nil."
  [n]
  (get (:children n) (:selected-index n)))

(def ^:private tab-page-changed!
  "What a page's tab field change does in a tabbed pane (defined below).")

(defmethod property-changed :after [(w widget) property value]
  (when (and (= property :tab-label) (instance? notebook-widget (:parent w)) (realized? w))
    (let [b (current-backend)
          n (:parent w)]
      (in-ui (fn [] (backend-set-page-label b n w value)))))
  (tab-page-changed! w property value))

(defmethod measure [(n notebook-widget)]
  (let [[dw dh] (backend-decoration-size (current-backend) n)
        sizes (map outer-size (:children n))]
    [(+ dw (reduce max 0 (map first sizes))) (+ dh (reduce max 0 (map second sizes)))]))

(defmethod arrange [(n notebook-widget) width height]
  (let [[x y w h] (backend-content-area (current-backend) n width height)]
    (doseq [c (:children n)]
      (allocate-in-cell c x y w h))))

(defn page-changed-by-user!
  "Backends call this when the user picked the notebook's page at index. Returns the
event."
  [n index]
  (sync-property! n :selected-index index)
  (emit! n (event-for n :page-changed :index index :value (get (:children n) index))))

(defclass paned-widget [container-widget]
  "Panes side by side, or one above another, with dividers the user drags. It emits
:divider-moved (a value-event with the new :position) when the user drags one."
  (orientation :cell :atom :init :horizontal
               :doc ":horizontal puts the panes side by side, :vertical one above another.")
  (position :cell :atom :init nil
            :doc "The first pane's length, in pixels, or nil for its natural length. It
keeps it when the paned widget is resized; the other panes share the rest."))

(declare-widget! paned-widget {:properties [:orientation :position]
                               :layout [:orientation :position]
                               :signals {:divider-moved value-event}})

(defn paned
  "A paned widget: (paned {:position 200} sidebar content)."
  [opts & children]
  (build paned-widget opts children))

(defn- divider-size
  "The thickness of the paned widget's dividers: the backend's decoration size."
  [p]
  (first (backend-decoration-size (current-backend) p)))

(defmethod measure [(p paned-widget)]
  (let [h? (= :horizontal (:orientation p))
        kids (visible-children p)
        sizes (map outer-size kids)
        main (+ (reduce + 0 (map (fn [[w h]] (if h? w h)) sizes))
                (* (divider-size p) (max 0 (dec (count kids)))))
        cross (reduce max 0 (map (fn [[w h]] (if h? h w)) sizes))]
    (if h? [main cross] [cross main])))

(defn pane-lengths
  "The length of each shown pane of p along the split, for total pixels: the first gets
its :position (or its natural length), and the others share the rest."
  [p total]
  (let [h? (= :horizontal (:orientation p))
        kids (visible-children p)
        n (count kids)
        available (max 0 (- total (* (divider-size p) (max 0 (dec n)))))]
    (cond
      (zero? n) []
      (= n 1) [available]
      :else (let [natural (let [[w h] (outer-size (first kids))] (if h? w h))
                  first-length (max 0 (min (or (:position p) natural) available))
                  rest-length (- available first-length)
                  each (quot rest-length (dec n))]
              (into [first-length]
                    (concat (repeat (- n 2) each) [(- rest-length (* each (- n 2)))]))))))

(defmethod arrange [(p paned-widget) width height]
  (let [h? (= :horizontal (:orientation p))
        d (divider-size p)]
    (reduce (fn [pos [c len]]
              (if h?
                (allocate-in-cell c pos 0 len height)
                (allocate-in-cell c 0 pos width len))
              (+ pos len d))
            0
            (map vector (visible-children p) (pane-lengths p (if h? width height))))
    nil))

(defn divider-moved-by-user!
  "Backends call this when the user dragged the paned widget's first divider to
position: it places the panes again and emits :divider-moved. Returns the event."
  [p position]
  (sync-property! p :position position)
  (when-let [[_ _ w h] (:allocation p)]
    (arrange p w h))
  (emit! p (event-for p :divider-moved :value position)))

(defgeneric backend-set-scroll-extent [backend scrolled width height]
  "Make the scrolled window's content area width by height. Returns the view's new [width
height] if showing or hiding a scroll bar changed it, else nil.")

(defgeneric backend-scroll-to [backend scrolled x y]
  "Scroll so that the point x, y of the content is at the view's top left.")

(defclass scrolled-window-widget [bin-widget]
  "Shows part of a widget bigger than its space, with scroll bars. Its natural size is
:min-content-width by :min-content-height, or the content's along an axis whose policy is
:never. It emits :scrolled (a value-event with [x y], the content's point at the top
left) when the user scrolls."
  (horizontal-policy :cell :atom :init :automatic
                     :doc ":automatic shows a scroll bar when the content is wider than the
view, :always always, and :never makes the content as wide as the view.")
  (vertical-policy :cell :atom :init :automatic :doc "As :horizontal-policy, for height.")
  (border :cell :atom :init false :doc "Whether to draw a border around the view.")
  (min-content-width :cell :atom :init 120)
  (min-content-height :cell :atom :init 80))

(declare-widget! scrolled-window-widget
                 {:properties [:horizontal-policy :vertical-policy :border]
                  :layout [:horizontal-policy :vertical-policy :border :min-content-width
                           :min-content-height]
                  :signals {:scrolled value-event}})

(defn scrolled-window
  "A scrolled window: (scrolled-window {:min-content-height 200} content)."
  [opts & children]
  (build scrolled-window-widget opts children))

(defmethod measure [(s scrolled-window-widget)]
  (let [[dw dh] (backend-decoration-size (current-backend) s)
        [cw ch] (if-let [c (content s)] (outer-size c) [0 0])]
    [(+ dw (if (= :never (:horizontal-policy s)) cw (min cw (:min-content-width s))))
     (+ dh (if (= :never (:vertical-policy s)) ch (min ch (:min-content-height s))))]))

(defmethod arrange [(s scrolled-window-widget) width height]
  (when-let [c (content s)]
    (let [b (current-backend)
          [_ _ vw vh] (backend-content-area b s width height)
          [cw ch] (outer-size c)
          extent (fn [vw vh] [(if (= :never (:horizontal-policy s)) vw (max vw cw))
                              (if (= :never (:vertical-policy s)) vh (max vh ch))])
          [w h] (extent vw vh)
          ;; Showing a scroll bar can shrink the view; if it did, size the content again.
          changed (in-ui (fn [] (backend-set-scroll-extent b s w h)))
          [w h] (if (and changed (not= changed [vw vh]))
                  (let [[w h] (apply extent changed)]
                    (in-ui (fn [] (backend-set-scroll-extent b s w h)))
                    [w h])
                  [w h])]
      (allocate-in-cell c 0 0 w h))))

(defn scroll-to!
  "Scroll the scrolled window so that the point x, y of its content is at the top left.
Returns it."
  [s x y]
  (let [b (current-backend)]
    (in-ui (fn [] (backend-scroll-to b s x y))))
  s)

(defn scrolled-by-user!
  "Backends call this when the user scrolled the scrolled window so that the content's
point x, y is at the top left. Returns the event."
  [s x y]
  (emit! s (event-for s :scrolled :value [x y])))

;;; ------------------------------------------------------------------------------------
;;; Stacks: one page shown at a time

(defn- page-size
  "A page's outer size as if it were shown: a stack measures its hidden pages too."
  [w]
  (if (:visible w)
    (outer-size w)
    (let [[mw mh] (measure w)
          [top right bottom left] (sides (:margin w))]
      [(+ (max (int (math/ceil mw)) (or (:width w) 0)) left right)
       (+ (max (int (math/ceil mh)) (or (:height w) 0)) top bottom)])))

(defclass stack-widget [container-widget]
  "A container showing one of its children, its pages, at a time, sized for the largest.
It emits :page-changed (a selection-event with the page) when another page shows."
  (selected-index :cell :atom :init 0 :doc "The index of the page shown, or nil for none.")
  (hexpand :cell :atom :init true)
  (vexpand :cell :atom :init true))

(declare-widget! stack-widget {:layout [:selected-index] :signals {:page-changed selection-event}})

(defn stack
  "A stack: (stack {:selected-index 0} (vbox {:tab-label \"One\"} ...) ...)."
  [opts & children]
  (build stack-widget opts children))

(defn- show-stack-page! [s]
  (doseq [[i p] (map-indexed vector (:children s))]
    (let [v (= i (:selected-index s))]
      (when (not= v (:visible p)) (set-slot! p :visible v)))))

(defmethod property-changed :after [(s stack-widget) property value]
  (when (= property :selected-index)
    (when-not (or (nil? value) (and (integer? value) (< -1 value (count (:children s)))))
      (error "no page" (pr-str value) "in the stack"))
    (show-stack-page! s)
    (emit! s (event-for s :page-changed :index value :value (when value (get (:children s) value))))))

(defmethod add! :after [(s stack-widget) child]
  (when (nil? (:tab-label child)) (set-slot! child :tab-label "Page"))
  (show-stack-page! s))

(defmethod removed-from! [(s stack-widget) child index]
  (set-slot! child :visible true)
  (let [n (count (:children s))
        i (:selected-index s)
        next (cond (zero? n) nil
                   (nil? i) nil
                   (= i index) (min index (dec n))
                   (> i index) (dec i)
                   :else i)]
    (if (= next i)
      (show-stack-page! s)
      (set-slot! s :selected-index next))))

(defmethod measure [(s stack-widget)]
  (let [sizes (map page-size (:children s))]
    [(reduce max 0 (map first sizes)) (reduce max 0 (map second sizes))]))

(defmethod arrange [(s stack-widget) width height]
  (when-let [p (get (:children s) (:selected-index s))]
    (allocate-in-cell p 0 0 width height)))

(defgeneric select-page! [container page]
  "Show page, a page of the notebook, stack or tabbed pane. Returns page.")

(defmethod select-page! [container page]
  (let [i (index-of (:children container) page)]
    (when (nil? i) (error "not a page of the container"))
    (set-slot! container :selected-index i)
    page))

(defclass vertical-notebook-widget [stack-widget]
  "A stack with a list of its pages' names on the left to choose one: :page-list, a list
box it owns, and :sidebar-width, the list's width."
  (sidebar-width :cell :atom :init 150)
  (page-list :cell :atom :init nil))

(declare-widget! vertical-notebook-widget {:layout [:sidebar-width]})

(defn vertical-notebook
  "A vertical notebook: (vertical-notebook {} (vbox {:tab-label \"General\"} ...) ...)."
  [opts & children]
  (build vertical-notebook-widget opts children))

(defn- update-page-list! [n]
  (when-let [l (:page-list n)]
    (with-handlers-blocked [l :selection-changed]
      (set-slot! l :items (vec (:children n)))
      (set-slot! l :selected-indices (if (:selected-index n) [(:selected-index n)] [])))))

(defmethod initialize :after [(n vertical-notebook-widget)]
  (let [l (build list-box-widget {:item-label (fn [page] (str (or (:tab-label page) "")))
                                  :hexpand false}
                 nil)]
    (set-slot! n :page-list l)
    (set-slot! l :parent n)
    (let [b (current-backend)]
      (in-ui (fn [] (backend-add-child b n l))))
    (on l :selection-changed (fn [e] (when (:index e) (set-slot! n :selected-index (:index e)))))))

(defmethod add! :after [(n vertical-notebook-widget) child]
  (update-page-list! n))

(defmethod removed-from! :after [(n vertical-notebook-widget) child index]
  (update-page-list! n))

(defmethod property-changed :after [(n vertical-notebook-widget) property value]
  (when (= property :selected-index) (update-page-list! n)))

(defmethod destroy! :before [(n vertical-notebook-widget)]
  (when-let [l (:page-list n)] (destroy! l)))

(defmethod measure [(n vertical-notebook-widget)]
  (let [[w h] (call-next-method)]
    [(+ w (:sidebar-width n) 12) (max h 120)]))

(defmethod arrange [(n vertical-notebook-widget) width height]
  (let [side (min width (:sidebar-width n))]
    (when-let [l (:page-list n)] (allocate l 0 0 side height))
    (when-let [p (get (:children n) (:selected-index n))]
      (allocate-in-cell p (+ side 12) 0 (max 0 (- width side 12)) height))))

;;; ------------------------------------------------------------------------------------
;;; Tabbed panes: tabs the user closes, reorders and drags between panes

(defclass page-close-event [selection-event vetoable-event]
  "A page (:value, at :index) is about to close; veto keeps it open.")

(defclass page-move-event [selection-event]
  "A page (:value) moved from :old-index to :index."
  (old-index :init nil))

(defclass page-drop-event [selection-event vetoable-event]
  "A page (:value) of another pane (:from) is moving to :index of this one; veto in
:page-drop-request refuses it."
  (from :init nil))

(defclass tab-context-event [mouse-event]
  "A right-click on a tab: :page is its page, :index its index, :x and :y the point in
the tab bar. consume! it after showing a menu of your own."
  (page :init nil)
  (index :init nil))

(defgeneric backend-tab-update [backend pane page]
  "Show the page's tab as its tab fields say: label (a string or widget), tooltip, icon,
closability and accessory.")

(defmethod backend-tab-update [(b backend) pane page]
  nil)

(defgeneric backend-tab-move [backend pane page old-index index]
  "Move the page's tab from old-index to index.")

(defmethod backend-tab-move [(b backend) pane page old-index index]
  nil)

(defgeneric backend-tab-reveal [backend pane page]
  "Scroll the tab bar so the page's tab shows.")

(defmethod backend-tab-reveal [(b backend) pane page]
  nil)

(defgeneric backend-tab-at-point [backend pane x y]
  "The page whose tab is at x, y in the pane's tab bar, or nil.")

(defmethod backend-tab-at-point [(b backend) pane x y]
  nil)

(defclass tab-bar-widget [container-widget]
  "A tabbed pane's tab bar: the platform draws its tabs; its :start and :end boxes hold
the program's widgets. Its pane owns it."
  (pane :init nil)
  (start :cell :atom :init nil)
  (end :cell :atom :init nil)
  (vexpand :cell :atom :init false))

(defclass tabbed-pane-widget [notebook-widget]
  "A notebook whose tabs the user can close, reorder and drag to other panes of its
window with the same :drag-group. Each page's tab shows its :tab-label (a string or a
widget), :tab-icon, :tab-tooltip, a close button unless :tab-closable is false, and its
:tab-accessory. It emits :page-close-request (vetoable), :page-closed, :page-moved,
:page-drop-request (vetoable), :page-received and :tab-context-request, and
:page-changed when another page shows."
  (selected-index :cell :atom :init nil)
  (reorderable :cell :atom :init true :doc "Whether the user can drag tabs to reorder them.")
  (drag-group :cell :atom :init nil
              :doc "Panes of a window with the same drag group (not nil) trade dragged tabs.")
  (tab-bar :cell :atom :init nil))

(declare-widget! tabbed-pane-widget
                 {:properties [:reorderable :drag-group]
                  :signals {:page-close-request page-close-event :page-closed selection-event
                            :page-moved page-move-event :page-drop-request page-drop-event
                            :page-received page-drop-event
                            :tab-context-request tab-context-event}})

(defn tabbed-pane
  "A tabbed pane: (tabbed-pane {:drag-group :docs} (text-view {:tab-label \"Notes\"}) ...)."
  [opts & children]
  (build tabbed-pane-widget opts children))

(defn tab-bar
  "The tabbed pane's tab bar, whose :start and :end boxes hold the program's widgets."
  [pane]
  (:tab-bar pane))

(defmethod initialize :after [(pane tabbed-pane-widget)]
  (when-not (contains? #{:top :bottom} (:tab-position pane))
    (error "a tabbed pane's tabs are at the :top or :bottom"))
  (let [bar (build tab-bar-widget {:pane pane} nil)
        start (build box-widget {:orientation :horizontal :spacing 4} nil)
        end (build box-widget {:orientation :horizontal :spacing 4} nil)]
    (set-slot! bar :parent pane)
    (set-slot! pane :tab-bar bar)
    (let [b (current-backend)]
      (in-ui (fn [] (backend-add-child b pane bar))))
    (add! bar start)
    (add! bar end)
    (set-slot! bar :start start)
    (set-slot! bar :end end)))

(defmethod destroy! :before [(pane tabbed-pane-widget)]
  (when-let [bar (:tab-bar pane)] (destroy! bar)))

(defn- tab-widgets [page]
  (filterv (fn [w] (instance? widget w)) [(:tab-label page) (:tab-accessory page)]))

(defn tab-title
  "A page's tab name as text: its label, or a widget label's text or tooltip."
  [pane page]
  (let [l (:tab-label page)]
    (cond (nil? l) ""
          (string? l) l
          (instance? widget l) (or (:tab-tooltip page) (:text l) (:label l) "Tab")
          :else (str l))))

(defn- update-tab! [pane page]
  (let [b (current-backend)]
    (in-ui (fn [] (backend-tab-update b pane page))))
  (invalidate-size! (:tab-bar pane)))

(defmethod add! :around [(pane tabbed-pane-widget) page]
  (if (instance? tab-bar-widget page)
    (call-next-method)
    (do
      (when (and (instance? widget (:tab-label page))
                 (identical? (:tab-label page) (:tab-accessory page)))
        (error "a tab's label and accessory are different widgets"))
      (doseq [w (tab-widgets page)]
        (when (:parent w) (error "the tab's widget is in a container already")))
      (let [first-page (empty? (:children pane))]
        (call-next-method)
        (doseq [w (tab-widgets page)] (add! (:tab-bar pane) w))
        (update-tab! pane page)
        (when first-page (set-slot! pane :selected-index 0))
        page))))

(defmethod add! :before [(pane tabbed-pane-widget) page]
  (when (and (nil? (:tab-label page)) (not (instance? tab-bar-widget page)))
    (set-slot! page :tab-label (str "Page " (inc (count (:children pane)))))))

(defmethod property-changed :after [(pane tabbed-pane-widget) property value]
  (when (= property :selected-index)
    (when-not (or (and (nil? value) (empty? (:children pane)))
                  (and (integer? value) (< -1 value (count (:children pane)))))
      (error "no tab" (pr-str value) "in the tabbed pane"))
    (let [b (current-backend)
          page (when value (get (:children pane) value))]
      (when page (in-ui (fn [] (backend-tab-reveal b pane page))))
      (emit! pane (event-for pane :page-changed :index value :value page)))))

(def ^:private tab-page-changed!
  (fn [w property value]
    ;; A page's tab fields show in its tabbed pane's tab.
    (when (and (contains? #{:tab-label :tab-tooltip :tab-icon :tab-closable :tab-accessory}
                          property)
               (instance? tabbed-pane-widget (:parent w)))
      (update-tab! (:parent w) w))))

(defn- check-page [pane page]
  (when-not (index-of (:children pane) page)
    (error "not a page of the tabbed pane")))

(defmethod removed-from! [(pane tabbed-pane-widget) page index]
  (doseq [w (tab-widgets page)]
    (remove! (:tab-bar pane) w)
    (destroy! w))
  (when (instance? widget (:tab-label page)) (set-slot! page :tab-label "Tab"))
  (set-slot! page :tab-accessory nil)
  (let [n (count (:children pane))
        i (:selected-index pane)
        next (cond (zero? n) nil
                   (= i index) (min index (dec n))
                   (and i (> i index)) (dec i)
                   :else i)]
    (when (not= next i)
      (set-slot! pane :selected-index next))))

(defn close-page!
  "Ask to close the page: the pane emits :page-close-request and, unless a handler vetoes
(or with force), takes the page out, destroys it and emits :page-closed. True if it
closed."
  ([pane page] (close-page! pane page false))
  ([pane page force]
   (check-page pane page)
   (let [index (index-of (:children pane) page)]
     (when (or force
               (not (vetoed? (emit! pane (event-for pane :page-close-request :index index
                                                    :value page)))))
       (remove! pane page)
       (destroy! page)
       (emit! pane (event-for pane :page-closed :index index :value page))
       true))))

(defn move-page!
  "Move the page to index, keeping the page shown, and emit :page-moved. Returns page."
  [pane page index]
  (check-page pane page)
  (when-not (and (integer? index) (< -1 index (count (:children pane))))
    (error "no tab" (pr-str index) "in the tabbed pane"))
  (let [old (index-of (:children pane) page)
        shown (get (:children pane) (:selected-index pane))]
    (when (not= old index)
      (let [others (vec (remove (fn [p] (identical? p page)) (:children pane)))]
        (set-slot! pane :children (vec (concat (subvec others 0 index) [page]
                                               (subvec others index)))))
      (sync-property! pane :selected-index (index-of (:children pane) shown))
      (let [b (current-backend)]
        (in-ui (fn [] (backend-tab-move b pane page old index))))
      (invalidate-size! (:tab-bar pane))
      (emit! pane (event-for pane :page-moved :old-index old :index index :value page)))
    page))

(defn transfer-page!
  "Move the page from its tabbed pane into pane, at index (the end by default), keeping
its tab's label, tooltip, icon and closability (a widget label becomes its text, an
accessory is dropped), and show it unless select is false. pane emits :page-received.
Returns page."
  ([page pane] (transfer-page! page pane nil true))
  ([page pane index select]
   (let [from (:parent page)]
     (when-not (instance? tabbed-pane-widget from) (error "not a page of a tabbed pane"))
     (when (identical? from pane) (error "already a page of that pane"))
     (let [title (tab-title from page)]
       (when (instance? widget (:tab-label page)) (set-slot! page :tab-label title)))
     (set-slot! page :tab-accessory nil)
     (remove! from page)
     (add! pane page)
     (let [last-index (dec (count (:children pane)))
           index (if index (max 0 (min index last-index)) last-index)]
       (move-page! pane page index)
       (when select (select-page! pane page))
       (emit! pane (event-for pane :page-received :index index :value page :from from))
       page))))

(defn page-drop-target?
  "True if a tab dragged from the pane from may be dropped on pane."
  [pane from]
  (boolean (and (instance? tabbed-pane-widget pane) (not (identical? pane from))
                (not (:destroyed pane)) (:drag-group from)
                (= (:drag-group pane) (:drag-group from))
                (identical? (layout-root pane) (layout-root from)))))

(defn page-dropped-by-user!
  "Backends call this when the user dropped page, a tab of another pane, on pane at
index: pane emits :page-drop-request and, unless a handler vetoes, the page moves. True
if it moved."
  [page pane index]
  (let [from (:parent page)]
    (boolean
     (when (and (instance? tabbed-pane-widget from) (page-drop-target? pane from)
                (not (vetoed? (emit! pane (event-for pane :page-drop-request :index index
                                                     :value page :from from)))))
       (transfer-page! page pane index true)))))

(defn page-moved-by-user!
  "Backends call this when the user dragged the page's tab to index in its pane."
  [pane page index]
  (move-page! pane page index))

(defn tab-at-point
  "The page whose tab is at x, y in the pane's tab bar, or nil."
  [pane x y]
  (let [b (current-backend)]
    (in-ui (fn [] (backend-tab-at-point b pane x y)))))

(def popup-menu!
  "Show a menu at a point in a widget (defined with the menus, below).")

(defn tab-context-requested!
  "Backends call this for a right-click at x, y in the pane's tab bar: it emits
:tab-context-request for the tab there, and shows the bar's :context-menu unless a
handler consumed it."
  [pane x y modifiers]
  (let [page (tab-at-point pane x y)
        e (when page (event-for pane :tab-context-request :page page
                                :index (index-of (:children pane) page) :x x :y y
                                :button :right :modifiers modifiers))]
    (when e (emit! pane e))
    (when (and (not (and e (consumed? e))) (:context-menu (:tab-bar pane)))
      (popup-menu! (:context-menu (:tab-bar pane)) (:tab-bar pane) x y))))

(defn- tabbed-ancestor [w]
  (first (filter (fn [o] (instance? tabbed-pane-widget o)) (take-while some? (iterate :parent w)))))

(defn handle-tab-key
  "Switch the pane's page for Control-Tab or Control-Shift-Tab, or Command-Shift-[ or ];
true (consuming the key event) if it did. It runs for the pane's widgets by itself."
  [pane e]
  (let [mods (set (:modifiers e))
        key (:key e)
        direction (cond (and (= key :tab) (contains? mods :control)
                             (every? #{:control :shift} mods))
                        (if (contains? mods :shift) -1 1)
                        (and (contains? mods :command) (contains? mods :shift)
                             (every? #{:command :shift} mods) (contains? #{\[ \] \{ \}} key))
                        (if (contains? #{\[ \{} key) -1 1))
        n (count (:children pane))]
    (when (and direction (= :key-down (:signal e)) (not (consumed? e)) (pos? n))
      (set-slot! pane :selected-index (mod (+ (or (:selected-index pane) 0) direction) n))
      (consume! e)
      true)))

(defmethod handle-event :around [(w widget) (e key-event)]
  (let [pane (tabbed-ancestor w)]
    (when-not (and pane (handle-tab-key pane e))
      (call-next-method))))

(defmethod measure [(bar tab-bar-widget)]
  ;; Room for a few tabs: the bar scrolls the rest rather than widening the window.
  (let [[sw sh] (outer-size (:start bar))
        [ew eh] (outer-size (:end bar))
        [_ nh] (let [b (current-backend)] (in-ui (fn [] (backend-natural-size b bar))))]
    [(+ 160 sw ew) (max nh (+ 8 sh) (+ 8 eh))]))

(defmethod arrange [(bar tab-bar-widget) width height]
  (let [[sw _] (outer-size (:start bar))
        [ew _] (outer-size (:end bar))
        sw (min width sw)
        ew (min (- width sw) ew)]
    (allocate-in-cell (:start bar) 0 0 sw height)
    (allocate-in-cell (:end bar) (- width ew) 0 ew height)))

(defgeneric backend-tab-layout [backend pane width height]
  "Place the tabs of a pane of width by height, once its tab bar has its allocation.")

(defmethod backend-tab-layout [(b backend) pane width height]
  nil)

(defgeneric backend-tab-page-area [backend pane width height]
  "The [width height] of the area the pane's pages get in a pane of width by height.")

(defmethod backend-tab-page-area [(b backend) pane width height]
  [width (max 0 (- height (last (outer-size (:tab-bar pane)))))])

(defmethod measure [(pane tabbed-pane-widget)]
  (let [[bw bh] (outer-size (:tab-bar pane))
        sizes (map outer-size (:children pane))]
    [(max bw (reduce max 0 (map first sizes))) (+ bh (reduce max 0 (map second sizes)))]))

(defmethod arrange [(pane tabbed-pane-widget) width height]
  (let [bar (:tab-bar pane)
        [_ bh] (outer-size bar)
        bh (min height bh)]
    (allocate bar 0 (if (= :bottom (:tab-position pane)) (- height bh) 0) width bh)
    (let [b (current-backend)] (in-ui (fn [] (backend-tab-layout b pane width height))))
    (let [[pw ph] (let [b (current-backend)] (in-ui (fn [] (backend-tab-page-area b pane width height))))]
      (doseq [p (:children pane)]
        (allocate-in-cell p 0 0 pw ph)))))

;;; ------------------------------------------------------------------------------------
;;; Canvases and drawing

(defgeneric backend-redraw [backend canvas rect]
  "Draw the canvas again soon (emitting :draw): all of it, or the part [x y width height]
that rect gives.")

(defgeneric backend-text-size [backend s font]
  "The [width height] of the string s drawn in font (a font map or nil).")

(defclass canvas-widget [widget]
  "A widget you draw yourself, which gets the mouse and the keyboard: handle :draw to draw
with the event's :context, and call redraw! when what it shows changes. Subclass it, with
methods on handle-event, to make a custom widget. Coordinates start at its top left."
  (focusable :cell :atom :init true :doc "Whether a click gives it the keyboard focus.")
  (background :cell :atom :init nil :doc "A color to fill it with before :draw, or nil.")
  (hexpand :cell :atom :init true)
  (vexpand :cell :atom :init true))

(declare-widget! canvas-widget
                 {:properties [:focusable :background]
                  :signals {:draw draw-event :resize resize-event :text-input text-input-event
                            :context-request mouse-event
                            :mouse-down mouse-event :mouse-up mouse-event
                            :mouse-move mouse-event :mouse-drag mouse-event
                            :mouse-enter mouse-event :mouse-leave mouse-event
                            :scroll scroll-event :key-down key-event :key-up key-event}})

(defn canvas
  "A canvas: (canvas {:width 200 :height 100 :on-draw (fn [e] (draw (:context e)))})."
  ([] (canvas {}))
  ([opts] (build canvas-widget opts nil)))

(defmethod measure [(c canvas-widget)]
  [100 100])

(defn redraw!
  "Draw the canvas again soon, all of it or the rectangle given. Returns the canvas."
  ([c] (redraw! c nil))
  ([c x y width height] (redraw! c [x y width height]))
  ([c rect]
   (let [b (current-backend)]
     (in-ui (fn [] (backend-redraw b c rect))))
   c))

(defn text-extent
  "The [width height] the string s takes drawn in font (a font designator, nil for the
default font), outside drawing."
  ([s] (text-extent s nil))
  ([s font]
   (let [b (current-backend)
         f (ensure-font font)]
     (in-ui (fn [] (backend-text-size b s f))))))

(def ^:private widget-color)

(defclass graphics-context []
  "What a canvas draws with during :draw. It keeps a fill color, a stroke color, a line
width and a font, which with-saved-state saves and restores, with the transformation and
clipping. Backends subclass it and implement the gc- generic functions."
  (fill-color :cell :atom :init (rgb 0 0 0))
  (stroke-color :cell :atom :init (rgb 0 0 0))
  (line-width :cell :atom :init 1.0)
  (font :cell :atom :init nil)
  (width :init 0 :doc "The canvas's width.")
  (height :init 0 :doc "The canvas's height.")
  (saved :cell :atom :init ())
  (widget :init nil :doc "The canvas it draws, whose palette resolves semantic colors."))

(defgeneric gc-set-fill-color [gc color]
  "Fill shapes with color (a color or a system color keyword).")
(defgeneric gc-set-stroke-color [gc color] "Draw lines with color.")
(defgeneric gc-set-line-width [gc width] "Draw lines width pixels wide.")
(defgeneric gc-set-line-style [gc cap join dash]
  "End lines with cap (:butt, :round or :square), join them with join (:miter, :round or
:bevel), and dash them with dash, a vector of lengths, or nil for solid lines.")
(defgeneric gc-save [gc] "Save the colors, line, transformation and clipping.")
(defgeneric gc-restore [gc] "Restore what the matching gc-save saved.")
(defgeneric gc-translate [gc dx dy] "Move the origin by dx, dy.")
(defgeneric gc-scale [gc sx sy] "Scale the coordinates.")
(defgeneric gc-rotate [gc radians] "Rotate the coordinates clockwise by radians.")
(defgeneric gc-clip-rectangle [gc x y width height] "Limit drawing to the rectangle.")
(defgeneric gc-rectangle [gc x y width height mode] "Draw a rectangle: mode is :fill or :stroke.")
(defgeneric gc-ellipse [gc x y width height mode] "Draw the ellipse in the rectangle.")
(defgeneric gc-begin-path [gc] "Start a new path.")
(defgeneric gc-move-to [gc x y] "Start a new part of the path at x, y.")
(defgeneric gc-line-to [gc x y] "Add a line to x, y.")
(defgeneric gc-curve-to [gc x1 y1 x2 y2 x y]
  "Add a cubic Bézier curve to x, y with control points x1, y1 and x2, y2.")
(defgeneric gc-arc [gc cx cy radius start end]
  "Add an arc of the circle at cx, cy from angle start to end, in radians, clockwise on
the screen.")
(defgeneric gc-close-path [gc] "Close the path's current part with a line to its start.")
(defgeneric gc-draw-path [gc mode]
  "Draw the path and forget it: :fill, :stroke or :fill-and-stroke.")
(defgeneric gc-text [gc s x y font color] "Draw s with its top left at x, y in font and color.")
(defgeneric gc-text-size [gc s font] "The [width height] of s in font.")
(defgeneric gc-image [gc image x y width height] "Draw the image scaled into the rectangle.")

(defn- d [x] (f64 x))

(defn save-state!
  "Save the context's colors, line width, font, transformation and clipping, for
restore-state!. with-saved-state is usually clearer."
  [gc]
  (update-slot! gc :saved conj [(:fill-color gc) (:stroke-color gc) (:line-width gc) (:font gc)])
  (gc-save gc))

(defn restore-state!
  "Put back what the last save-state! saved."
  [gc]
  (let [[f s w font] (first (:saved gc))]
    (update-slot! gc :saved rest)
    (gc-restore gc)
    (set-slot! gc :fill-color f)
    (set-slot! gc :stroke-color s)
    (set-slot! gc :line-width w)
    (set-slot! gc :font font)
    nil))

(defmacro with-saved-state
  "Run body, then put the context's colors, line, font, transformation and clipping back
as they were: (with-saved-state [gc] (translate! gc 10 10) ...)."
  [[gc] & body]
  `(let [g# ~gc]
     (save-state! g#)
     (try (do ~@body)
          (finally (restore-state! g#)))))

(defn- context-color
  "A color designator as the context draws it: a semantic color through its canvas's
palette, if it has one."
  [gc color]
  (let [c (ensure-color color)]
    (if (and (keyword? c) (:widget gc)) (widget-color (:widget gc) c) c)))

(defn set-fill-color!
  "Fill shapes with color, a color designator."
  [gc color]
  (let [c (context-color gc color)]
    (set-slot! gc :fill-color c)
    (gc-set-fill-color gc c)
    c))

(defn set-stroke-color!
  "Draw lines with color, a color designator."
  [gc color]
  (let [c (context-color gc color)]
    (set-slot! gc :stroke-color c)
    (gc-set-stroke-color gc c)
    c))

(defn set-color!
  "Fill shapes and draw lines with color."
  [gc color]
  (set-fill-color! gc color)
  (set-stroke-color! gc color))

(defn set-line-width!
  "Draw lines width pixels wide."
  [gc width]
  (set-slot! gc :line-width (d width))
  (gc-set-line-width gc (d width))
  width)

(defn set-font!
  "Draw text in font, a font designator."
  [gc font]
  (set-slot! gc :font (ensure-font font)))

(defn set-line-style!
  "How lines end (:cap, :butt, :round or :square), join (:join, :miter, :round or :bevel)
and are dashed (:dash, a vector of lengths, or nil)."
  [gc {:keys [cap join dash]}]
  (gc-set-line-style gc (or cap :butt) (or join :miter) dash))

(defn- with-style
  "Call f with the :color and :line-width of opts in effect, if any."
  [gc opts f]
  (let [{:keys [color line-width]} opts]
    (if (or color line-width)
      (with-saved-state [gc]
        (when color (set-color! gc color))
        (when line-width (set-line-width! gc line-width))
        (f))
      (f))))

(defn- rounded-rectangle-path [gc x y width height radius]
  (let [r (min radius (/ width 2) (/ height 2))
        q (/ math/pi 2)]
    (gc-begin-path gc)
    (gc-move-to gc (d (+ x r)) (d y))
    (gc-line-to gc (d (- (+ x width) r)) (d y))
    (gc-arc gc (d (- (+ x width) r)) (d (+ y r)) (d r) (d (- q)) 0.0)
    (gc-line-to gc (d (+ x width)) (d (- (+ y height) r)))
    (gc-arc gc (d (- (+ x width) r)) (d (- (+ y height) r)) (d r) 0.0 (d q))
    (gc-line-to gc (d (+ x r)) (d (+ y height)))
    (gc-arc gc (d (+ x r)) (d (- (+ y height) r)) (d r) (d q) (d math/pi))
    (gc-line-to gc (d x) (d (+ y r)))
    (gc-arc gc (d (+ x r)) (d (+ y r)) (d r) (d math/pi) (d (* 3 q)))
    (gc-close-path gc)))

(defn- rectangle [gc x y width height opts mode]
  (with-style gc opts
    (fn []
      (if (and (:radius opts) (pos? (:radius opts)))
        (do (rounded-rectangle-path gc x y width height (:radius opts))
            (gc-draw-path gc mode))
        (gc-rectangle gc (d x) (d y) (d width) (d height) mode)))))

(defn fill-rectangle!
  "Fill the rectangle, with corners rounded to :radius if given, in :color or the fill
color."
  ([gc x y width height] (fill-rectangle! gc x y width height {}))
  ([gc x y width height opts] (rectangle gc x y width height (dissoc opts :line-width) :fill)))

(defn stroke-rectangle!
  "Outline the rectangle, with corners rounded to :radius if given, in :color and
:line-width or the context's."
  ([gc x y width height] (stroke-rectangle! gc x y width height {}))
  ([gc x y width height opts] (rectangle gc x y width height opts :stroke)))

(defn fill-ellipse!
  "Fill the ellipse inside the rectangle, in :color or the fill color."
  ([gc x y width height] (fill-ellipse! gc x y width height {}))
  ([gc x y width height opts]
   (with-style gc (dissoc opts :line-width)
     (fn [] (gc-ellipse gc (d x) (d y) (d width) (d height) :fill)))))

(defn stroke-ellipse!
  "Outline the ellipse inside the rectangle, in :color and :line-width or the context's."
  ([gc x y width height] (stroke-ellipse! gc x y width height {}))
  ([gc x y width height opts]
   (with-style gc opts (fn [] (gc-ellipse gc (d x) (d y) (d width) (d height) :stroke)))))

(defn fill-circle!
  "Fill the circle of radius centered on cx, cy."
  ([gc cx cy radius] (fill-circle! gc cx cy radius {}))
  ([gc cx cy radius opts]
   (fill-ellipse! gc (- cx radius) (- cy radius) (* 2 radius) (* 2 radius) opts)))

(defn stroke-circle!
  "Outline the circle of radius centered on cx, cy."
  ([gc cx cy radius] (stroke-circle! gc cx cy radius {}))
  ([gc cx cy radius opts]
   (stroke-ellipse! gc (- cx radius) (- cy radius) (* 2 radius) (* 2 radius) opts)))

(defn draw-line!
  "Draw a line from x1, y1 to x2, y2 in :color and :line-width or the context's."
  ([gc x1 y1 x2 y2] (draw-line! gc x1 y1 x2 y2 {}))
  ([gc x1 y1 x2 y2 opts]
   (with-style gc opts
     (fn []
       (gc-begin-path gc)
       (gc-move-to gc (d x1) (d y1))
       (gc-line-to gc (d x2) (d y2))
       (gc-draw-path gc :stroke)))))

(defn- point-pairs
  "points as a seq of [x y]: from [[x y] ...] or a flat [x1 y1 x2 y2 ...]."
  [points]
  (if (number? (first points)) (partition 2 points) points))

(defn- polygon-path [gc points closed]
  (let [ps (point-pairs points)]
    (gc-begin-path gc)
    (when (seq ps)
      (let [[x y] (first ps)] (gc-move-to gc (d x) (d y)))
      (doseq [[x y] (rest ps)] (gc-line-to gc (d x) (d y)))
      (when closed (gc-close-path gc)))))

(defn draw-polyline!
  "Draw lines through points ([[x y] ...] or [x1 y1 x2 y2 ...]), back to the first if
:closed, in :color and :line-width or the context's."
  ([gc points] (draw-polyline! gc points {}))
  ([gc points opts]
   (with-style gc opts
     (fn [] (polygon-path gc points (:closed opts)) (gc-draw-path gc :stroke)))))

(defn fill-polygon!
  "Fill the polygon with corners points, in :color or the fill color."
  ([gc points] (fill-polygon! gc points {}))
  ([gc points opts]
   (with-style gc (dissoc opts :line-width)
     (fn [] (polygon-path gc points true) (gc-draw-path gc :fill)))))

(defn begin-path! "Start a new path." [gc] (gc-begin-path gc))
(defn move-to! "Start a new part of the path at x, y." [gc x y] (gc-move-to gc (d x) (d y)))
(defn line-to! "Add a line to x, y to the path." [gc x y] (gc-line-to gc (d x) (d y)))

(defn curve-to!
  "Add a Bézier curve to x, y with control points x1, y1 and x2, y2 to the path."
  [gc x1 y1 x2 y2 x y]
  (gc-curve-to gc (d x1) (d y1) (d x2) (d y2) (d x) (d y)))

(defn arc!
  "Add an arc of the circle at cx, cy from start to end, angles in radians (0 pointing
right, clockwise on the screen), to the path."
  [gc cx cy radius start end]
  (gc-arc gc (d cx) (d cy) (d radius) (d start) (d end)))

(defn close-path! "Close the path's current part." [gc] (gc-close-path gc))

(defn fill-path!
  "Fill the path, in :color or the fill color, and start a new one."
  ([gc] (fill-path! gc {}))
  ([gc opts] (with-style gc (dissoc opts :line-width) (fn [] (gc-draw-path gc :fill)))))

(defn stroke-path!
  "Draw the path's lines, in :color and :line-width or the context's, and start a new one."
  ([gc] (stroke-path! gc {}))
  ([gc opts] (with-style gc opts (fn [] (gc-draw-path gc :stroke)))))

(defn translate! "Move the origin by dx, dy." [gc dx dy] (gc-translate gc (d dx) (d dy)))

(defn scale!
  "Scale the coordinates by s, or by sx and sy."
  ([gc s] (scale! gc s s))
  ([gc sx sy] (gc-scale gc (d sx) (d sy))))

(defn rotate!
  "Rotate the coordinates clockwise by radians."
  [gc radians]
  (gc-rotate gc (d radians)))

(defn clip-rectangle!
  "Limit drawing to the rectangle, until the state is restored."
  [gc x y width height]
  (gc-clip-rectangle gc (d x) (d y) (d width) (d height)))

(defn paint!
  "Fill the whole canvas with color, or the fill color."
  ([gc] (paint! gc nil))
  ([gc color] (fill-rectangle! gc 0 0 (:width gc) (:height gc) {:color color})))

(defn text-size
  "The [width height] of the string s drawn in :font (a font designator) or the context's
font."
  ([gc s] (text-size gc s {}))
  ([gc s opts] (gc-text-size gc s (or (ensure-font (:font opts)) (:font gc)))))

(defn draw-text!
  "Draw the string s at x, y in :font and :color (the context's font and fill color if
not given). :align (:left, :center or :right) and :valign (:top, :center or :bottom) say
which point of the text is at x, y."
  ([gc s x y] (draw-text! gc s x y {}))
  ([gc s x y opts]
   (let [font (or (ensure-font (:font opts)) (:font gc))
         color (or (context-color gc (:color opts)) (:fill-color gc))
         align (or (:align opts) :left)
         valign (or (:valign opts) :top)
         [w h] (if (and (= align :left) (= valign :top)) [0 0] (gc-text-size gc s font))]
     (gc-text gc s
              (d (case align :left x :center (- x (/ w 2)) :right (- x w)))
              (d (case valign :top y :center (- y (/ h 2)) :bottom (- y h)))
              font color))))

(defn draw-image!
  "Draw the image with its top left at x, y, scaled to :width and :height if given."
  ([gc image x y] (draw-image! gc image x y {}))
  ([gc image x y opts]
   (gc-image gc image (d x) (d y) (d (or (:width opts) (:width image)))
             (d (or (:height opts) (:height image))))))

;;; ------------------------------------------------------------------------------------
;;; Dialogs

(defgeneric backend-message-box [backend parent message detail type labels]
  "Show the platform's alert with the buttons labels (the default first) and wait for
the user to click one. Returns its index, or nil if the alert was dismissed.")

(defgeneric backend-prompt-text [backend parent message detail default ok cancel]
  "Ask for a line of text and wait. Returns it, or nil if the user cancelled.")

(defgeneric backend-choose-file [backend parent opts]
  "Show the platform's file chooser and wait. opts are choose-file's, with :mode filled
in. Returns a vector of paths, or nil if the user cancelled.")

(defgeneric backend-show-about [backend info]
  "Show the platform's About box: info has :name, :version, :copyright, :comments,
:website and :icon.")

(def ^:private response-labels
  {:ok "OK" :cancel "Cancel" :yes "Yes" :no "No" :save "Save" :discard "Don't Save"
   :close "Close"})

(defn- dialog-buttons
  "buttons as a vector of [label response]."
  [buttons]
  (mapv (fn [b] (if (vector? b) b [(get response-labels b (string/capitalize (name b))) b]))
        (case buttons
          :ok [:ok]
          :ok-cancel [:ok :cancel]
          :yes-no [:yes :no]
          :yes-no-cancel [:yes :no :cancel]
          :save-discard-cancel [:save :discard :cancel]
          buttons)))

(defn message-box
  "Show message in the platform's alert, wait for the user to click a button, and return
the button's response. opts: :detail, smaller text under the message; :type, :info (the
default), :warning, :error or :question; :buttons, :ok (the default), :ok-cancel, :yes-no,
:yes-no-cancel, :save-discard-cancel, or a vector of responses (keywords) and [label
response] pairs, the default first; :parent, the window it is for."
  ([message] (message-box message {}))
  ([message opts]
   (let [type (or (:type opts) :info)
         specs (dialog-buttons (or (:buttons opts) :ok))
         b (current-backend)]
     (when-not (contains? #{:info :warning :error :question} type)
       (error "a message box's :type is :info, :warning, :error or :question, not"
              (pr-str type)))
     (let [i (in-ui (fn [] (backend-message-box b (:parent opts) message (:detail opts) type
                                                (mapv first specs))))]
       (second (get specs (or i 0)))))))

(defn confirm
  "Ask message with two buttons, :yes (\"OK\") and :no (\"Cancel\") labels, and return
true if the user clicked yes. opts: :detail, :yes, :no, :type (:question) and :parent."
  ([message] (confirm message {}))
  ([message opts]
   (= :yes (message-box message {:detail (:detail opts) :parent (:parent opts)
                                 :type (or (:type opts) :question)
                                 :buttons [[(or (:yes opts) "OK") :yes]
                                           [(or (:no opts) "Cancel") :no]]}))))

(defn prompt-text
  "Ask for a line of text with message, starting with :default (\"\"). Returns the text,
or nil if the user cancelled. opts: :detail, :default, :ok, :cancel and :parent."
  ([message] (prompt-text message {}))
  ([message opts]
   (let [b (current-backend)]
     (in-ui (fn [] (backend-prompt-text b (:parent opts) message (:detail opts)
                                        (or (:default opts) "") (or (:ok opts) "OK")
                                        (or (:cancel opts) "Cancel")))))))

(defn choose-file
  "Show the platform's file chooser. :mode is :open (the default) to pick existing files,
:save to name a file to write, or :directory to pick a folder; :filters limits the files
offered, a vector of [description extension ...] such as [[\"Skein\" \"skn\"]];
:multiple lets :open pick several; :directory is where to start, :name the suggested name
for :save, :title the chooser's title and :parent its window. Returns a path, a vector of
paths with :multiple, or nil if the user cancelled."
  ([] (choose-file {}))
  ([opts]
   (let [mode (or (:mode opts) :open)
         b (current-backend)]
     (when-not (contains? #{:open :save :directory} mode)
       (error "a file chooser's :mode is :open, :save or :directory, not" (pr-str mode)))
     (when (and (:parent opts) (:destroyed (:parent opts)))
       (error "the file chooser's parent window was destroyed"))
     (let [paths (in-ui (fn [] (backend-choose-file b (:parent opts) (assoc opts :mode mode))))]
       (when (seq paths)
         (if (:multiple opts) (vec paths) (first paths)))))))

(defn choose-directory
  "Show the folder chooser. Returns a path, or nil. opts: :title, :directory, :parent."
  ([] (choose-directory {}))
  ([opts] (choose-file (assoc opts :mode :directory :multiple false))))

(defn show-about
  "Show the platform's About box. opts: :name, :version, :copyright, :comments, :website
and :icon (an image)."
  ([] (show-about {}))
  ([opts]
   (let [b (current-backend)]
     (in-ui (fn [] (backend-show-about b opts))))
   nil))

;;; ------------------------------------------------------------------------------------
;;; Menus and shortcuts

(defgeneric backend-popup-menu [backend menu widget x y]
  "Show the menu at x, y in the widget, and return when the user chose an item or
dismissed it.")

(defgeneric backend-perform-role [backend role]
  "Do what a menu item with role (:undo, :copy, :minimize, ...) does natively, to the
focused control or the active window.")

(defgeneric backend-active-window [backend]
  "The window that has the keyboard, if it is one of skein-ui's, or nil.")

(defgeneric backend-shortcut-label [backend shortcut]
  "How the platform shows the shortcut string, such as \"⌘S\" or \"Ctrl+S\".")

(defn active-window
  "The window that has the keyboard, or nil."
  []
  (let [b (current-backend)]
    (in-ui (fn [] (backend-active-window b)))))

(defclass menu-object [ui-object]
  "The superclass of menu bars, menus, menu items and separators. They aren't widgets:
they take no part in layout.")

(defclass menu-bar-widget [menu-object]
  "The menus of a window, left to right: give it to the window's :menu-bar. On macOS it
shows at the top of the screen, after the application menu.")

(defclass menu-widget [menu-object]
  "A menu of items: in a menu bar, in another menu as a submenu, or shown with
popup-menu!. It emits :opening (an event) when it is about to open, a chance to update
its items."
  (title :cell :atom :init "" :doc "The menu's title, in the menu bar or its parent menu."))

(declare-widget! menu-widget {:properties [:title] :signals {:opening event}})

(defclass menu-item-widget [menu-object]
  "An item of a menu. It emits :activate (an action-event) when the user chooses it."
  (label :cell :atom :init "" :doc "Its text; by default its :role's.")
  (shortcut :cell :atom :init nil
            :doc "A shortcut such as \"Primary+S\" (parse-shortcut), or nil; by default
its :role's.")
  (enabled :cell :atom :init true :doc "Whether the user can choose it.")
  (enabled-fn :cell :atom :init nil
              :doc "A function of the item, asked when its menu opens and before it runs:
false disables it.")
  (role :init nil
        :doc "A standard item: :quit, :about, :preferences, :close-window, :undo, :redo,
:cut, :copy, :paste, :delete, :select-all, :minimize, :zoom or :fullscreen. It gets the
platform's label, shortcut and place (on macOS :quit, :about and :preferences go to the
application menu), and does its usual job if it has no :activate handler."))

(declare-widget! menu-item-widget {:properties [:label :shortcut :enabled]
                                   :signals {:activate action-event}})

(defclass check-menu-item-widget [menu-item-widget]
  "A menu item with a check mark that it turns on and off when chosen; in its :activate
handler, :checked is already the new state."
  (checked :cell :atom :init false)
  (checked-fn :cell :atom :init nil
              :doc "A function of the item, asked when its menu opens, giving its :checked."))

(declare-widget! check-menu-item-widget {:properties [:checked]})

(defclass menu-separator-widget [menu-object]
  "A line between groups of items in a menu.")

(def menu-roles
  "Each menu item role's standard label and shortcut."
  {:quit ["Quit" "Primary+Q"] :about ["About" nil] :preferences ["Settings…" "Primary+,"]
   :close-window ["Close" "Primary+W"] :undo ["Undo" "Primary+Z"]
   :redo ["Redo" "Primary+Shift+Z"] :cut ["Cut" "Primary+X"] :copy ["Copy" "Primary+C"]
   :paste ["Paste" "Primary+V"] :delete ["Delete" nil] :select-all ["Select All" "Primary+A"]
   :minimize ["Minimize" "Primary+M"] :zoom ["Zoom" nil]
   :fullscreen ["Enter Full Screen" "Primary+Control+F"]})

(defmethod initialize :after [(item menu-item-widget)]
  (when-let [role (:role item)]
    (let [[label shortcut] (or (get menu-roles role)
                               (error "unknown menu item role" (pr-str role)))]
      (when (= "" (:label item)) (set-slot! item :label label))
      (when (nil? (:shortcut item)) (set-slot! item :shortcut shortcut)))))

(defn- check-menu-parent [parent child]
  (when (:destroyed parent) (error "can't add to a destroyed menu"))
  (when (:destroyed child) (error "can't add a destroyed menu object"))
  (when (some (fn [p] (identical? p child)) (take-while some? (iterate :parent parent)))
    (error "a menu can't hold itself or a menu it is in")))

(defmethod add! :before [(bar menu-bar-widget) child]
  (when-not (instance? menu-widget child)
    (error "a menu bar holds menus, not" (pr-str (class-name (class-of child)))))
  (check-menu-parent bar child))

(defmethod add! :before [(m menu-widget) child]
  (when-not (or (instance? menu-widget child) (instance? menu-item-widget child)
                (instance? menu-separator-widget child))
    (error "a menu holds menu items, submenus and separators, not"
           (pr-str (class-name (class-of child)))))
  (check-menu-parent m child))

(defn menu-bar
  "A menu bar: (menu-bar {} (menu {:title \"File\"} ...) ...)."
  [opts & menus]
  (build menu-bar-widget opts menus))

(defn menu
  "A menu: (menu {:title \"File\"} (menu-item {:label \"Open…\" :shortcut \"Primary+O\"
:on-activate f}) (menu-separator) (menu-item {:role :quit}))."
  [opts & items]
  (build menu-widget opts items))

(defn menu-item
  "A menu item: (menu-item {:label \"Save\" :shortcut \"Primary+S\" :on-activate f})."
  [opts]
  (build menu-item-widget opts nil))

(defn check-menu-item
  "A check menu item: (check-menu-item {:label \"Wrap Lines\" :checked true :on-activate f})."
  [opts]
  (build check-menu-item-widget opts nil))

(defn menu-separator
  "A separator between groups of menu items."
  ([] (menu-separator {}))
  ([opts] (build menu-separator-widget opts nil)))

(defn validate-menu-item!
  "Work out the item's check mark (:checked-fn) and whether the user can choose it
(:enabled and :enabled-fn), and show that natively. True if it can be chosen."
  [item]
  (when-not (:destroyed item)
    (when (and (instance? check-menu-item-widget item) (:checked-fn item))
      (set-slot! item :checked (boolean ((:checked-fn item) item))))
    (let [ok (boolean (and (:enabled item)
                           (or (nil? (:enabled-fn item)) ((:enabled-fn item) item))))
          b (current-backend)]
      (in-ui (fn [] (backend-set-property b item :enabled ok)))
      ok)))

(defn map-menu-items
  "Call (f item menus) for each menu item in root (a menu bar or menu), where menus are
the menus it is in, outermost first. Separators are skipped. Returns root."
  [f root]
  (let [walk (fn walk [o path]
               (cond (instance? menu-widget o)
                     (let [path (conj path o)] (doseq [c (:children o)] (walk c path)))
                     (instance? menu-bar-widget o) (doseq [c (:children o)] (walk c path))
                     (instance? menu-item-widget o) (when-not (:destroyed o) (f o path))))]
    (walk root [])
    root))

(defn refresh-menus!
  "Validate every item in root, a menu bar or menu. Returns root."
  [root]
  (map-menu-items (fn [item _] (validate-menu-item! item)) root))

(defgeneric perform-role [role item]
  "What a menu item with role does when it has no :activate handler: by default the
platform's own action.")

(defmethod perform-role [role item]
  (let [b (current-backend)]
    (in-ui (fn [] (backend-perform-role b role)))))

(defmethod perform-role [(role (= :quit)) item]
  (quit!))

(defmethod perform-role [(role (= :about)) item]
  (show-about))

(defmethod perform-role [(role (= :close-window)) item]
  (when-let [w (active-window)] (close! w)))

(defn activate-menu-item!
  "Choose the item as the user would: if it can be chosen, a check item toggles, then it
emits :activate, or does its role's job if it has no handler. True if it ran."
  [item]
  (boolean
   (when (validate-menu-item! item)
     (when (instance? check-menu-item-widget item) (update-slot! item :checked not))
     (if (and (empty? (get (:handlers item) :activate)) (:role item))
       (perform-role (:role item) item)
       (emit! item (event-for item :activate)))
     true)))

(defn menu-opening!
  "Backends call this when the menu is about to open: it emits :opening, then validates
the items."
  [m]
  (emit! m (event-for m :opening))
  (refresh-menus! m))

(defn popup-menu!
  "Show the menu at x, y in the widget, and return when the user chose an item or
dismissed it."
  ([m widget] (popup-menu! m widget 0 0))
  ([m widget x y]
   (let [b (current-backend)]
     (in-ui (fn [] (backend-popup-menu b m widget x y))))))

(defn show-tab-menu
  "Show a menu of the tabbed pane's pages, checking the one shown, at the end of its tab
bar; choosing one shows it. Backends use it for the button that lists all the tabs."
  [pane]
  (let [bar (:tab-bar pane)
        m (build menu-widget {} nil)]
    (doseq [[i page] (map-indexed vector (:children pane))]
      (add! m (build check-menu-item-widget
                     {:label (tab-title pane page) :checked (= i (:selected-index pane))
                      :on-activate (fn [_] (when (index-of (:children pane) page)
                                             (select-page! pane page)))}
                     nil)))
    (try
      (let [[_ _ bw bh] (or (:allocation bar) [0 0 0 0])]
        (popup-menu! m bar (max 0 (- bw 24)) bh))
      (finally (destroy! m)))))

(def ^:private modifier-names
  {"primary" :primary "ctrl" :control "control" :control "cmd" :command "command" :command
   "super" :command "meta" :command "alt" :alt "option" :alt "opt" :alt "shift" :shift})

(def ^:private key-aliases
  {:enter :return :esc :escape :del :delete :pageup :page-up :pagedown :page-down})

(defn parse-shortcut
  "The shortcut string s, such as \"Primary+Shift+S\", as [key modifiers]: key is a
lower-case character or a keyword such as :f5, :return or :left, and modifiers a set of
:shift, :control, :alt and :command. Primary is :command on macOS and :control elsewhere.
Parts are joined with + or -, and names aren't case-sensitive."
  [s]
  (let [[parts cur] (reduce (fn [[parts cur] ch]
                              (if (and (or (= ch \+) (= ch \-)) (seq cur))
                                [(conj parts cur) ""]
                                [parts (str cur ch)]))
                            [[] ""] s)
        parts (conj parts cur)
        key-name (peek parts)
        mods (set (map (fn [p]
                         (let [m (get modifier-names (string/lower-case p))]
                           (cond (nil? m) (error "unknown modifier" (pr-str p) "in the shortcut"
                                                 (pr-str s))
                                 (= m :primary) (primary-modifier)
                                 :else m)))
                       (pop parts)))
        key (if (= 1 (count key-name))
              (first (string/lower-case key-name))
              (let [k (keyword (string/lower-case key-name))] (get key-aliases k k)))]
    [key mods]))

(defn portable-shortcut-label
  "The shortcut string s as \"Ctrl+Shift+S\": how backends without their own symbols
show it."
  [s]
  (let [[key mods] (parse-shortcut s)
        names (keep (fn [[m label]] (when (contains? mods m) label))
                    [[:control "Ctrl"] [:alt "Alt"] [:shift "Shift"] [:command "Cmd"]])
        key-label (if (char? key)
                    (string/upper-case (str key))
                    (get {:return "Enter" :escape "Esc" :page-up "PgUp" :page-down "PgDown"}
                         key (string/capitalize (name key))))]
    (string/join "+" (concat names [key-label]))))

(defmethod backend-shortcut-label [(b backend) shortcut]
  (portable-shortcut-label shortcut))

(defn shortcut-label
  "How the platform shows the shortcut (a string or a menu item's), or \"\" for none."
  [shortcut]
  (let [s (if (instance? menu-item-widget shortcut) (:shortcut shortcut) shortcut)
        b (current-backend)]
    (if s (in-ui (fn [] (backend-shortcut-label b s))) "")))

(defn shortcut-matches?
  "True if the key event is the shortcut string s."
  [s e]
  (let [[key mods] (parse-shortcut s)
        ekey (:key e)]
    (and (= mods (set (:modifiers e)))
         (if (and (char? key) (char? ekey))
           (= (string/lower-case (str key)) (string/lower-case (str ekey)))
           (= key ekey)))))

(defn menu-item-for-key
  "The menu item in root (a menu bar or menu) whose shortcut the key event is, or nil."
  [root e]
  (let [found (atom nil)]
    (map-menu-items (fn [item _]
                      (when (and (nil? @found) (:shortcut item)
                                 (shortcut-matches? (:shortcut item) e))
                        (reset! found item)))
                    root)
    @found))

(defn add-shortcut!
  "Make the shortcut string s call f (of no arguments) in the window, before the focused
widget gets the key; enabled-fn, if given, is asked first. It replaces a binding of the
same keys. Returns the binding, which remove-shortcut! takes."
  ([w s f] (add-shortcut! w s f nil))
  ([w s f enabled-fn]
   (when (:destroyed w) (error "can't add a shortcut to a destroyed window"))
   (let [[key mods] (parse-shortcut s)
         binding {:shortcut s :key key :modifiers mods :fn f :enabled-fn enabled-fn}]
     (update-slot! w :shortcuts
                   (fn [bs] (conj (filterv (fn [b] (not (and (= key (:key b))
                                                             (= mods (:modifiers b)))))
                                           bs)
                                  binding)))
     binding)))

(defn remove-shortcut!
  "Remove the binding (from add-shortcut!), or the shortcut string's, from the window.
True if there was one."
  [w binding]
  (let [[key mods] (if (string? binding) (parse-shortcut binding)
                       [(:key binding) (:modifiers binding)])
        old (:shortcuts w)
        new (filterv (fn [b] (not (and (= key (:key b)) (= mods (:modifiers b))))) old)]
    (set-slot! w :shortcuts new)
    (not= (count old) (count new))))

(defn dispatch-shortcut!
  "Backends call this with a key-down event in the window before its focused widget gets
it: if it is one of the window's shortcuts, it consumes the event, runs the binding and
returns true."
  [w e]
  (when (and (not (:destroyed w)) (not (consumed? e)))
    (when-let [b (first (filter (fn [b] (shortcut-matches? (:shortcut b) e)) (:shortcuts w)))]
      (when (or (nil? (:enabled-fn b)) ((:enabled-fn b)))
        (consume! e)
        ((:fn b))
        true))))

;;; ------------------------------------------------------------------------------------
;;; Surfaces: popovers and completion popups, shown beside a widget outside any window's
;;; layout. A popover is the platform's (NSPopover, GtkPopover) and takes the keyboard
;;; while it is open; a completion popup never does: the widget it is shown for keeps the
;;; focus and hands it the keys it needs.

(def ^:private open-surfaces
  "The surfaces that are shown, the most recently shown first."
  (atom []))

(defclass surface-widget [bin-widget]
  "A bin shown beside a widget, outside any window's layout: the superclass of popovers and
completion popups. Its natural size is its content's plus :padding, and at least its :width
and :height. close-surface! closes it; it can be shown again. It emits :closed (a
value-event) with why: :accepted when a completion was accepted, :cancelled for Escape,
:dismissed when the user clicked or went elsewhere, :closed when the program closed it."
  (size :cell :atom :init nil :doc "Its content area's [width height], from its last layout.")
  (padding :cell :atom :init 0
           :doc "Space between its edge and its content: as a margin, a number, [vertical
horizontal] or [top right bottom left].")
  (owner :cell :atom :init nil :doc "The widget it is shown for, or nil when not shown.")
  (anchor :cell :atom :init nil
          :doc "Where in its owner it shows: [x y width height], a character position in a
text view, or :caret.")
  (shown :cell :atom :init false :doc "True while it is shown.")
  (hooks :cell :atom :init [] :doc "[object signal id] of the handlers it connected while shown."))

(declare-widget! surface-widget {:properties [:size] :layout [:padding]
                                 :signals {:closed value-event}})

(defmethod layout-root? [(s surface-widget)]
  true)

(defn- surface-natural-size [s]
  (let [[top right bottom left] (sides (:padding s))
        [w h] (if-let [c (content s)] (outer-size c) [0 0])]
    [(max (+ w left right) (or (:width s) 0)) (max (+ h top bottom) (or (:height s) 0))]))

(defmethod update-layout! [(s surface-widget)]
  (let [[w h] (surface-natural-size s)]
    (when (not= [w h] (:size s)) (set-slot! s :size [w h]))
    (when-let [c (content s)]
      (let [[top right bottom left] (sides (:padding s))]
        (allocate-in-cell c left top (max 0 (- w left right)) (max 0 (- h top bottom)))))))

(defn holders
  "w and what holds it, nearest first: its containers, and for a popover or completion
popup the widget it is shown for and that widget's. Appearances and palettes come down
this chain."
  [w]
  (loop [o w out []]
    (if (nil? o)
      out
      (recur (or (:parent o) (when (instance? surface-widget o) (:owner o))) (conj out o)))))

(defn window-of
  "The window w is in, through any popovers, or nil."
  [w]
  (first (filter (fn [o] (instance? window-widget o)) (holders w))))

(defn- widget-rectangle [w]
  (let [[_ _ width height] (or (:allocation w) [0 0 0 0])] [0 0 width height]))

(defn- hook!
  "Connect f to object's signal until the surface closes (first, before the handlers
already connected, with first)."
  [s object signal f first]
  (when (and object (contains? (signals object) signal))
    (let [id (if first
               (let [id (swap! handler-ids inc)]
                 (update-slot! object :handlers update signal
                               (fn [hs] (into [[id f]] hs)))
                 id)
               (on object signal f))]
      (update-slot! s :hooks conj [object signal id]))))

(defn- surface-opened! [s owner anchor]
  (set-slot! s :owner owner)
  (set-slot! s :anchor anchor)
  (set-slot! s :shown true)
  (swap! open-surfaces (fn [ss] (into [s] (remove (fn [o] (identical? o s)) ss)))))

(defn surface-closed!
  "Backends call this when the surface closed by itself (a popover after a click outside
it): it emits :closed with reason (:dismissed by default), once. True if it was shown."
  ([s] (surface-closed! s :dismissed))
  ([s reason]
   (when (:shown s)
     (doseq [[object signal id] (:hooks s)] (off object signal id))
     (set-slot! s :hooks [])
     (set-slot! s :owner nil)
     (set-slot! s :shown false)
     (swap! open-surfaces (fn [ss] (vec (remove (fn [o] (identical? o s)) ss))))
     (emit! s (event-for s :closed :value reason))
     true)))

(defgeneric backend-show-popover [backend popover widget rectangle edge]
  "Show the popover pointing at rectangle, [x y width height] in widget, on its edge
(:bottom, :top, :left or :right); shown again, it moves.")

(defgeneric backend-close-popover [backend popover]
  "Close the popover; the core emits :closed.")

(defgeneric backend-show-panel [backend popup widget anchor]
  "Show the completion popup by widget without taking the focus: below anchor ([x y
width height] in widget, a character position in a text view, or :caret), or above it when
there is no room below. Shown again, it moves.")

(defgeneric backend-close-panel [backend popup]
  "Hide the completion popup; the core emits :closed.")

(defgeneric backend-caret-rectangle [backend view position]
  "Where the caret at position is in the text view, [x y width height] from its top left,
its scrolled part taken into account.")

(defgeneric close-natively! [s]
  "Have the backend close the surface: a popover or a completion popup.")

(defn close-surface!
  "Close the popover or completion popup if it is shown, and emit :closed with reason
(:closed if not given). Returns true if it was shown. It can be shown again."
  ([s] (close-surface! s :closed))
  ([s reason]
   (when (:shown s)
     (let [b (current-backend)]
       (in-ui (fn [] (close-natively! s))))
     (surface-closed! s reason))))

(defmethod destroy! :before [(s surface-widget)]
  (when (and (:shown s) (realized? s))
    (close-surface! s)))

(defn place-popup
  "Where a popup of size [width height] goes beside anchor, [x y width height], on screen,
the usable rectangle of the screen, all from the screen's top left: just below anchor with
their left edges lined up, or just above when there is no room below, then moved left or
right to stay on screen. Returns [x y side], side :below or :above. Backends use it to
place completion popups."
  ([anchor size screen] (place-popup anchor size screen 2))
  ([anchor size screen gap]
   (let [[ax ay _ ah] anchor
         [w h] size
         [sx sy sw sh] screen
         below (+ ay ah gap)
         above (- ay gap h)
         side (if (or (<= (+ below h) (+ sy sh)) (< above sy)) :below :above)]
     [(max sx (min ax (- (+ sx sw) w))) (if (= side :below) below above) side])))

(defgeneric caret-position [view]
  "Where the caret is in the text or code view, as a character position.")

(defmethod caret-position [(v text-view-widget)]
  (second (text-selection v)))

(defgeneric has-caret? [w]
  "True for widgets with a text caret, which a completion popup can be shown under.")

(defmethod has-caret? [w] false)

(defmethod has-caret? [(v text-view-widget)] true)

(defn caret-rectangle
  "Where the caret is, or would be at position, in the text view, [x y width height] from
its top left with its scrolled part taken into account: where to show a completion popup."
  ([view] (caret-rectangle view (caret-position view)))
  ([view position]
   (let [b (current-backend)]
     (in-ui (fn [] (backend-caret-rectangle b view position))))))

;;; Popovers

(def notify-appearance-changed!
  "Work out the appearances in a tree again (defined with the appearances, below).")

(defclass popover-widget [surface-widget]
  "A small panel with an arrow pointing at a widget, holding any widgets, as NSPopover and
GtkPopover are: a settings form, a color chooser, an item's details. Put a box or grid in
it, show it with show-popover!, and close it with close-surface!; the user can also close
it, as :behavior says. It takes the keyboard while open, so its entries and buttons work
as in a window."
  (behavior :cell :atom :init :transient
            :doc "When it closes by itself: :transient on a click anywhere outside it or
Escape, :semi-transient on a click in its window but not in others, :application-defined
only when the program calls close-surface!.")
  (preferred-edge :cell :atom :init :bottom
                  :doc "The side of its anchor it prefers: :bottom, :top, :left or :right.
It goes on the other side when there is no room.")
  (padding :cell :atom :init 12))

(declare-widget! popover-widget {:properties [:behavior]})

(defmethod initialize :after [(p popover-widget)]
  (when-not (contains? #{:transient :semi-transient :application-defined} (:behavior p))
    (error "a popover's behavior is :transient, :semi-transient or :application-defined")))

(defn popover
  "A popover: (popover {:behavior :transient} (vbox {} ...)). Show it with show-popover!."
  [opts & children]
  (build popover-widget opts children))

(defn show-popover!
  "Show the popover pointing at widget, which must be in a window that is shown: at its
:rectangle ([x y width height] in widget) or all of it, on its :edge (:bottom, :top, :left
or :right; the popover's :preferred-edge if not given). :focus, a widget in the popover,
gets the keyboard focus. Shown again, the popover moves. Returns the popover."
  ([p widget] (show-popover! p widget {}))
  ([p widget opts]
   (let [rectangle (or (:rectangle opts) (widget-rectangle widget))
         edge (or (:edge opts) (:preferred-edge p))]
     (when-not (contains? #{:bottom :top :left :right} edge)
       (error "a popover's edge is :bottom, :top, :left or :right"))
     (when (and (:shown p) (not (identical? widget (:owner p))))
       (close-surface! p))
     (flush-layouts!)
     ;; Its owner, for the appearance and palette, before it is laid out.
     (set-slot! p :owner widget)
     (update-layout! p)
     (let [b (current-backend)]
       (in-ui (fn [] (backend-show-popover b p widget rectangle edge))))
     (if (:shown p)
       (set-slot! p :anchor rectangle)
       (do (surface-opened! p widget rectangle)
           (hook! p (window-of widget) :closed (fn [_] (close-surface! p :closed)) false)))
     (notify-appearance-changed! p)
     (when-let [f (:focus opts)] (focus! f))
     p)))

;;; Completion popups

(defclass completion-popup-widget [surface-widget]
  "A list of completions shown under the caret of a text view (or by any widget), in a
borderless panel that never takes the keyboard: the view keeps the focus, so typing goes on
in it and the program narrows the list by setting :items.

While it is shown, its owner's :key-down events go through handle-completion-key first: Up,
Down, Page Up and Page Down move the highlight, Return or Tab (:accept-keys) accept the
highlighted item, emitting :accept, and Escape closes it. Clicking an item accepts it;
clicking elsewhere, leaving the window or scrolling closes it. It emits :accept and
:selection-changed (selection-events with the item and its index)."
  (items :cell :atom :init []
         :doc "The completions, any values. Setting it highlights the first and resizes the
popup; setting it empty closes it.")
  (item-label :cell :atom :init str :doc "A function from an item to the text shown for it.")
  (item-detail :cell :atom :init nil
               :doc "A function from an item to a short text shown dimmer at the right of
its row (\"function\", a type), or nil.")
  (selected-index :cell :atom :init 0 :doc "The highlighted item's index, or nil for none.")
  (max-visible-rows :cell :atom :init 10 :doc "The most rows shown at once; the rest scroll.")
  (accept-keys :cell :atom :init [:return :tab] :doc "The keys that accept the highlighted item.")
  (row-height :cell :atom :init 20)
  (list-view :cell :atom :init nil))

(declare-widget! completion-popup-widget
                 {:layout [:items :selected-index :item-label :item-detail :max-visible-rows]
                  :signals {:accept selection-event :selection-changed selection-event}})

(defclass completion-list-widget [canvas-widget]
  "The rows of a completion popup, drawn by skein-ui."
  (popup :init nil)
  (top :cell :atom :init 0 :doc "The index of the first row shown.")
  (focusable :cell :atom :init false))

(def ^:private completion-inset
  "Pixels above the first row and below the last."
  4)

(defn- completion-font [p] (or (:font p) (font {:size 12})))

(defn- item-detail-text [p item]
  (if-let [f (:item-detail p)] (str (or (f item) "")) ""))

(defn- visible-rows [p]
  (min (count (:items p)) (max 1 (:max-visible-rows p))))

(defn- clamp-selection! [p]
  (let [n (count (:items p))
        i (:selected-index p)]
    (set-slot! p :selected-index (when (pos? n) (max 0 (min (or i 0) (dec n)))))))

(defn- scroll-to-selection! [p]
  (let [l (:list-view p)
        i (:selected-index p)
        rows (visible-rows p)
        n (count (:items p))]
    (when i
      (set-slot! l :top (max 0 (min (max 0 (- n rows))
                                    (cond (< i (:top l)) i
                                          (>= i (+ (:top l) rows)) (inc (- i rows))
                                          :else (:top l))))))))

(defmethod initialize :after [(p completion-popup-widget)]
  (let [l (build completion-list-widget {:popup p} nil)]
    (set-slot! p :list-view l)
    (set-slot! p :items (vec (:items p)))
    (add! p l)
    (clamp-selection! p)))

(defn completion-popup
  "A completion popup: (completion-popup {:on-accept (fn [e] (insert! (:value e)))}).
Show it with show-completion-popup!."
  ([] (completion-popup {}))
  ([opts] (build completion-popup-widget opts nil)))

(defmethod close-natively! [(p popover-widget)]
  (backend-close-popover (current-backend) p))

(defmethod close-natively! [(p completion-popup-widget)]
  (backend-close-panel (current-backend) p))

(defn dismiss-popups!
  "For backends: close the completion popups shown for widgets in the window (any window
if nil) but except, with reason (:dismissed). Call it when the user clicks outside a
popup, moves or resizes its window, or scrolls with the wheel."
  ([] (dismiss-popups! nil :dismissed nil))
  ([window reason except]
   (doseq [s @open-surfaces]
     (when (and (instance? completion-popup-widget s) (not (identical? s except))
                (or (nil? window) (identical? window (window-of (:owner s)))))
       (close-surface! s reason)))))

(defmethod measure [(l completion-list-widget)]
  (let [p (:popup l)
        f (completion-font p)
        [_ ch] (text-extent "Mg" f)
        rh (+ 6 (int (math/ceil ch)))
        widest (reduce max 0 (map (fn [item]
                                    (+ (first (text-extent (str ((:item-label p) item)) f))
                                       (let [d (item-detail-text p item)]
                                         (if (= d "") 0 (+ 24 (first (text-extent d f)))))))
                                  (:items p)))]
    (set-slot! p :row-height rh)
    [(max 160 (min 480 (+ 24 (int (math/ceil widest)))))
     (+ (* 2 completion-inset) (* (visible-rows p) rh))]))

(defn- row-at [l y]
  (let [p (:popup l)
        i (+ (:top l) (int (math/floor (/ (- y completion-inset) (:row-height p)))))]
    (when (and (>= y completion-inset) (< -1 i (count (:items p)))
               (< i (+ (:top l) (visible-rows p))))
      i)))

(defn selected-completion
  "The item highlighted in the completion popup, or nil."
  [p]
  (let [i (:selected-index p)]
    (when (and i (< -1 i (count (:items p)))) (nth (:items p) i))))

(defn accept-completion!
  "Accept the highlighted item, as Return does: close the popup, then emit :accept with the
item. Returns the item, or nil when there is none."
  [p]
  (let [item (selected-completion p)
        i (:selected-index p)]
    (when (and i (:shown p))
      (close-surface! p :accepted)
      (emit! p (event-for p :accept :value item :index i))
      item)))

(defmethod handle-event :after [(l completion-list-widget) (e draw-event)]
  (let [p (:popup l)
        gc (:context e)
        f (completion-font p)
        h (:row-height p)
        w (:width e)
        items (:items p)]
    (doseq [row (range (visible-rows p))]
      (let [i (+ row (:top l))]
        (when (< i (count items))
          (let [item (nth items i)
                y (+ completion-inset (* row h))
                selected (= i (:selected-index p))
                color (if selected (rgb 1 1 1) :text)
                [_ th] (text-size gc "Mg" {:font f})
                ty (+ y (/ (- h th) 2))]
            (when selected
              (fill-rectangle! gc 5 y (- w 10) h {:color :accent :radius 4}))
            (draw-text! gc (str ((:item-label p) item)) 12 ty {:font f :color color})
            (let [d (item-detail-text p item)]
              (when-not (= d "")
                (draw-text! gc d (- w 12) ty {:font f :align :right
                                              :color (if selected (rgb 1 1 1 0.8)
                                                         :secondary-text)})))))))))

(defmethod handle-event :after [(l completion-list-widget) (e mouse-event)]
  (let [p (:popup l)]
    (cond
      (and (= :mouse-down (:signal e)) (= :left (:button e)))
      (when-let [i (row-at l (:y e))]
        (set-slot! p :selected-index i)
        (accept-completion! p))
      (= :scroll (:signal e))
      (let [rows (visible-rows p)
            n (count (:items p))
            step (if (:precise e) (/ (:delta-y e) (:row-height p)) (:delta-y e))]
        (set-slot! l :top (max 0 (min (- n rows) (- (:top l) (int (math/round step))))))
        (redraw! l))
      :else nil)))

(defmethod property-changed :after [(p completion-popup-widget) property value]
  (cond
    (= property :items)
    (if (vector? value)
      (do (set-slot! p :selected-index 0)
          (when-let [l (:list-view p)] (set-slot! l :top 0))
          (clamp-selection! p)
          (if (empty? value)
            (close-surface! p :closed)
            (when-let [l (:list-view p)]
              (invalidate-size! l)
              (when (:shown p) (update-layout! p))
              (redraw! l))))
      (set-slot! p :items (vec value)))
    (contains? #{:item-label :item-detail :max-visible-rows} property)
    (when-let [l (:list-view p)]
      (invalidate-size! l)
      (when (:shown p) (update-layout! p))
      (redraw! l))
    (= property :selected-index)
    (let [n (count (:items p))
          ok (if (pos? n) (and (integer? value) (< -1 value n)) (nil? value))]
      (if ok
        (when-let [l (:list-view p)]
          (scroll-to-selection! p)
          (redraw! l))
        (clamp-selection! p)))
    :else nil))

(defn- move-completion-selection! [p delta]
  (let [n (count (:items p))]
    (when (pos? n)
      (let [new (max 0 (min (dec n) (+ (or (:selected-index p) 0) delta)))]
        (when (not= new (:selected-index p))
          (set-slot! p :selected-index new)
          (emit! p (event-for p :selection-changed :index new :value (selected-completion p))))))))

(defn handle-completion-key
  "Act on e, a :key-down of the widget the popup is shown for: Up and Down move the
highlight a row, Page Up and Page Down a page, a key in :accept-keys accepts the
highlighted item, and Escape closes the popup. Those keys, with no modifier, are consumed.
True if the popup acted on e. The popup calls it from its owner's handlers; call it first
in a handle-event method of your own that would take one of these keys."
  [p e]
  (when (and (:shown p) (not (consumed? e)) (= :key-down (:signal e)) (empty? (:modifiers e)))
    (let [key (:key e)
          page (visible-rows p)
          act (cond (= key :up) (fn [] (move-completion-selection! p -1))
                    (= key :down) (fn [] (move-completion-selection! p 1))
                    (= key :page-up) (fn [] (move-completion-selection! p (- page)))
                    (= key :page-down) (fn [] (move-completion-selection! p page))
                    (= key :escape) (fn [] (close-surface! p :cancelled))
                    (some (fn [k] (= k key)) (:accept-keys p)) (fn [] (accept-completion! p))
                    :else nil)]
      (when act
        (act)
        (consume! e)
        true))))

(defn show-completion-popup!
  "Show the completion popup for widget without taking the keyboard from it: below
:rectangle ([x y width height] in widget) or, for a text or code view, below the caret at
:position (the caret's own if not given), or above when there is no room below. :items,
if given, become its items; with none it closes, or isn't shown. Shown again, it moves.
From then on widget's :key-down events go through handle-completion-key first, and a click
in widget or leaving its window closes it. Returns the popup, or nil with no items."
  ([p widget] (show-completion-popup! p widget {}))
  ([p widget opts]
   (when (contains? opts :items) (set-slot! p :items (vec (:items opts))))
   (if (empty? (:items p))
     (do (close-surface! p :closed) nil)
     (do
       (when (and (:shown p) (not (identical? widget (:owner p))))
         (close-surface! p :closed))
       (let [anchor (or (:rectangle opts)
                        (if (has-caret? widget)
                          (or (:position opts) :caret)
                          (widget-rectangle widget)))]
         (set-slot! p :owner widget)
         (update-layout! p)
         (redraw! (:list-view p))
         (let [b (current-backend)]
           (in-ui (fn [] (backend-show-panel b p widget anchor))))
         (if (:shown p)
           (set-slot! p :anchor anchor)
           (let [window (window-of widget)]
             (surface-opened! p widget anchor)
             (hook! p widget :key-down (fn [e] (handle-completion-key p e)) true)
             (hook! p widget :mouse-down (fn [_] (close-surface! p :dismissed)) false)
             (hook! p window :deactivated (fn [_] (close-surface! p :dismissed)) false)
             (hook! p window :closed (fn [_] (close-surface! p :closed)) false)))
         (notify-appearance-changed! p)
         p)))))

;;; ------------------------------------------------------------------------------------
;;; Timers, the clipboard and the system

(defgeneric backend-start-timer [backend timer]
  "Call timer-fired! on the UI thread after the timer's :interval seconds, and again
every interval if it :repeat-s. Returns a handle for backend-stop-timer.")

(defgeneric backend-stop-timer [backend timer handle]
  "Stop the timer that backend-start-timer gave handle for.")

(defgeneric backend-clipboard-text [backend] "The text on the clipboard, or nil.")
(defgeneric backend-set-clipboard-text [backend s] "Put the string s on the clipboard.")
(defgeneric backend-beep [backend] "Play the system's alert sound.")
(defgeneric backend-open-url [backend url] "Open url in the browser or the app for it.")
(defgeneric backend-system-color [backend name] "The color the system color keyword name is now.")
(defgeneric backend-dark-mode? [backend] "True if the system is in dark mode.")

(defclass timer [emitter]
  "Emits :tick (a timer-event) every :interval seconds, or once if :repeat is false, on
the UI thread. after and every make and start one; start-timer! and stop-timer! start and
stop it."
  (interval :cell :atom :init 1 :doc "Seconds between ticks.")
  (repeat :cell :atom :init true :doc "Whether it keeps ticking, or ticks once.")
  (handle :cell :atom :init nil))

(declare-widget! timer {:signals {:tick timer-event}})

(defn stop-timer!
  "Stop the timer; start-timer! starts it again. Returns it."
  [t]
  (when-let [h (:handle t)]
    (let [b (current-backend)]
      (in-ui (fn [] (backend-stop-timer b t h))))
    (set-slot! t :handle nil))
  t)

(defn start-timer!
  "Start the timer, or start it again from now. Returns it."
  [t]
  (stop-timer! t)
  (let [b (current-backend)]
    (set-slot! t :handle (in-ui (fn [] (backend-start-timer b t)))))
  t)

(defn timer-running?
  "True if the timer will tick."
  [t]
  (some? (:handle t)))

(defn timer-fired!
  "Backends call this when the timer's interval passed: it emits :tick."
  [t]
  (when-not (:repeat t) (set-slot! t :handle nil))
  (emit! t (event-for t :tick)))

(defn after
  "Call f (of no arguments) once, seconds from now, on the UI thread. Returns the timer,
which stop-timer! cancels."
  [seconds f]
  (let [t (make timer :interval seconds :repeat false)]
    (on t :tick (fn [_] (f)))
    (start-timer! t)))

(defn every
  "Call f (of no arguments) every seconds on the UI thread. Returns the timer, which
stop-timer! stops."
  [seconds f]
  (let [t (make timer :interval seconds :repeat true)]
    (on t :tick (fn [_] (f)))
    (start-timer! t)))

(defn clipboard-text
  "The text on the clipboard, or nil."
  []
  (let [b (current-backend)] (in-ui (fn [] (backend-clipboard-text b)))))

(defn set-clipboard-text!
  "Put the string s on the clipboard. Returns s."
  [s]
  (let [b (current-backend)] (in-ui (fn [] (backend-set-clipboard-text b s))))
  s)

(defn beep!
  "Play the system's alert sound."
  []
  (let [b (current-backend)] (in-ui (fn [] (backend-beep b))))
  nil)

(defn open-url!
  "Open url, a string, in the user's browser, or the app that handles it."
  [url]
  (let [b (current-backend)] (in-ui (fn [] (backend-open-url b url))))
  nil)

;;; ------------------------------------------------------------------------------------
;;; Text buffers: text for editors, shared by any number of code views. A buffer is plain
;;; Skein, with no native counterpart: backends mirror it. Positions count characters
;;; from 0. Every change goes through replace-buffer-range!, which updates the line index, bumps
;;; the revision, records the undo history and emits :changed.

(defclass buffer-change-event [event]
  "A text buffer's text changed: the characters from :start to :old-end were replaced by
those from :start to :new-end. :removed-text and :inserted-text are the old and new text,
:revision the buffer's revision after the change."
  (start :init 0)
  (old-end :init 0)
  (new-end :init 0)
  (removed-text :init "")
  (inserted-text :init "")
  (revision :init 0))

(defclass text-buffer [emitter]
  "Text to edit, shared by any number of code views: its lines, an index of where each
starts, a revision that grows with every change, an undo history, and :changed (a
buffer-change-event) for each change. Make one with make-text-buffer."
  (lines :cell :atom :init [""] :doc "The text's lines, without their newlines.")
  (starts :cell :atom :init [0] :doc "Where each line starts.")
  (length :cell :atom :init 0 :doc "The number of characters.")
  (astral :cell :atom :init 0
          :doc "How many characters are outside the Basic Multilingual Plane (two UTF-16
units each).")
  (revision :cell :atom :init 0 :doc "A number that grows with every change.")
  (history-limit :cell :atom :init 1000
                 :doc "How many changes undo! can take back; 0 keeps no history.")
  (undo-stack :cell :atom :init ())
  (redo-stack :cell :atom :init ())
  (group :cell :atom :init [])
  (group-depth :cell :atom :init 0)
  (undoing :cell :atom :init false)
  (views :cell :atom :init [] :doc "The code views showing it.")
  (mirror :cell :atom :init nil :doc "The id of its :changed handler that updates the views."))

(declare-widget! text-buffer {:signals {:changed buffer-change-event}})

(def ^:private replace-buffer-range!)

(def ^:dynamic *suppress-history*
  "True while changes are made that undo! shouldn't see, such as a buffer's first text."
  false)

(defn make-text-buffer
  "A new text buffer: (make-text-buffer {:text \"(defn f [x] x)\" :history-limit 1000}).
:history-limit is how many changes undo! can take back; 0 keeps no history, for programs
that keep their own."
  ([] (make-text-buffer {}))
  ([opts]
   (let [b (make text-buffer :history-limit (get opts :history-limit 1000))
         text (str (or (:text opts) ""))]
     (when (pos? (count text))
       (binding [*suppress-history* true]
         (replace-buffer-range! b 0 0 text)))
     (set-slot! b :revision 0)
     b)))

(defn buffer-length
  "The number of characters in the buffer."
  [b]
  (:length b))

(defn buffer-line-count
  "The number of lines in the buffer: one more than its number of newlines."
  [b]
  (count (:lines b)))

(defn- check-range [b start end]
  (when-not (and (integer? start) (integer? end) (<= 0 start end (:length b)))
    (error (str "the range " start " to " end " is outside the buffer, which has "
                (:length b) " characters"))))

(defn line-start
  "Where line (counting from 0) of the buffer starts."
  [b line]
  (when-not (and (integer? line) (< -1 line (count (:lines b))))
    (error (str "line " line " is not in the buffer, which has " (count (:lines b)) " lines")))
  (nth (:starts b) line))

(defn line-end
  "Where line of the buffer ends, before its newline."
  [b line]
  (+ (line-start b line) (count (nth (:lines b) line))))

(defn line-text
  "The text of line of the buffer, without its newline."
  [b line]
  (line-start b line)
  (nth (:lines b) line))

(defn position-line
  "The line position is on in the buffer, counting from 0."
  [b position]
  (let [starts (:starts b)]
    (loop [lo 0 hi (dec (count starts))]
      (if (< lo hi)
        (let [mid (quot (+ lo hi 1) 2)]
          (if (<= (nth starts mid) position) (recur mid hi) (recur lo (dec mid))))
        lo))))

(defn position-column
  "How many characters position is from the start of its line."
  [b position]
  (- position (line-start b (position-line b position))))

(defn buffer-text
  "The buffer's text, all of it or from start to end."
  ([b] (string/join "\n" (:lines b)))
  ([b start end]
   (check-range b start end)
   (let [ls (position-line b start)
         le (position-line b end)
         lines (:lines b)
         starts (:starts b)]
     (if (= ls le)
       (subs (nth lines ls) (- start (nth starts ls)) (- end (nth starts ls)))
       (string/join "\n" (concat [(subs (nth lines ls) (- start (nth starts ls)))]
                                 (subvec lines (inc ls) le)
                                 [(subs (nth lines le) 0 (- end (nth starts le)))]))))))

(defn buffer-char
  "The character at position in the buffer (\newline at a line's end)."
  [b position]
  (check-range b position (inc position))
  (let [line (position-line b position)
        column (- position (nth (:starts b) line))
        text (nth (:lines b) line)]
    (if (< column (count text)) (nth text column) \newline)))

(defn- split-at-newlines
  "s cut at each newline, empty lines kept: one more string than s has newlines."
  [s]
  (loop [c (string/cursor s) from c out []]
    (let [ch (string/char-at s c)]
      (cond (nil? ch) (conj out (string/slice s from c))
            (= ch \newline) (let [n (string/next s c)] (recur n n (conj out (string/slice s from c))))
            :else (recur (string/next s c) from out)))))

(defn- astral-count [s]
  (count (filter (fn [c] (> (int c) 0xFFFF)) s)))

;; The undo history: a record is a vector of edits [start removed inserted], oldest first.

(defn- merge-edit
  "record with edit joined to it when edit continues typing or deleting there, or nil."
  [record edit]
  (when (= 1 (count record))
    (let [[s1 r1 i1] (first record)
          [s2 r2 i2] edit
          newline? (fn [t] (some (fn [c] (= c \newline)) t))]
      (cond
        ;; typing on: an insertion right after the last, no newline
        (and (= "" r1) (= "" r2) (= s2 (+ s1 (count i1))) (not (newline? i2)) (not (newline? i1)))
        [[s1 r1 (str i1 i2)]]
        ;; Backspace: a deletion ending where the last began
        (and (= "" i1) (= "" i2) (= (+ s2 (count r2)) s1))
        [[s2 (str r2 r1) ""]]
        ;; forward delete: a deletion at the same place
        (and (= "" i1) (= "" i2) (= s2 s1))
        [[s1 (str r1 r2) ""]]
        :else nil))))

(defn- record-change! [b start removed inserted merge]
  (when-not (or (:undoing b) *suppress-history* (not (pos? (:history-limit b))))
    (set-slot! b :redo-stack ())
    (let [edit [start removed inserted]
          merged (when (and merge (seq (:undo-stack b)))
                   (merge-edit (first (:undo-stack b)) edit))]
      (cond (pos? (:group-depth b)) (update-slot! b :group conj edit)
            merged (update-slot! b :undo-stack (fn [st] (conj (rest st) merged)))
            :else (update-slot! b :undo-stack
                                (fn [st] (apply list (take (:history-limit b) (conj st [edit])))))))))

(defn replace-buffer-range!
  "Replace the buffer's characters from start to end with text, record the change for
undo!, and emit :changed. With merge, the change joins the previous one in the history
when it continues it, as typing a word or deleting with Backspace does, so undo! takes them
back together. Returns the end of the new text."
  ([b start end text] (replace-buffer-range! b start end text false))
  ([b start end text merge]
   (check-range b start end)
   (let [text (str text)]
     (if (and (= start end) (= "" text))
       end
       (let [removed (buffer-text b start end)
             lines (:lines b)
             starts (:starts b)
             ls (position-line b start)
             le (position-line b end)
             prefix (subs (nth lines ls) 0 (- start (nth starts ls)))
             suffix (subs (nth lines le) (- end (nth starts le)))
             new-lines (split-at-newlines (str prefix text suffix))
             delta (- (count text) (- end start))
             new-starts (reduce (fn [acc line] (conj acc (+ (peek acc) (count line) 1)))
                                [(nth starts ls)] (butlast new-lines))]
         (set-slot! b :lines (into (into (subvec lines 0 ls) new-lines) (subvec lines (inc le))))
         (set-slot! b :starts (into (into (subvec starts 0 ls) new-starts)
                                    (map (fn [x] (+ x delta)) (subvec starts (inc le)))))
         (update-slot! b :length + delta)
         (update-slot! b :astral + (- (astral-count text) (astral-count removed)))
         (update-slot! b :revision inc)
         (record-change! b start removed text merge)
         (emit! b (event-for b :changed :start start :old-end end :new-end (+ start (count text))
                             :removed-text removed :inserted-text text :revision (:revision b)))
         (+ start (count text)))))))

(defn insert-into-buffer!
  "Insert text at position in the buffer. Returns the end of the inserted text."
  [b position text]
  (replace-buffer-range! b position position text))

(defn delete-buffer-range!
  "Delete the buffer's characters from start to end."
  [b start end]
  (replace-buffer-range! b start end ""))

(defn set-buffer-text!
  "Replace all of the buffer's text with text, as one change."
  [b text]
  (replace-buffer-range! b 0 (:length b) text)
  text)

;; Characters and UTF-16 units, for backends whose strings count UTF-16 units

(defn buffer-utf16-position
  "position in the buffer counted in UTF-16 units, as NSString and Windows count."
  [b position]
  (if (zero? (:astral b))
    position
    (+ position (astral-count (buffer-text b 0 position)))))

(defn buffer-position-from-utf16
  "The character position in the buffer of the UTF-16 offset units."
  [b units]
  (if (zero? (:astral b))
    (min units (:length b))
    (loop [i 0 u 0]
      (if (or (>= u units) (>= i (:length b)))
        i
        (recur (inc i) (+ u (if (> (int (buffer-char b i)) 0xFFFF) 2 1)))))))

(defn utf16-length
  "The number of UTF-16 units the string s takes."
  [s]
  (+ (count s) (astral-count s)))

(defn call-with-undo-group
  "Call f so that the changes it makes to the buffer are undone and redone as one."
  [b f]
  (update-slot! b :group-depth inc)
  (try (f)
       (finally
         (when (zero? (update-slot! b :group-depth dec))
           (let [group (:group b)]
             (set-slot! b :group [])
             (when (seq group)
               (update-slot! b :undo-stack conj group)))))))

(defmacro with-undo-group
  "Run body so the changes it makes to the buffer are undone and redone as one:
(with-undo-group [b] (delete-buffer-range! b 0 3) (insert-into-buffer! b 0 \"x\"))."
  [[b] & body]
  `(call-with-undo-group ~b (fn [] ~@body)))

(defn clear-history!
  "Forget the buffer's undo and redo history. Returns the buffer."
  [b]
  (set-slot! b :undo-stack ())
  (set-slot! b :redo-stack ())
  b)

(defgeneric can-undo? [object]
  "True when undo! has a change to take back in the text buffer or code view.")

(defmethod can-undo? [(b text-buffer)] (boolean (seq (:undo-stack b))))

(defgeneric can-redo? [object]
  "True when redo! has a change to make again in the text buffer or code view.")

(defmethod can-redo? [(b text-buffer)] (boolean (seq (:redo-stack b))))

(defn- apply-edits!
  "Apply edits, each [start old new], without recording them. Returns [start end] of the
last."
  [b edits]
  (set-slot! b :undoing true)
  (try
    (reduce (fn [_ [s old new]] [s (replace-buffer-range! b s (+ s (count old)) new)]) [0 0] edits)
    (finally (set-slot! b :undoing false))))

(defgeneric undo! [object]
  "Take back the last change to the text buffer or code view. For a buffer, returns
[start end] of the text it restored, or nil with nothing to undo.")

(defmethod undo! [(b text-buffer)]
  (when-let [record (first (:undo-stack b))]
    (update-slot! b :undo-stack rest)
    (update-slot! b :redo-stack conj record)
    (apply-edits! b (reverse (map (fn [[s r i]] [s i r]) record)))))

(defgeneric redo! [object]
  "Make again the last change undo! took back in the text buffer or code view. For a
buffer, returns [start end] of the new text, or nil.")

(defmethod redo! [(b text-buffer)]
  (when-let [record (first (:redo-stack b))]
    (update-slot! b :redo-stack rest)
    (update-slot! b :undo-stack conj record)
    (apply-edits! b record)))

;;; ------------------------------------------------------------------------------------
;;; Code views: an editor view on a text buffer, with its own caret and selection, styled
;;; runs and a line-number gutter. It is the platform's text view (NSTextView, GtkTextView),
;;; so typing, input methods and accessibility are native; the buffer stays the truth: the
;;; backend mirrors it and reports the native view's edits back as buffer changes. The
;;; editing commands here are what the headless backend uses, and what programs call.

(def ^:dynamic *native-input*
  "True while a backend emits an input event that its native text view acts on itself if
no one consumes it. When false, as in tests, a code view does the editing."
  false)

(def ^:dynamic *edit-origin*
  "The code view whose native view made the buffer change being reported, or nil."
  nil)

(def ^:dynamic *from-native*
  "True while a buffer change from a native view is applied, so it isn't sent back."
  false)

(defclass code-view-widget [widget]
  "A text view for editing code: it shows a text buffer with styled runs and a
line-number gutter, with a caret and selection of its own, so several views show and edit
one buffer independently. Its keyboard and mouse signals come first, as for every widget
with input-signals: a handle-event method that consumes Return, Home or any key replaces
what it does. It emits :changed (a buffer-change-event) for any change to its buffer,
:selection-changed when the caret or selection moves, and :scrolled."
  (buffer :cell :atom :init (make-text-buffer) :doc "The text buffer it shows and edits.")
  (editable :cell :atom :init true
            :doc "Whether the user can change the text; programs can either way.")
  (line-numbers :cell :atom :init true :doc "Whether to show line numbers in a gutter.")
  (tab-width :cell :atom :init 4 :doc "How many spaces wide a tab is.")
  (wrap :cell :atom :init false
        :doc "Whether long lines wrap at its width, instead of scrolling sideways.")
  (placeholder :cell :atom :init nil :doc "Dimmed text shown while it is empty, or nil.")
  (text-styles :cell :atom :init {}
               :doc "A map from style names to attribute maps, which runs with :style use.
Changing it restyles the view, as a theme change needs.")
  (font :cell :atom :init {:family :monospace :size 12 :weight :regular :italic false})
  (cursor :cell :atom :init 0 :doc "Where the caret is: the moving end of the selection.")
  (anchor :cell :atom :init 0 :doc "The fixed end of the selection; the cursor's if empty.")
  (goal-column :cell :atom :init nil)
  (runs :cell :atom :init [] :doc "The styled runs, [start end attributes], by start.")
  (styled :cell :atom :init nil :doc "[start end] of the text whose runs the backend shows.")
  (hexpand :cell :atom :init true)
  (vexpand :cell :atom :init true))

(declare-widget! code-view-widget
                 {:properties [:buffer :editable :line-numbers :tab-width :wrap :placeholder
                               :text-styles]
                  :signals (merge input-signals
                                  {:changed buffer-change-event :selection-changed event
                                   :scrolled event :mouse-move mouse-event
                                   :mouse-enter mouse-event :mouse-leave mouse-event})})

(defn code-view
  "A code view: (code-view {:buffer (make-text-buffer {:text \"(defn f [x] x)\"})})."
  ([] (code-view {}))
  ([opts] (build code-view-widget opts nil)))

(defmethod measure [(v code-view-widget)]
  [300 200])

(defmethod has-caret? [(v code-view-widget)] true)

(defmethod caret-position [(v code-view-widget)] (:cursor v))

;;; Buffers and views

(defgeneric backend-buffer-replaced [backend buffer start old-end text removed]
  "The buffer's text from start to old-end (removed) became text: show it in the native
views of the buffer's code views, except the one that made the change (*edit-origin*).")

(defgeneric backend-code-set-selection [backend view anchor cursor]
  "Show the code view's selection from anchor to cursor, the caret at cursor.")

(defgeneric backend-code-position-at-point [backend view x y]
  "The text position nearest x, y in the code view's content (its text area from the
top left, scrolled part included, gutter excluded).")

(defgeneric backend-code-point-at-position [backend view position]
  "Where position is in the code view's content: [x y height], the top of a caret there.")

(defgeneric backend-code-scroll-to-position [backend view position]
  "Scroll the code view, if needed, so position shows.")

(defgeneric backend-code-visible-lines [backend view]
  "[first last], the lines the code view shows.")

(defgeneric backend-code-gutter-width [backend view]
  "The width of the code view's line-number gutter.")

(defgeneric backend-code-apply-runs [backend view start end runs]
  "Show runs, [start end attributes] with styles resolved, between start and end of the
code view's text, whose text there has no style otherwise.")

(defn- shift-position
  "Where position goes when the text from start to old-end becomes start to new-end."
  [position start old-end new-end]
  (cond (<= position start) position
        (>= position old-end) (+ position (- new-end old-end))
        :else start))

(defn- shift-runs
  "runs moved for a change replacing start to old-end with start to new-end. A run that
continues past an insertion grows to cover it, as typing in a word does."
  [runs start old-end new-end]
  (if (and (= start old-end) (= start new-end))
    runs
    (let [delta (- new-end old-end)]
      (into [] (comp (map (fn [[s e a]]
                            [(if (>= s old-end) (+ s delta) (min s start))
                             (cond (>= e old-end) (+ e delta) (> e start) start :else e)
                             a]))
                     (filter (fn [[s e _]] (< s e))))
            runs))))

(def ^:private restyle!)
(def ^:private ensure-styled!)

(defn- buffer-changed!
  "Keep the native views, and every view's selection and runs, in step with a change."
  [e]
  (let [b (:source e)
        start (:start e)
        old-end (:old-end e)
        new-end (:new-end e)]
    (when (and (not *from-native*) (some realized? (:views b)))
      (let [bk (current-backend)]
        (in-ui (fn [] (backend-buffer-replaced bk b start old-end (:inserted-text e)
                                               (:removed-text e))))))
    (doseq [v (:views b)]
      (when-not (:destroyed v)
        (set-slot! v :cursor (shift-position (:cursor v) start old-end new-end))
        (set-slot! v :anchor (shift-position (:anchor v) start old-end new-end))
        (set-slot! v :runs (shift-runs (:runs v) start old-end new-end))
        (when-let [[a z] (:styled v)]
          (set-slot! v :styled [(shift-position a start old-end new-end)
                                (shift-position z start old-end new-end)]))
        (when (realized? v)
          (let [bk (current-backend)]
            (when-not (identical? v *edit-origin*)
              (in-ui (fn [] (backend-code-set-selection bk v (:anchor v) (:cursor v)))))
            (in-ui (fn [] (backend-redraw bk v nil))))
          (restyle! v (line-start b (position-line b start)) (line-end b (position-line b new-end)))
          (ensure-styled! v))
        (emit! v (event-for v :changed :start start :old-end old-end :new-end new-end
                            :removed-text (:removed-text e) :inserted-text (:inserted-text e)
                            :revision (:revision e)))))))

(defn- attach-view! [v b]
  (when-not (:mirror b)
    (set-slot! b :mirror (on b :changed buffer-changed!)))
  (update-slot! b :views (fn [vs] (if (some (fn [x] (identical? x v)) vs) vs (conj vs v)))))

(defn- detach-view! [v b]
  (update-slot! b :views (fn [vs] (filterv (fn [x] (not (identical? x v))) vs)))
  (when (and (empty? (:views b)) (:mirror b))
    (off b :changed (:mirror b))
    (set-slot! b :mirror nil)))

(defmethod initialize :after [(v code-view-widget)]
  (attach-view! v (:buffer v))
  ;; Its buffer, now and later.
  (add-watch (cell v :buffer) ::buffer
             (fn [_ _ old new]
               (when-not (identical? old new)
                 (detach-view! v old)
                 (attach-view! v new)
                 (set-slot! v :cursor 0)
                 (set-slot! v :anchor 0)
                 (set-slot! v :runs [])
                 (set-slot! v :styled nil)))))

(defmethod destroy! :before [(v code-view-widget)]
  (detach-view! v (:buffer v)))

(defn native-buffer-edited!
  "Backends call this when the native text view origin (a code view, or nil) replaced the
buffer's characters from start to old-end with text: it changes the buffer without sending
the change back. Typing and deleting one character at a time merge in the undo history."
  [b start old-end text origin]
  (binding [*from-native* true
            *edit-origin* origin]
    (replace-buffer-range! b start old-end text (<= (+ (count text) (- old-end start)) 1))))

;;; Text

(defn code-text
  "All of the code view's text."
  [v]
  (buffer-text (:buffer v)))

(defn set-code-text!
  "Make text all of the code view's text, as one change. Returns text."
  [v text]
  (set-buffer-text! (:buffer v) text))

(defn text-length
  "The number of characters in the code view's buffer."
  [v]
  (buffer-length (:buffer v)))

;;; The selection

(defn- clamp-position [v p] (max 0 (min p (text-length v))))

(def ^:private scroll-to-position!)

(defn set-selection!
  "Select from anchor to cursor in the code view, the caret going to cursor, and unless
:scroll is false bring the caret into view. Returns cursor."
  ([v anchor cursor] (set-selection! v anchor cursor {}))
  ([v anchor cursor opts]
   (let [anchor (clamp-position v anchor)
         cursor (clamp-position v cursor)]
     (when-not (and (= anchor (:anchor v)) (= cursor (:cursor v)))
       (set-slot! v :anchor anchor)
       (set-slot! v :cursor cursor)
       (when (realized? v)
         (let [b (current-backend)]
           (in-ui (fn [] (backend-code-set-selection b v anchor cursor)))))
       (emit! v (event-for v :selection-changed)))
     (when (and (get opts :scroll true) (realized? v))
       (scroll-to-position! v cursor))
     cursor)))

(defn set-cursor!
  "Put the code view's caret at position, with nothing selected. Returns it."
  [v position]
  (set-slot! v :goal-column nil)
  (set-selection! v position position))

(defn native-selection-changed!
  "Backends call this when the user moved the code view's caret or selection natively."
  [v anchor cursor]
  (when-not (and (= anchor (:anchor v)) (= cursor (:cursor v)))
    (set-slot! v :anchor anchor)
    (set-slot! v :cursor cursor)
    (set-slot! v :goal-column nil)
    (emit! v (event-for v :selection-changed))))

(defn selection
  "The code view's selection as [start end], start <= end."
  [v]
  [(min (:anchor v) (:cursor v)) (max (:anchor v) (:cursor v))])

(defn selection-empty?
  "True when nothing is selected in the code view."
  [v]
  (= (:anchor v) (:cursor v)))

(defn selected-text
  "The text selected in the code view, or \"\"."
  [v]
  (let [[s e] (selection v)] (buffer-text (:buffer v) s e)))

(defn replace-selection!
  "Replace the code view's selection with s, leaving the caret after it. With merge, the
change joins the previous one in the undo history, as typing does. Returns the caret."
  ([v s] (replace-selection! v s false))
  ([v s merge]
   (let [[start end] (selection v)
         new-end (binding [*edit-origin* v] (replace-buffer-range! (:buffer v) start end s merge))]
     (set-cursor! v new-end))))

(defn select-all!
  "Select all of the code view's text."
  [v]
  (set-selection! v 0 (text-length v) {:scroll false}))

;;; The clipboard and the history

(defn copy-selection!
  "Put the code view's selected text on the clipboard."
  [v]
  (when-not (selection-empty? v)
    (set-clipboard-text! (selected-text v))))

(defn cut-selection!
  "Put the code view's selected text on the clipboard and delete it."
  [v]
  (when (and (:editable v) (not (selection-empty? v)))
    (copy-selection! v)
    (replace-selection! v "")))

(defn paste-clipboard!
  "Replace the code view's selection with the text on the clipboard."
  [v]
  (let [t (clipboard-text)]
    (when (and t (:editable v))
      (replace-selection! v t))))

(defmethod undo! [(v code-view-widget)]
  (when-let [[_ end] (binding [*edit-origin* v] (undo! (:buffer v)))]
    (set-cursor! v end)
    end))

(defmethod redo! [(v code-view-widget)]
  (when-let [[_ end] (binding [*edit-origin* v] (redo! (:buffer v)))]
    (set-cursor! v end)
    end))

(defmethod can-undo? [(v code-view-widget)] (can-undo? (:buffer v)))
(defmethod can-redo? [(v code-view-widget)] (can-redo? (:buffer v)))

;;; Geometry

(defn position-at-point
  "The text position nearest x, y in the code view's content (its text area from the top
left, scrolled part included, gutter excluded), where a click there puts the caret."
  [v x y]
  (let [b (current-backend)] (in-ui (fn [] (backend-code-position-at-point b v x y)))))

(defn point-at-position
  "Where position is in the code view's content: [x y height], the top of a caret there."
  [v position]
  (let [b (current-backend)
        p (clamp-position v position)]
    (in-ui (fn [] (backend-code-point-at-position b v p)))))

(defn scroll-to-position!
  "Scroll the code view, if needed, so position shows."
  [v position]
  (let [b (current-backend)
        p (clamp-position v position)]
    (in-ui (fn [] (backend-code-scroll-to-position b v p)))))

(defn visible-lines
  "[first last], the lines the code view shows."
  [v]
  (let [b (current-backend)] (in-ui (fn [] (backend-code-visible-lines b v)))))

(defn gutter-width
  "The width of the code view's line-number gutter, or 0 when it has none."
  [v]
  (if (:line-numbers v)
    (let [b (current-backend)] (in-ui (fn [] (backend-code-gutter-width b v))))
    0))

(defn code-view-scrolled!
  "Backends call this when the code view scrolled."
  [v]
  (ensure-styled! v)
  (emit! v (event-for v :scrolled)))

;;; Styled runs. Runs are kept sorted by start. The backend shows the runs of the styled
;;; range, the visible lines with a margin; ensure-styled! extends it as the view scrolls,
;;; so restyling a large text costs only what shows.

(def ^:private style-margin
  "How many lines beyond those showing get their runs shown ahead of scrolling."
  200)

(defn- normalize-run [r]
  (let [[s e & more] r
        attrs (if (map? (first more)) (first more) (apply hash-map more))]
    [s e attrs]))

(defn text-runs
  "The code view's styled runs, [start end attributes] by start."
  [v]
  (:runs v))

(defn- runs-between
  "The runs of the view overlapping start to end, clipped to it."
  [v start end]
  (into [] (comp (filter (fn [[s e _]] (and (< s end) (> e start))))
                 (map (fn [[s e a]] [(max s start) (min e end) a])))
        (:runs v)))

(defn resolve-run-attributes
  "A run's attributes with its :style replaced by the style's attributes from the view's
:text-styles, and its colors made colors or system color keywords."
  [v attrs]
  (let [all (merge (get (:text-styles v) (:style attrs)) (dissoc attrs :style))
        color (fn [k] (when-let [c (get all k)] (ensure-color c)))]
    (cond-> {}
      (color :color) (assoc :color (color :color))
      (color :background) (assoc :background (color :background))
      (:bold all) (assoc :bold true)
      (:italic all) (assoc :italic true)
      (:underline all) (assoc :underline true))))

(defn- show-runs! [v start end]
  (when (< start end)
    (let [b (current-backend)
          runs (mapv (fn [[s e a]] [s e (resolve-run-attributes v a)]) (runs-between v start end))]
      (in-ui (fn [] (backend-code-apply-runs b v start end runs))))))

(defn- restyle!
  "Show the view's runs again from start to end, where that is in its styled range."
  [v start end]
  (when-let [[a z] (:styled v)]
    (when (realized? v)
      (show-runs! v (max start a) (min end z (text-length v))))))

(defn- ensure-styled!
  "Make sure the backend shows the runs of the view's visible lines, and some around."
  [v]
  (when (realized? v)
    (let [b (:buffer v)
          [first-line last-line] (visible-lines v)
          a (line-start b (max 0 (- first-line style-margin)))
          z (line-end b (min (dec (buffer-line-count b)) (+ last-line style-margin)))
          styled (:styled v)]
      (cond (and styled (<= (first styled) a) (>= (second styled) z)) nil
            (and styled (<= a (second styled)) (>= z (first styled)))
            (do (show-runs! v a (first styled))
                (show-runs! v (second styled) z)
                (set-slot! v :styled [(min a (first styled)) (max z (second styled))]))
            :else (do (show-runs! v a z)
                      (set-slot! v :styled [a z]))))))

(defn set-text-runs!
  "Make runs all of the code view's styled runs: each [start end attributes], attributes a
map of :style (a name in :text-styles giving defaults for the rest), :color and
:background (color designators), :bold, :italic and :underline. Text outside any run has
the plain style. Only what shows is styled at once; the rest as it scrolls into view."
  [v runs]
  (set-slot! v :runs (vec (sort-by first (filter (fn [[s e _]] (< s e)) (map normalize-run runs)))))
  (let [old (:styled v)]
    (set-slot! v :styled nil)
    (when (and old (realized? v))
      (let [b (current-backend)
            z (min (second old) (text-length v))]
        (in-ui (fn [] (backend-code-apply-runs b v (first old) z []))))))
  (ensure-styled! v)
  runs)

(defn replace-text-runs!
  "Replace the code view's runs between start and end with runs, which should lie in that
range, and show the change where it shows: how to restyle part of a large text."
  [v start end runs]
  (let [piece (fn [s e a] (when (< s e) [s e a]))
        old (mapcat (fn [[s e a]]
                      (if (or (<= e start) (>= s end))
                        [[s e a]]
                        (remove nil? [(piece s (min e start) a) (piece (max s end) e a)])))
                    (:runs v))
        new (remove nil? (map (fn [[s e a]] (piece (max start s) (min end e) a))
                              (map normalize-run runs)))]
    (set-slot! v :runs (vec (sort-by first (concat old new)))))
  (restyle! v start end)
  runs)

(defn text-style-at
  "The attributes of the run at position in the code view, its style resolved, or nil."
  [v position]
  (when-let [[_ _ a] (first (filter (fn [[s e _]] (and (<= s position) (< position e))) (:runs v)))]
    (resolve-run-attributes v a)))

(defmethod property-changed :after [(v code-view-widget) property value]
  (when (= property :text-styles)
    (when-let [[a z] (:styled v)] (restyle! v a z))))

;;; Editing commands. Native views do these themselves on macOS; they are here for the
;;; headless backend, for platforms whose text view lacks one, and for programs (a Home key
;;; that goes to the first character that isn't blank).

(defn- word-char? [c]
  (let [n (int c)]
    (or (<= 48 n 57) (<= 65 n 90) (<= 97 n 122) (> n 127) (contains? (set "_-*+!?<>=/%&$") c))))

(defn motion-target
  "Where motion takes the code view's caret, and the goal column vertical motions keep:
[position goal]. motion is :left, :right, :word-left, :word-right, :up, :down,
:line-start, :line-end, :page-up, :page-down, :buffer-start or :buffer-end."
  [v motion]
  (let [b (:buffer v)
        p (:cursor v)
        n (buffer-length b)
        line (position-line b p)
        vertical (fn [lines]
                   (let [goal (or (:goal-column v) (position-column b p))
                         target (max 0 (min (dec (buffer-line-count b)) (+ line lines)))]
                     [(min (+ (line-start b target) goal) (line-end b target)) goal]))
        page (fn [] (let [[f l] (visible-lines v)] (max 1 (- l f))))]
    (case motion
      :left [(max 0 (dec p)) nil]
      :right [(min n (inc p)) nil]
      :word-left [(let [i (loop [i p] (if (and (> i 0) (not (word-char? (buffer-char b (dec i)))))
                                        (recur (dec i)) i))]
                    (loop [i i] (if (and (> i 0) (word-char? (buffer-char b (dec i)))) (recur (dec i)) i)))
                  nil]
      :word-right [(let [i (loop [i p] (if (and (< i n) (not (word-char? (buffer-char b i))))
                                         (recur (inc i)) i))]
                     (loop [i i] (if (and (< i n) (word-char? (buffer-char b i))) (recur (inc i)) i)))
                   nil]
      :line-start [(line-start b line) nil]
      :line-end [(line-end b line) nil]
      :up (vertical -1)
      :down (vertical 1)
      :page-up (vertical (- (page)))
      :page-down (vertical (page))
      :buffer-start [0 nil]
      :buffer-end [n nil])))

(defn move-cursor!
  "Move the code view's caret by motion (see motion-target), extending the selection with
extend, else leaving nothing selected. Returns where the caret went."
  ([v motion] (move-cursor! v motion false))
  ([v motion extend]
   (let [[target goal] (motion-target v motion)
         target (if (and (not extend) (not (selection-empty? v)) (contains? #{:left :right} motion))
                  (let [[s e] (selection v)] (if (= motion :left) s e))
                  target)]
     (set-selection! v (if extend (:anchor v) target) target)
     (set-slot! v :goal-column (when (contains? #{:up :down :page-up :page-down} motion) goal))
     target)))

(defn delete-backward!
  "Delete the selection, or from the caret back to where motion (:left) takes it."
  ([v] (delete-backward! v :left))
  ([v motion]
   (when (:editable v)
     (when (selection-empty? v)
       (set-selection! v (:cursor v) (first (motion-target v motion)) {:scroll false}))
     (replace-selection! v "" true))))

(defn delete-forward!
  "Delete the selection, or from the caret forward to where motion (:right) takes it."
  ([v] (delete-forward! v :right))
  ([v motion]
   (when (:editable v)
     (when (selection-empty? v)
       (set-selection! v (:cursor v) (first (motion-target v motion)) {:scroll false}))
     (replace-selection! v "" true))))

(defn type-text!
  "Type text into the code view as the user would: it emits :text-input and, unless a
handler consumes it, replaces the selection with text."
  [v text]
  (binding [*native-input* false]
    (emit! v (event-for v :text-input :text text))))

(defgeneric key-command [view e]
  "What the key event e does in the code view when no handler consumes it: a function of
the view, or nil. Platforms whose native view does the editing keys don't call it.")

(defmethod key-command [(v code-view-widget) e]
  (let [key (:key e)
        mods (set (:modifiers e))
        mac (= :macos (system/os))
        shift (contains? mods :shift)
        word (contains? mods (if mac :alt :control))
        primary (contains? mods (primary-modifier))
        line (and primary mac)
        move (fn [m] (fn [v] (move-cursor! v m shift)))]
    (case key
      :left (move (cond line :line-start word :word-left :else :left))
      :right (move (cond line :line-end word :word-right :else :right))
      :up (move (if line :buffer-start :up))
      :down (move (if line :buffer-end :down))
      :home (move (if primary :buffer-start :line-start))
      :end (move (if primary :buffer-end :line-end))
      :page-up (move :page-up)
      :page-down (move :page-down)
      :backspace (fn [v] (delete-backward! v (if word :word-left :left)))
      :delete (fn [v] (delete-forward! v (if word :word-right :right)))
      :return (fn [v] (type-text! v "\n"))
      :tab (fn [v] (type-text! v "\t"))
      (when (and primary (char? key))
        (case key
          \a select-all!
          \c copy-selection!
          \x cut-selection!
          \v paste-clipboard!
          \z (if shift redo! undo!)
          nil)))))

(defmethod handle-event :around [(v code-view-widget) (e input-event)]
  (call-next-method)
  (when-not (or *native-input* (consumed? e))
    (let [signal (:signal e)]
      (cond
        (= signal :key-down)
        (let [command (key-command v e)
              t (str (or (:text e) ""))]
          (cond command (do (command v) (consume! e))
                (and (pos? (count t))
                     (every? (fn [c] (>= (int c) 32)) t)
                     (not (some #{:command :control} (:modifiers e))))
                (do (type-text! v t) (consume! e))
                :else nil))
        (= signal :text-input)
        (when (:editable v)
          (replace-selection! v (:text e) (= 1 (count (:text e)))))
        (and (= signal :mouse-down) (= :left (:button e)))
        (let [p (position-at-point v (:x e) (:y e))]
          (if (contains? (set (:modifiers e)) :shift)
            (set-selection! v (:anchor v) p)
            (set-cursor! v p)))
        :else nil))))

;;; ------------------------------------------------------------------------------------
;;; Appearance, palettes and control sizes

(def system-palette
  "The platform's palette of adaptable colors, for color coding: each keyword's light and
dark sRGB values, which backends without a native palette (macOS has one) use."
  {:system-red ["#FF3B30" "#FF453A"] :system-orange ["#FF9500" "#FF9F0A"]
   :system-yellow ["#FFCC00" "#FFD60A"] :system-green ["#28CD41" "#32D74B"]
   :system-mint ["#00C7BE" "#63E6E2"] :system-teal ["#30B0C7" "#40C8E0"]
   :system-cyan ["#32ADE6" "#64D2FF"] :system-blue ["#007AFF" "#0A84FF"]
   :system-indigo ["#5856D6" "#5E5CE6"] :system-purple ["#AF52DE" "#BF5AF2"]
   :system-pink ["#FF2D55" "#FF375F"] :system-brown ["#A2845E" "#AC8E68"]
   :system-gray ["#8E8E93" "#98989D"]})

(defn system-palette-color
  "The portable value of the palette color name in dark (dark true) or light mode, or nil."
  [name dark]
  (when-let [[light dark-value] (get system-palette name)]
    (parse-color (if dark dark-value light))))

(def derived-palette-roles
  "Palette roles the platforms have no color of their own for, with the role each falls
back to."
  {:selection-text :text :caret :text :gutter-background :background :gutter-text :secondary-text})

(def palette-roles
  "The roles a widget's :palette can set: the semantic system colors (not the color
coding palette), plus :selection-text, :caret, :gutter-background and :gutter-text."
  (into (set (remove (fn [c] (contains? system-palette c)) system-colors))
        (keys derived-palette-roles)))

(def ^:private appearances #{:inherit :system :light :dark})
(def ^:private control-sizes #{:regular :small :mini :large})

(defgeneric backend-widget-appearance [backend widget]
  "The widget's actual appearance, :light or :dark.")

(defn- inherited-appearance
  "The nearest :light or :dark that widget or what holds it asks for, or nil."
  [w]
  (some (fn [o] (let [a (:appearance o)] (when (or (= a :light) (= a :dark)) a)))
        (holders w)))

(defmethod backend-widget-appearance [(b backend) w]
  (or (inherited-appearance w) (if (backend-dark-mode? b) :dark :light)))

(defgeneric backend-color-in-appearance [backend name widget]
  "The color the semantic color keyword name is in the widget's appearance.")

(defmethod backend-color-in-appearance [(b backend) name widget]
  (backend-system-color b name))

(defgeneric backend-apply-palette [backend widget]
  "Recolor the widget's native control after its palette, or an enclosing one, changed.")

(defmethod backend-apply-palette [(b backend) widget]
  nil)

(defn effective-appearance
  "The widget's actual appearance, :light or :dark: its own, or its container's, or the
system's."
  [w]
  (let [b (current-backend)] (in-ui (fn [] (backend-widget-appearance b w)))))

(defn palette-color
  "The color the widget's palette, or the nearest enclosing one, sets for role, or nil."
  [w role]
  (some (fn [o] (get (:palette o) role)) (holders w)))

(defn effective-palette?
  "True if the widget or a container of it has a palette."
  [w]
  (boolean (some :palette (holders w))))

(defn widget-color
  "The color designator as the widget shows it: a semantic color that a palette sets is
the palette's (itself perhaps a semantic color), a derived role a palette leaves out its
base role's, any other semantic color the platform's in the widget's appearance; a color
is itself."
  ([w d] (widget-color w d #{}))
  ([w d seen]
   (let [c (if (and (keyword? d) (contains? palette-roles d)) d (ensure-color d))]
     (if-not (keyword? c)
       c
       (let [override (palette-color w c)
             base (get derived-palette-roles c)]
         (cond (and override (not (contains? seen c)))
               (widget-color w override (conj seen c))
               base (widget-color w base (conj seen c))
               :else (let [b (current-backend)]
                       (in-ui (fn [] (backend-color-in-appearance b c w))))))))))

(defn system-color
  "The color the system color keyword name (one of system-colors) is now, in light or
dark mode, or as the widget shows it (its appearance and palette). Keep the keyword
itself where a color should follow the mode."
  ([name]
   (when-not (contains? system-colors name)
     (error "not a system color:" (pr-str name)))
   (let [b (current-backend)] (in-ui (fn [] (backend-system-color b name)))))
  ([name w]
   (when-not (or (contains? system-colors name) (contains? palette-roles name))
     (error "not a system color:" (pr-str name)))
   (widget-color w name)))

(defn dark-mode?
  "True if the system is in dark mode, or with a widget, if the widget's appearance is
dark."
  ([] (let [b (current-backend)] (in-ui (fn [] (backend-dark-mode? b)))))
  ([w] (= :dark (effective-appearance w))))

(defn notify-palette-changed!
  "Let the backend recolor root and everything in it (and redraw the canvases), after a
palette changed. The core does this when a :palette changes."
  [root]
  (when (realized? root)
    (let [b (current-backend)]
      (doseq [w (widgets-in root)]
        (when (realized? w)
          (in-ui (fn [] (backend-apply-palette b w)))
          (when (instance? canvas-widget w) (redraw! w))))))
  root)

(defn notify-appearance-changed!
  "Work out the appearance of root and everything in it again, and emit
:appearance-changed on each whose effective appearance changed, redrawing canvases and
recoloring palettes. The core does this when an :appearance changes; backends call it
when the system's does."
  [root]
  (when (realized? root)
    (doseq [w (widgets-in root)]
      (when (realized? w)
        (let [new (effective-appearance w)
              old (:last-appearance w)]
          (set-slot! w :last-appearance new)
          (when (and old (not= old new))
            (when (instance? canvas-widget w) (redraw! w))
            (when (effective-palette? w)
              (let [b (current-backend)] (in-ui (fn [] (backend-apply-palette b w)))))
            (emit! w (event-for w :appearance-changed :value new)))))))
  root)

(defn- appearance-property-changed! [o property]
  (if (= property :appearance)
    (do (when (and (= (:appearance o) :system) (not (instance? window-widget o)))
          (error ":system appearance is a window's; a widget inside one has :inherit"))
        (when-not (contains? appearances (:appearance o))
          (error "an appearance is :inherit, :light or :dark, not" (pr-str (:appearance o))))
        (notify-appearance-changed! o))
    (notify-palette-changed! o)))

(defmethod initialize :after [(w widget)]
  (when-not (contains? control-sizes (:control-size w))
    (error "a control size is :regular, :small, :mini or :large, not" (pr-str (:control-size w))))
  (when-not (contains? appearances (:appearance w))
    (error "an appearance is :inherit, :light or :dark, not" (pr-str (:appearance w))))
  (when (= :system (:appearance w))
    (error ":system appearance is a window's; a widget inside one has :inherit"))
  (when (:palette w)
    (doseq [[role _] (:palette w)]
      (when-not (contains? palette-roles role)
        (error "unknown palette role" (pr-str role)))))
  (when (realized? w)
    (set-slot! w :last-appearance (effective-appearance w))))

(defmethod initialize :after [(c container-widget)]
  (when-not (contains? surface-roles (:surface c))
    (error "unknown surface role" (pr-str (:surface c)))))

(defmethod add! :after [(parent ui-object) child]
  (when (instance? widget child)
    (notify-appearance-changed! child)
    (when (effective-palette? child) (notify-palette-changed! child))))

(defn surface-color-role
  "The palette role coloring the surface role, or nil for :automatic."
  [role]
  (get {:window :window-background :content :content-background :sidebar :sidebar-background
        :status :status-background :toolbar :toolbar-background :activity :activity-background
        :popover :popover-background}
       role))

(defn container-fill
  "The color a container (or window) is filled with: its :background, else its palette's
color for its surface role, else nil for the native surface."
  [c]
  (or (:background c)
      (when-let [role (surface-color-role (:surface c))]
        (when (palette-color c role) (widget-color c role)))))
