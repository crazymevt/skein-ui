(ns skein.ui.code-test
  (:require [skein.test :refer [deftest is are testing use-fixtures]]
            [skein.ui :as ui]
            [skein.ui.headless :as headless]))

;; Text buffers and code views (part E of step 6 of M2.14, D-097), on the headless
;; backend.

(use-fixtures :each (fn [t] (ui/use-backend! (headless/backend)) (t)))

(deftest buffers
  (let [b (ui/make-text-buffer {:text "one\ntwo\n\nfour"})
        seen (atom [])]
    (ui/on b :changed (fn [e] (swap! seen conj [(:start e) (:old-end e) (:new-end e)
                                                (:removed-text e) (:inserted-text e)])))
    (is (= 13 (ui/buffer-length b)))
    (is (= 4 (ui/buffer-line-count b)))
    (is (= [0 4 8 9] (mapv (fn [l] (ui/line-start b l)) (range 4))))
    (is (= 7 (ui/line-end b 1)))
    (is (= "" (ui/line-text b 2)))
    (is (= 3 (ui/position-line b 9)))
    (is (= 2 (ui/position-column b 6)))
    (is (= "two\n\nf" (ui/buffer-text b 4 10)))
    (is (= \newline (ui/buffer-char b 3)))
    (is (= 0 (:revision b)))
    (is (= 7 (ui/replace-buffer-range! b 4 7 "TWO")))
    (is (= "one\nTWO\n\nfour" (ui/buffer-text b)))
    (is (= [[4 7 7 "two" "TWO"]] @seen))
    (is (= 1 (:revision b)))
    (ui/insert-into-buffer! b 0 "zero\n")
    (is (= 5 (ui/buffer-line-count b)))
    (ui/delete-buffer-range! b 0 5)
    (is (thrown-with-msg? error "outside the buffer" (ui/replace-buffer-range! b 3 99 "")))
    (is (thrown-with-msg? error "not in the buffer" (ui/line-start b 9)))))

(deftest undo-and-redo
  (let [b (ui/make-text-buffer {:text "ab"})]
    (is (not (ui/can-undo? b)) "the first text isn't a change")
    (ui/replace-buffer-range! b 2 2 "c" true)
    (ui/replace-buffer-range! b 3 3 "d" true)
    (ui/replace-buffer-range! b 4 4 "\n" true)
    (is (= "abcd\n" (ui/buffer-text b)))
    (is (= [4 4] (ui/undo! b)) "the newline alone")
    (is (= [2 2] (ui/undo! b)) "the typing, merged")
    (is (= "ab" (ui/buffer-text b)))
    (is (not (ui/can-undo? b)))
    (ui/redo! b)
    (is (= "abcd" (ui/buffer-text b)))
    (ui/insert-into-buffer! b 4 "!")
    (ui/replace-buffer-range! b 5 5 "?" true)
    (ui/undo! b)
    (is (= "abcd!" (ui/buffer-text b)) "typing doesn't join a program's change")
    (ui/undo! b)
    (ui/with-undo-group [b]
      (ui/delete-buffer-range! b 0 1)
      (ui/insert-into-buffer! b 0 "X"))
    (is (= "Xbcd" (ui/buffer-text b)))
    (is (not (ui/can-redo? b)) "a change forgets what could be redone")
    (ui/undo! b)
    (is (= "abcd" (ui/buffer-text b)) "the group, as one")
    (ui/clear-history! b)
    (is (not (ui/can-undo? b))))
  (let [b (ui/make-text-buffer {:text "abc" :history-limit 0})]
    (ui/insert-into-buffer! b 0 "x")
    (is (not (ui/can-undo? b)))))

(deftest utf16-positions
  (let [b (ui/make-text-buffer {:text "a😀b"})]
    (is (= 3 (ui/buffer-length b)))
    (is (= 3 (ui/buffer-utf16-position b 2)))
    (is (= 2 (ui/buffer-position-from-utf16 b 3)))
    (is (= 4 (ui/utf16-length "a😀b")))))

(deftest buffers-against-a-model
  ;; Random edits to a buffer and to a plain string agree, and undo takes them all back.
  (dotimes [seed 20]
    (let [alphabet ["a" "b" "\n" "é" "😀" "xy" "\n\n" ""]
          start-text "hello\nworld"
          b (ui/make-text-buffer {:text start-text})
          model (atom start-text)]
      (dotimes [_ 60]
        (let [n (count @model)
              s (rand-int (inc n))
              e (+ s (rand-int (inc (- n s))))
              t (apply str (repeatedly (rand-int 4) (fn [] (rand-nth alphabet))))]
          (ui/replace-buffer-range! b s e t)
          (swap! model (fn [m] (str (subs m 0 s) t (subs m e))))
          (is (= @model (ui/buffer-text b)))
          (is (= (count @model) (ui/buffer-length b)))
          (let [p (rand-int (inc (count @model)))
                before (subs @model 0 p)
                line (count (filter (fn [c] (= c \newline)) before))]
            (is (= line (ui/position-line b p)))
            (is (= (ui/utf16-length before) (ui/buffer-utf16-position b p)) "UTF-16 units")
            (is (= p (ui/buffer-position-from-utf16 b (ui/utf16-length before))))
            (is (= (inc (count (filter (fn [c] (= c \newline)) @model)))
                   (ui/buffer-line-count b))))))
      (while (ui/can-undo? b) (ui/undo! b))
      (is (= start-text (ui/buffer-text b))))))

(deftest code-views
  (let [b (ui/make-text-buffer {:text "(defn f [x]\n  x)"})
        changes (atom 0)
        v (ui/code-view {:buffer b :on-changed (fn [_] (swap! changes inc))})
        w (ui/window {:width 400 :height 300} v)]
    (ui/show! w)
    (testing "the selection and editing"
      (ui/set-selection! v 1 5)
      (is (= "defn" (ui/selected-text v)))
      (is (= [1 5] (headless/native-selection v)))
      (ui/replace-selection! v "def")
      (is (= "(def f [x]\n  x)" (ui/code-text v)))
      (is (= 4 (:cursor v)))
      (is (= 1 @changes))
      (ui/undo! v)
      (is (= "(defn f [x]\n  x)" (ui/code-text v))))
    (testing "keys edit as the platform's text view would"
      (ui/set-cursor! v 0)
      (headless/key-down! v "Right")
      (is (= 1 (:cursor v)))
      (headless/key-down! v "Down")
      (is (= 13 (:cursor v)) "the same column, a line down")
      (headless/key-down! v "Shift+Left")
      (is (= [13 12] [(:anchor v) (:cursor v)]))
      (headless/key-down! v "Backspace")
      (is (= "(defn f [x]\n x)" (ui/code-text v)))
      (ui/type-text! v "ab")
      (is (= "(defn f [x]\nab x)" (ui/code-text v)))
      (headless/key-down! v "Primary+Z")
      (is (= "(defn f [x]\n x)" (ui/code-text v)) "the typing, merged"))
    (testing "two views of one buffer"
      (let [v2 (ui/code-view {:buffer b})]
        (ui/set-cursor! v2 3)
        (ui/set-cursor! v 0)
        (ui/replace-selection! v ";; ")
        (is (= 6 (:cursor v2)) "the other caret moves with the text")
        (ui/destroy! v2)
        (is (= [v] (:views b)))))
    (testing "runs"
      (ui/set-text-runs! v [[1 5 {:style :keyword}] [6 7 {:color :red :bold true}]])
      (set-slot! v :text-styles {:keyword {:color :purple}})
      (is (= {:color (ui/ensure-color :purple)} (ui/text-style-at v 2)))
      (ui/insert-into-buffer! b 0 "  ")
      (is (= [3 7] (take 2 (first (ui/text-runs v)))) "runs move with the text")
      (is (seq (headless/applied-runs v)))
      (ui/replace-text-runs! v 0 5 [[0 2 {:italic true}]])
      (is (= [[0 2 {:italic true}] [5 7 {:style :keyword}]] (take 2 (ui/text-runs v)))))
    (testing "geometry"
      (is (= [0 16 16] (ui/point-at-position v (ui/line-start b 1))))
      (is (= (ui/line-start b 1) (ui/position-at-point v 0 20)))
      (is (= 40 (ui/gutter-width v)))
      (is (= [0 1] (ui/visible-lines v))))
    (testing "a completion popup under the caret"
      (let [c (ui/completion-popup {})]
        (ui/set-cursor! v 2)
        (ui/show-completion-popup! c v {:items ["a" "b"]})
        (is (= :caret (:anchor (headless/shown-for c))))
        (is (= [56 0 1 16] (ui/caret-rectangle v)))
        (ui/close-surface! c)))
    (ui/close! w)))

;; A code view's runs against a model (Skein's M3.6, D-108): the runs kept in one sorted
;; vector, moved and replaced as the code view did before it kept them in chunks.

(defn- model-shift [runs start old-end new-end]
  (if (and (= start old-end) (= start new-end))
    runs
    (let [delta (- new-end old-end)]
      (into [] (comp (map (fn [[s e a]]
                            [(if (>= s old-end) (+ s delta) (min s start))
                             (cond (>= e old-end) (+ e delta) (> e start) start :else e)
                             a]))
                     (filter (fn [[s e _]] (< s e))))
            runs))))

(defn- model-replace [runs start end new]
  (let [piece (fn [s e a] (when (< s e) [s e a]))
        old (mapcat (fn [[s e a]]
                      (if (or (<= e start) (>= s end))
                        [[s e a]]
                        (remove nil? [(piece s (min e start) a) (piece (max s end) e a)])))
                    runs)
        new (remove nil? (map (fn [[s e a]] (piece (max start s) (min end e) a)) new))]
    (vec (sort-by first (concat old new)))))

(defn- random-runs
  "About n runs in text of length len, mostly short and apart, some long and overlapping."
  [n len]
  (vec (sort-by first
                (for [_ (range n)
                      :let [s (rand-int (max 1 len))
                            e (min len (+ s 1 (if (< (rand) 0.05) (rand-int 400) (rand-int 8))))]
                      :when (< s e)]
                  [s e {:style (rand-nth [:a :b :c])}]))))

(deftest runs-against-a-model
  (dotimes [seed 6]
    (let [text (apply str (repeatedly 3000 (fn [] (rand-nth ["a" "b" " " "\n" "(" ")"]))))
          b (ui/make-text-buffer {:text text})
          v (ui/code-view {:buffer b})
          shuffled (shuffle (random-runs 900 (count text)))
          model (atom (vec (sort-by first shuffled)))]
      (ui/set-text-runs! v shuffled)
      (is (= @model (ui/text-runs v)) "set-text-runs! sorts them, keeping equal starts' order")
      (dotimes [_ 150]
        (let [n (ui/buffer-length b)]
          (if (< (rand) 0.5)
            (let [s (rand-int (inc n))
                  e (min n (+ s (if (< (rand) 0.3) (rand-int 50) 0)))
                  t (apply str (repeatedly (rand-int 6) (fn [] (rand-nth ["x" "\n" " "]))))]
              (ui/replace-buffer-range! b s e t)
              (swap! model model-shift s e (+ s (count t))))
            (let [s (rand-int (inc n))
                  e (min n (+ s (rand-int 200)))
                  new (random-runs (rand-int 30) n)]
              (ui/replace-text-runs! v s e new)
              (swap! model model-replace s e new)))
          (is (= @model (ui/text-runs v)))
          (let [n (ui/buffer-length b)
                p (rand-int (max 1 n))
                expected (when-let [[_ _ a] (first (filter (fn [[s e _]] (and (<= s p) (< p e)))
                                                           @model))]
                           (ui/resolve-run-attributes v a))]
            (is (= expected (ui/text-style-at v p)))))))))

(deftest rich-run-attributes
  ;; Fonts and paragraphs in runs (Skein's M3.6, D-108).
  (let [b (ui/make-text-buffer {:text "Title\nsome code here\nend"})
        v (ui/code-view {:buffer b :text-styles {:h1 {:size 20 :bold true :space-below 6}}})
        w (ui/window {:width 300 :height 200} v)]
    (ui/show! w)
    (ui/flush-layouts!)
    (testing "the new attributes reach the backend, a style's among them"
      (is (= {:size 20 :bold true :space-below 6}
             (ui/resolve-run-attributes v {:style :h1})))
      (is (= {:family :monospace :indent 8 :first-indent -4 :space-above 2 :tabs [40 80]}
             (ui/resolve-run-attributes v {:family :monospace :indent 8 :first-indent -4
                                           :space-above 2 :tabs [40 80]})))
      (is (= (ui/ensure-color "#eeeeee")
             (:block-background (ui/resolve-run-attributes v {:block-background "#eeeeee"})))))
    (testing "values of the wrong kind"
      (is (thrown-with-msg? error "number of pixels" (ui/resolve-run-attributes v {:indent "8"})))
      (is (thrown-with-msg? error ":family is" (ui/resolve-run-attributes v {:family 12}))))
    (testing "the backend restyles whole lines, with their newlines"
      (ui/set-text-runs! v [[0 5 {:style :h1}] [11 15 {:family :monospace}]])
      (let [before (count (headless/applied-runs v))]
        (ui/replace-text-runs! v 11 13 [[11 13 {:bold true}]])
        (let [[start end runs] (last (headless/applied-runs v))]
          (is (= (inc before) (count (headless/applied-runs v))))
          (is (= [6 21] [start end]) "the line \"some code here\" and its newline")
          (is (= [[11 13 {:bold true}] [13 15 {:family :monospace}]] runs)))))
    (ui/close! w)))
