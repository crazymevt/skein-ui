(ns skein.ui.gtk-test
  (:require [skein.test :refer [deftest is are testing use-fixtures]]
            [skein.ui :as ui]
            [skein.ui.gtk :as gtk]
            [skein.io :as io]))

;; The GTK 4 backend (step 5 of M2.14, D-097), where GTK 4 is installed and can open a
;; display (Linux CI runs it under Xvfb): the widgets as GTK's, read back from GTK and
;; acted on as the user would.

(def gtk? (delay (gtk/available?)))

(def backend (delay (gtk/backend)))

(use-fixtures :each (fn [t] (when @gtk? (ui/use-backend! @backend) (t))))

(deftest windows-and-labels
  (let [l (ui/label {:text "Hello" :tooltip "greeting"})
        w (ui/window {:title "GTK" :width 300 :height 200} (ui/vbox {:padding 10} l))]
    (is (= "GTK" (gtk/native-string w)))
    (is (= "Hello" (gtk/native-string l)))
    (set-slot! l :text "Goodbye")
    (is (= "Goodbye" (gtk/native-string l)))
    (ui/show! w)
    (gtk/settle!)
    (let [[x y width height] (gtk/native-frame l)]
      (is (= [10 10] [x y]) "placed from the top left of its box")
      (is (= 280 width))
      (is (< 10 height 40)))
    (set-slot! l :visible false)
    (is (not (gtk/native-visible? l)))
    (ui/close! w)))

(deftest buttons-and-entries
  (let [clicks (atom 0)
        typed (atom [])
        b (ui/button {:label "Go" :on-clicked (fn [e] (swap! clicks inc))})
        e (ui/entry {:placeholder "Name" :on-changed (fn [ev] (swap! typed conj (:value ev)))
                     :on-activate (fn [ev] (swap! typed conj :return))})
        w (ui/window {} (ui/hbox {:spacing 8} e b))]
    (is (= "Go" (gtk/native-string b)))
    (gtk/click! b)
    (is (= 1 @clicks))
    (gtk/type-text! e "Ada")
    (is (= "Ada" (:text e)))
    (gtk/press-return! e)
    (is (= ["Ada" :return] @typed))
    (set-slot! e :text "Grace")
    (is (= "Grace" (gtk/native-string e)))
    (is (= ["Ada" :return] @typed) "a program's change emits nothing")
    (ui/show! w)
    (gtk/settle!)
    (let [[ex _ ew _] (gtk/native-frame e)
          [bx _ bw _] (gtk/native-frame b)]
      (is (= 0 ex))
      (is (= (+ ew 8) bx))
      (is (< 20 bw 150)))
    (ui/close! w)))

(deftest closing-asks-the-handlers
  (let [w (ui/window {:title "Close me"} (ui/label {:text "x"}))
        veto? (atom true)]
    (ui/on w :close-request (fn [e] (when @veto? (ui/veto e))))
    (ui/show! w)
    (is (not (ui/close! w)))
    (is (gtk/native-visible? w))
    (reset! veto? false)
    (is (ui/close! w))))

(deftest the-main-loop-runs-other-fibers-calls
  (let [l (ui/label {:text "waiting"})
        w (ui/window {:title "Loop"} l)
        seen (atom nil)]
    (ui/show! w)
    (future
      (sleep 0.2)
      (set-slot! l :text "changed during the loop")
      (reset! seen (ui/backend-in-ui-thread (ui/current-backend) (fn [] (gtk/native-string l))))
      (ui/quit!))
    (ui/run!)
    (is (= "changed during the loop" @seen))
    (ui/close! w)))

(deftest toggles-and-ranges
  (let [seen (atom [])
        c (ui/check-box {:label "Wrap" :on-toggled (fn [e] (swap! seen conj (:value e)))})
        r1 (ui/radio-button {:label "S" :checked true})
        r2 (ui/radio-button {:label "M"})
        s (ui/slider {:min 0 :max 10 :value 5 :on-changed (fn [e] (swap! seen conj (:value e)))})
        n (ui/spin-button {:min 1 :max 9 :value 3})
        p (ui/progress-bar {:value 0.5})
        w (ui/window {} (ui/vbox {} c r1 r2 s n p (ui/spinner {})))]
    (gtk/toggle! c)
    (is (= true (:checked c)))
    (gtk/toggle! r2)
    (is (= [false true] (mapv :checked [r1 r2])))
    (is (= [false true] (mapv gtk/native-active? [r1 r2])))
    (set-slot! s :value 7)
    (is (= 7.0 (gtk/native-value s)))
    (gtk/move-slider! s 2)
    (is (= 2 (:value s)))
    (is (= [true 2] @seen))
    (is (= 3.0 (gtk/native-value n)))
    (is (= 0.5 (gtk/native-value p)))
    (ui/show! w)
    (ui/close! w)))

(deftest choices-pickers-and-images
  (let [chosen (atom nil)
        c (ui/combo-box {:items ["Red" "Green"] :selected-index 1
                         :on-changed (fn [e] (reset! chosen (:value e)))})
        e (ui/combo-entry {:items ["8" "10"] :text "10"})
        color (ui/color-button {:color "#ff0000"})
        d (ui/date-picker {:mode :date-time :date 1700000000000})
        img (ui/image-from-file "test/skein/ui/red-3x2.png")
        v (ui/image-view {:image img})]
    (is (= 1 (gtk/native-selected c)))
    (gtk/choose-item! c 0)
    (is (= "Red" @chosen))
    (is (= "10" (:text e)))
    (is (= (ui/rgb 1 0 0) (gtk/native-color color)))
    (is (= (- 1700000000000 (mod 1700000000000 60000)) (gtk/native-date d))
        "to the minute")
    (is (= [3 2] [(:width img) (:height img)]))
    (is (gtk/has-image? v))
    (is (gtk/has-image? (ui/image-view {:image (ui/image-from-pixels 1 1 (make-array u8 4))})))))

(deftest containers
  (let [l (ui/label {:text "inside"})
        f (ui/frame {:title "Box"} l)
        page1 (ui/label {:text "one" :tab-label "One"})
        page2 (ui/label {:text "two" :tab-label "Two"})
        pages (atom [])
        nb (ui/notebook {:on-page-changed (fn [e] (swap! pages conj (:index e)))} page1 page2)
        a (ui/label {:text "left"})
        b (ui/label {:text "right"})
        split (ui/paned {:position 80} a b)
        big (ui/label {:text "big" :height 500})
        scroll (ui/scrolled-window {:min-content-height 60} big)
        tv (ui/text-view {:text "Hello"})
        w (ui/window {:width 400 :height 600} (ui/vbox {} f nb split scroll tv))]
    (ui/show! w)
    (gtk/settle!)
    (dotimes [_ 5] (gtk/settle!))
    (is (= 400 (:width w)) "the split pane's divider is counted: GTK doesn't widen the window")
    (testing "a frame holds its content inside its border"
      (let [[_ _ fw fh] (gtk/native-frame f)
            [lx ly lw lh] (gtk/native-frame l)]
        (is (= [0 0] [lx ly]) "placed in the frame's inner fixed")
        (is (< lw fw))
        (is (< lh fh))))
    (testing "notebooks"
      (is (= ["One" "Two"] (gtk/tab-labels nb)))
      (gtk/choose-tab! nb 1)
      (is (= [1] @pages))
      (set-slot! nb :selected-index 0)
      (is (= [1] @pages) "a program's change emits nothing")
      (set-slot! page2 :tab-label "Second")
      (is (= ["One" "Second"] (gtk/tab-labels nb))))
    (testing "scrolled windows"
      (ui/scroll-to! scroll 0 100)
      (gtk/settle!)
      (is (= 100 (second (gtk/scroll-origin scroll)))))
    (testing "text views"
      (is (= "Hello" (gtk/native-text tv)))
      (ui/append-text! tv ", world")
      (is (= "Hello, world" (gtk/native-text tv)))
      (ui/set-text-selection! tv 0 5)
      (ui/insert-text! tv "Bye")
      (is (= "Bye, world" (gtk/native-text tv)))
      (is (= "Bye, world" (:text tv)))
      (gtk/edit-text! tv "typed")
      (is (= "typed" (:text tv))))
    (ui/close! w)))

(deftest lists-tables-and-trees
  (let [seen (atom [])
        l (ui/list-box {:items ["a" "b" "c"]
                        :on-selection-changed (fn [e] (swap! seen conj [:selected (:index e)]))
                        :on-row-activated (fn [e] (swap! seen conj [:activated (:item e)]))})
        t (ui/table-view {:columns [(ui/column "Name" :name {:width 100})
                                    (ui/column "Age" :age)]
                          :items [{:name "Ada" :age 36} {:name "Bob" :age 7}]})
        files {"/" ["docs" "src"] "src" ["main.skn"]}
        tree (ui/tree-view {:roots ["/"] :children-fn (fn [f] (get files f []))
                            :on-expanded (fn [e] (swap! seen conj [:expanded (:item e)]))})
        w (ui/window {:width 400 :height 500} (ui/vbox {} l t tree))]
    (ui/show! w)
    (gtk/settle!)
    (testing "list boxes"
      (is (= 3 (gtk/row-count l)))
      (is (= "b" (gtk/cell-string l 1 0)))
      (gtk/select-rows-natively! l [2])
      (is (= [2] (:selected-indices l)))
      (gtk/activate-row! l 2)
      (set-slot! l :items ["x" "y"])
      (is (= 2 (gtk/row-count l)))
      (is (= [[:selected 2] [:activated "c"]] @seen)))
    (testing "tables sort by a clicked column"
      (is (= "36" (gtk/cell-string t 0 1)))
      (gtk/click-column-title! t 1)
      (gtk/settle!)
      (is (= ["Bob" "Ada"] (mapv :name (:items t))))
      (is (= "Bob" (gtk/cell-string t 0 0))))
    (testing "trees"
      (is (= 1 (gtk/row-count tree)))
      (ui/expand! tree "/")
      (is (= 3 (gtk/row-count tree)))
      (gtk/expand-natively! tree "src")
      (is (= 4 (gtk/row-count tree)))
      (is (ui/expanded? tree "src"))
      (is (= [:expanded "src"] (last @seen)))
      (gtk/select-rows-natively! tree [3])
      (is (= ["main.skn"] (:selection tree))))
    (ui/close! w)))

(deftest canvases-draw-and-get-the-mouse
  (let [clicks (atom [])
        c (ui/canvas {:width 200 :height 100 :background :white
                      :on-draw (fn [e]
                                 (let [gc (:context e)]
                                   (ui/fill-rectangle! gc 0 0 100 100 {:color "#ff0000"})
                                   (ui/fill-circle! gc 150 50 20 {:color "#0000ff"})
                                   (ui/draw-line! gc 110 90 190 90 {:color :black :line-width 2})
                                   (ui/draw-text! gc "Hi" 110 5 {:color :black})))
                      :on-mouse-down (fn [e] (swap! clicks conj [(:x e) (:y e) (:button e)]))})
        w (ui/window {} c)]
    (ui/show! w)
    (gtk/settle!)
    (is (= (ui/rgb 1 0 0) (gtk/draw-into-image! c 50 50)) "the red square")
    (is (= (ui/rgb 0 0 1) (gtk/draw-into-image! c 150 50)) "the blue circle")
    (is (= (ui/rgb 1 1 1) (gtk/draw-into-image! c 195 5)) "the white background")
    (let [[tw th] (ui/text-extent "abcdefghij" {:size 12})]
      (is (< 40 tw 120))
      (is (< 10 th 25)))
    (gtk/press-mouse! c 30 40)
    (is (= [[30.0 40.0 :left]] @clicks))
    (ui/close! w)))

(deftest menus
  (let [log (atom [])
        save (ui/menu-item {:label "Save" :shortcut "Primary+Shift+S"
                            :on-activate (fn [e] (swap! log conj :save))})
        wrap (ui/check-menu-item {:label "Wrap"})
        quit (ui/menu-item {:role :quit :on-activate (fn [e] (swap! log conj :quit))})
        file (ui/menu {:title "File"} save quit)
        bar (ui/menu-bar {} file (ui/menu {:title "Edit"} wrap))
        w (ui/window {:menu-bar bar} (ui/label {:text "x"}))]
    (ui/show! w)
    (gtk/settle!)
    (is (= ["File" "Edit"] (gtk/menu-labels bar)))
    (is (= ["Save" "Quit"] (gtk/menu-labels file)))
    (is (= "<Control><Shift>s" (gtk/accelerator "Control+Shift+S")))
    (gtk/activate-menu-item-natively! save)
    (gtk/activate-menu-item-natively! wrap)
    (gtk/activate-menu-item-natively! quit)
    (is (= [:save :quit] @log))
    (is (:checked wrap))
    (set-slot! save :label "Save All")
    (is (= ["Save All" "Quit"] (gtk/menu-labels file)))
    (set-slot! file :title "Document")
    (is (= ["Document" "Edit"] (gtk/menu-labels bar)))
    (ui/close! w)))

(deftest dialogs
  (gtk/answer-next-dialog! "Don't Save")
  (is (= :discard (ui/message-box "Save changes?" {:buttons :save-discard-cancel})))
  (gtk/answer-next-dialog! nil)
  (is (= :save (ui/message-box "Again?" {:buttons :save-discard-cancel}))
      "dismissing gives the default button's response")
  (gtk/answer-next-dialog! "Ada")
  (is (= "Ada" (ui/prompt-text "Your name?")))
  (gtk/answer-next-dialog! nil)
  (is (nil? (ui/prompt-text "Your name?")))
  (gtk/answer-next-dialog! nil)
  (is (nil? (ui/choose-file {:filters [["Text" "txt"]]}))))

(deftest timers-and-the-clipboard
  (let [ticks (atom [])
        once (ui/after 0.05 (fn [] (swap! ticks conj :once)))
        often (ui/every 0.04 (fn [] (swap! ticks conj :often)))]
    ;; Until the ticks came, or two seconds: a busy machine may run the loop late.
    (loop [n 0]
      (when (and (< n 20) (not (and (some #{:once} @ticks)
                                    (<= 3 (count (filter #{:often} @ticks))))))
        (gtk/run-for! 0.1)
        (recur (inc n))))
    (ui/stop-timer! often)
    (is (= 1 (count (filter #{:once} @ticks))))
    (is (<= 3 (count (filter #{:often} @ticks))))
    (is (not (ui/timer-running? once))))
  (ui/set-clipboard-text! "from skein-ui's GTK backend")
  (is (= "from skein-ui's GTK backend" (ui/clipboard-text)))
  (is (instance? ui/color (ui/system-color :accent)))
  (is (boolean? (ui/dark-mode?))))

(deftest lgt-basics
  (let [l (ui/label {:text "Big" :font {:size 22 :weight :bold} :text-color :red})
        e (ui/entry {})
        keys (atom [])
        w (ui/window {:title "Basics" :resizable false} (ui/vbox {} l e))]
    (ui/on e :key-down (fn [ev] (swap! keys conj (:key ev))
                         (when (= (:key ev) \x) (ui/consume! ev))))
    (ui/show! w)
    (gtk/settle!)
    (is (< 25 (nth (gtk/native-frame l) 3)) "a 22-point label is tall")
    (is (not (gtk/native-resizable? w)))
    (is (not (gtk/send-key! e \a)))
    (is (gtk/send-key! e \x) "a handler consumed it")
    (is (= [\a \x] @keys))
    (ui/close! w))
  (testing "modal runs"
    (let [w (ui/window {:title "Modal"} (ui/label {:text "x"}))]
      (ui/after 0.1 (fn [] (ui/end-modal! w 42)))
      (is (= 42 (ui/run-modal w)))
      (ui/close! w))))

(deftest appearance-and-surfaces
  (let [changes (atom [])
        l (ui/label {:text "x"})
        side (ui/vbox {:surface :sidebar :palette {:text "#ff0000"}} l)
        c (ui/canvas {:on-appearance-changed (fn [e] (swap! changes conj (:value e)))})
        w (ui/window {:title "Look"} (ui/hbox {} side c))]
    (ui/show! w)
    (set-slot! w :appearance :light)
    (reset! changes [])
    (set-slot! w :appearance :dark)
    (is (= :dark (ui/effective-appearance c)))
    (is (= [:dark] @changes))
    (is (not= (ui/system-color :background c) (do (set-slot! w :appearance :light)
                                                  (ui/system-color :background c))))
    (is (= (ui/rgb 1 0 0) (ui/system-color :text l)))
    (is (gtk/has-css-rule? l) "the palette's text color is the label's CSS")
    (ui/close! w)))

(deftest stacks-and-tabbed-panes
  (let [a (ui/label {:text "one"})
        b (ui/label {:text "two"})
        s (ui/stack {} a b)
        n (ui/vertical-notebook {} (ui/label {:text "general" :tab-label "General"})
                                (ui/label {:text "other" :tab-label "Other"}))
        w (ui/window {:title "Stacks"} (ui/vbox {} s n))]
    (ui/show! w)
    (gtk/settle!)
    (is (not (gtk/native-visible? b)))
    (ui/select-page! s b)
    (is (gtk/native-visible? b))
    (is (not (gtk/native-visible? a)))
    (is (= 150 (nth (gtk/native-frame (:page-list n)) 2)) "the list of pages")
    (ui/close! w))
  (let [closed (atom [])
        a (ui/text-view {:tab-label "Notes" :tab-tooltip "Your notes"})
        b (ui/text-view {:tab-closable false})
        c (ui/text-view {:tab-label "Third"})
        p (ui/tabbed-pane {:drag-group :docs :on-page-closed (fn [e] (swap! closed conj (:index e)))}
                          a b c)
        q (ui/tabbed-pane {:drag-group :docs} (ui/text-view {:tab-label "Other"}))
        w (ui/window {:width 800 :height 400} (ui/hbox {:homogeneous true} p q))]
    (ui/add! (:end (ui/tab-bar p)) (ui/button {:label "+"}))
    (ui/show! w)
    (gtk/settle!)
    (testing "tabs are GtkNotebook tabs"
      (is (= {:title "Notes" :closable true :tooltip "Your notes"} (gtk/native-tab a)))
      (is (= "Page 2" (:title (gtk/native-tab b))))
      (is (not (:closable (gtk/native-tab b)))))
    (testing "finding a tab by its point"
      (let [[x y] (gtk/tab-point c)]
        (is (identical? c (ui/tab-at-point p x y)))))
    (testing "reordering in GTK moves the page"
      (gtk/reorder-tab! a 2)
      (is (= [b c a] (:children p))))
    (testing "closing a tab"
      (gtk/click-tab-close! c)
      (is (= [1] @closed))
      (is (= [b a] (:children p))))
    (testing "dropping a tab on another pane"
      (gtk/drag-tab-to! a q)
      (gtk/settle!)
      (is (= [b] (:children p)))
      (is (identical? a (last (:children q))))
      (is (= 1 (:selected-index q))))
    (ui/close! w)))

(deftest popovers-and-completion-popups
  (let [closed (atom [])
        name (ui/entry {})
        b (ui/button {:label "Settings"})
        v (ui/text-view {:text "ab\ncd"})
        p (ui/popover {:on-closed (fn [e] (swap! closed conj (:value e)))}
                      (ui/vbox {} (ui/label {:text "Name"}) name))
        w (ui/window {:title "Popovers" :width 400 :height 300} (ui/vbox {} b v))]
    (ui/show! w)
    (gtk/settle!)
    (testing "a popover"
      (ui/show-popover! p b {:focus name})
      (gtk/settle!)
      (is (gtk/native-surface-shown? p))
      (ui/close-surface! p)
      (gtk/settle!)
      (is (not (gtk/native-surface-shown? p)))
      (is (= [:closed] @closed) "the program's closing isn't taken for the user's"))
    (testing "a completion popup under the caret"
      (let [c (ui/completion-popup {})]
        (ui/focus! v)
        (ui/set-text-selection! v 4 4)
        (gtk/settle!)
        (let [[x y _ h] (ui/caret-rectangle v)]
          (is (< 0 h 40))
          (is (< 5 y 60) "on the second line")
          (is (< 0 x 40) "after a character"))
        (ui/show-completion-popup! c v {:items ["cab" "car" "cat"]})
        (gtk/settle!)
        (is (gtk/native-surface-shown? c))
        (is (identical? v (ui/focused-widget)) "the view keeps the keyboard")
        (ui/close-surface! c)
        (gtk/settle!)
        (is (not (gtk/native-surface-shown? c)))))
    (ui/close! w)))

(deftest code-views
  (let [b (ui/make-text-buffer {:text "(defn f [x]\n  x)"})
        v (ui/code-view {:buffer b})
        v2 (ui/code-view {:buffer b :line-numbers false})
        empty (ui/code-view {:placeholder "Type here"})
        w (ui/window {:title "Code" :width 500 :height 400} (ui/vbox {} v v2 empty))]
    (ui/show! w)
    (gtk/settle!)
    (is (= "(defn f [x]\n  x)" (gtk/code-native-text v)))
    (testing "the core's edits reach both views"
      (ui/insert-into-buffer! b 0 ";; ")
      (is (= ";; (defn f [x]\n  x)" (gtk/code-native-text v)))
      (is (= ";; (defn f [x]\n  x)" (gtk/code-native-text v2))))
    (testing "typing in one view changes the buffer and the other view"
      (ui/set-cursor! v 3)
      (is (= [3 3] (gtk/code-native-selection v)))
      (gtk/type-into-code-view! v "x")
      (is (= ";; x(defn f [x]\n  x)" (ui/buffer-text b)))
      (is (= 4 (:cursor v)))
      (is (= ";; x(defn f [x]\n  x)" (gtk/code-native-text v2)))
      (ui/undo! v)
      (is (= ";; (defn f [x]\n  x)" (gtk/code-native-text v))))
    (testing "geometry"
      (gtk/settle!)
      (let [[x0 y0 h] (ui/point-at-position v 0)
            [_ y1 _] (ui/point-at-position v (ui/line-start b 1))]
        (is (< 0 h 40))
        (is (< y0 y1))
        (is (= (ui/line-start b 1) (ui/position-at-point v (+ x0 1) (+ y1 2)))))
      (is (< 20 (ui/gutter-width v) 80))
      (is (= [0 1] (ui/visible-lines v))))
    (testing "runs"
      (ui/set-text-runs! v [[4 8 {:color :purple :bold true}]])
      (is (= [[4 8 {:color :purple :bold true}]] (ui/text-runs v))))
    (testing "the placeholder shows while empty"
      (is (gtk/code-placeholder-shown? empty))
      (ui/set-code-text! empty "x")
      (is (not (gtk/code-placeholder-shown? empty))))
    (ui/close! w)))

(deftest images-fonts-and-row-icons
  (let [png (io/read-bytes "test/skein/ui/red-3x2.png")
        i (ui/image-from-bytes png)
        g (ui/glyph-image "λ" {:size 20})
        star (or (ui/system-image "starred") (ui/system-image "folder") g)]
    (is (= [3 2] [(:width i) (:height i)]))
    (is (nil? (ui/system-image "no-such-icon-anywhere")))
    (is (pos? (count (ui/font-families))))
    (let [l (ui/list-box {:items ["a" "b"] :icon-fn (fn [x] (when (= x "a") star))})
          t (ui/table-view {:items [{:n 1}] :columns [(ui/column "N" :n {:icon-fn (fn [_] g)})]})
          c (ui/canvas {:on-draw (fn [e] (ui/draw-image! (:context e) g 0 0)
                                   (ui/draw-image! (:context e) i 20 0))})
          v (ui/image-view {:image i})
          w (ui/window {:title "Images" :width 300 :height 300} (ui/vbox {} l t v c))]
      (ui/show! w)
      (gtk/settle!)
      (is (= "a" (gtk/cell-string l 0 0)))
      (is (gtk/cell-has-icon? l 0 0))
      (is (not (gtk/cell-has-icon? l 1 0)))
      (is (gtk/cell-has-icon? t 0 0))
      (is (gtk/has-image? v))
      (ui/close! w))
    (ui/free-image! i)
    (is (thrown-with-msg? error "freed" (ui/image-view {:image i})))))

(deftest window-states
  (let [w (ui/window {:title "States" :width 400 :height 300} (ui/label {:text "x"}))
        wait (fn [state] (loop [n 0]
                           (gtk/settle!)
                           (when (and (< n 100) (not= state (ui/window-state w)))
                             (sleep 0.02)
                             (recur (inc n)))))]
    (ui/show! w)
    (gtk/settle!)
    (is (= :normal (ui/window-state w)))
    (set-slot! w :state :maximized)
    (wait :maximized)
    (is (= :maximized (ui/window-state w)))
    (gtk/settle!)
    (is (= :maximized (:state w)))
    (is (= [400 300] (:size (ui/window-frame w))) "the normal size is kept")
    (set-slot! w :state :normal)
    (wait :normal)
    (gtk/settle!)
    (is (= :normal (ui/window-state w)))
    (is (= [400 300] [(:width w) (:height w)]))
    (ui/close! w)))

(deftest web-views
  ;; WebKitGTK 6.0 is Linux's: Linux CI installs it; elsewhere this checks nothing.
  (when (gtk/web-available?)
    (let [loaded (atom [])
          messages (atom [])
          v (ui/web-view {:html "<html><body><h1 id='t'>Hello</h1><script>window.skein.postMessage({ready:true});</script></body></html>"
                          :local-messages true
                          :on-loaded (fn [e] (swap! loaded conj (:value e)))
                          :on-message (fn [e] (swap! messages conj (:value e)))})
          w (ui/window {:title "Web" :width 500 :height 400} v)
          wait (fn [pred] (loop [n 0] (gtk/settle!) (when (and (< n 200) (not (pred))) (sleep 0.05) (recur (inc n)))))]
      (is (= :webkitgtk (ui/web-engine v)))
      (ui/show! w)
      (wait (fn [] (seq @loaded)))
      (is (= 1 (count @loaded)))
      (wait (fn [] (seq @messages)))
      (is (= ["{\"ready\":true}"] @messages))
      (let [result (atom nil)]
        (ui/run-script! v "document.getElementById('t').textContent" (fn [r e] (reset! result [r e])))
        (wait (fn [] @result))
        (is (= ["\"Hello\"" nil] @result)))
      (ui/close! w))))
