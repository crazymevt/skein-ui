(ns skein.ui.cocoa-test
  (:require [skein.test :refer [deftest is are testing use-fixtures]]
            [skein.ui :as ui]
            [skein.ui.cocoa :as cocoa]
            [skein.ui.cocoa.objc :as objc]
            [skein.system :as system]
            [skein.io :as io]
            [skein.ffi :as ffi]
            [skein.string :as string]))

;; The Cocoa backend (step 4 of M2.14, D-097), on macOS only: the widgets as AppKit
;; controls, read back from AppKit and acted on as the user would.

(def mac? (= :macos (system/os)))

(def backend
  (when mac?
    (delay
      (let [b (cocoa/backend)
            info (objc/send (objc/cls "NSProcessInfo") (objc/sel "processInfo"))]
        ;; On CI every application is in the background, where App Nap slows timers and
        ;; the run loop: a user-initiated, latency-critical activity keeps the tests' pace.
        ;; NSActivityUserInitiated 0x00FFFFFF | NSActivityLatencyCritical 0xFF00000000.
        (objc/retain (objc/send-lp info (objc/sel "beginActivityWithOptions:reason:")
                                   0xFF00FFFFFF (objc/ns-string "skein-ui's tests")))
        b))))

(use-fixtures :each (fn [t] (when mac? (ui/use-backend! @backend) (t))))

(defn- run-until!
  "Run the event loop until (done?) or two seconds have passed; returns (done?)."
  [done?]
  (loop [n 0]
    (cond (done?) true
          (>= n 100) false
          :else (do (cocoa/run-for! 0.02) (recur (inc n))))))

(deftest windows-and-labels
  (let [l (ui/label {:text "Hello" :tooltip "greeting"})
        w (ui/window {:title "Cocoa" :width 300 :height 200} (ui/vbox {:padding 10} l))]
    (is (= "Cocoa" (cocoa/native-string w)))
    (is (= "Hello" (cocoa/native-string l)))
    (set-slot! l :text "Goodbye")
    (is (= "Goodbye" (cocoa/native-string l)))
    (ui/show! w)
    (let [[x y width height] (cocoa/native-frame l)]
      (is (= [10 10] [x y]) "flipped: placed from the top left")
      (is (= 280 width))
      (is (< 10 height 30)))
    (set-slot! l :visible false)
    (is (cocoa/native-bool l "isHidden"))
    (ui/close! w)))

(deftest buttons-and-entries
  (let [clicks (atom 0)
        typed (atom [])
        b (ui/button {:label "Go" :on-clicked (fn [e] (swap! clicks inc))})
        e (ui/entry {:placeholder "Name" :on-changed (fn [ev] (swap! typed conj (:value ev)))
                     :on-activate (fn [ev] (swap! typed conj :return))})
        w (ui/window {} (ui/hbox {:spacing 8} e b))]
    (is (= "Go" (cocoa/native-string b)))
    (cocoa/click! b)
    (is (= 1 @clicks))
    (cocoa/type-text! e "Ada")
    (is (= "Ada" (:text e)))
    (cocoa/press-return! e)
    (is (= ["Ada" :return] @typed))
    (set-slot! e :text "Grace")
    (is (= "Grace" (cocoa/native-string e)))
    (testing "layout uses AppKit's natural sizes"
      (ui/show! w)
      (let [[ex _ ew _] (cocoa/native-frame e)
            [bx _ bw _] (cocoa/native-frame b)]
        (is (= 0 ex))
        (is (= 150 ew) "20 characters of about 7 pixels")
        (is (= (+ ew 8) bx))
        (is (< 30 bw 120))))
    (ui/close! w)))

(deftest closing-asks-the-handlers
  (let [w (ui/window {:title "Close me"} (ui/label {:text "x"}))
        veto? (atom true)]
    (ui/on w :close-request (fn [e] (when @veto? (ui/veto e))))
    (ui/show! w)
    (is (not (ui/close! w)))
    (is (cocoa/native-bool w "isVisible"))
    (reset! veto? false)
    (is (ui/close! w))))

(deftest calls-from-other-fibers
  (let [l (ui/label {:text "before"})]
    @(future (set-slot! l :text "from a fiber"))
    (is (= "from a fiber" (cocoa/native-string l)))))

(deftest the-event-loop-runs-other-fibers-calls
  (let [l (ui/label {:text "waiting"})
        w (ui/window {:title "Loop"} l)
        seen (atom nil)]
    (ui/show! w)
    (future
      (sleep 0.2)
      (set-slot! l :text "changed during the loop")
      (reset! seen (cocoa/native-string l))
      (ui/quit!))
    (ui/run!)
    (is (= "changed during the loop" @seen))
    (ui/close! w)))

(deftest toggles-and-ranges
  (let [seen (atom [])
        c (ui/check-box {:label "Wrap" :on-toggled (fn [e] (swap! seen conj (:value e)))})
        r1 (ui/radio-button {:label "S" :checked true})
        r2 (ui/radio-button {:label "M"})
        s (ui/slider {:min 0 :max 10 :value 5 :on-changed (fn [e] (swap! seen conj (:value e)))})
        n (ui/spin-button {:min 1 :max 9 :value 3})
        p (ui/progress-bar {:value 0.5})
        w (ui/window {} (ui/vbox {} c r1 r2 s n p (ui/spinner {})))]
    (is (= "Wrap" (cocoa/native-string c)))
    (is (not= 0 (cocoa/native-image-position c)) "the box shows (not NSNoImage)")
    (is (not= 0 (cocoa/native-image-position r1)))
    (cocoa/click! c)
    (is (= true (:checked c)))
    (cocoa/click! r2)
    (is (= [false true] (mapv :checked [r1 r2])))
    (set-slot! s :value 7)
    (is (= 7.0 (cocoa/native-double s "doubleValue")))
    (cocoa/set-native-double! s 2.0)
    (is (= 2 (:value s)))
    (is (= [true 2] @seen))
    (is (= "3" (cocoa/native-spin-text n)))
    (set-slot! n :value 4)
    (is (= "4" (cocoa/native-spin-text n)))
    (is (= 0.5 (cocoa/native-double p "doubleValue")))
    (ui/show! w)
    (ui/close! w)))

(deftest choices-pickers-and-images
  (let [chosen (atom nil)
        c (ui/combo-box {:items ["Red" "Green"] :selected-index 1
                         :on-changed (fn [e] (reset! chosen (:value e)))})
        color (ui/color-button {:color "#ff0000"})
        d (ui/date-picker {:date 0})
        img (ui/image-from-file "test/skein/ui/red-3x2.png")
        v (ui/image-view {:image img})]
    (is (= "Green" (cocoa/native-title-of-selected c)))
    (cocoa/choose-item! c 0)
    (is (= "Red" @chosen))
    (is (= (ui/rgb 1 0 0) (cocoa/native-color color)))
    (is (= 0 (cocoa/native-date d)))
    (is (= [3 2] [(:width img) (:height img)]))
    (is (= [3 2] (ui/preferred-size v)))
    (is (cocoa/has-image? v))
    (is (cocoa/has-image? (ui/image-view {:image (ui/image-from-pixels 1 1 (make-array u8 4))})))))

(deftest containers
  (let [l (ui/label {:text "inside"})
        f (ui/frame {:title "Box"} l)
        page1 (ui/label {:text "one" :tab-label "One"})
        page2 (ui/label {:text "two" :tab-label "Two"})
        pages (atom [])
        nb (ui/notebook {:on-page-changed (fn [e] (swap! pages conj (:index e)))} page1 page2)
        a (ui/label {:text "left"})
        b (ui/label {:text "right"})
        split (ui/paned {:position 80} a b)
        big (ui/label {:text "big" :height 500})
        scroll (ui/scrolled-window {:min-content-height 60} big)
        tv (ui/text-view {:text "Hello"})
        w (ui/window {:width 400 :height 600} (ui/vbox {} f nb split scroll tv))]
    (ui/show! w)
    (testing "a frame holds its content inside its border"
      (let [[x y fw fh] (cocoa/native-frame f)
            [lx ly lw lh] (cocoa/native-frame l)]
        (is (= [0 0] [lx ly]) "placed in the frame's content view")
        (is (< lw fw))
        (is (< lh fh))))
    (testing "notebooks"
      (is (= ["One" "Two"] (cocoa/tab-labels nb)))
      (cocoa/choose-tab! nb 1)
      (is (= [1] @pages))
      (is (= 1 (:selected-index nb)))
      (set-slot! nb :selected-index 0)
      (is (= [1] @pages) "a program's change emits nothing")
      (set-slot! page2 :tab-label "Second")
      (is (= ["One" "Second"] (cocoa/tab-labels nb))))
    (testing "split panes"
      (is (= 80 (nth (cocoa/native-frame a) 2))))
    (testing "scrolled windows"
      (is (= 500 (nth (cocoa/native-frame big) 3)) "the content keeps its height")
      (ui/scroll-to! scroll 0 100)
      (is (= 100 (second (cocoa/scroll-origin scroll)))))
    (testing "text views"
      (is (= "Hello" (cocoa/native-text tv)))
      (ui/append-text! tv ", world")
      (is (= "Hello, world" (cocoa/native-text tv)))
      (ui/set-text-selection! tv 0 5)
      (ui/insert-text! tv "Bye")
      (is (= "Bye, world" (cocoa/native-text tv)))
      (is (= "Bye, world" (:text tv))))
    (ui/close! w)))

(deftest lists-tables-and-trees
  (let [seen (atom [])
        l (ui/list-box {:items ["a" "b" "c"]
                        :on-selection-changed (fn [e] (swap! seen conj [:selected (:index e)]))
                        :on-row-activated (fn [e] (swap! seen conj [:activated (:item e)]))})
        t (ui/table-view {:columns [(ui/column "Name" :name {:width 100})
                                    (ui/column "Age" :age)]
                          :items [{:name "Ada" :age 36} {:name "Bob" :age 7}]})
        files {"/" ["docs" "src"] "src" ["main.skn"]}
        tree (ui/tree-view {:roots ["/"] :children-fn (fn [f] (get files f []))
                            :on-expanded (fn [e] (swap! seen conj [:expanded (:item e)]))})
        w (ui/window {:width 400 :height 500} (ui/vbox {} l t tree))]
    (ui/show! w)
    (testing "list boxes"
      (is (= 3 (cocoa/row-count l)))
      (is (= "b" (cocoa/cell-string l 1 0)))
      (cocoa/select-rows-natively! l [2])
      (is (= [2] (:selected-indices l)))
      (cocoa/double-click-selected! l)
      (set-slot! l :items ["x" "y"])
      (is (= 2 (cocoa/row-count l)))
      (is (= [[:selected 2] [:activated "c"]] @seen)))
    (testing "tables sort by a clicked column"
      (is (= "36" (cocoa/cell-string t 0 1)))
      (cocoa/click-column-title! t 1)
      (is (= "Bob" (cocoa/cell-string t 0 0)))
      (is (= ["Bob" "Ada"] (mapv :name (:items t)))))
    (testing "trees"
      (is (= 1 (cocoa/row-count tree)))
      (ui/expand! tree "/")
      (is (= 3 (cocoa/row-count tree)))
      (is (= "src" (cocoa/cell-string tree 2 0)))
      (cocoa/expand-natively! tree "src")
      (is (= 4 (cocoa/row-count tree)))
      (is (ui/expanded? tree "src"))
      (is (= [:expanded "src"] (last @seen)))
      (cocoa/select-rows-natively! tree [3])
      (is (= ["main.skn"] (:selection tree))))
    (ui/close! w)))

(deftest editing-cells
  ;; Skein's M3.6, D-108.
  (let [seen (atom [])
        name-col (ui/column "Name" :name {:editable true})
        age-col (ui/column "Age" :age)
        t (ui/table-view {:columns [name-col age-col]
                          :items [{:name "Ada" :age 36} {:name "Bob" :age 7}]
                          :on-cell-edited (fn [e] (swap! seen conj [(:index e) (:title (:column e))
                                                                    (:text e)]))})
        w (ui/window {:width 300 :height 200} t)]
    (ui/show! w)
    (is (cocoa/cell-editable? t 0 0))
    (is (not (cocoa/cell-editable? t 0 1)))
    (testing "an edit is reported; the cell shows :items again"
      (cocoa/edit-cell-natively! t 1 0 "Robert")
      (is (= [[1 "Name" "Robert"]] @seen))
      (is (= "Bob" (cocoa/cell-string t 1 0))))
    (testing "a handler that saves it"
      (ui/on t :cell-edited
             (fn [e] (set-slot! t :items (assoc-in (vec (:items t)) [(:index e) :name] (:text e)))))
      (cocoa/edit-cell-natively! t 0 0 "Augusta")
      (is (= "Augusta" (:name (first (:items t)))))
      (is (= "Augusta" (cocoa/cell-string t 0 0))))
    (testing "after the user moves the column"
      (cocoa/move-column-natively! t 0 1)
      (is (cocoa/cell-editable? t 0 1))
      (is (not (cocoa/cell-editable? t 0 0)))
      (cocoa/edit-cell-natively! t 1 1 "Bobby")
      (is (= [1 "Name" "Bobby"] (last @seen))))
    (ui/close! w)))

(deftest rich-text
  ;; Skein's M3.6, D-108.
  (let [seen (atom [])
        r (ui/rich-text {:content [[:h2 "Result"]
                                   [:p "Call " [:code "(f 1)"] " or see "
                                    [:a {:href "https://x.test"} "the docs"] "."]
                                   [:ul [:li "one"] [:li "two"]]
                                   [:pre "(defn f [x]\n  x)"]
                                   [:table [:tr [:th "Name"] [:th "Age"]]
                                           [:tr [:td "Ada"] [:td "36"]]]]
                         :on-link-activated (fn [e] (swap! seen conj (:href e)))})
        w (ui/window {:width 400 :height 300} r)
        text (fn [] (ui/code-text r))
        at (fn [s] (string/index-of (text) s))]
    (ui/show! w)
    (cocoa/run-for! 0.05)
    (is (= (text) (cocoa/native-code-text r)))
    (testing "headings, code, lists and tables in the text storage"
      (is (= 19.5 (:size (cocoa/code-text-attributes r 0))))
      (is (:monospace (cocoa/code-text-attributes r (at "(f 1)"))))
      (is (not (:monospace (cocoa/code-text-attributes r (at "Call")))) "proportional text")
      (is (= [24.0 -18.0] ((juxt :indent :first-indent) (cocoa/code-text-attributes r (at "one")))))
      (is (:block-background (cocoa/code-text-attributes r (at "(defn"))))
      (is (= 1 (count (:tabs (cocoa/code-text-attributes r (at "Ada")))))))
    (testing "links are AppKit's, and their clicks are reported"
      (is (= "0" (cocoa/link-at-native r (+ 2 (at "the docs")))))
      (is (nil? (cocoa/link-at-native r (at "Call"))))
      (is (cocoa/click-link! r (+ 2 (at "the docs"))))
      (is (= ["https://x.test"] @seen)))
    (testing "appending"
      (ui/append-content! r [[:p "More, " [:a {:href "u2"} "there"]]])
      (cocoa/run-for! 0.05)
      (is (= (text) (cocoa/native-code-text r)))
      (is (= "1" (cocoa/link-at-native r (+ 1 (at "there")))))
      (cocoa/click-link! r (+ 1 (at "there")))
      (is (= ["https://x.test" "u2"] @seen)))
    (testing "strikethrough, and an image as a text attachment (Skein's M3.8, D-110)"
      (ui/append-content! r [[:p "was " [:del "old"] " "
                              [:img {:src (io/absolute-path "test/skein/ui/red-3x2.png")}]]])
      (cocoa/run-for! 0.05)
      (is (:strikethrough (cocoa/code-text-attributes r (at "old"))))
      (is (not (:strikethrough (cocoa/code-text-attributes r (at "was")))))
      (is (= [3.0 2.0] (:attachment (cocoa/code-text-attributes r (at "\uFFFC"))))))
    (ui/close! w)))

(deftest code-views-take-a-new-palette
  ;; A palette changed while the view shows recolors its plain text (Skein Studio's themes
  ;; left it the old theme's color, M3.8): its own palette, and its window's.
  (let [v (ui/code-view {:buffer (ui/make-text-buffer {:text "plain (bold)"})
                         :palette {:text "#ececE8"}})
        w (ui/window {:width 300 :height 200} v)]
    (ui/set-text-runs! v [[7 11 {:bold true}]])
    (ui/show! w)
    (cocoa/run-for! 0.05)
    (is (= "#ECECE8" (string/upper-case (:color (cocoa/code-text-attributes v 0)))))
    (set-slot! v :palette {:text "#1C1C1A"})
    (cocoa/run-for! 0.05)
    (is (= "#1C1C1A" (string/upper-case (:color (cocoa/code-text-attributes v 0)))))
    (is (:bold (cocoa/code-text-attributes v 8)) "the runs keep their fonts")
    (set-slot! v :palette nil)
    (set-slot! w :palette {:text "#336699"})
    (cocoa/run-for! 0.05)
    (is (= "#336699" (string/upper-case (:color (cocoa/code-text-attributes v 0))))
        "from the window's")
    (ui/close! w)))

(deftest rows-at-points-and-snapshots
  ;; Skein's M3.6, D-108.
  (let [l (ui/list-box {:items ["a" "b" "c"]})
        name-col (ui/column "Name" :name {:width 100})
        age-col (ui/column "Age" :age)
        t (ui/table-view {:columns [name-col age-col]
                          :items [{:name "Ada" :age 36} {:name "Bob" :age 7}]})
        files {"/" ["docs" "src"] "src" ["main.skn"]}
        tree (ui/tree-view {:roots ["/"] :children-fn (fn [f] (get files f []))})
        w (ui/window {:width 400 :height 500} (ui/vbox {} l t tree))
        at (fn [f widget row column] (let [[x y] (cocoa/cell-point widget row column)]
                                       (f widget x y)))]
    (ui/show! w)
    (testing "list boxes"
      (is (= ["a" "b" "c"] (mapv (fn [r] (at ui/item-at-point l r 0)) [0 1 2])))
      (is (nil? (ui/item-at-point l 5 2000)) "below the rows"))
    (testing "tables, by column, also once the user moved one"
      (is (= [{:name "Bob" :age 7} age-col] (at ui/cell-at-point t 1 1)))
      (is (= [{:name "Ada" :age 36} name-col] (at ui/cell-at-point t 0 0)))
      (cocoa/move-column-natively! t 1 0)
      (is (= [{:name "Ada" :age 36} age-col] (at ui/cell-at-point t 0 0)))
      (is (= "36" (cocoa/cell-string t 0 0)) "the moved column shows its own cells"))
    (testing "trees"
      (ui/expand! tree "/")
      (is (= ["/" "docs" "src"] (mapv (fn [r] (at ui/item-at-point tree r 0)) [0 1 2]))))
    (testing "snapshots"
      (let [png (ui/snapshot w)
            u32 (fn [i] (reduce (fn [n k] (+ (* n 256) (aget png (+ i k)))) 0 (range 4)))
            scale (quot (u32 16) 400)]
        (is (= [137 80 78 71] (mapv (fn [i] (aget png i)) (range 4))))
        (is (contains? #{1 2 3} scale) "the screen's scale")
        (is (= [(* scale 400) (* scale 500)] [(u32 16) (u32 20)]) "the content area")
        (let [path (str (io/temp-dir "snapshot") "/w.png")]
          (ui/snapshot w path)
          (is (< 1000 (io/file-size path))))))
    (ui/close! w)))

(deftest canvases-draw-and-get-the-mouse
  (let [clicks (atom [])
        c (ui/canvas {:width 200 :height 100 :background :white
                      :on-draw (fn [e]
                                 (let [gc (:context e)]
                                   (ui/fill-rectangle! gc 0 0 100 100 {:color "#ff0000"})
                                   (ui/fill-circle! gc 150 50 20 {:color "#0000ff"})
                                   (ui/draw-text! gc "Hi" 110 5 {:color :black})))
                      :on-mouse-down (fn [e] (swap! clicks conj [(:x e) (:y e) (:button e)]))})
        w (ui/window {} c)
        ;; The bitmap is in the display's color space, so a color comes back near itself:
        ;; judge by its strongest component.
        strongest (fn [c] (let [rgb {:red (ui/color-red c) :green (ui/color-green c)
                                     :blue (ui/color-blue c)}]
                            (if (every? (fn [v] (> v 0.9)) (vals rgb))
                              :white
                              (key (apply max-key val rgb)))))]
    (ui/show! w)
    (is (= :red (strongest (cocoa/draw-into-image! c 50 50))) "the red square")
    (is (= :blue (strongest (cocoa/draw-into-image! c 150 50))) "the blue circle")
    (is (= :white (strongest (cocoa/draw-into-image! c 190 90))) "the white background")
    (let [[w h] (ui/text-extent "abcdefghij" {:size 12})]
      (is (< 50 w 75) "about 6 pixels a character at 12 points")
      (is (< 13 h 18) "a line"))
    (cocoa/send-mouse! c 1 30 40)
    (is (= [[30.0 40.0 :left]] @clicks) "flipped: from the top left")
    (ui/close! w)))

(deftest menus
  (let [log (atom [])
        save (ui/menu-item {:label "Save" :shortcut "Primary+Shift+S"
                            :on-activate (fn [e] (swap! log conj :save))})
        wrap (ui/check-menu-item {:label "Wrap"})
        quit (ui/menu-item {:role :quit :on-activate (fn [e] (swap! log conj :quit))})
        about (ui/menu-item {:role :about})
        settings (ui/menu-item {:role :preferences})
        file (ui/menu {:title "File"} save (ui/menu-separator) quit)
        bar (ui/menu-bar {} file (ui/menu {:title "Edit"} wrap)
                         (ui/menu {:title "Help"} about settings))]
    (is (= ["" "File" "Edit" "Help"] (cocoa/menu-titles bar)) "the application menu first")
    (is (= ["Save" ""] (cocoa/menu-titles file)) "Quit moved to the application menu")
    (is (= ["About" "" "Settings…" "" "Hide" "Hide Others" "Show All" "" "Quit"]
           (cocoa/app-menu-titles bar)))
    (is (= ["s" (+ 0x20000 0x100000)] (cocoa/key-equivalent save)))
    (cocoa/choose-menu-item-natively! save)
    (cocoa/choose-menu-item-natively! wrap)
    (cocoa/choose-menu-item-natively! quit)
    (is (= [:save :quit] @log))
    (is (:checked wrap))
    (set-slot! save :label "Save All")
    (is (= ["Save All" ""] (cocoa/menu-titles file)))
    (set-slot! file :title "Document")
    (is (= ["" "Document" "Edit" "Help"] (cocoa/menu-titles bar)))
    (is (= "⇧⌘S" (ui/shortcut-label save)))))

(deftest dialogs
  (cocoa/answer-next-dialog! "Don't Save")
  (is (= :discard (ui/message-box "Save changes?" {:buttons :save-discard-cancel})))
  (cocoa/answer-next-dialog! "Ada")
  (is (= "Ada" (ui/prompt-text "Your name?")))
  (cocoa/answer-next-dialog! nil)
  (is (nil? (ui/prompt-text "Your name?")))
  (cocoa/answer-next-dialog! nil)
  (is (nil? (ui/choose-file {:filters [["Text" "txt"]]}))))

(deftest timers-and-the-clipboard
  (let [ticks (atom [])
        once (ui/after 0.05 (fn [] (swap! ticks conj :once)))
        often (ui/every 0.04 (fn [] (swap! ticks conj :often)))]
    ;; A shared CI runner can't keep a 40 ms rate: wait for three ticks, up to 2 s.
    (is (run-until! (fn [] (<= 3 (count (filter #{:often} @ticks))))) "every repeats")
    (ui/stop-timer! often)
    (is (= 1 (count (filter #{:once} @ticks))))
    (is (not (ui/timer-running? once))))
  (let [saved (ui/clipboard-text)]
    (ui/set-clipboard-text! "from skein-ui")
    (is (= "from skein-ui" (ui/clipboard-text)))
    (when saved (ui/set-clipboard-text! saved)))
  (is (instance? ui/color (ui/system-color :accent)))
  (is (boolean? (ui/dark-mode?))))

(deftest lgt-basics
  (let [l (ui/label {:text "Big" :font {:size 22 :weight :bold} :text-color :red})
        e (ui/entry {})
        keys (atom [])
        w (ui/window {:title "Basics" :resizable false :position [100 120]} (ui/vbox {} l e))]
    (ui/on e :key-down (fn [ev] (swap! keys conj (:key ev))
                         (when (= (:key ev) \x) (ui/consume! ev))))
    (is (= 22.0 (cocoa/native-font-size l)))
    (ui/show! w)
    (is (not (cocoa/native-resizable? w)))
    (is (= [100 120] (cocoa/native-top-left w)))
    (ui/focus! e)
    (is (identical? e (ui/focused-widget)))
    (is (not (cocoa/send-key! e \a)))
    (is (cocoa/send-key! e \x) "a handler consumed it: AppKit never sees it")
    (is (= [\a \x] @keys))
    (ui/close! w))
  (testing "modal runs"
    (let [w (ui/window {:title "Modal"} (ui/label {:text "x"}))]
      (ui/after 0.1 (fn [] (ui/end-modal! w 42)))
      (is (= 42 (ui/run-modal w)))
      (ui/close! w))))

(deftest appearance-and-surfaces
  (let [changes (atom [])
        l (ui/label {:text "x"})
        side (ui/vbox {:surface :sidebar :palette {:text "#ff0000"}} l)
        c (ui/canvas {:on-appearance-changed (fn [e] (swap! changes conj (:value e)))})
        w (ui/window {:title "Look"} (ui/hbox {} side c))]
    (ui/show! w)
    ;; From light, whichever mode the system is in.
    (set-slot! w :appearance :light)
    (reset! changes [])
    (set-slot! w :appearance :dark)
    (is (= :dark (ui/effective-appearance c)))
    (is (= [:dark] @changes))
    (set-slot! w :appearance :light)
    (is (= :light (ui/effective-appearance c)))
    (testing "colors resolve in the widget's appearance"
      (let [light (ui/system-color :window-background c)]
        (set-slot! side :appearance :dark)
        (is (= :dark (ui/effective-appearance l)))
        (is (not= light (ui/system-color :window-background l)))))
    (is (= (ui/rgb 1 0 0) (ui/system-color :text l)) "the sidebar's palette")
    (is (cocoa/has-material? side) "the sidebar surface is a visual effect view")
    (ui/close! w))
  (is (< (first (ui/preferred-size (ui/button {:label "Go" :control-size :mini})))
         (first (ui/preferred-size (ui/button {:label "Go"}))))))

(deftest cards
  (let [card (ui/vbox {:padding 8 :background "#336699" :corner-radius 10
                       :border-color "#ff0000" :border-width 2}
                      (ui/label {:text "inside"}))
        tint (ui/vbox {:padding 8 :background [:accent 0.15] :corner-radius 6}
                      (ui/label {:text "tinted"}))
        outline (ui/vbox {:padding 8 :border-color "#00ff00"} (ui/label {:text "outlined"}))
        plain (ui/vbox {} (ui/label {:text "plain"}))
        w (ui/window {:title "Cards"} (ui/vbox {:padding 10 :spacing 10} card tint outline plain))]
    (ui/show! w)
    (let [n (cocoa/native-card card)]
      (is (= 10.0 (:corner-radius n)))
      (is (= 2.0 (:border-width n)))
      (is (= "#ff0000" (ui/color-hex (:border-color n))))
      (is (= "#336699" (ui/color-hex (:fill n)))))
    (let [a (ui/color-alpha (:fill (cocoa/native-card tint)))]
      (is (< 0.14 a 0.16) "the accent at 15%"))
    (is (= 0.0 (ui/color-alpha (:fill (cocoa/native-card outline)))) "clear inside")
    (is (= 1.0 (:border-width (cocoa/native-card outline))))
    (is (nil? (cocoa/native-card plain)))
    (set-slot! card :corner-radius 0)
    (set-slot! card :border-color nil)
    (is (= 0.0 (:border-width (cocoa/native-card card))) "no border once it has no color")
    (ui/close! w)))

(deftest height-for-width
  (let [long-text (apply str (interpose " " (repeat 40 "word")))
        l (ui/label {:text long-text :wrap true})
        one (ui/label {:text "word"})
        v (ui/code-view {:fit-height true :wrap true :line-numbers false
                         :buffer (ui/make-text-buffer {:text "one\ntwo"})})
        col (ui/vbox {:spacing 0} l one v)
        w (ui/window {:title "Heights" :width 300 :height 400} col)]
    (ui/show! w)
    (ui/allocate col 0 0 200 400)
    (cocoa/run-for! 0.1)
    (let [line (second (ui/preferred-size one))
          h (ui/preferred-height l 200)]
      (is (> h (* 3 line)) "40 words wrap to several lines at 200 pixels")
      (is (< (ui/preferred-height l 400) h) "fewer at 400"))
    (let [h2 (ui/preferred-height v 200)]
      (ui/insert-into-buffer! (:buffer v) 7 "\nthree\nfour")
      (cocoa/run-for! 0.1)
      (let [h4 (ui/preferred-height v 200)]
        (is (< (* 1.6 h2) h4 (* 2.4 h2)) "four lines are about twice as tall as two")))
    (is (= "SkeinPassScrollView"
           (objc/string-of (objc/send (objc/send (cocoa/native-scroll v) (objc/sel "class"))
                                      (objc/sel "description"))))
        "the wheel goes on to the column")
    (ui/close! w)))

(deftest icons-and-clickable-containers
  (let [red (ui/vector-image "M4 4h16v16H4z" {:size 24 :fill "#ff0000"})
        arrow (ui/vector-image "M5 12h14 M12 5l7 7l-7 7" {:size 16})
        iv (ui/image-view {:image red})
        b (ui/button {:label "Send" :image arrow})
        events (atom [])
        card (ui/vbox {:clickable true :padding 8 :background "#202020"
                       :hover-background "#404040" :corner-radius 8
                       :on-clicked (fn [_] (swap! events conj :clicked))
                       :on-mouse-enter (fn [_] (swap! events conj :enter))
                       :on-mouse-leave (fn [_] (swap! events conj :leave))}
                      (ui/label {:text "Explain this file"}))
        plain (ui/vbox {:padding 8} (ui/label {:text "plain"}))
        w (ui/window {:title "Icons"} (ui/vbox {:padding 10 :spacing 8} iv b card plain))]
    (ui/show! w)
    (cocoa/run-for! 0.1)
    (testing "a vector image draws its path"
      ;; in the middle of the view, which centers the image (drawn in the device's color
      ;; space, so red isn't sRGB's exactly)
      (let [[_ _ vw vh] (:allocation iv)
            c (cocoa/draw-into-image! iv (quot vw 2) (quot vh 2))]
        (is (and (< 0.8 (ui/color-red c)) (< (ui/color-green c) 0.4) (< (ui/color-blue c) 0.4))
            "filled red")))
    (is (objc/send-bool (cocoa/ns-image arrow) (objc/sel "isTemplate"))
        "in the text color, a template, which the button tints")
    (testing "a click on the card, released over it"
      (cocoa/send-mouse! card 1 5 5)
      (cocoa/send-mouse! card 2 5 5)
      (is (= [:clicked] @events))
      (cocoa/send-mouse! card 1 5 5)
      (cocoa/send-mouse! card 2 -20 5)
      (is (= [:clicked] @events) "released off it, no click"))
    (testing "hovering"
      (objc/send-p-void (cocoa/container-view card) (objc/sel "mouseEntered:") (ffi/null))
      (is (:hovered card))
      (is (= "#404040" (ui/color-hex (:fill (cocoa/native-card card)))))
      (objc/send-p-void (cocoa/container-view card) (objc/sel "mouseExited:") (ffi/null))
      (is (= "#202020" (ui/color-hex (:fill (cocoa/native-card card)))))
      (is (= [:clicked :enter :leave] @events)))
    (is (pos? (objc/send-long (objc/send (cocoa/container-view card) (objc/sel "trackingAreas"))
                              (objc/sel "count")))
        "it tracks the pointer")
    (testing "a container that isn't clickable passes the mouse on"
      (cocoa/send-mouse! plain 1 5 5)
      (cocoa/send-mouse! plain 2 5 5)
      (is (= [:clicked :enter :leave] @events)))
    (ui/close! w)))

(deftest a-side-pane-kept-at-the-end
  ;; A pane on the right, kept at its length, hidden and then shown: it gets its length,
  ;; the first pane gives it up, and the window doesn't grow for the first's natural width.
  (let [main (ui/label {:text (apply str (repeat 60 "m"))})
        side (ui/vbox {:visible false} (ui/label {:text "side"}))
        split (ui/paned {:keep :end :position 150} main side)
        w (ui/window {:title "Side" :width 400 :height 200} split)]
    (ui/show! w)
    (cocoa/run-for! 0.2)
    (set-slot! side :visible true)
    (cocoa/run-for! 0.2)
    (is (= 400 (:width w)) "the window keeps its width")
    (is (= 150 (nth (:allocation side) 2)) "the side pane has its length")
    (is (< (nth (:allocation main) 2) 250) "the first pane gave it up")
    (ui/close! w)))

(deftest stacks-and-tabbed-panes
  (let [a (ui/label {:text "one"})
        b (ui/label {:text "two"})
        s (ui/stack {} a b)
        n (ui/vertical-notebook {} (ui/label {:text "general" :tab-label "General"})
                                (ui/label {:text "other" :tab-label "Other"}))
        w (ui/window {:title "Stacks"} (ui/vbox {} s n))]
    (ui/show! w)
    (is (cocoa/native-bool b "isHidden"))
    (ui/select-page! s b)
    (is (not (cocoa/native-bool b "isHidden")))
    (is (cocoa/native-bool a "isHidden"))
    (is (= 150 (nth (cocoa/native-frame (:page-list n)) 2)) "the list of pages")
    (ui/close! w))
  (let [closed (atom [])
        a (ui/text-view {:tab-label "Notes" :tab-tooltip "Your notes"})
        b (ui/text-view {:tab-closable false})
        c (ui/text-view {:tab-label "Third"})
        p (ui/tabbed-pane {:drag-group :docs :on-page-closed (fn [e] (swap! closed conj (:index e)))}
                          a b c)
        q (ui/tabbed-pane {:drag-group :docs} (ui/text-view {:tab-label "Other"}))
        w (ui/window {:width 800 :height 400} (ui/hbox {:homogeneous true} p q))]
    (ui/show! w)
    (testing "tabs are buttons"
      (is (= {:title "Notes" :selected true :closable true :tooltip "Your notes"}
             (cocoa/native-tab a)))
      (is (= "Page 2" (:title (cocoa/native-tab b))))
      (is (not (:closable (cocoa/native-tab b)))))
    (testing "the pages are below the tab bar"
      (let [[_ _ _ bh] (:allocation (ui/tab-bar p))]
        (is (<= 28 bh 40))
        (is (= bh (second (cocoa/native-page-area p))))))
    (testing "clicking a tab shows its page"
      (cocoa/click-tab! b)
      (is (= 1 (:selected-index p)))
      (is (:selected (cocoa/native-tab b)))
      (is (not (:selected (cocoa/native-tab a)))))
    (testing "finding a tab by its point"
      (let [[x y] (cocoa/native-tab-point c)]
        (is (identical? c (ui/tab-at-point p x y)))))
    (testing "dragging a tab over another reorders them"
      (cocoa/drag-tab! a c)
      (is (= [b c a] (:children p)))
      (is (identical? a (ui/selected-page p)) "the dragged tab shows")
      (is (< (first (cocoa/native-tab-point c)) (first (cocoa/native-tab-point a)))))
    (testing "closing a tab"
      (cocoa/click-tab-close! c)
      (is (= [1] @closed))
      (is (= [b a] (:children p))))
    (testing "dropping a tab on another pane"
      (cocoa/drag-tab! a q)
      (cocoa/run-for! 0.1)
      (is (= [b] (:children p)))
      (is (identical? a (last (:children q))))
      (is (:selected (cocoa/native-tab a))))
    (ui/close! w)))

(deftest popovers-and-completion-popups
  (let [closed (atom [])
        name (ui/entry {})
        b (ui/button {:label "Settings"})
        v (ui/text-view {:text "ab\ncd"})
        p (ui/popover {:on-closed (fn [e] (swap! closed conj (:value e)))}
                      (ui/vbox {} (ui/label {:text "Name"}) name))
        w (ui/window {:title "Popovers" :width 400 :height 300} (ui/vbox {} b v))]
    (ui/show! w)
    (testing "a popover"
      (ui/show-popover! p b {:focus name})
      (is (cocoa/native-surface-shown? p))
      (is (= (:size p) (vec (take-last 2 (cocoa/native-frame p)))))
      (ui/close-surface! p)
      (is (not (cocoa/native-surface-shown? p)))
      (is (= [:closed] @closed)))
    (testing "a completion popup under the caret"
      (let [c (ui/completion-popup {})]
        (ui/focus! v)
        (ui/set-text-selection! v 4 4)
        (let [[x y cw ch] (ui/caret-rectangle v)]
          (is (< 0 ch 30))
          (is (< y 40) "on the second line"))
        (ui/show-completion-popup! c v {:items ["cab" "car" "cat"]})
        (is (run-until! (fn [] (cocoa/native-surface-shown? c))))
        (let [[px py pw ph] (cocoa/native-panel-frame c)
              [cx cy _ ch] (cocoa/native-screen-rect v (ui/caret-rectangle v))]
          (is (= (:size c) [pw ph]))
          (is (= cx px) "lined up with the caret")
          (is (<= (+ cy ch) py (+ cy ch 4)) "just below it"))
        (is (identical? v (ui/focused-widget)) "the view keeps the keyboard")
        (cocoa/send-key! v \x)
        (is (cocoa/native-surface-shown? c))
        (ui/close-surface! c)
        (is (not (cocoa/native-surface-shown? c)))))
    (ui/close! w)))

(deftest code-views
  (let [b (ui/make-text-buffer {:text "(defn f [x]\n  x)"})
        v (ui/code-view {:buffer b})
        v2 (ui/code-view {:buffer b :line-numbers false})
        empty (ui/code-view {:placeholder "Type here"})
        w (ui/window {:title "Code" :width 500 :height 400} (ui/vbox {} v v2 empty))]
    (ui/show! w)
    (cocoa/run-for! 0.05)
    (is (= "(defn f [x]\n  x)" (cocoa/native-code-text v)))
    (testing "the core's edits reach the text view, and both views share the text"
      (ui/insert-into-buffer! b 0 ";; ")
      (is (= ";; (defn f [x]\n  x)" (cocoa/native-code-text v)))
      (is (= ";; (defn f [x]\n  x)" (cocoa/native-code-text v2))))
    (testing "typing in the text view changes the buffer"
      (ui/focus! v)
      (ui/set-cursor! v 3)
      (cocoa/run-for! 0.05)
      (is (= [3 0] (cocoa/native-code-selection v)))
      (cocoa/type-into-code-view! v "x")
      (is (= ";; x(defn f [x]\n  x)" (ui/buffer-text b)))
      (is (= 4 (:cursor v)))
      (is (= ";; x(defn f [x]\n  x)" (cocoa/native-code-text v2)))
      (ui/undo! v)
      (is (= ";; (defn f [x]\n  x)" (cocoa/native-code-text v))))
    (testing "geometry"
      (let [[x0 y0 h] (ui/point-at-position v 0)
            [_ y1 _] (ui/point-at-position v (ui/line-start b 1))]
        (is (< 0 h 30))
        (is (< y0 y1) "the second line is lower")
        (is (= (ui/line-start b 1) (ui/position-at-point v (+ x0 1) (+ y1 2)))))
      (is (< 20 (ui/gutter-width v) 80))
      (is (= [0 1] (ui/visible-lines v))))
    (testing "runs and a bold one"
      (ui/set-text-runs! v [[4 8 {:color :purple :bold true}]])
      (cocoa/run-for! 0.05)
      (is (= [[4 8 {:color :purple :bold true}]] (ui/text-runs v))))
    (testing "fonts and paragraphs in runs (Skein's M3.6, D-108)"
      (let [b (ui/make-text-buffer {:text "Title\nsome code here\n- item one\na\tb\tc"})
            r (ui/code-view {:buffer b :line-numbers false :wrap true
                             :font {:family :system :size 13}})
            w2 (ui/window {:width 400 :height 300} r)]
        (ui/show! w2)
        (ui/set-text-runs! r [[0 5 {:size 20 :bold true :space-below 6}]
                              [11 15 {:family :monospace}]
                              [6 21 {:block-background "#eeeeee" :indent 8 :space-above 4}]
                              [22 32 {:indent 24 :first-indent -12}]
                              [33 38 {:tabs [100 200]}]])
        (cocoa/run-for! 0.05)
        (let [title (cocoa/code-text-attributes r 2)
              plain (cocoa/code-text-attributes r 7)
              code (cocoa/code-text-attributes r 12)
              item (cocoa/code-text-attributes r 25)
              row (cocoa/code-text-attributes r 34)]
          (is (= [20.0 true false] [(:size title) (:bold title) (:monospace title)]))
          (is (= 6.0 (:space-below title)))
          (is (= [13.0 false] [(:size plain) (:monospace plain)]))
          (is (:monospace code) "a family of its own inside the line")
          (is (= [8.0 4.0 true] [(:indent plain) (:space-above plain) (:block-background plain)])
              "the whole line, though the run starts after it")
          (is (= [24.0 -12.0] [(:indent item) (:first-indent item)]) "a hanging indent")
          (is (= [100.0 200.0] (:tabs row)))
          (is (not (:block-background item))))
        (testing "restyling a line takes its paragraph style away"
          (ui/replace-text-runs! r 22 32 [])
          (cocoa/run-for! 0.05)
          (is (nil? (:indent (cocoa/code-text-attributes r 25)))))
        (ui/close! w2)))
    (testing "the placeholder shows while empty"
      (is (cocoa/code-placeholder-shown? empty))
      (ui/set-code-text! empty "x")
      (is (not (cocoa/code-placeholder-shown? empty))))
    (ui/close! w)))

(deftest images-fonts-and-row-icons
  (let [png (io/read-bytes "test/skein/ui/red-3x2.png")
        i (ui/image-from-bytes png)
        star (ui/system-image "star.fill")
        g (ui/glyph-image "λ" {:size 20})]
    (is (= [3 2] [(:width i) (:height i)]))
    (is (some? star))
    (is (nil? (ui/system-image "no.such.symbol.anywhere")))
    (is (= [20 20] [(:width g) (:height g)]))
    (is (contains? (set (ui/font-families)) "Helvetica"))
    (let [f "/System/Library/Fonts/Supplemental/Courier New.ttf"]
      (when (io/file-exists? f)
        (is (= f (ui/register-font-file! f)) "registered already by the system: no error")))
    (let [l (ui/list-box {:items ["a" "b"] :icon-fn (fn [x] (when (= x "a") star))})
          t (ui/table-view {:items [{:n 1}] :columns [(ui/column "N" :n {:icon-fn (fn [_] g)})]})
          v (ui/image-view {:image i})
          w (ui/window {:title "Images" :width 300 :height 300} (ui/vbox {} l t v))]
      (ui/show! w)
      (is (= "a" (cocoa/cell-string l 0 0)))
      (is (not (ffi/null? (cocoa/cell-image l 0 0))) "a's row has its icon")
      (is (ffi/null? (cocoa/cell-image l 1 0)) "b's has none")
      (is (not (ffi/null? (cocoa/cell-image t 0 0))))
      (is (= "1" (cocoa/cell-string t 0 0)))
      (ui/close! w))
    (ui/free-image! i)
    (is (thrown-with-msg? error "freed" (ui/image-view {:image i})))))

(deftest window-states
  (let [seen (atom [])
        w (ui/window {:title "States" :width 400 :height 300 :position [100 120]
                      :on-state-changed (fn [e] (swap! seen conj (:value e)))}
                     (ui/label {:text "x"}))]
    (ui/show! w)
    (is (= :normal (ui/window-state w)))
    (testing "maximized, the normal frame is kept"
      (set-slot! w :state :maximized)
      (cocoa/run-for! 0.3)
      (is (= :maximized (ui/window-state w)))
      (is (< 400 (:width w)) "zoomed to the screen")
      (is (= {:position [100 120] :size [400 300] :state :maximized} (ui/window-frame w))))
    (testing "back to normal"
      (set-slot! w :state :normal)
      (cocoa/run-for! 0.3)
      (is (= :normal (ui/window-state w)))
      (is (= [400 300] [(:width w) (:height w)])))
    (testing "minimized"
      (set-slot! w :state :minimized)
      (cocoa/run-for! 0.8)
      (is (= :minimized (ui/window-state w)))
      (is (= :normal (:state (ui/window-frame w))) "saved as normal")
      (set-slot! w :state :normal)
      (cocoa/run-for! 0.8)
      (is (= :normal (ui/window-state w))))
    (is (= [:maximized :normal :minimized :normal] @seen))
    (ui/close! w)))

(deftest web-views
  (let [loaded (atom [])
        messages (atom [])
        v (ui/web-view {:html "<html><body><h1 id='t'>Hello</h1><script>window.skein.postMessage({ready:true});</script></body></html>"
                        :local-messages true
                        :on-loaded (fn [e] (swap! loaded conj (:value e)))
                        :on-message (fn [e] (swap! messages conj (:value e)))})
        w (ui/window {:title "Web" :width 500 :height 400} v)
        wait (fn [pred] (loop [n 0] (when (and (< n 100) (not (pred))) (cocoa/run-for! 0.05) (recur (inc n)))))]
    (is (= :webkit (ui/web-engine v)))
    (ui/show! w)
    (wait (fn [] (seq @loaded)))
    (is (= ["about:blank"] @loaded))
    (wait (fn [] (seq @messages)))
    (is (= ["{\"ready\":true}"] @messages) "a trusted local page's message, as JSON")
    (testing "scripts give JSON results"
      (let [result (atom nil)]
        (ui/run-script! v "document.getElementById('t').textContent" (fn [r e] (reset! result [r e])))
        (wait (fn [] @result))
        (is (= ["\"Hello\"" nil] @result))
        (reset! result nil)
        (ui/run-script! v "no_such_function()" (fn [r e] (reset! result [r e])))
        (wait (fn [] @result))
        (is (nil? (first @result)))
        (is (string? (second @result)) "the error's message")))
    (testing "navigation can be vetoed"
      (let [asked (atom [])]
        (ui/on v :navigation-request (fn [e] (swap! asked conj (:url e))
                                       (when (string/includes? (:url e) "blocked") (ui/veto e))))
        (ui/run-script! v "location.href='https://blocked.example/'")
        (wait (fn [] (seq @asked)))
        (cocoa/run-for! 0.2)
        (is (= ["https://blocked.example/"] @asked))
        (is (= ["about:blank"] @loaded) "it stayed")))
    (ui/close! w)))

(deftest every-system-color
  ;; Regression: the surface colors had no NSColor, and painting a canvas's
  ;; :background :content-background crashed.
  (doseq [c ui/system-colors]
    (is (not (ffi/null? (cocoa/ns-color c))) (str c)))
  (let [c (ui/canvas {:width 50 :height 50 :background :content-background})
        w (ui/window {:width 100 :height 100} c)]
    (ui/show! w)
    (is (some? (cocoa/draw-into-image! c 25 25)) "it paints")
    (ui/close! w true)))
