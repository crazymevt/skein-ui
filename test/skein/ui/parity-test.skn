(ns skein.ui.parity-test
  (:require [skein.test :refer [deftest is are testing use-fixtures]]
            [skein.ui :as ui]
            [skein.ui.headless :as headless]
            [skein.io :as io]))

;; The parts of LGT that skein-ui gained before its examples were ported (part A of step 6
;; of M2.14, D-097): fonts, colors, focus, input events, user data, windows' options and
;; events, modal runs, dialogs of the program's own and the application.

(use-fixtures :each (fn [t] (ui/use-backend! (headless/backend)) (t)))

(deftest fonts-colors-and-user-data
  (let [l (ui/label {:text "Big" :font {:size 22 :weight :bold} :text-color :red
                     :background "#eeeeee" :user-data {:id 7}})]
    (is (= {:size 22 :weight :bold} (headless/native-property l :font)))
    (is (= :red (headless/native-property l :text-color)))
    (is (= {:id 7} (:user-data l)))
    (set-slot! l :font :monospace)
    (is (= :monospace (headless/native-property l :font)))))

(deftest blocking-handlers
  (let [seen (atom 0)
        b (ui/button {:label "Go" :on-clicked (fn [e] (swap! seen inc))})]
    (ui/with-handlers-blocked [b :clicked]
      (headless/click! b))
    (ui/with-handlers-blocked [b]
      (headless/click! b))
    (is (= 0 @seen))
    (headless/click! b)
    (is (= 1 @seen))))

(deftest walking-widgets-and-focus
  (let [a (ui/entry {}) b (ui/entry {}) l (ui/label {})
        box (ui/vbox {} a l b)]
    (is (= [a b] (ui/widgets-of-type box ui/entry-widget)))
    (let [seen (atom [])]
      (ui/map-widgets (fn [w] (swap! seen conj w)) box)
      (is (= [box a l b] @seen)))
    (ui/focus! b)
    (is (identical? b (ui/focused-widget)))
    (ui/clear! box)
    (is (empty? (:children box)))
    (is (headless/destroyed? a))
    (is (nil? (ui/focused-widget)) "a destroyed widget has no focus")))

(deftest input-events-on-controls
  (let [keys (atom [])
        e (ui/entry {:on-key-down (fn [ev] (swap! keys conj (:key ev))
                                    (when (= (:key ev) :up) (ui/consume! ev)))})]
    (is (not (ui/consumed? (headless/key-down! e "a"))))
    (is (ui/consumed? (headless/key-down! e "Up")))
    (is (= [\a :up] @keys)))
  (let [menu (ui/menu {:title "Edit"} (ui/menu-item {:label "Copy"}))
        l (ui/list-box {:items ["a"] :context-menu menu})]
    (headless/right-click! l 5 5)
    (is (= :popup-menu (first (last (headless/backend-log)))))
    (ui/on l :context-request (fn [ev] (ui/consume! ev)))
    (headless/right-click! l 5 5)
    (is (= 1 (count (filter (fn [x] (= :popup-menu (first x))) (headless/backend-log))))
        "a consumed request shows no menu")))

(deftest windows
  (let [events (atom [])
        w (ui/window {:title "W" :position [10 20] :resizable false
                      :on-shown (fn [e] (swap! events conj :shown))
                      :on-closed (fn [e] (swap! events conj :closed))}
                     (ui/label {:text "abcd"}))]
    (is (= false (headless/native-property w :resizable)))
    (is (= [10 20] (headless/native-property w :position)))
    (ui/show! w)
    (is (not (headless/centered? w)) "a window with a :position isn't centered")
    (is (= [32 16] (:min-size w)))
    (is (some (fn [x] (identical? x w)) (ui/windows)))
    (ui/hide! w)
    (is (not (headless/shown? w)))
    (is (not (some (fn [x] (identical? x w)) (ui/windows))))
    (ui/show! w)
    (testing "a window grows to fit its content"
      (set-slot! (ui/content w) :text "abcdefgh")
      (headless/run-pending!)
      (is (= 64 (:width w))))
    (ui/close! w)
    (is (= [:shown :shown :closed] @events)))
  (let [w (ui/window {} (ui/label {}))]
    (ui/show! w)
    (is (headless/centered? w))
    (ui/close! w)))

(deftest modal-windows-and-dialogs
  (let [w (ui/window {:title "Modal"} (ui/label {}))]
    (headless/answer! (fn [win] (ui/end-modal! win 42)))
    (is (= 42 (ui/run-modal w)))
    (ui/close! w))
  (let [name (ui/entry {})
        d (ui/dialog {:title "Rename" :buttons [:cancel :ok]} name)
        tries (atom 0)]
    (is (identical? (:parent name) (:content-area d)) "children go in the content area")
    (is (= ["Cancel" "OK"] (mapv :label (:children (:button-box d)))) "OK last, as macOS has it")
    (ui/on d :response (fn [e] (when (and (= :ok (:value e)) (empty? (:text name)))
                                 (swap! tries inc)
                                 (ui/veto e))))
    (headless/answer! (fn [win] (headless/click! (last (:children (:button-box win)))))
                      (fn [win] (headless/type-text! name "New")
                        (headless/click! (last (:children (:button-box win))))))
    (is (= :ok (ui/run-dialog d)))
    (is (= 1 @tries) "the first OK was vetoed: the name was empty")
    (is (headless/destroyed? d)))
  (let [d (ui/dialog {:buttons [:cancel :ok]})]
    (headless/answer! (fn [win] (ui/close! win)))
    (is (= :close (ui/run-dialog d)))))

(deftest the-application
  (is (= "Skein" (:name ui/app)))
  (let [veto? (atom true)
        id (ui/on ui/app :quit-request (fn [e] (when @veto? (ui/veto e))))]
    (is (not (ui/quit!)))
    (reset! veto? false)
    (is (ui/quit!))
    (ui/off ui/app :quit-request id))
  (let [img (ui/image-from-pixels 1 1 (make-array u8 4))]
    (ui/set-application-icon! img)
    (is (identical? img (:icon ui/app)))))

(deftest appearance-and-palettes
  (let [changes (atom [])
        c (ui/canvas {:on-appearance-changed (fn [e] (swap! changes conj (:value e)))})
        l (ui/label {:text "x"})
        side (ui/vbox {:surface :sidebar :palette {:text "#ff0000"}} l)
        w (ui/window {:title "Look"} (ui/hbox {} side c))]
    (ui/show! w)
    (is (= :light (ui/effective-appearance c)))
    (testing "an appearance is inherited, and a change is announced"
      (set-slot! w :appearance :dark)
      (is (= :dark (ui/effective-appearance c)))
      (is (= [:dark] @changes))
      (is (ui/dark-mode? l))
      (set-slot! side :appearance :light)
      (is (= :light (ui/effective-appearance l)))
      (is (= :dark (ui/effective-appearance c))))
    (testing "palettes override semantic colors for what is inside"
      (is (= (ui/rgb 1 0 0) (ui/system-color :text l)))
      (is (= (ui/rgb 1 0 0) (ui/system-color :caret l)) "a derived role follows its base")
      (is (= (ui/rgb 1 0 0) (:text (headless/palette-colors l))))
      (is (not= (ui/rgb 1 0 0) (ui/system-color :text c)) "the canvas isn't inside the sidebar")
      (set-slot! w :palette {:accent :system-green})
      (is (= (ui/system-palette-color :system-green true) (ui/system-color :accent c))
          "a palette may name a semantic color, which follows the appearance"))
    (testing "drawing resolves semantic colors through the canvas's palette"
      (set-slot! c :palette {:text "#00ff00"})
      (ui/on c :draw (fn [e] (ui/draw-text! (:context e) "hi" 0 0 {:color :text})))
      (is (= (ui/rgb 0 1 0) (nth (last (headless/draw! c)) 5))))
    (ui/close! w))
  (testing "control sizes scale a control's natural size"
    (is (< (first (ui/preferred-size (ui/button {:label "Go" :control-size :small})))
           (first (ui/preferred-size (ui/button {:label "Go"})))))
    (is (thrown-with-msg? error "control size" (ui/button {:control-size :huge}))))
  (is (thrown-with-msg? error "a window's" (ui/label {:appearance :system})))
  (is (thrown-with-msg? error "surface role" (ui/vbox {:surface :ceiling})))
  (is (thrown-with-msg? error "palette role" (ui/label {:palette {:sky "#0000ff"}}))))

(deftest stacks
  (let [seen (atom [])
        a (ui/label {:text "abcd" :tab-label "A"})
        b (ui/label {:text "abcdefgh"})
        s (ui/stack {:on-page-changed (fn [e] (swap! seen conj (:index e)))} a b)]
    (is (= "Page" (:tab-label b)))
    (is (= [true false] (mapv :visible [a b])))
    (is (= [64 16] (ui/preferred-size s)) "sized for the largest page, shown or not")
    (ui/select-page! s b)
    (is (= [false true] (mapv :visible [a b])))
    (is (= [1] @seen) "a stack emits :page-changed for any change")
    (ui/remove! s b)
    (is (= 0 (:selected-index s)))
    (is (:visible a))
    (is (thrown-with-msg? error "no page" (set-slot! s :selected-index 5))))
  (let [g (ui/label {:text "general" :tab-label "General"})
        o (ui/label {:text "other" :tab-label "Other"})
        n (ui/vertical-notebook {:sidebar-width 100} g o)
        l (:page-list n)]
    (is (= ["General" "Other"] (mapv (fn [i] (ui/item-text l i)) (range 2))))
    (headless/select-rows! l [1])
    (is (= 1 (:selected-index n)))
    (is (= [1] (:selected-indices l)))
    (ui/show! (ui/window {} n))
    (is (= [0 0 100 (nth (headless/bounds n) 3)] (headless/bounds l)))
    (is (= 112 (first (headless/bounds o))) "the page beside the list")))

(deftest tabbed-panes
  (let [seen (atom [])
        note (fn [e] (swap! seen conj [(:signal e) (:index e)]))
        a (ui/text-view {:tab-label "Notes" :tab-tooltip "Your notes"})
        b (ui/text-view {:tab-closable false})
        c (ui/text-view {:tab-label (ui/label {:text "Live"})})
        p (ui/tabbed-pane {:drag-group :docs :on-page-changed note :on-page-moved note
                           :on-page-closed note}
                          a b c)
        q (ui/tabbed-pane {:drag-group :docs :on-page-received note})
        w (ui/window {:width 600 :height 400} (ui/hbox {} p q))]
    (ui/show! w)
    (testing "tabs show their fields"
      (is (= 0 (:selected-index p)))
      (is (= {:label "Notes" :tooltip "Your notes" :icon nil :closable true :accessory nil}
             (headless/tab a)))
      (is (= "Page 2" (:label (headless/tab b))))
      (is (= "Live" (ui/tab-title p c)) "a widget label's text")
      (is (identical? (:tab-bar p) (:parent (:tab-label c))) "the tab bar holds the label"))
    (testing "choosing, moving and closing tabs"
      (headless/click-tab! p b)
      (headless/drag-tab! p a 2)
      (is (= [b c a] (:children p)))
      (is (= 0 (:selected-index p)) "b is still shown, now first")
      (is (identical? a (ui/tab-at-point p (headless/tab-x p a) 5)))
      (set-slot! a :tab-label "Renamed")
      (is (= "Renamed" (:label (headless/tab a))))
      (ui/on p :page-close-request (fn [e] (when (identical? (:value e) c) (ui/veto e))))
      (is (not (headless/close-tab! p c)) "vetoed")
      (is (headless/close-tab! p a))
      (is (headless/destroyed? a)))
    (testing "dropping a tab on another pane of its drag group"
      (is (headless/drop-tab! c q 0))
      (is (= [b] (:children p)))
      (is (= [c] (:children q)))
      (is (= "Live" (:tab-label c)) "a widget label becomes its text"))
    (is (= [[:page-moved 2] [:page-closed 2] [:page-received 0]]
           (filterv (fn [[s _]] (not= s :page-changed)) @seen)))
    (is (= [0 1] (take 2 (keep (fn [[s i]] (when (= s :page-changed) i)) @seen)))
        "the first page shown, then the clicked one")
    (testing "Control-Tab switches pages"
      (ui/add! p (ui/text-view {}))
      (let [e (headless/key-down! b "Control+Tab")]
        (is (ui/consumed? e))
        (is (= 1 (:selected-index p)))))
    (testing "a right-click on a tab"
      (let [asked (atom nil)]
        (ui/on p :tab-context-request (fn [e] (reset! asked (:page e)) (ui/consume! e)))
        (headless/right-click-tab! p b)
        (is (identical? b @asked))))
    (ui/close! w)))

(deftest popovers
  (let [closed (atom [])
        name (ui/entry {})
        b (ui/button {:label "Settings"})
        p (ui/popover {:on-closed (fn [e] (swap! closed conj (:value e)))}
                      (ui/vbox {} (ui/label {:text "Name"}) name))
        w (ui/window {:appearance :dark} (ui/vbox {} b))]
    (ui/show! w)
    (ui/show-popover! p b {:focus name})
    (is (:shown p))
    (is (headless/surface-shown? p))
    (is (identical? b (:owner p)))
    (is (= :bottom (:edge (headless/shown-for p))))
    (is (= [0 0 (nth (:allocation b) 2) (nth (:allocation b) 3)]
           (:rectangle (headless/shown-for p))))
    (is (= [(+ 24 (nth (:size-cache (ui/content p)) 0)) (+ 24 (nth (:size-cache (ui/content p)) 1))]
           (:size p))
        "its content's size and 12 pixels of padding each side")
    (is (identical? name (ui/focused-widget)))
    (is (= :dark (ui/effective-appearance name)) "the appearance of the widget it is for")
    (is (identical? w (ui/window-of name)))
    (headless/click-outside! p)
    (is (not (:shown p)))
    (is (= [:dismissed] @closed))
    (ui/show-popover! p b {:edge :right})
    (is (= :right (:edge (headless/shown-for p))))
    (is (ui/close-surface! p))
    (is (not (headless/surface-shown? p)))
    (is (not (ui/close-surface! p)) "not shown")
    (ui/show-popover! p b)
    (ui/close! w)
    (is (= [:dismissed :closed :closed] @closed) "closing its window closes it")
    (is (thrown-with-msg? error "behavior" (ui/popover {:behavior :sometimes})))))

(deftest completion-popups
  (let [accepted (atom [])
        v (ui/text-view {:text "ab\ncd"})
        p (ui/completion-popup {:item-detail (fn [s] (if (= s "car") "noun" ""))
                                :on-accept (fn [e] (swap! accepted conj (:value e)))})
        w (ui/window {} v)]
    (ui/show! w)
    (ui/set-text-selection! v 4 4)
    (is (= [8 16 1 16] (ui/caret-rectangle v)) "after the c, on the second line")
    (is (nil? (ui/show-completion-popup! p v {:items []})) "nothing to show")
    (ui/show-completion-popup! p v {:items ["cab" "car" "cat"]})
    (is (:shown p))
    (is (= :caret (:anchor (headless/shown-for p))))
    (is (= 0 (:selected-index p)))
    (testing "keys in the view move the highlight and accept"
      (is (ui/consumed? (headless/key-down! v "Down")))
      (is (= "car" (ui/selected-completion p)))
      (is (not (ui/consumed? (headless/key-down! v "x"))) "typing goes on in the view")
      (is (ui/consumed? (headless/key-down! v "Return")))
      (is (= ["car"] @accepted))
      (is (not (:shown p)))
      (is (not (ui/consumed? (headless/key-down! v "Down"))) "not shown: the view's own"))
    (testing "narrowing, clicking and dismissing"
      (ui/show-completion-popup! p v {:items ["cab" "car" "cat"]})
      (set-slot! p :items ["cat"])
      (is (= 0 (:selected-index p)))
      (is (= "cat" (ui/selected-completion p)))
      (headless/click-completion! p 0)
      (is (= ["car" "cat"] @accepted))
      (ui/show-completion-popup! p v {:items ["x" "y"]})
      (headless/key-down! v "Escape")
      (is (not (:shown p)))
      (ui/show-completion-popup! p v {:items ["x" "y"]})
      (set-slot! p :items [])
      (is (not (:shown p)) "no items closes it")
      (ui/show-completion-popup! p v {:items ["x" "y"]})
      (ui/dismiss-popups!)
      (is (not (:shown p))))
    (testing "rows: a detail widens a row, and the list scrolls"
      (let [[w1 _] (ui/preferred-size (:list-view p))]
        (set-slot! p :items (mapv str (range 30)))
        (set-slot! p :max-visible-rows 5)
        (is (= (+ 8 (* 5 (:row-height p))) (second (ui/preferred-size (:list-view p)))))
        (ui/show-completion-popup! p v)
        (dotimes [_ 7] (headless/key-down! v "Down"))
        (is (= 3 (:top (:list-view p))) "the highlighted row shows")))
    (is (= (ui/place-popup [100 100 10 20] [50 40] [0 0 1000 800]) [100 122 :below]))
    (is (= (ui/place-popup [980 780 10 20] [50 40] [0 0 1000 800]) [950 738 :above]))
    (ui/close! w)))

(deftest images-and-fonts
  (let [png (io/read-bytes "test/skein/ui/red-3x2.png")
        i (ui/image-from-bytes png)]
    (is (= [3 2] [(:width i) (:height i)]))
    (is (thrown-with-msg? error "empty" (ui/image-from-bytes (make-array u8 0))))
    (let [star (ui/system-image "star")]
      (is (= [16 16] [(:width star) (:height star)]))
      (is (= "star" (:system star))))
    (testing "glyph images are made once and shared"
      (let [g (ui/glyph-image \A)
            h (ui/glyph-image "A" {:size 24 :color :red})]
        (is (identical? g (ui/glyph-image "A")))
        (is (= [18 18] [(:width g) (:height g)]))
        (is (:template (:glyph g)) ":text glyphs follow the control's color")
        (is (not (:template (:glyph h))))
        (is (= 24 (:size (:font (:glyph h)))) "the font takes the image's size")))
    (testing "freeing"
      (ui/free-image! i)
      (is (:freed i))
      (is (thrown-with-msg? error "freed" (ui/check-image i)))
      (ui/free-image! (ui/glyph-image "A"))
      (is (not (:freed (ui/glyph-image "A"))) "shared glyphs aren't freed"))
    (testing "fonts"
      (is (= ["Monospace" "Sans" "Serif"] (ui/font-families)))
      (is (thrown-with-msg? error "no font file" (ui/register-font-file! "no/such.ttf")))))
  (testing "row icons"
    (let [star (ui/system-image "star")
          l (ui/list-box {:items ["a" "b"] :icon-fn (fn [x] (when (= x "a") star))})
          t (ui/table-view {:items [{:n 1}] :columns [(ui/column "N" :n {:icon-fn (fn [_] star)})
                                                      (ui/column "M" :n)]})]
      (is (= [star nil] (headless/row-icons l)))
      (is (= [star] (headless/row-icons t 0)))
      (is (= [nil] (headless/row-icons t 1)))
      (is (thrown-with-msg? error "an :icon-fn gives"
                            (ui/row-icon (ui/list-box {:items [1] :icon-fn (fn [_] "x")}) 1))))))

(deftest window-states
  (let [seen (atom [])
        w (ui/window {:title "Doc" :width 400 :height 300 :position [100 120]
                      :on-state-changed (fn [e] (swap! seen conj (:value e)))}
                     (ui/label {:text "x"}))]
    (ui/show! w)
    (is (= :normal (ui/window-state w)))
    (testing "the user maximizes: the normal frame is kept"
      (headless/change-state! w :maximized)
      (is (= :maximized (:state w)))
      (is (= headless/screen-size [(:width w) (:height w)]))
      (is (= {:position [100 120] :size [400 300] :state :maximized} (ui/window-frame w))))
    (testing "the program restores it"
      (set-slot! w :state :normal)
      (is (= [400 300] [(:width w) (:height w)]))
      (is (= [100 120] (:position w))))
    (testing "a minimized window is saved as normal"
      (headless/drag-window! w [50 60] [500 350])
      (headless/change-state! w :minimized)
      (is (= {:position [50 60] :size [500 350] :state :normal} (ui/window-frame w))))
    (is (= [:maximized :normal :minimized] @seen))
    (let [s (ui/window-frame-string w)]
      (is (= "{:position [50 60] :size [500 350] :state :normal}" s))
      (ui/close! w)
      (testing "restoring before show opens it as it was"
        (let [w2 (ui/window {:title "Again"} (ui/label {:text "x"}))]
          (ui/restore-window-frame! w2 "{:position [50 60] :size [500 350] :state :fullscreen}")
          (ui/show! w2)
          (is (= :fullscreen (ui/window-state w2)))
          (is (= {:position [50 60] :size [500 350] :state :fullscreen} (ui/window-frame w2)))
          (ui/close! w2)))))
  (is (thrown-with-msg? error "not a window frame" (ui/restore-window-frame! (ui/window {}) "(eval 1)")))
  (is (thrown-with-msg? error "not a window frame"
                        (ui/restore-window-frame! (ui/window {}) "{:position [1 2] :size [3 4] :state :normal} x")))
  (is (thrown-with-msg? error ":size" (ui/restore-window-frame! (ui/window {}) {:position nil :size [0 4] :state :normal})))
  (is (thrown-with-msg? error "a window's state" (ui/window {:state :huge})))
  (is (= {:position nil :size [3 4] :state :normal}
         (ui/window-frame (ui/restore-window-frame! (ui/window {}) "{:position nil :size [3 4] :state :normal}")))))
