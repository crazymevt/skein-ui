  (ui/password-entry {:text "secret" :width-chars 28}))
(define-sample search-entry "Text" "A native search field with its platform's search affordances."
  (ui/search-entry {:placeholder "Search…" :width-chars 32}))
(define-sample text-view "Text" "A multi-line native text view with selection, editing and scrolling."
