    [b (fn [] (ui/destroy! p))]))
(define-sample completion-popup "Windows and popups" "A completion popup leaves the keyboard with its owner. Use the arrows and Return."
  (let [e (ui/entry {:text "Choose a language"})
        p (ui/completion-popup {:items ["Skein" "Common Lisp" "Clojure"]
                                :on-accept (fn [ev] (set-slot! e :text (:value ev)))})]
    [(ui/vbox {:spacing 12}
              e
              (ui/button {:label "Show completions"
                          :on-clicked (fn [_] (ui/focus! e) (ui/show-completion-popup! p e))}))
     (fn [] (ui/destroy! p))]))

(defn sample-title [s] (str (:type s)))

(defn catalog
  "The samples, by title."
  []
  (vec (sort-by sample-title @samples)))

;; Showing a form: one line if it fits, else its head and first argument, then one
;; argument a line, indented.

(defn- pretty
  ([form] (pretty form 0))
  ([form indent]
   (let [flat (pr-str form)
         width (- 88 indent)
         pad (apply str (repeat (+ indent 2) " "))]
     (cond
       (<= (count flat) width) flat
       (seq? form) (let [[head first-arg & more] form
                         start (str "(" (pr-str head) " ")
                         first-s (pretty first-arg (+ indent (count start)))]
                     (str start first-s
                          (apply str (map (fn [x] (str "\n" pad (pretty x (+ indent 2)))) more))
                          ")"))
       (vector? form) (str "[" (string/join (str "\n" (apply str (repeat (inc indent) " ")))
                                            (map (fn [x] (pretty x (inc indent))) form))
                           "]")
       (map? form) (str "{" (string/join (str "\n" (apply str (repeat (inc indent) " ")))
                                         (map (fn [[k v]] (str (pr-str k) " " (pretty v (+ indent 2 (count (pr-str k))))))
                                              form))
                        "}")
       :else flat))))

(defn sample-source
  "The program text that makes the sample's widget."
  [s]
  (str "(ns widget-demo\n  (:require [skein.ui :as ui]))\n\n" (pretty (:form s)) "\n"))

(defn- dispose-preview! [w]
  (when-let [f (:cleanup (:user-data w))] (f))
  (set-slot! w :user-data (dissoc (:user-data w) :cleanup))
  (ui/clear! (ui/find-widget w :preview)))

(defn show-sample!
  "Show the sample's preview and source in the explorer window, and select it in the
catalog. Returns the sample."
  [w s]
  (dispose-preview! w)
  (set-slot! w :user-data (assoc (:user-data w) :sample s :preview-error nil))
  (let [list (ui/find-widget w :catalog)
        i (when s (index-of (vec (:items list)) s))]
    (set-slot! list :selected-indices (if i [i] [])))
  (set-slot! (ui/find-widget w :sample-title) :text (if s (sample-title s) "No matching widgets"))
  (set-slot! (ui/find-widget w :description) :text (if s (:description s) "Try another search."))
  (ui/set-code-text! (ui/find-widget w :source) (if s (sample-source s) ""))
  (ui/set-cursor! (ui/find-widget w :source) 0)
  (set-slot! (ui/find-widget w :copy-source) :enabled (some? s))
  (set-slot! (ui/find-widget w :reset) :enabled (some? s))
  (when s
    (try
      (let [made ((:factory s))
            [widget cleanup] (if (vector? made) made [made nil])]
        (set-slot! w :user-data (assoc (:user-data w) :cleanup cleanup))
        (ui/add! (ui/find-widget w :preview) widget))
      (catch error c
        (set-slot! w :user-data (assoc (:user-data w) :preview-error c))
        (ui/add! (ui/find-widget w :preview)
                 (ui/label {:wrap true :width 560
                            :text (str "This preview is unavailable: " (ex-message c))})))))
  (ui/flush-layouts!)
  s)

(defn filter-catalog!
  "Show only the samples whose title or category has query in it."
  [w query]
  (let [list (ui/find-widget w :catalog)
        q (string/lower-case query)
        old (:sample (:user-data w))
        matches (filterv (fn [s] (or (string/includes? (string/lower-case (sample-title s)) q)
                                     (string/includes? (string/lower-case (:category s)) q)))
                         (catalog))
        selected (or (first (filter (fn [s] (identical? s old)) matches)) (first matches))]
    (set-slot! list :items matches)
    (set-slot! list :selected-indices (if selected [(index-of matches selected)] []))
    (set-slot! (ui/find-widget w :count) :text (str (count matches) " widgets"))
    (when-not (identical? old selected) (show-sample! w selected))))

(define-example widget-explorer
  {:title "Widget Explorer"
   :description "Choose a widget on the left. Try it live, or read the exact source that makes
it. Search by widget name or category."
   :topics [:list-box :paned :tabbed-pane :code-view :stack :web-view :popover]}
  (let [source (ui/code-view {:name :source :editable false :line-numbers true :tab-closable false
                              :tab-label "Source"})
        preview (ui/vbox {:name :preview :padding 24 :spacing 16 :surface :content
                          :tab-closable false :tab-label "Preview"})
        tabs (ui/tabbed-pane {:name :tabs :reorderable false} preview source)
        w (ui/window
           {:title "skein-ui Widget Explorer" :width 1080 :height 720 :user-data {}}
           (ui/paned {:position 240}
                     (ui/vbox {:padding 12 :spacing 10 :hexpand false}
                              (ui/label {:text "WIDGETS" :font {:size 12 :weight :bold}})
                              (ui/search-entry {:name :filter :placeholder "Search widgets…" :width-chars 20})
                              (ui/list-box {:name :catalog :items (catalog) :item-label sample-title :border false})
                              (ui/label {:name :count :text-color :secondary-text}))
                     (ui/vbox {:padding 18 :spacing 12}
                              (ui/hbox {:spacing 10}
                                       (ui/label {:name :sample-title :font {:size 24 :weight :bold} :hexpand true})
                                       (ui/button {:name :reset :label "Reset"})
                                       (ui/button {:name :copy-source :label "Copy source"}))
                              (ui/label {:name :description :wrap true :width 620 :text-color :secondary-text})
                              tabs)))]
    (ui/on (ui/find-widget w :catalog) :selection-changed (fn [e] (show-sample! w (:value e))))
    (ui/on (ui/find-widget w :filter) :changed (fn [e] (filter-catalog! w (:value e))))
    (ui/on (ui/find-widget w :reset) :clicked (fn [_] (show-sample! w (:sample (:user-data w)))))
    (ui/on (ui/find-widget w :copy-source) :clicked (fn [_] (ui/set-clipboard-text! (ui/code-text source))))
    (ui/on w :closed (fn [_] (dispose-preview! w)))
    (ui/show! w)
    (let [samples (catalog)
          initial (first (filter (fn [s] (= 'button (:type s))) samples))]
      (set-slot! (ui/find-widget w :catalog) :selected-indices [(index-of samples initial)])
      (set-slot! (ui/find-widget w :count) :text (str (count samples) " widgets"))
      (show-sample! w initial))
    w))
