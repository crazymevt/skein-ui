(ns examples.widget-explorer
  "Live widgets beside the exact, runnable forms that make them."
  (:require [skein.ui :as ui]
            [skein.string :as string]
            [examples.registry :refer [define-example]]))

(def samples
  "The samples: {:type :category :description :form :factory}, in the order defined."
  (atom []))

(defmacro define-sample
  "Define the sample of a widget type: the form both makes it (its factory) and is shown
as its source, so the two never differ. The form gives a widget, or [widget cleanup]."
  [type category description form]
  `(swap! samples (fn [ss#] (conj (filterv (fn [s#] (not= (:type s#) '~type)) ss#)
                                  {:type '~type :category ~category :description ~description
                                   :form '~form :factory (fn [] ~form)}))))

(define-sample label "Text" "Selectable text with wrapping and a semantic text color."
  (ui/label {:text "Hello from skein-ui. Select this text to copy it."
             :selectable true :wrap true :width 360 :text-color :text}))
(define-sample entry "Text" "An editable single-line field. Try typing or pressing Return."
  (ui/entry {:text "Edit me" :placeholder "Type a value…" :width-chars 32}))
