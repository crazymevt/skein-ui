(define-sample window "Windows and popups" "Open a separate window. It closes when you choose another preview."
  (let [w (atom nil)]
    [(ui/button {:label "Open window"
                 :on-clicked (fn [_]
                               (when (or (nil? @w) (:destroyed @w))
                                 (reset! w (ui/window {:title "Sample Window" :width 420 :height 240}
                                                      (ui/label {:text "A separate native window" :margin 24}))))
                               (ui/show! @w))})
     (fn [] (when (and @w (not (:destroyed @w))) (ui/close! @w true)))]))
