;;;; The editor for code: highlighting with state, matching brackets,
;;;; undo, find and replace, completion and signature popups (headless).

(ns code-editor-test
  (:refer-core :exclude [settle])
  (:require [skein.test :refer [is deftest testing]] [skein.ui :as ui]))

(ui/theme! ui/base-theme)
(defn settle [] (sleep 120))

(defn styles [line] (mapv (fn [[a b s]] [(subs line a b) s]) (ui/highlight-skein line)))

(deftest highlighting
  (testing "brackets by depth, and an unmatched closer"
    (is (= [["(" :bracket-1] ["[" :bracket-2] ["]" :bracket-2] [")" :bracket-1] [")" :bracket-error]]
           (filterv (fn [[t _]] (contains? #{"(" ")" "[" "]"} t)) (styles "(f [x]))")))))
  (testing "a character literal isn't a bracket"
    (is (= [["(" :bracket-1] ["\\(" :string] [")" :bracket-1]]
           (filterv (fn [[_ s]] (not= s nil)) (styles "(\\()")))))
  (testing "state carries depth and an open string to the next line"
    (let [{:keys [state]} (ui/highlight-skein "(defn f [x] \"a" nil)]
      (is (= {:depth 1 :string? true} state))
      (is (= [[0 4 :string] [5 6 :bracket-1]] (:spans (ui/highlight-skein "b c\" )" state)))))))

(defn open [text]
  (let [doc (ui/editor-model text)
        st (atom nil)
        w (ui/window {:size [480 200]}
                     (fn [_] [:column {:flex-grow 1} (ui/find-bar doc) [:editor {:id :ed :model doc :highlight ui/highlight-skein :flex-grow 1}]])
                     st)]
    (settle)
    (ui/click! w :ed)
    (settle)
    [doc w]))

(defn keys! [w & ks]
  (doseq [k ks] (if (vector? k) (ui/simulate! [:key w (first k) (second k)]) (ui/simulate! [:key w k #{}])))
  (settle))

(deftest undo-groups-typing
  (let [[doc w] (open "")]
    (ui/simulate! [:type w "a"]) (ui/simulate! [:type w "b"]) (ui/simulate! [:type w "c"])
    (settle)
    (keys! w :enter)
    (ui/simulate! [:type w "d"])
    (settle)
    (is (= "abc\nd" (ui/editor-text doc)))
    (keys! w ["z" #{:cmd}])
    (is (= "abc\n" (ui/editor-text doc)))
    (keys! w ["z" #{:cmd}])
    (is (= "abc" (ui/editor-text doc)))
    (keys! w ["z" #{:cmd}])
    (is (= "" (ui/editor-text doc)) "the typed word is one step")
    (keys! w ["z" #{:cmd :shift}] ["z" #{:cmd :shift}])
    (is (= "abc\n" (ui/editor-text doc)))
    (ui/close-window w)))

(deftest an-opened-string-rehighlights-the-lines-after
  (let [[doc w] (open "(a)\n(b)\n(c)")]
    (keys! w [:arrow-up #{:cmd}] [:arrow-left #{:cmd}])
    (ui/stats)
    (ui/simulate! [:type w "\""])
    (settle)
    (is (= "\"(a)\n(b)\n(c)" (ui/editor-text doc)))
    (let [s (ui/stats)]
      (is (<= 1 (:frames s)))
      (is (= 0 (:layouts s))))
    (ui/close-window w)))

(deftest matching-brackets
  (let [[doc w] (open "(defn f [x]\n  (inc x))")]
    (keys! w [:arrow-up #{:cmd}] [:arrow-left #{:cmd}] :arrow-right)
    ;; the caret is after "(": its partner is the last ")" of line 2
    (is (some? (:skein.ui/sent-decs @doc)))
    (is (= [{:line 0 :from 0 :to 1 :kind :highlight :style :bracket-match}
            {:line 1 :from 9 :to 10 :kind :highlight :style :bracket-match}]
           (:skein.ui/sent-decs @doc)))
    (ui/close-window w)))

(deftest find-and-replace
  (let [[doc w] (open "foo bar\nfoo baz foo")]
    (keys! w [:arrow-up #{:cmd}] ["f" #{:cmd}])
    (is (ui/editor-find-open? doc))
    (ui/simulate! [:type w "foo"])
    (settle)
    (is (= 3 (count (:matches (:find @doc)))))
    (is (= 0 (:current (:find @doc))))
    (ui/editor-find-next! doc 1)
    (settle)
    (is (= 1 (:current (:find @doc))))
    (ui/screenshot w "/tmp/skein-ui-find.png" 2)
    (ui/editor-replace! doc "qux")
    (settle)
    (is (= "foo bar\nqux baz foo" (ui/editor-text doc)))
    (ui/editor-replace-all! doc "x")
    (settle)
    (is (= "x bar\nqux baz x" (ui/editor-text doc)))
    ;; (the find field has the keyboard: undo in the editor)
    (ui/click! w :ed)
    (keys! w ["z" #{:cmd}])
    (is (= "foo bar\nqux baz foo" (ui/editor-text doc)) "replace all is one undo step")
    (ui/editor-find-close! doc)
    (settle)
    (is (not (ui/editor-find-open? doc)))
    (ui/close-window w)))

(deftest completion-and-signatures
  (let [[doc w] (open "(ma")]
    (keys! w [:arrow-down #{:cmd}])
    (ui/editor-complete! doc ["map" "mapv" {:label "max" :detail "fn"} "min"])
    (settle)
    (is (= 1 (count (ui/popups-of w))))
    (ui/simulate! [:type w "p"])
    (settle)
    (is (= 1 (count (ui/popups-of w))) "still open while it matches")
    (keys! w :arrow-down :enter)
    (is (= "(mapv" (ui/editor-text doc)))
    (is (empty? (ui/popups-of w)))
    (testing "a signature above the caret"
      (ui/editor-signature! doc [:rich-text "(mapv " [:b "f"] " coll)"])
      (settle)
      (is (= 1 (count (ui/popups-of w))))
      (ui/screenshot (first (ui/popups-of w)) "/tmp/skein-ui-signature.png" 2)
      (ui/editor-close-popups! doc)
      (settle)
      (is (empty? (ui/popups-of w))))
    (testing "inline results go with the next edit"
      (ui/editor-inline! doc 0 ":done")
      (settle)
      (is (contains? (:layers @doc) :inline))
      (ui/simulate! [:type w " "])
      (settle)
      (is (not (contains? (:layers @doc) :inline))))
    (ui/close-window w)))

(deftest stale-completions
  ;; Completions are found on another fiber; they may arrive after the
  ;; typing has gone past the word they were for (skein-studio's Enter
  ;; once inserted "defn" after "(defn g [y]").
  (testing "items for a word typed past aren't shown"
    (let [[doc w] (open "(ma")]
      (keys! w [:arrow-down #{:cmd}])
      (ui/simulate! [:type w "p x"])
      (settle)
      (ui/editor-complete! doc ["map" "mapv" "max"] {:prefix "ma"})
      (settle)
      (is (empty? (ui/popups-of w)))
      (keys! w :enter)
      (is (= "(map x\n" (ui/editor-text doc)))
      (ui/close-window w)))
  (testing "a popup whose word the caret left lets Enter through"
    (let [[doc w] (open "(ma")]
      (keys! w [:arrow-down #{:cmd}])
      (ui/editor-complete! doc ["map" "mapv" "max"] {:prefix "ma"})
      (settle)
      (is (= 1 (count (ui/popups-of w))))
      (keys! w :arrow-left :enter)
      (is (= "(m\na" (ui/editor-text doc)) "a new line, no item inserted")
      (is (empty? (ui/popups-of w)))
      (ui/close-window w)))
  (testing "without :prefix, as before"
    (let [[doc w] (open "(ma")]
      (keys! w [:arrow-down #{:cmd}])
      (ui/editor-complete! doc ["map" "mapv" "max"])
      (settle)
      (keys! w :enter)
      (is (= "(map" (ui/editor-text doc)))
      (ui/close-window w))))

(deftest models-that-leave-the-window
  ;; Two models taking turns in one place, as tabs do.
  (let [a (ui/editor-model "(a)") b (ui/editor-model "(b)")
        st (atom a)
        w (ui/window {:size [300 120]} (fn [m] [:column {:flex-grow 1} [:editor {:key (if (= m a) :a :b) :model m :flex-grow 1}]]) st)]
    (settle)
    (is (some? (:skein.ui/node @a)))
    (reset! st b)
    (settle)
    (is (nil? (:skein.ui/node @a)) "a hidden model has no node, so its edits send nothing")
    (is (some? (:skein.ui/node @b)))
    (ui/editor-decorations! a :lint [{:line 0 :from 1 :to 2 :kind :squiggle :style :find-current}])
    (reset! st a)
    (settle)
    (is (= [{:line 0 :from 1 :to 2 :kind :squiggle :style :find-current}] (:skein.ui/sent-decs @a))
        "shown again, it gets its decorations")
    (ui/close-window w)))

(deftest hovering-says-where-the-pointer-rests
  (let [doc (ui/editor-model "(shout word)\n\nend")
        heard (atom [])
        w (ui/window {:size [480 200]} (fn [_] [:editor {:id :ed :model doc :hover true :flex-grow 1}]) (atom nil))]
    (ui/editor-hover! doc (fn [e] (swap! heard conj (when e [(:line e) (:col e)]))))
    (settle)
    (ui/click! w :ed)
    (settle)
    (let [at (fn [line col] (ui/editor-set-carets! doc [[[line col] nil]]) (settle) (ui/editor-caret-rect doc))
          {x1 :x y1 :y h :h} (at 0 1)
          {x2 :x} (at 0 2)
          {xe :x} (at 0 12)
          cw (- x2 x1)
          row (+ y1 (/ h 2))]
      (reset! heard [])
      (testing "over a character, after a moment"
        (ui/simulate! [:move w (+ x1 (/ cw 2)) row])
        (settle)
        (is (= [] @heard) "not at once")
        (sleep 600)
        (is (= [[0 1]] @heard) "the character under the pointer"))
      (testing "moving to another character ends it, and starts again there"
        (ui/simulate! [:move w (+ x2 (* 3.5 cw)) row])
        (settle)
        (is (= [[0 1] nil] @heard))
        (sleep 600)
        (is (= [[0 1] nil [0 5]] @heard)))
      (testing "past the end of a line, or on a line with no text, there's nothing to hear"
        (ui/simulate! [:move w (+ xe (* 4 cw)) row])
        (sleep 700)
        (is (= [[0 1] nil [0 5] nil] @heard))
        (ui/simulate! [:move w (+ x1 cw) (+ row h)])
        (sleep 700)
        (is (= [[0 1] nil [0 5] nil] @heard)))
      (testing "a key ends it"
        (ui/simulate! [:move w (+ x1 (/ cw 2)) (+ row h h)])
        (sleep 700)
        (is (= [2 1] (peek @heard)))
        (keys! w :arrow-left)
        (is (nil? (peek @heard)))))
    (ui/close-window w)))
